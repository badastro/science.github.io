<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 1</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3 4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MISNOMER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="OBVIOUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>A diner in Buffalo, New York</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A diner holds tables, chairs, and stuff. There is a stick positioned by a wall. A Red Wings poster is hung on the wall.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> is chilling.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> enters. She takes a seat.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Normal evening. Moderate time. Okay day.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Optimal atmosphere.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ms. Do you have a reservation?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> has some reservations about the place.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your body language says otherwise.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fine. Fine dining in a restaurant where there is nobody in nowhere Buffalo has me in reservation.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> hands her a white square card.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> writes “Ms. </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Nomer</Text>
      <Text>” on the card.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> sticks the card on a stand in the middle of her table. The card reads “Ms. </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Nomer</Text>
      <Text>.”</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your time here will be just fine. And I’m not a nobody. Manager Obvious. I will be your host today. I chewed my last employee last night, so things cannot get more understaffed here.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Camera: The stick (staff) tips over by the walls.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, it shouldn’t take more than one person to get me a buffalo wing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> comes out with a plate of a single buffalo wing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> touches the buffalo wing, realizing it is cold.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can you at least </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">cook up</Text>
      <Text> the buffalo wing?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A buffalo wing: a delicacy in many American dining establishments. It all started during the founding of this country during the birth of Sasquatch-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I meant “cook up” as in putting a buffalo wing on a stove. I don’t mean “cook up” as in to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">concoct a story</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ah, cock. Cock is typically the main ingredients for this menu item.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to the </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Audience</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Typically</Text>
      <Text>?! Not only is this restaurant understaffed, but the only person here is running around like a chicken.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I cannot help that I chewed out all my employees...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> stabs a pen into the buffalo wing.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> pulls out a clipboard with an application clipped.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If you wanna dish it out as an employee, here is an application. You’d be such a great fit in this restaurant, that it’d be your job for the rest of your life. Don’t be a chicken.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> extracts the pen from the buffalo wing.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let me be a chicken. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I need my chicken feeds</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> bites into the cold buffalo wing. It is an alienating taste.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This does not taste like a typical buffalo wings. In fact, I’ve never tasted anything like this before...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You don’t go out much do you?</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Manager Obvious. Since stepping foot in here, you’ve been so literal. Did... Did you actually stock up on bison meat?!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Beat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Wikipedias</Text>
      <Text> “bison hunting.”</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s been illegal to hunt bison since 1894. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I did add the spirit of Buffalo on this plate.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The spirit of Buffalo.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A soul...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What’s the phone number to call </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EPA</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Licking their lips)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No need to call anyone, especially the FDA! It’s on me as long as you leave this instance.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> is about to leave.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>By the way... Wherever you’re from, you cannot dish it out in my restaurant.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Why would I want to dish it out. You chewed out your employees after all.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to the AUDIENCE)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Chewed out...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Camera montages of hints that reveals that </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> did cook up something Buffalo.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You ate the people of Buffalo?!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> tries to stab </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> in the face, but she dodges.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It took one person to get you that buffalo wing. All I needed to do was cut back on one of their arms.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">MIsnomer</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">OBvious</Text>
      <Text> brawl.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I would dare never to eat my own supply. That breaks the ethics of our employee handbook!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> knocks </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> into a shelf of books and stuff. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> grabs the staff.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Misnomer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Things can get way more understaffed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Misnomer</Text>
      <Text> decks </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Blackout.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Epilogue</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="OBVIOUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Great Beyond</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The clouds.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Obvious</Text>
      <Text> is on top of the clouds. Wings expand behind them.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Buffaloes are grazing in the background. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Obvious</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Wild...?</Text>
    </Paragraph>
    <Paragraph Type="End of Act">
      <Text>End of Sketch</Text>
    </Paragraph>
  </Content>

