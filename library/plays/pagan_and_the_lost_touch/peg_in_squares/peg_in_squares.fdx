<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Label="Scene 1" Type="New Act">
      <Text>Scene ○</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 5/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AMBROSE/IA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MS. NGO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PEG/I">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>An Empty Block</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>After attending the retirement party of their pre-K teacher, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Peg/i</Text>
      <Text> walks home and talks to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic+AllCaps">Ambrose</Text>
      <Text>/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic+AllCaps">ia</Text>
      <Text> on their </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">AirPods</Text>
      <Text>. They carry a briefcase. They soon walk by their former run-down school.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ms. Ngo. She shaped up to be a great teacher. We’re lucky to have been in her first class.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A decade is just too quick for a retirement...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Middle-age retirement parties are so in</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No one but us went!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The invite list was a slip of paper.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>By the way, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">who slipped away with her briefcase</Text>
      <Text>? She has been frantically texting the group chat.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I don’t know.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s not me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ms. Ngo can live without it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (phone)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You and I always had very different experience with her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She can be such a square.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Mockingly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She hasn’t changed. Remember when she’d be like: “Peg/i, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">don</Text>
      <Text>’</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">t hop on the squares</Text>
      <Text>!”</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She was so weird about us playing hopscotch.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Mockingly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Oh</Text>
      <Text>, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">it</Text>
      <Text>’</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">s against her lord and savior</Text>
      <Text>,</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> Buddha</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She had a better sense of keeping religion out of public schools more than most teachers in this country.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where are you in this country?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is this another riddle?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No. Have you gotten home yet?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Almost.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The hopscotch is in sight. Peg/i towers over the ominous and anomalous chalk on the road.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Peg/i sets their briefcase on the ground. They open it. The briefcase holds a single stone which is societally insignificant but the whole world to Peg/i.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It only took ten years.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ten years to get home? Did you move out to Flushing without telling me?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My attempts were flushed down the tube going to this school, but today will be different.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Wait, where-? </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Whatcha</Text>
      <Text> doing visiting our elementary school?!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was on the fence. Since then, I vaulted hurdles. I jumped guns. I will hop these squares!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AMBROSE/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">IA</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Mockingly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Oh no</Text>
      <Text>... </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Ms</Text>
      <Text>. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Ngo is not gonna like this</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Too bad, she’s not here!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Peg/i tosses the rock on the first square. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ms. Ngo (Offstage)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Echoing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Peg/i...!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Did you hear that?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Uh, I admit it. You’re hearing me put square pegs in the wrong holes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ew- Damn, Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">ia.</Text>
      <Text> You get it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And you best not get...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Peg/i jumps on each square. With each hop erupts echoes of warnings  and children’s </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">laughters</Text>
      <Text>.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Ambrose/</Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Yourself into trouble.</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Ms. Ngo (offstage)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>You are in trouble!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Peg/i reaches the semi-circle of the hopscotch. They fall into another plane of existence.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene </Text>
      <Text>□</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 2/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MS. NGO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PEG/I">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Nowhere Block</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Ms. Ngo </Text>
      <Text>is in the darkness trying to put a literal square peg in a round hole of a toy. There is something off about her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ms. Ngo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Peg... Peg... Peg...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ms. Ngo?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh no... You completed the hopscotch?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Is this what you’re in? What’re you doing here?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Insanely)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nowhere else have I felt so whole.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You know you could have moved to Florida like every retiree. For a messed-up place, at least it has some beaches!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I retired? Never will I retire.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’ve been only teaching for ten years. You really shouldn’t.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sweetie. It’s still student teaching. It’s my first year.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>PEG/I</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you recognize me?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you happen to be Peg/i’s older sibling?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’re looking at Peg/i.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It can’t be!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Throwing themself in a loop)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Who is the Ms. Ngo that I know?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MS. NGO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That Ms. Ngo you’ve known has been a misnomer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Peg/i</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This has sure rocked my world.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Ms. Ngo </Text>
      <Text>notices the rock illuminating on the ground.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ms. Ngo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My stone... It is an ancient liminal stone that has warped spacetime. And you placed its roundness into the chalked up square. This is the only way to our salvation.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AMBROSE/IA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>An Empty Block</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Peg/i </Text>
      <Text>is lying on the ground, dazed. The hopscotch is now scribbles.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Ambrose/ia</Text>
      <Text>’s shadow towers </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Peg/i</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Ambrose/</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">ia</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Peg/i?! Get off the chalk!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Fin</Text>
    </Paragraph>
  </Content>

