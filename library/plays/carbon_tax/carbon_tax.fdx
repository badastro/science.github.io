<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Label="Scene 1" Type="New Act">
      <Text>Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CAM">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ESTHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HONG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MALUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="STEEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ship to Antarctica, 1998</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>From the ship’s deck, Antarctica appears in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>, an aspiring environmentalist and human rights activist, stares out towards the white horizon. She soon catches a snowflake.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tuyet </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">(Vietnamese: “Snow”)...</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Esther</Text>
      <Text>, formerly a boat person, enters the deck. She joins </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The ship is running aground soon. That’s where you can truly marvel at the snowy monsoon.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I remembered catching my first raindrop as a kid. They kept falling in, looking to get caught, until my hands could not hold all of them any longer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ESTHER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, you’ll love snowballs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Snowballs?</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Snow is a lot easier to hold than water, don’t you know?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s my first time, water zealot.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ESTHER</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’ve lived at the start and end of each year since emigrating to Canada and I’m still not used to it.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Esther</Text>
      <Text> tries warming her hands. She retreats into her quarters.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Cam</Text>
      <Text> enters and joins </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hong. Quit evading us.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Evading what, Cam?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The satellite phone bill. You rung it up. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s impossible to get a signal here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>CAM</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes, in the middle of Esther’s favorite escape.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Esther cannot run away from her past as a boat person.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Are you running away from something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Are </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">you</Text>
      <Text> running away from something?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The world.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The world is all we have. The world is... more like </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">someone</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Are you running away from someone?</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Amused)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Something: taxes! It’s unreal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So is Antarctica and them penguins.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Birds that cannot fly. That is definitely unreal. Scary to think that they need no breeze to set them free.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Steen</Text>
      <Text> enters.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Full steam ahead, am I right, Steen?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Three weeks of this nightmare and now we finally reach the belly of the beast.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m ready to eat the cost.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The Vietnamese, ready to eat anything that moves.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Du ma</Text>
      <Text> </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">(Vietnamese: Fuck you)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I wonder what penguins taste like.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like penguins, your jokes are always in poor tastes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I expected </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">MIT</Text>
      <Text> people on this expedition. Instead, I am surrounded by drug addicts and criminals out for flightless birds.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther (Offstage)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We are making landfall shortly. Everyone to your quarters.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Cam</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Steen</Text>
      <Text> exit, leaving </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> alone. The ship transforms into a cold prison.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 2</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="7/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HONG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WARDEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Prison, 2023</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Warden</Text>
      <Text> enters. They hand </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> some clothes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Warden</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your sentence will begin shortly. You can start making your way to your quarters.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I expected prison guards who worked with integrity. I’m surrounded by nepotistic fools who can’t fight no less.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Warden</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And I cannot cook either, so build them taste buds of yours. I wonder how you’ll fair here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Du ma </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">(Vietnamese: Fuck you)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Warden</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Environmental terrorists, ready to kill the progress of humanity to save a couple monkeys.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m ready for anything but never will I employ violence, like you for money.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Warden</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Three years you’re looking at. We’ll watch you end up the beast you purport to fight.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"> Warden</Text>
      <Text> exits, leaving </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> alone.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> puts the shirt over herself. She sees a bird fly in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The prison transforms into a town square in New Orleans.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 3</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 6/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT BLUE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT PURPLE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT WHITE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENTS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CAM">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DJ CAULIFLOWER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ESTHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HONG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="STEEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>New Orleans Town Square, 2008</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Cam</Text>
      <Text>, now </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agent Orange</Text>
      <Text>, and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Steen</Text>
      <Text>, now </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agent Purple</Text>
      <Text>, enter with protest materials. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Steen</Text>
      <Text> hands a megaphone to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>, now </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agent White</Text>
      <Text>. They are the Rainbow Agency, an independent global campaigning network, founded by this team of environmentalists.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent White</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Speaking into the megaphone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Birds cannot fly when they die. Quit crying for the dead and fight for their lives!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Purple</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Climate leads to one date and that date is the end of days!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Orange</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This is our dozenth unattended climate protest to date.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent White</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>“Agency.” It’s in our name.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Orange</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Rainbow Agency. Understood. However, the public clearly has no agency. America’s </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EPA</Text>
      <Text> does not even have agency and that’s also in the name! How’s it working out for you, Public Relations?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Purple</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>There’s enough agency for me to spend on materials out of my own pocket.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AGENT ORANGE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What did we hire Agent Green for?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AGENT White</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Herbert is an exceptional accountant. Rainbow Agency only hires the best. He’ll cover our losses.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Police lights illuminate in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Blue (Offstage)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hey! That’s our water!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Esther</Text>
      <Text>, now </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agent Blue</Text>
      <Text>, enters.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Blue</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Them cops are cutting our water supplies.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Purple</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Noticing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They literally are! They’re hacking at our refillable jugs and rendering them useless!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Orange</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The police, wasting our water again.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Blue</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They lay waste our freedom. Water was free until the corporations started bottling them.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Orange</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fuck the police. All they protect is corporations.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent White</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And we aid and abet them whenever we purchase bottled water. That’s why I proposed weaning out Nestle next year 09.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Blue</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The cops are burning the nest they’ve stolen.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Purple</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The only relationship that will never exist in the world is law enforcement and the public.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent White</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>At least they don’t know who amongst the public is a protester or a street performer here.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agents</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nawlins...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Police sirens blare.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Orange</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>They’re onto us!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AGENT Blue</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Cover our tracks. Let’s go!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AGENT WHITE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We can no longer evade the destruction of life!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agent Orange</Text>
      <Text> nabs the megaphone away from </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agent White</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Purple</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>There’s more to life than facing prison time.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Agent Orange</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>All this is taxing on our bodies.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Agents</Text>
      <Text> hide away their materials.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The police sirens and lights die down.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We started Rainbow Agency so that we can put our bodies on the line.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>There’s less need for that since we have a following online.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(re: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Esther</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>This geezer is not following.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We’re not making the same strides as Code Pink.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We’re no Greenpeace either.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Please.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where is Herbert these days?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>He is out finding for us the greens and peace. And he will find us back in our office.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The space was such a steal during our ongoing housing crisis.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Climate crisis</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 4</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3 2/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CAM">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ESTHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HONG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HONG, ESTHER, STEEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="STEEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Rainbow Agency Office, 2008</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The office has governmental and millennial inspirations.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> pulls out an overused poster board that currently reads “Save New Orleans” from the back. She gathers some markers and towels.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Listen up. The next climate protest is soon.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ah, yes. We’re going to Orleans, France for this one!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So, for this poster board, it should be simple to wipe off “New.”</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>New Orleans has a wonderful Vietnamese community that we should have hit up.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We can make up for that oversight. France also has a Vietnamese community- </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>More like... France has an interesting past with Vietnamese communists.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>For what the French have done to the world, there should never be “water under the bridge” for them.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Letting it go is what we must due as a society.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> tries wiping off “New” on the poster board.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Are you ever gonna let go of that? Thing’s falling apart.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So is life but we must remain content and recycle.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The cycle of life is using up all the energy until you’ve got none left, eh.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s every society’s model when it comes to convenience and waste.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Life is better content today at the expense of tomorrow.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>People are who should protect the environment.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Blaming the public is bad PR.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Who is to blame?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I don’t know. I do know we cannot openly look to the government for blame whenever we need their organizations’ funding.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That cursed government taxing us for our bread when they refund us crumbs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You cannot even get the crumbs out, huh, Hong? Agent White?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It does not matter.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Let’s settle this matter: why am I Agent Purple?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, the reason Hong declared me “Agent Orange” is cause I get all up in your space and stay there.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong, Esther, Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Yes, you do. And your jokes stink.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And you declared yourself “Agent White” of all colors.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The first Southeast Asian to set foot on Antarctica gets first dibs.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I second that-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I was second! Second Southeasterner to touch Antarctica.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(re: </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Esther</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>“Agent Blue” is obvious for you.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hong, you won’t be able to get that stuff off. Paint is not recyclable either.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My standards of white is icy.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I get it. Meeting the penguins on their home turf can change a person.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Doing that for the United Nations would change anyone.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> looks intently at the poster board.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Soliloquizing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Antarctica, a blank canvas. The unnatural men on Earth bring about change in the climate. Someone as unnatural as a Viet on Antarctica will change their worldview. That was the moment I missed the lushly painted green of Vietnam. My tears could not compare to her brush with morning dew.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Cam</Text>
      <Text> playfully takes a marker and directs it towards the poster board.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You were so scared that our ship would crack the whole continent when it beached.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m more afraid than ever.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Steen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Empty your mind of the trash coming out of Cam’s mouth.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m the one who speaks trash? Who mentioned that Agent Green Herbert will be with us.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fine. We’ll replace the poster board with a fresh one.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> discards the poster board.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You cracked under pressure.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>HONG</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sometimes, to gain moral, you must break the ice.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CAM">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ESTHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HONG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MALUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="STEEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ship to Antarctica, 1998</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The ship makes landfall.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> catches each snowflake.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">Audience Engagement</Text>
      <Text>: Before the play, the production team collected audience members’ answers for the prompt: “Describe snow,” written on snowflake papers. The answers are translated in Vietnamese. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> reads the snowflakes out loud.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Reading each snowflake)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>_ </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">(Vietnamese: _)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Cam</Text>
      <Text>, </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Esther</Text>
      <Text>, and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Steen</Text>
      <Text> amusingly observe </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Esther</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She’s so expressive. Her mother tongue is out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>STeen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If that tongue does not stop, it’ll freeze.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Cam</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>More like it will get her locked up.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Looks like you’re trapped here!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>And so are you three! What I learnt recently in English is that you cannot spell “freeze” without “free.”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene _</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="11" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MALUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Prison, The 2020s</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> enters the cold prison.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The prison doors lock.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> catches a dust in the air.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The prison transform into Antarctica.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene Last</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2/8" Page="11" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HONG">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MALUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RAU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Antarctica, The 1990s</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Hong</Text>
      <Text> has finally set foot on Antarctica. She opens her hand to reveal a snowflake.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hong</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tuyet </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">(Vietnamese: “Snow”)...</Text>
    </Paragraph>
    <Paragraph Type="End of Act">
      <Text>End of Play</Text>
    </Paragraph>
