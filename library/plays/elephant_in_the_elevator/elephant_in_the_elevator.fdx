  <SmartType>
    <Characters>
      <Character>Perry</Character>
      <Character>Warren</Character>
      <Character>Pery</Character>
    </Characters>
    <Extensions>
      <Extension>(OFF)</Extension>
      <Extension>(OFFSTAGE)</Extension>
    </Extensions>
    <SceneIntros Separator=". ">
      <SceneIntro>INT</SceneIntro>
      <SceneIntro>EXT</SceneIntro>
    </SceneIntros>
    <Locations>
      <Location>CARGO ELEVATOR, JAZZ FOUNDATION BUILDING</Location>
    </Locations>
    <TimesOfDay Separator=" - "/>
    <Transitions>
      <Transition>AT RISE:</Transition>
      <Transition>BLACKOUT.</Transition>
      <Transition>FADE UP:</Transition>
      <Transition>LIGHTS DIM.</Transition>
      <Transition>LIGHTS FADE.</Transition>
      <Transition>LIGHTS OUT.</Transition>
      <Transition>LIGHTS UP ON:</Transition>
    </Transitions>
  </SmartType>

