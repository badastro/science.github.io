<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="19691231T185959" id="11959490-87e9-458a-bfda-d7d416088c58"/>

  <Content>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8158d9d4-0383-4860-87f2-87c081f2a3a0">
      <SceneProperties Length="1 6/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JENNIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JENNIE, JOEY, OLIVIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="OLIVIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Int. Cafeteria in Madison Heights High School</Text>
    </Paragraph>
    <Paragraph Type="Action" id="33157cf5-ad0b-4290-b335-71e0b36db852">
      <Text Style="AllCaps">Banks</Text>
      <Text>, a middle-aged teacher, enters. In the speaker system, they try to set up a Bluetooth connection, then an aux connection, then any connection.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34569f60-f99f-42ed-9442-381c1bf12585">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8e1277f4-107b-45c5-a1fc-137d59204ec4">
      <Text>We cannot establish a connection.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="99410f4c-0ebc-43bb-8683-31dc31af2c6c">
      <Text Style="AllCaps">Joey</Text>
      <Text>, junior, and </Text>
      <Text Style="AllCaps">Olivia</Text>
      <Text>, freshman, step out to help.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf1d4685-4446-43d5-9649-d3e0aad5667e">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="010a7105-8a5e-4bcf-bcb3-f3ff848a8f42">
      <Text>Wanna play off mine?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="856ec9d0-5afb-4ea8-bc5a-edbfdb0bff6d">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21da4e25-b9a4-4ef6-812c-251d4cfb0017">
      <Text>Let’s do it the </Text>
      <Text AdornmentStyle="-1">ol</Text>
      <Text>’ fashion way. Got cymbals?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="96e6535e-5ca8-4361-b1e1-cc711a9c77fc">
      <Text Style="AllCaps">Olivia</Text>
      <Text> finds two plates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="95509279-f8ba-4a1c-8c4f-c65eb84de88b">
      <Text>BankS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b6ce052a-91d4-4f51-ae4e-005bc00b8d40">
      <Text>Those plates belong to the cafeteria staff.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d963d340-8f68-4745-989d-c5875223409e">
      <Text Style="AllCaps">Olivia</Text>
      <Text> finds two pieces of wood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5240f13c-60c1-4c8a-b387-1098b6ca1da6">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b5686d9-0c98-42fb-96a7-b8ac16e10e7b">
      <Text>That ain’t an instrument.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05e60138-0968-40a6-81e9-8d0b69fb351c">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aea70cac-5e42-4199-bfbc-bd1a8de987f2">
      <Text>Most things ain’t an instrument </Text>
      <Text AdornmentStyle="-1">til</Text>
      <Text> you make </Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a066a202-d1ab-4b0a-80a7-82fb948d98a0">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="84f0d121-8679-4cac-b947-4e7320e9df93">
      <Text>Will you two stop arguing? Time is running out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f88009c7-ecc6-4951-ab20-be8aa57c47fd">
      <Text>OlIVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="84f0d121-8679-4cac-b947-4e7320e9df93">
      <Text>Jen and Rey probably melted</Text>
      <Text Size="10"> </Text>
      <Text>in</Text>
      <Text Size="10"> </Text>
      <Text>the</Text>
      <Text Size="10"> </Text>
      <Text>lion</Text>
      <Text Size="10"> </Text>
      <Text>costume.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43ca1bc9-794b-47a7-bc72-bf7e31729fd4">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4827625-706c-4e63-88fc-b139575313c9">
      <Text>1... 2... 1 2 3 4 5 6... Just hit it, Olivia!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2d22b5a0-7708-4b2b-a5ad-c50b7efa942f">
      <Text Style="AllCaps">Olivia</Text>
      <Text> arrhythmically hits the woods. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="2a1d025c-a40a-4992-98ec-bd8875d6a9c2">
      <Text Style="AllCaps">Reynold</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Jennie</Text>
      <Text>, in a lion costume, dance in the audience. They try to engage with them before they join the others.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="555bc352-66f1-4afc-ba4c-9751dd01484f">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f94f5d49-a261-440a-810e-167b5177645a">
      <Text>(to the audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4393c038-1327-4b66-ba56-6f6745426787">
      <Text>Thank you for taking the time out of your meal to celebrate Chinese New-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c5da1e0-b196-48c0-90f9-39c39041e0c1">
      <Text>Jennie, Joey, Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="22e74b4b-dad6-45bc-b39c-c5611235de0b">
      <Text Style="Italic">Lunar New Year</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7dc5e84-fc45-47bd-bcc8-bbab2a7f17ee">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9a8d842-0fa4-4457-92c7-c8ff9943562d">
      <Text Style="Italic">Lunar New Year</Text>
      <Text> with the Asian Student Association. Club officers, state your role for those who don’t know you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c21f9e9-2d6f-4c37-b1d0-831e9af10cd6">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a369455-5bc1-40a8-be5b-6eb33ee90176">
      <Text>Olivia, treasurer.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a863148-9f59-4a28-9587-4ad85783895a">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06b8f8ba-d506-4a70-b67a-24f85dd130c5">
      <Text>Joey, secretary.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d2f08016-98e7-4a8a-bb79-ad9176f4b9e1">
      <Text>JennIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="be9b3d57-7b90-430f-b76d-705ca282fb6a">
      <Text>Jennie, </Text>
      <Text AdornmentStyle="-1">VP</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e26d33d6-bc55-4a0d-8f48-ccf5ea52de17">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a217da71-d368-4e90-9398-e7c63752eae8">
      <Text>President Reynold. ASA has been here for 25 years. This is huge! To commemorate this, we’ll host an end-of-the-year celebration with alums. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b95780c-6fd4-48e5-951d-9228d112ce32">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a217da71-d368-4e90-9398-e7c63752eae8">
      <Text>And we’ll need money!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c21ca633-2c79-4645-867c-6a2416e139ce">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a217da71-d368-4e90-9398-e7c63752eae8">
      <Text>So please feed our lion.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3428d7af-5007-48f6-9498-2bc7f7388a88">
      <Text>OlivIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a217da71-d368-4e90-9398-e7c63752eae8">
      <Text>Are your parents broke?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68781b93-f07f-4782-a3ba-e7077d093dfe">
      <Text>JENNIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a217da71-d368-4e90-9398-e7c63752eae8">
      <Text>Let’s have ASA last another 25!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2d22b5a0-7708-4b2b-a5ad-c50b7efa942f">
      <Text Style="AllCaps">Olivia</Text>
      <Text> hits the woods while </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Jennie</Text>
      <Text> dance out.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8158d9d4-0383-4860-87f2-87c081f2a3a0">
      <SceneProperties Length="2 2/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JENNIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="OLIVIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Int. Classroom - Shortly After</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d34c733e-c488-4650-97cf-0f03c824f23a">
      <Text Style="AllCaps">Olivia</Text>
      <Text> counts the same few bills over and over.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f28eb135-f877-4ab9-a292-713df0e51556">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="036361d1-6f25-460c-8995-3d7657a9caca">
      <Text>10... 20... 25... 10... 20... 25...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e204d186-ccd5-4d2e-894d-2d97820c8d7a">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61ce34a2-d201-4c39-8da2-3a228ed481d7">
      <Text>It’s been great while it lasted.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c18be3af-3c36-46e0-a2ed-eab3424caa94">
      <Text>Jennie</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a40dd3a6-f069-4821-8f42-cbcf9ceaebc2">
      <Text>While it lasted?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b4d978d-e746-448d-993b-be8c7f9e30f7">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a3be8ddf-c540-4bd2-9c22-4acef0631a07">
      <Text>Reynold was at the town hall?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d69ded6-fd8d-451d-9ccc-b21a38107501">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b914592f-1f49-4a73-9bfd-f015dba7c285">
      <Text>Yeah...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9ac27790-3c66-492e-b203-1cf32f4890bb">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1c9a1f78-e1f3-4ddb-9fda-8ef6e635f649">
      <Text>Did you not relay the message to the others?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60b993e2-601c-4d1d-9325-fa0213dc13e1">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bac7b1c8-7877-4153-9e19-5bc9524f64c3">
      <Text>What message...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b22413fc-2138-4235-93a4-60f0c22785df">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5b44a875-4ed1-488c-80f7-660f5bb8698f">
      <Text>To ensure compliance with the Department of Education’s new guidelines, all identity-based clubs are to cease activities by May.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e274292e-c42f-4c01-81bf-4331a88b2344">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1aac4ea3-b589-4115-a71f-0653649fefb9">
      <Text>I didn’t know that was for us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7888026b-08c3-42f6-8459-ca414306a5bf">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="18703144-b866-4a89-ab65-56cd0e9893c0">
      <Text>Pardon my French, but what the hell?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="257373c4-4c69-40ca-8b04-a4f08cd27ae6">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="254010f1-0bc0-4da3-9135-6e6cf41f195d">
      <Text>No need to curse!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00e3224c-b974-4464-8295-03cc9afc8cab">
      <Text>OliVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a8942048-8558-4718-af2b-cef20ade1322">
      <Text>Those fuckers-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1bfcbec-8453-4229-8dfc-61fa7289cd7a">
      <Text>Jennie</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="70e84a46-c058-4466-8062-d3edfdd774a7">
      <Text>We should make amends with the French club, hm?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b359c160-2cf0-4b41-9c16-7565c801a01a">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9d7629d-2363-4f1d-a472-d53f7d2306f2">
      <Text>The French are untouched by these guidelines.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5ef9779-1d5b-40f6-94bb-f4ceecf822b8">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bb96a7ff-2c0f-43b6-8eba-7edd8736d52f">
      <Text AdornmentStyle="-1">Excusez-moi</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91fdf358-a2e9-4c56-a0d4-7c99d553d774">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e37a6405-e305-441b-b257-dd7d11d05c03">
      <Text>The French, German, and Russian clubs are directly tied to our classes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d15852b-8b4b-4ad4-afab-189a58421890">
      <Text>OLIVIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="380c0b53-5528-4d34-8c2b-dd7d78d7b3d5">
      <Text>So, you want us to start a Vietnamese class?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8dcb1957-bc89-4582-809e-4fb8f7d58a30">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6297da5-3feb-4660-99fa-bbd265d3bae5">
      <Text>Let’s do a language people care about: Korean!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f112974f-bf00-4fd3-ae53-19dc3794c465">
      <Text>Jennie</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="814b3745-a238-4fc4-b98e-3da085e18927">
      <Text>Madison Heights is full of </Text>
      <Text AdornmentStyle="-1">Viets</Text>
      <Text>. How would Korean help?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="98f0a0eb-8fae-479d-ae42-1103f4b566da">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="756dd730-22cd-47ec-8aa9-90718172748e">
      <Text>America lost to you. No one really likes you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37eae7d5-2dc1-4ff8-bc5c-bf818571e4d9">
      <Text>ReyNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4a5991c-bd14-4863-ac21-8504843a544b">
      <Text>Let me speak directly to the board. They’ll listen to us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b3729f8d-b883-4af4-9f2d-7c2aec5f555d">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f36ecae2-455b-456f-b5ca-8b304d39ca81">
      <Text>I’m sorry there’s nothing the board can do.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c7a6ba4-5c0d-465c-bcd5-b4480546b382">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f5ea233-e3ac-4540-b705-92d76df5b533">
      <Text>You’re supposed to fight for us, Banks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4694ffdf-63fd-4a69-9d8a-a18311b47197">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b330ec5-12ff-4d03-af47-9591ace01c70">
      <Text>I bought you time. School clubs everywhere shuttered immediately.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d6267324-2d7c-430f-9f82-01de1d2e4073">
      <Text>Olivia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db3c47c3-783c-40ee-aa7e-a2dff3c872ee">
      <Text>I wish I </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> work with Ms. Tran’s leadership.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="340048d8-74f9-41e2-bf77-fc045710693f">
      <Text>ReyNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="016e4165-2090-4418-baa8-b88ba3b500dd">
      <Text>No need to say that, Olivia.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5c2c801-448e-41fd-a626-e81316b8ffa7"/>
    <Paragraph Type="Character" id="ef78ce0a-ac07-4821-b5e6-7481f5ea31c2"/>
    <Paragraph Type="Character" id="96cb1897-015a-4a28-a61c-bef918a41509"/>
    <Paragraph Type="Character" id="bff15867-a0b6-4d0f-b300-498eecdd19bf"/>
    <Paragraph Type="Action" id="0e6b6692-bfee-4b57-a37e-456cd646c6d8">
      <Text Style="AllCaps">Banks</Text>
      <Text> holds a dollar bill, then switches to a brown bill.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b31e281-1490-446c-b8b0-09c61694927a">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9a214459-fdeb-49ed-86d4-e3bc0212fc7c">
      <Text>For our currency called </Text>
      <Text Style="Italic">bullshit</Text>
      <Text>. It seems you all have done so while entering our carnation. The local and visiting merchants will want to sell you junk during our tour. Imagine the sorts of souvenirs that crawl out of Woodwork! And exits are located there in case there ever were to be a natural disaster. Only you can... get the fuck out of here while the firefighters put out the wildfires. Also, be conscientious of your language. You best not upset the wildlife. Do not say the C-R-A-P or P-O-O-P obscenities.
</Text>
      <Text Size="8">
</Text>      <Text>And if you need a refresher on that AP Biology class you took in high school, there is a link to our reference guide in our wildlife program. The tour is a bit over an hour. Now, welcome to Woodwork!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8d772c67-e741-49f5-9004-bdf8f264d4f1">
      <Text Style="AllCaps">Banks</Text>
      <Text> stands on patrol.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8158d9d4-0383-4860-87f2-87c081f2a3a0">
      <SceneProperties Length="1/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Peninsulas</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="71aaf3eb-5988-44e7-b97d-f8f81a31c9e6">
      <SceneProperties Length="2 5/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline">1. “</Text>
      <Text Style="Underline+AllCaps">Come into the Woodwork</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="86b33a33-2946-40dc-9de1-d9944eae2dff">
      <Text Style="AllCaps">Pyrus </Text>
      <Text>enters.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2836f637-abf1-444c-b466-619fc1f582bb">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0bb41021-1753-4b72-9a22-bd18fe34881f">
      <Text>Woodwork...
Works its way from the conclusion.
The town is backwards.
Understood?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="10dba982-673d-49df-b729-52c1336601c8">
      <Text>A miniature food truck with a Pineapple inside makes its way around the Peninsulas map. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="111ae973-749e-4cc9-bbe1-8a0add5ad0e1">
      <Text Style="AllCaps">Joey Pineapple</Text>
      <Text>, a young entrepreneur, drives about until the food truck lands in Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="078979fc-886e-4e0b-a4d1-5fe3b1fdf3b3">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5840b934-95bb-4f12-9aab-decf720647c6">
      <Text>Coming into the Woodwork!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70c23938-4748-4a2e-8b09-69580624c7a2">
      <Text Style="AllCaps">Joey</Text>
      <Text> parks their food truck. They bake fertilizer pizzas.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c40f180a-7a49-4c99-9b45-28da4f6e0173">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cf21eca1-9b02-45d8-b50b-21bc2d1cc6cc">
      <Text>Coming in with a permit?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="80e58451-c091-4266-adc6-7e3517a62410">
      <Text Style="AllCaps">Joey</Text>
      <Text> hands paperwork to </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4287f0ca-299a-4a92-b1dc-3bee84a3cc96">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6716c306-b849-4058-95c6-dc32210a1551">
      <Text>Joey in the peninsulas...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e621908b-5401-4647-9120-5df95d5f851f">
      <Text Style="AllCaps">Banks</Text>
      <Text> signs the paperwork and leaves to go about their day.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="62457b0c-d4e5-434f-9d7c-1d17e42ea1ac">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> approaches </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="40efd4ae-dc92-42bc-b789-9ac7e9fda598">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="605e86bc-0517-49da-a792-ff8f4d146367">
      <Text>Woodwork works in mysterious ways...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="26b759e6-6bdc-4f94-bab1-aef9d0e86fcc">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="605e86bc-0517-49da-a792-ff8f4d146367">
      <Text>Coming in hot!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c897a07-8b46-483b-9c5a-2e1f5e01cc72">
      <Text Style="AllCaps">Joey</Text>
      <Text> offers a sample of pizza to </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c897a07-8b46-483b-9c5a-2e1f5e01cc72">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> spits it out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cba22a4f-9590-4813-bb48-7cbb28abe73e">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2af70c39-0f49-447a-ba8a-5507746af616">
      <Text>Ugh... Ain’t no way, Pineapples shouldn’t be making pizzas!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00c6bf14-ee54-4670-82e0-af78b88301f3">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f90c79b9-d613-489d-940d-270154c55e94">
      <Text>And Crabapples shouldn’t be making anything.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7068285c-ad5a-456e-aa87-2f92c0d7cd26">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec2e2241-b2bb-405f-82d1-c0d238e7075d">
      <Text>Perhaps, I’m making mountains </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> mole hills. Ya look like a mole.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3946b5f3-283a-447b-8338-9ef65bce566a">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="be7ceffd-7f08-4a13-8a70-d539683814a5">
      <Text>I’m tryna get </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> my family’s shadow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9107239b-76ff-44b4-a6b6-fbf7f5fdcc9a">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d148c92-c4b0-440d-a5cc-0ba6d46b28aa">
      <Text>I know how that feels... So, ya family has a business?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="858102b3-58d2-4488-8b10-0d85d9ab850a">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3137b53a-e0c1-4ff5-9c5e-ded93c46380b">
      <Text>A business empire... Y n’ Pizza.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="35fda388-7f75-4676-bae1-4f563e46de07">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="80ac856e-b5a3-4d7b-8f9c-22f9eee5a1fe">
      <Text>My aunty/uncle owns a bar named “Fig Garden.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4c7708bb-a50e-4d56-888d-07997384800a">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="44b17ada-9c48-4181-86d3-50b8d2f6672d">
      <Text>Fig Garden... Do you work for them?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="65cda5f3-d0a4-444b-bd2f-d797aa01ffa7">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c1e1eb71-085b-44b3-8dfa-d5edb4dae095">
      <Text>I got their last bar Fig Leaf to shut down. Malus ain’t allowing me anywhere near this one. It just opened a few summers ago!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43e8db7a-40f9-4ffb-b266-3876fb251208">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="28130f76-bdd0-426c-9109-c53dc0c23bd8">
      <Text>Where are their headquarters?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c80b263-5f95-47b6-b5e9-066c86e3e8c1">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a78693b9-83cb-4f8a-ad76-c156eae7918a">
      <Text>It’s in Dirt Rapids.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1899edb-7cd8-4d87-acce-343a1a2f6492">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f42766a2-176e-4cd4-98b1-4ee1a4568bbe">
      <Text>Ah, just by Dirty City... Beautiful city.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d440a2a2-7df1-4c59-aab9-1ef1753c76aa">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db314abc-beba-4414-bf96-27e59b446050">
      <Text>Great plants.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="42546af6-cc59-4ad5-9a72-b6d752901065">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="92459b94-269e-4bb9-af57-3c411b525e58">
      <Text>Full of transplants, migrants.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="56730ed6-c6eb-4746-bebf-dd2f93f450da">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9a4af25-2c31-4504-8a48-0723c1f30af7">
      <Text>I work for a family there. The mother owns the salon, </Text>
      <Text AdornmentStyle="-1">Salontro</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb1adee7-cf40-4a51-82bc-b587db7d0aa2">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="641c2932-7d4a-454f-96dc-051778559eff">
      <Text>Who?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="25114519-fb17-466d-8e2d-fc563a165031">
      <Text>PyruS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="22814ae0-b67c-4fd3-897e-b050e5270749">
      <Text>You’ll have to meet the son. He’s visiting.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79f77736-eb8a-42bd-825f-cb92297fb027">
      <Text Style="AllCaps">Joey</Text>
      <Text> drives away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e8876ae9-802e-4a63-8083-e4e3c497c13a">
      <Text Style="Bold">Audience Engagement:</Text>
      <Text> A fingerpost with boards reading “Woodwork,” “Dirty City,” and other cities the audience wrote before the production is stationed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="99ab9296-2395-402b-b3c2-7a2847045926">
      <Text>The Cilantro symbol inches their way up to Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="638cd360-2d9d-4291-a853-0c9631d4b82a">
      <Text Style="AllCaps">Reynold </Text>
      <Text>runs in with luggage and talks on an apple-shaped phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ccf25da0-9ce9-4b4d-82c3-2f3bac2f1a0a">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="28c27ade-0329-467a-af4f-cdeef0ca27c2">
      <Text>(On the phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a937ead8-a94b-45f5-b1b9-a67d20e96859">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Chào</Text>
      <Text>, </Text>
      <Text Color="#3A3A0000FEFE" Style="Italic">me</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Hello, mom”)</Text>
      <Text>. I’m coming into the Woodwork. The guide post says it’s a few stops away, just past </Text>
      <Text Style="Underline">audience input</Text>
      <Text>, </Text>
      <Text Style="Underline">audience input</Text>
      <Text>, and </Text>
      <Text Style="Underline">audience input</Text>
      <Text>. Okay, okay! I won’t make eye contact with anyone in </Text>
      <Text Style="Underline">audience input</Text>
      <Text>. There’s only one or two roads in the Upper Peninsula. </Text>
      <Text Style="Underline">Audience input</Text>
      <Text> is unavoidable. Yes, mom. I brought the aphid repellent. Don’t worry. Pyrus has worked for us for two summers without an incident. </Text>
      <Text Style="Italic">Besides </Text>
      <Text>the party- </Text>
      <Text Style="Italic">Parties</Text>
      <Text>. And one was a surprise birthday party for you. </Text>
      <Text Style="Italic">Yes</Text>
      <Text>, </Text>
      <Text Style="Italic">you were very </Text>
      <Text AdornmentStyle="-1" Style="Italic">very</Text>
      <Text Style="Italic"> surprised</Text>
      <Text>. Indeed. Yes, I will plant that seed in their head. Bye, mom! Yes, I will keep my crop top nice and clean. Fuck </Text>
      <Text Style="Underline">audience input</Text>
      <Text> and everyone who lives there! They’re full of poop heads! Geez, I’ll watch the language. Fine, I’ll shut the fuck up. I’m coming into the Woodwork!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2502d682-05c1-4175-bd10-512b8da4c672">
      <Text Style="Underline">End of “</Text>
      <Text Style="Underline+AllCaps">Come into the Woodwork</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="edb5c629-1971-4b40-949a-eb7320a6f462">
      <Text>The large-scale map of the Upper and Lower Peninsulas vanishes.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="24eace42-9d91-4030-b39d-76f38a1a6643">
      <SceneProperties Length="2/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Woodwork, Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b3b0484f-5a52-4578-83db-7c01e35fc56a">
      <Text>Woodwork is a small town that resembles a town in the Upper Peninsula of Michigan like Ironwood. The town is surrounded by hilly resorts and sandy parks.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="71aaf3eb-5988-44e7-b97d-f8f81a31c9e6">
      <SceneProperties Length="5 3/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS &amp; REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD &amp; PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline">2. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Photosynthesis</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5583464d-cee5-4960-85ea-1d4e0edc8884">
      <Text>PyruS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4c622f68-f1a6-4b41-bbff-b1df4d43af18">
      <Text>Breathe in, breathe out.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="52542ac4-0749-4c1c-b994-96dd5c5c669b">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="c72a9954-78de-4207-99c2-c76cd672193a">
          <Text>Reynold</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="13b47965-eb23-442e-943e-7ad3fe978c8e">
          <Text Style="AllCaps">C 6
H 12 (Twelve)
O 6...
Plus 6 O 2.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="41e08dde-5938-431b-bb89-520e8a746de5">
          <Text>Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="67d89958-d18f-420f-be86-a7f9297ff149">
          <Text Style="AllCaps">Sugar,
Sugar,
Sugar,
and Starch.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="604103d0-e122-4e6e-8320-6ce7849d153b">
      <Text>PYRUS &amp; REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8364e236-e541-4b0d-a579-62cb3fe6f92b">
      <Text>Photosynthesis! Photosynthesis!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="782a82ff-465e-46fa-8246-b8463b471d31">
      <Text Style="AllCaps">Reynold</Text>
      <Text> pulls out his phone and snaps a selfie with </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83074a39-f351-4fee-9de5-0e95a1d4cae4">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8bc49474-9125-46ca-a844-f2b1fbac919d">
      <Text>Ya mom let ya have a phone?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fbcf0c0f-4369-4e73-8298-46370b18014c">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2678e239-4e96-461a-95c5-76a2faf0c51d">
      <Text>Remember. I’m going to high school this fall. Everyone has phones.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a4cbb722-8b99-470b-8699-776b7869b754">
      <Text Style="AllCaps">Reynold</Text>
      <Text> snaps another selfie.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="164b2fa6-e1d8-4b0c-a833-a402ec36eba7">
      <Text>Pyrus &amp; REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4d1ef949-be1f-4112-ab00-2f96552b9004">
      <Text>Photosynthesis! Photosynthesis!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="53ff0866-250f-4b58-8b01-b6b8f6f02b1d">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="c72a9954-78de-4207-99c2-c76cd672193a">
          <Text>Reynold</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="13b47965-eb23-442e-943e-7ad3fe978c8e">
          <Text Style="AllCaps">C 6
H 12 (Twelve)
O 6...
Plus 6 O 2.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="41e08dde-5938-431b-bb89-520e8a746de5">
          <Text>Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="67d89958-d18f-420f-be86-a7f9297ff149">
          <Text Style="AllCaps">Sugar,
Sugar,
Sugar,
and Starch.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="ba7962ba-1400-4663-916f-6a2ba9a21bd8">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> drink water and take photos at every corner of Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="651b4da5-dc05-4f67-a2bb-e2453ccedfd1">
      <Text>Pictures are displayed, including a photo of </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> with </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s pet mushroom named </Text>
      <Text Style="AllCaps">Matsu</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2a620d65-70b7-4ca9-8788-fae4d5f0555a">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="56d55250-c37e-43c1-baec-051653482267">
          <Text>Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="8f2c5606-0492-46d4-813f-62823fc70c93">
          <Text Style="AllCaps">6 carbon
12 hydrogen
6 oxygen...
Plus 6 oxygen molecules.
</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="67235bbd-4514-4b07-9af9-194f219e83b9">
          <Text Style="AllCaps">Carbohydrate!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="ac6a936c-7192-404a-88d8-a2bf6e515429">
          <Text>Reynold</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="7e6c75ff-a753-4fff-a8d9-5966dc791b21">
          <Text Style="AllCaps">Glucose,
glucose,
glucose,
and starch.
</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="241a4411-a3be-49b9-ab4f-2bc3ee26233f">
          <Text Style="AllCaps">This is photosynthesis.
Photosynthesis.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="4ca85702-c18c-48a6-be97-9fa23a15f8fd">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e755bbf6-61fc-4c7c-8133-b4d0af6f1b54">
      <Text>Ya photos need some work.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="608ebd73-b135-4094-8cbc-3188e4e5af04">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="61625257-7d73-416c-b358-8462c9ac56f9">
      <Text>I need good lighting.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dc715aea-7e7c-40cc-8114-2fb979291bbc">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="23bd78ec-1458-4c86-b2be-df76dbea6bd8">
      <Text>Ya should lighten up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="89ccfbfb-a506-411b-b9c3-f864905a261b">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4120a83b-0089-4bbf-a671-a529f21a698f">
      <Text Style="Italic+AllCaps">Light</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4c68916a-d619-414b-95bf-83d424979161">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> dance the sweetest of dances.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="0228a026-e709-4eeb-87c9-f53a1eee675d">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="1518ace8-451c-4e98-98c2-c4b63479a0e2">
          <Text>Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="761325df-dc69-47be-8e1e-aac9ba955940">
          <Text Style="AllCaps">C 6
H 12 (twelve)
O 6...
Plus 6 O 2.
</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="2fc0a3a1-8a92-4789-9e66-5f739c760508">
          <Text Style="AllCaps">Your cellulose.

Your cellulose.</Text>
          <Text Size="8" Style="AllCaps">
</Text>        </Paragraph>
        <Paragraph Type="Dialogue" id="ff043a9a-5356-4528-a4dc-7b16273df79b">
          <Text Style="AllCaps">We write: photosynthesis.
Photosynthesis.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="9a383a2f-ab3e-424a-a695-d8e39ff70e18">
          <Text>Reynold</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="f20cf886-aad8-4c34-bdb3-79400b135527">
          <Text Style="AllCaps">Sugar,
Sugar,
Sugar,
and starch.
</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="32083be6-b730-430c-a07c-e766ad525a7b">
          <Text Style="AllCaps">6 carbon
12 hydrogen
6 oxygen...
Plus 6 oxygen molecules.
</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="baeba1a1-ff76-4076-820e-b86f9837017b">
          <Text Style="AllCaps">Carbohydrate!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="bf269734-d181-41a1-b7e8-36719c829790">
      <Text>The space displays the equation: </Text>
      <Text Style="Italic">6CO2 + 6H2O → C6H12O6 + 6O2</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="03fe3cbd-4a25-4a3b-a01c-5d24b2c509a0">
      <Text Style="Bold">Audience Engagement</Text>
      <Text>: </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> hand juices to the audience.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06b47b72-0446-44f3-aeed-35754c2690a9">
      <Text>Reynold &amp; Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9c08424d-3807-44e4-a0b0-b4f250e7a902">
      <Text>C 6
H 12 (twelve)
O 6...
Plus 6 O 2.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9c08424d-3807-44e4-a0b0-b4f250e7a902"/>
    <Paragraph Type="Lyrics" id="9c08424d-3807-44e4-a0b0-b4f250e7a902">
      <Text>6 carbon
12 hydrogen
6 oxygen...
Plus 6 oxygen molecules.
</Text>
      <Text Size="8">
</Text>      <Text>Photosynthesis.
Photosynthesis.
Photo!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2502d682-05c1-4175-bd10-512b8da4c672">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Photosynthesis</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eaaeff98-c5c4-44c7-af30-debeca629134">
      <Text>The town square contains a structure of a hatchet. There is an informational plaque nearby, with a realistic hatchet attached.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eaaeff98-c5c4-44c7-af30-debeca629134">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> rest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="65f09887-d6b5-43d8-97b7-4cb9ffcb104b">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5f7e76f8-f161-4de0-a10e-962c16f57007">
      <Text>Welcome to Woodwork, a town where ya can visit everything in just one song.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="0c6bc59f-7f72-43ac-8c72-bc8072e08de1">
      <Text>(to the audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d97bce21-838f-49c9-bf16-d2affd6828ec">
      <Text>Drink in moderation. The latrines here ain’t cleaned in years. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="7217e304-e8ef-42c4-955f-1634d89b265a">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f89cf38a-a30d-44cd-9f5b-63f3bbfd1de7">
      <Text>Oh shit! I met your pet mushroom, Matsu, at the vet. But, we haven’t visited your parents-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="99a7d317-c505-4715-ad77-2657b9c3f087">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8c57529-8094-47fb-9b1d-25cdd303d438">
      <Text>Would ya like to know the founders of Woodwork?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9fdc8439-8d14-4001-b252-f18cdbcf7f55">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b11bcef-1c1e-4e1d-b692-2e1dac70f68b">
      <Text>I would!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="58a0a57a-2b74-43d2-85e9-ad94f8b3148c">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0d3e10a-9d13-4937-8581-883df7e92788">
      <Text>So would I!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="501b04d9-1bd2-4c6f-b0f2-3dbadb31230e">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ce322c63-1280-461b-a25b-f15d1251e50a">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b9e3e535-1ad0-4576-9fcb-48b8a978916f">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> knocks on the plaque.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11ad0745-72ba-4d54-b0b6-cbd910a40137">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d28a53c1-f156-488b-b37b-780cd8da7cb5">
      <Text>I ain’t know a splinter about Woodwork. I ain’t care to memorize. Knock on wood. I just read these plaques. Legend says that long ago before anything, everything was made of ice.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90b7c10f-254f-439c-a626-58c7c1bfb674">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="12e44ff2-e954-4485-989e-927e699d884f">
      <Text>An ice age!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15f040c7-0312-4279-b52b-f80faa842658">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c90b0f15-e0e9-4216-8b28-f95852265112">
      <Text>No surprise ya paid attention in school. There was a hatchet like this, stuck in an iceberg.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f7feca1-e756-421a-9136-1a87da01c9d3">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="336df5fb-ad2b-470f-a0b7-cc2849f60d67">
      <Text>This is not the original.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c60d8436-b91c-44da-8831-15178c5d4500">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a074d18-5d72-4fd3-abda-32989e7da5d6">
      <Text>It’s a replica. </Text>
      <Text Style="Italic">Because it’s legend</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c8bc6a8-8a24-4608-b665-50de4dadc6ec">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9c67abe2-7669-4720-88b5-dbc5aaf913a1">
      <Text>Un-canon? Taxpayer money went to a replica?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b89c4704-2101-4342-b4c0-0e38a97180a1">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3ffa22e2-bea2-4c2b-9d0b-c6c3dae6f80a">
      <Text Style="Italic">Ya interruptions are taxing</Text>
      <Text>. No mere giant could pull the hatchet out. Until this hot giant came around.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="42cd4f86-33f9-4e4e-b4c1-e139c9fbfac6">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="886f589d-f3e9-4720-a107-87b73d68fc35">
      <Text>What a way to break the ice about this town.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fec6ae81-a3bc-43fc-ba48-aac5d75c1570">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52bd7afb-21f1-4950-8cf6-2f7fbeecd06f">
      <Text>They came on through and melted it out. Then, they did a hatchet job on the Peninsulas, clearing a path for Woodwork to germinate.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6062dbb6-45d9-43b8-b112-4f34985ba850">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29e82462-e438-495b-bcf2-d305e9ed0e6b">
      <Text>What else did this giant use the hatchet for?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b573b44-d38e-4cba-84b1-9bdd43654a46">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56e63efd-5b78-4730-97dd-d429708c52ed">
      <Text>Killing monsters, zombies, and taming beasts?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="10025e55-a9b0-4a6a-af21-8604329ecc31">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7c7f302c-8288-4fa2-b9d5-7d19be3e0a5b">
      <Text>Did this giant happen to na a pet named “</Text>
      <Text Style="Italic">Babe</Text>
      <Text>?”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="784480b1-30b6-4adb-bb49-cc0720936074">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0ebf08aa-9729-47d7-9231-3faf132955c4">
      <Text>They wouldn’t name their pet something silly like “</Text>
      <Text Style="Italic">Babe</Text>
      <Text>.” I’d bet ya bullshit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="829d23ab-6c52-4dfc-b26c-1b8aefd1c153">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d3e7510-a4ed-4e48-a367-0826118c048b">
      <Text>Actually, they were an ox. I know the legend! The giant’s appendages were responsible for the creation of 10,000 lakes in a neighboring state.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6738ed5b-a2ef-429d-ba7e-5ba9c92d4989">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="002c7788-1f80-4ad3-a28e-fdcaed57e1ca">
      <Text>If ya think the Gopher State is 10,000 times more interesting, then </Text>
      <Text Style="Italic">let’s go</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d35a47f9-4047-4a65-b011-2ebc0142963b">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a1df115c-3808-4644-8f26-7fc3afa60de2">
      <Text>Woodwork, I dig it!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5d750873-474e-4b6c-b9ad-2260c89111b6">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7791a1b-fa5f-49a2-a64b-ec72690b3eda">
      <Text>Ya rodents are so easy to entertain. Our origin story ain’t so original. </Text>
      <Text AdornmentStyle="-1">Anywho</Text>
      <Text>, storytelling ain’t why you’re here!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e6fb148-fc7f-4b9b-b3e3-3c216ab78420">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="861e8698-a4cf-4953-96da-8ae5f654156c">
      <Text Style="Italic">You are so campy</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9fc73d92-ec92-44d4-a41b-b208796b837f">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5ad44f6-deed-4a3d-8b15-da8778a2e222">
      <Text Style="Italic">Say it to my petals, goody two-leaf</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45780f26-0abc-4171-a0c7-99a3d25b935b">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c4b70cba-03b5-4cd9-ab1a-d3f66f60bd29">
      <Text>I mean- We’re camping!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a9012c96-4721-4445-8111-af6c8161f1d7">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e8b980b-add3-4a50-a38d-1143b5585fbe">
      <Text>Ya bet ya axils off, we’re camping!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0bda13ef-b7c0-40bf-815b-5696221f449c">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9c55d1a6-76d7-49d7-b961-8dfde08a6b45">
      <Text>Woodwork National Park?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c844ae27-3113-4b6a-b3c0-4b5e7a783f6f">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="944d571a-e969-43fe-bbe7-33bc27b1a645">
      <Text>Sand. Valleys of sand as far as ya xylem can imagine. No moms to boss us around.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ebbd988-1542-4b85-af06-26441a647a84">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5e83f3d-3f57-4260-bd34-1b24ce8d749f">
      <Text>Yeah haha... I cannot imagine a world without mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="604574bd-cb3b-4fdc-8cad-17be0682959e">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7587ed5a-fd7c-4e3c-b4ee-ae758274f6a5">
      <Text>Ya ain’t need to. This is real.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72f145c2-8a9d-4048-943e-fca79426916d">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f34e4424-ff42-4da5-befd-99d35ae45287">
      <Text>Surreal... Like that food truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a544eda1-2b5d-42a3-8b26-e52ccd46fb61">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5262f55-4f8a-4c35-9773-fd9c86bf8a36">
      <Text>Yeah...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e5e68c8d-1a34-4dbf-a1d8-8b9179e06bcf">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03c07d5c-91cb-4ea9-a917-3d7a2bd35ffc">
      <Text>Why are ya avoiding that food truck?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fad598d1-4250-485d-89b0-3998cc712b86">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="85fedf28-ae3a-4e09-9286-34a7dd178418">
      <Text>Pineapples shouldn’t be making pizza. That ain’t natural.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4cb6cd8-9e05-4ef5-bed2-f095223a7d2e">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="561f01cb-8b7c-4df4-b70c-2f129ebcfc0a">
      <Text>That’s what my mom use to say about our friendship...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f0c4102-2b34-4c16-b9da-9095cdad91ea">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d422eeb3-f068-48e4-ad7c-d50ade7c61f3">
      <Text>Acquired taste. Much like a Pear and Lil Herb.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fd8afd0-d0bd-4ae7-afbb-cff9c044d7ce">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3348c870-44ed-4f56-8db6-19fc46e89bde">
      <Text>I’m not so little anymore!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed552dd6-4475-4256-995e-2f6573e4acd6">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f35ef7c-2811-4d84-9368-0668e4783d58">
      <Text>So, you’re old enough to set up a tent?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30d07ad0-f766-41c5-b8fe-34dbd226c195">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e1fffc26-0a9b-43a2-9b19-5564f806625a">
      <Text>Woah, woah, woah! You set me up!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6597107c-acf1-4fb0-ab5b-08f665de746c">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c283835-aca2-44d9-8b20-5f8df189563b">
      <Text>Nuh uh. </Text>
      <Text Style="Italic">Ya grew up</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d3ac8c7-3694-4224-94f8-d976f9b18bee">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bbbb48c2-1617-4888-a2fa-550ac51e62be">
      <Text>Alright. Let’s make some adult deals. I get the food and you set up camp.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70c23938-4748-4a2e-8b09-69580624c7a2">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> hands bullshit to </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84b20b62-43fb-4a4b-8e24-ed3ad2936efd">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="285c2298-485e-41f1-8a9a-ff0f0bf61d69">
      <Text>Here’s twenty bullshit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af4d164f-adc3-4ce5-b968-0f99fc283f10">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="95d86bfa-dfd4-44ef-a7b3-3d684e7fd391">
      <Text>After the seasonal job at </Text>
      <Text AdornmentStyle="-1">Salontro</Text>
      <Text>... What do you actually want to be when you grow up?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aedd06ee-d883-4c19-bc6b-c574bd2b81f7">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d416d674-677c-4f43-943c-f98bbe3021ce">
      <Text>I don’t know... You?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="57e2d2a5-b72a-4f97-91d2-0e5229585231">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d15857dc-a58c-4a0e-97a8-33be22635f25">
      <Text>I always want to be a good business partner.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37781879-06db-4841-83e5-e4641567fbda">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f42d3b9-05e7-4d04-af8b-cec639cbf649">
      <Text Style="Italic">Ya certainly are never apart and always in everyone’s business</Text>
      <Text>... I know: I want to come out of the unknown. I want to be remembered.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="102459d9-46f9-4ed0-bade-3795b75c674a">
      <Text Style="AllCaps">Reynold</Text>
      <Text> motions for more money.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="531276f8-f1c1-40b6-9e99-9b23c35c5277">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="80a75f05-7023-4601-92f6-72e83a38d658">
      <Text>Sounds like a load of bullshit. You’ll make bank. Give me even more bullshit or </Text>
      <Text Style="Italic">I’ll tell my mom you left me unattended</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9351bd3e-e2a6-4c75-93a2-aa64213b674f">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0f62fea-80dd-41ea-8263-88ea27de43d8">
      <Text>Buzz off. You’ve learnt a lot, but you’ve got plots to learn from me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="baeac4a3-57ec-4761-85de-a232b4e6e1ab">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7e3fb8f6-7830-471c-8731-1228fdd5f19b">
      <Text>Nothing more to learn from a </Text>
      <Text Style="Italic">poop head</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8a682890-dc3f-475d-a681-a8492d395809">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20231240-8955-41b6-a134-dc2a8f46dfcf">
      <Text>Wash ya mouth out with soap or ya mom will!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9430f6bb-32da-4189-a8de-79377147d60d">
      <Text>PyruS &amp; REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e0bd1829-467b-4957-a2fb-8085ca5ada80">
      <Text>Let’s make some sweet memories together...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="01c05894-5cdc-40d3-b567-5c5196926b28">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> exits.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="88b4e076-3cbd-4e45-b07a-aedbfd99d197">
      <SceneProperties Length="1 2/8" Page="13" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork, Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d1500964-799d-439e-a405-9a9ae1598827">
      <Text Style="AllCaps">Joey</Text>
      <Text> drives in the food truck.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d1500964-799d-439e-a405-9a9ae1598827">
      <Text Style="AllCaps">Reynold</Text>
      <Text> goes to the food truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="271678b5-09fc-4bcb-8595-0c8145fcd954">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="619df7e9-f4fb-4570-be4a-445ab12b5a43">
      <Text>Woodwork keeps surprising me. A Herb in these parts?! Are you the one I’ve heard is visiting?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7647d8b1-4a0c-4e1d-8004-75a009686acd">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="371959d4-4658-4c1d-8e4d-7c690a057636">
      <Text>Where’d you hear that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cb502fc3-2500-4a82-ac2f-ca8281c3611d">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4ea14664-7b93-4750-9449-9ac2e21e8e3b">
      <Text>A Pear told me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c6d02ba8-3e70-4850-a662-6834e1d4c6de">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="26aaf891-4e94-4a91-aa27-c5a2a5be9f77">
      <Text>Ah, Pyrus Crabapple. Are you...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5daa1028-ea08-4cf5-b999-b8cfcc93e0b4">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="82b87fd4-dd46-47c7-b185-fcf0b6b4e4de">
      <Text>A Pineapple. Yes! And where are you from?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fce90ca4-499a-46b6-8931-a79dd006e56d">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db40dd0e-28a9-478f-8c6c-a322854da16a">
      <Text>Dirty City.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8f8e1bd5-458a-4803-bcc8-559f93408fbc">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8088be3d-3ed6-4df4-8ce0-f7b7e87f3ffe">
      <Text Style="Italic">Really, where are you from</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e88381b-462f-405d-b6a6-c87257ac8a7e">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="067ad2bd-ef69-4b45-a42d-fca630b3fbaf">
      <Text>Dirty City is in the Lower Peninsula.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78af5c4a-4996-4185-8c0d-5cd33eb31dfb">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e9b26c1-75d5-4266-bb19-449dcf133f78">
      <Text>What are your species?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d7c79ff7-a327-4d07-b499-14038f61fb5d">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="792c1a7f-96c9-403b-83b9-e2d2d96c7e75">
      <Text>I’m a Cilantro.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="300a0488-f9fd-42a4-b51f-73cf93a280c6">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c76d05d2-ba55-4544-9da0-c6687af1502c">
      <Text>No... Where did your parents come from?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="97b7ce37-d70d-4b10-a3a9-018542b1138a">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e57c82b4-ad45-4d23-907a-e42596444693">
      <Text>Like you, my mom comes from a business mindset.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82544d73-0fad-4814-becf-7d302b9834e9">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fd3afc0b-60f8-449a-8d47-9328299bbe88">
      <Text>What is your name?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="70e0ecae-825b-4828-be0e-e5356f470231">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7f1de78-203e-4e8b-9db4-ca87cac53483">
      <Text>Reynold... Reynold </Text>
      <Text Style="Italic">Ram</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef1632af-9706-4c1c-803a-17c448cc6d9a">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49050c42-e95e-4ea7-a6cd-f075138296f6">
      <Text Style="Italic">Ram</Text>
      <Text>...</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Chào</Text>
      <Text Color="#00000000FEFE" Style="Italic">.</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE" Style="Italic">Reynold oi, con </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">có</Text>
      <Text Color="#00000000FEFE" Style="Italic"> me. Con </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">phai</Text>
      <Text Color="#00000000FEFE" Style="Italic"> di lam </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">cong</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">viet</Text>
      <Text Color="#00000000FEFE" Style="Italic">? </Text>
      <Text Style="Italic">(Vietnamese: “Hello. Hi Reynold, you have a mom. You are on a business trip?”)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ab2ef38d-911f-4ae4-89b5-bc04d26ba38c">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="81dd683c-200a-43de-bee9-92d222676524">
      <Text>Your Vietnamese is sour, but in a good way. I’m not here for business, I’m here for the fun.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d6880391-eefc-4481-b893-f323dd1e88f9">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b596a4e-0e0e-4629-9f55-3407ff6b0d8b">
      <Text>Same thing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bdd9155-edcd-4127-abfd-dda0afa3828e">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="81dd683c-200a-43de-bee9-92d222676524">
      <Text>You and my mom would get along. Hi...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3fd83fd-a33e-4917-8923-7457f520a838">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6fc75baa-38a0-43b0-81b3-b79974f446bc">
      <Text>Joey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c2cd8023-ea79-473e-8d72-5c051bb564aa">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="97000325-b63a-4e78-8fb9-74b60a759620">
      <Text>Joey. What is the finest pizza in your establishment?</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="71aaf3eb-5988-44e7-b97d-f8f81a31c9e6">
      <SceneProperties Length="3" Page="14" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD &amp; JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline">3. “</Text>
      <Text Style="Underline+AllCaps">Pineapple and Pizza Go Together</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="82c516ba-5a21-4387-91f9-a5761e5f3a4e">
      <Text Style="AllCaps">Reynold</Text>
      <Text> hands bullshit to </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="82c516ba-5a21-4387-91f9-a5761e5f3a4e">
      <Text Style="AllCaps">Joey</Text>
      <Text> bakes a pizza in the meantime.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="098f7337-a29c-44d8-968b-4a16a8432c5e">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="63b566ec-9113-4f93-a691-6c65a87618d2">
      <Text>The finest pizza is made by yours truly...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0cb8cc10-6e83-4c93-8d97-1d848e705067">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="45f319cb-c5d7-424d-afe7-aab54f88b8db">
      <Text>Pineapple and pizza?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68ac0145-6be1-48f8-94ad-efeef7c6f975">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7952364b-ba3f-450f-9341-cf84de0110b8">
      <Text>Go together!
</Text>
      <Text Size="8">
</Text>      <Text>I know that sounds cheesy...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c3aa3f7-d59e-4bb5-b5a9-3b81bdf89235">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7952364b-ba3f-450f-9341-cf84de0110b8">
      <Text>It already makes me queasy!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c3e5ad1-65e7-4c80-88a5-a479ee973acd">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8b875dd3-1a62-45a8-b7a1-11d549cfa82b">
      <Text>You </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> balance it out with the sour!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="87d000a0-1aab-4d48-8878-e95d7c04a254">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="239d544c-09c6-42c9-9d0a-9344c91d3fd3">
      <Text>You shouldn’t have this creative power.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9177cbb5-1ce2-490f-a6c9-93b8954f8506">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="166caec5-e2ea-4531-90f0-5f27596d6aed">
      <Text>I’ll let democracy decide.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="08c786a7-521b-4120-8ac1-f17b250445d2">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="22aa8e46-0b72-43d9-bb3e-33a50cb6b8be">
      <Text Style="Italic">Letting</Text>
      <Text> democracy decide is ironic?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6ff30aaa-fdc0-4401-b309-470c31c2a593">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f773e6a1-6099-4bc4-9dde-12fde43087fd">
      <Text>(to the audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee370c57-4262-4a9d-bd87-5ba9a9a98a4a">
      <Text>Raise your appendages if Pineapple and pizzas go together!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c65a5e23-0d29-4a19-b823-2e7e20442817">
      <Text Style="AllCaps">Joey</Text>
      <Text> responds positively to any raised hands from the audience.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="369260f0-2eff-4141-a162-dc8c0fabcff7">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f2f24f19-3660-49c5-bf9d-9228fa28dd8a">
      <Text>These sneezeworts love me!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aafe99c8-af5b-4f36-a1db-15f8ab39f891">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="98d93edc-fb73-410a-a151-99eeb561f136">
      <Text>You see these sneezeworts, too?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da421876-9421-4887-80ca-d00d4ea7d97f">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="264d6d57-a35f-4df2-a1de-e58cee914203">
      <Text>(to the audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8bc3e9b3-92f6-4d00-8f16-f7176c7e18a3">
      <Text>Pineapple lovers, do you feel seen?!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="83cdd81a-b7db-43ee-9263-8f36b9103406">
      <Text>Feast with your eyes
eat with your mouth
feel with your soul.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f4d2caf6-8987-4f79-a6a7-edb5e88cd7ef">
      <Text Style="AllCaps">Joey</Text>
      <Text> finishes baking the pizza. They give a piece to </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="123016dc-76e9-4c3d-ae57-827704920342">
      <Text Style="AllCaps">Reynold</Text>
      <Text> eats the slice.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4c7b786e-ad9d-4d4e-a614-259c62c55127">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="95d7a077-961d-43df-adfc-92383fd6765e">
      <Text>Feast with your eyes...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad2f7256-ba7b-4ce2-83e5-7efcb81118b1">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="df1dd84f-5971-4f91-b745-d42b9bd7adcc">
      <Text>Feast with your eyes...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a9f3417-db0f-4c78-bdad-81e30244c1e7">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9dad2921-8d75-4c36-88ab-50adccd111ab">
      <Text>Eat with your mouth...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b508a1dc-1d34-4a53-b93d-6423e9ba2bcd">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="926a3c3c-908f-44ef-8cd3-dfa8686b8298">
      <Text>Eat with your mouth...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e9bff39-0f29-4d5c-b621-0cedbcc47cb1">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="95d7a077-961d-43df-adfc-92383fd6765e">
      <Text>feels very sour...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86139de3-18bf-491a-88b5-27edd8be03f1">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b256c8bc-94a0-4dd2-8cae-a4b5af1251b1">
      <Text>feel very sou- What?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="450a75aa-0aac-42ab-adeb-29511056287a">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7d5e3a18-42af-4b16-b3b7-8433b0843768">
      <Text>Pineapple and pizza go...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e5c1db37-ecec-4550-a439-d18a654f8cb4">
      <Text>Reynold &amp; Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0df686ff-ea1c-477b-b001-734c36c2ff57">
      <Text>Together!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c1f0d29-1a39-4898-b9ff-55f52fe06308">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="1b58ab03-d01a-47cc-bc07-48550b21e4ab">
      <Text>(to the audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9ab2a9d2-c1b9-4d7b-aadb-1ca5b92581e0">
      <Text>Slice of Pineapple’s pizza? Piece is on me!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8091fa2-cab3-471b-a3ab-0c73113b6b3d">
      <Text Style="Bold">Audience Engagement</Text>
      <Text>: </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> hands miniature slices of pizza to the audience while </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text> sells refreshments to the audience in exchange for bullshit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e962bc1e-8391-4615-9709-787f988ba88c">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd6091dc-bad9-4805-831e-3d36b4daeeb5">
      <Text>Refreshments for a few bullshit!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e562467b-fa68-4d03-990d-4bbbd9d8bbe3">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="2dcd39bf-f87e-4773-88c3-fd71641634fc">
      <Text>(to disapproving audience members)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="813efd70-eafd-424a-bca5-7f990d67354f">
      <Text>You have bad tastes... You’ll come around...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="99fd6eca-c77c-452c-9d83-75c35cdb0bbc">
      <Text Style="AllCaps">Reynold</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text> dance the Cilantro-and-Pineapple dance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9df0045-0f48-446f-891f-7a42855da3e2">
      <Text>Reynold &amp; Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7d5e3a18-42af-4b16-b3b7-8433b0843768">
      <Text>Pineapple and pizza go together!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2502d682-05c1-4175-bd10-512b8da4c672">
      <Text Style="Underline">End of “</Text>
      <Text Style="Underline+AllCaps">Pineapple and Pizza Go Together</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="deff1650-a40d-4502-a0ca-3763914e34ec">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1c6e435c-a4c5-4623-89df-8d015b5c0199">
      <Text>And Cilantros go with everything!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78e0b5fc-80ff-4521-82f6-f642400589df">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d46be222-92d2-4d22-a9aa-c2bd2cfce794">
      <Text>My mom doesn’t always think so.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b8d6ce9f-0b22-4399-a4b6-ddf4b55a1a45">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fae09e17-e00f-4c49-b9f5-86e9b07bdd82">
      <Text>How come?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b0a6bf8-85bd-4902-8d38-00bbc2095a2d">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5fedc7da-c11e-44d3-a2ee-14dc4982f892">
      <Text>She says that the public sees our demeanor like a soap opera. We are but foreign creatives cleansed in melodrama.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="28997b91-b855-4651-bdab-66eeed556549">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="849d6489-e56e-4468-b64c-5d84cc6c9f26">
      <Text>Well, the public seeing us Pineapples as sour pricks </Text>
      <Text AdornmentStyle="-1">turnt</Text>
      <Text> out to be bad optics. And now, my family owns the multinational food empire.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="71025441-c603-4486-be90-e4c469fe9a58">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56e047ae-492e-42a7-967d-9737ba30125a">
      <Text>I don’t think the Cilantros are gonna start the international salon empire any time soon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6737b80d-dc9c-43bb-a74d-cfc95c8b035a">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1ab92159-1f3c-41d2-a63b-06f69c276399">
      <Text>Perhaps she’d be proud to see you trying new things. Making new friends. Baking new food. Imagine Cilantros making pizza!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70385211-f575-487d-9dcb-c93bb910fe1b">
      <Text Style="AllCaps">Reynold</Text>
      <Text>’s limbs begin itching.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f3ae04f-5b0d-4f31-b8de-f6653c8956eb">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="51c22195-cf62-4df3-b6be-fc209fda53e8">
      <Text>Only I could make pizza taste like soap. My skin is crawling. I best be going.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a91f2e6-f910-491e-b167-ffe804fc198b">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a446bfc9-0c36-4722-93a2-5ba27a7bedc0">
      <Text>And I best be staying.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d32f69d-7d52-4004-ba8a-e8a2facb4990">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="995844f7-4bd6-4ec7-8a8d-68c8d1bc461b">
      <Text>Thanks for the pizza!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ae3cccd5-29cc-44f3-8725-9ecf7eb339d4">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="423fbd03-711a-4dda-b954-d732a7429f54">
      <Text>Thanks for the peace in mind...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f7c35e6-7b02-4e7f-8c4e-f43b55c268f9">
      <Text Style="AllCaps">Joey</Text>
      <Text> visits and speaks directly to audience members who ate pizza.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6725fa2f-8fa0-4c06-8ef7-ffdf147d2340">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9619865-5663-4ef9-a61d-f9246cba75f9">
      <Text>You don’t look at peace... You seem to have a sick mind. Wait, you are sick. Oh no! The fungi is not sitting well with you. This ain’t fun.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70385211-f575-487d-9dcb-c93bb910fe1b">
      <Text Style="AllCaps">Joey</Text>
      <Text> rushes back into the food truck and drives away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70385211-f575-487d-9dcb-c93bb910fe1b">
      <Text Style="AllCaps">Reynold</Text>
      <Text> walks away with the pizza.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="3 3/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork campsite, Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="94976fdd-e81c-48ee-9dda-c0bb74719971">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> is having a difficult time setting up the tent.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="df38cc7d-104d-43a8-ab96-dbe705a0c8ef">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7a43dd0f-dd72-47ce-ba4a-1daebbca206a">
      <Text>I’m gonna give that Lil Herb a piece of my mind. What is taking Reynold so long! I ain’t reading this crud.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9322aa86-630e-482a-8f21-51b149af9dae">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> reluctantly flips through the manual. They toss it away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72e492d3-34a9-49e4-9c7a-efcb02763cfe">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac22b900-fd88-493d-96be-15e48ca85b4d">
      <Text>Words, words, words. You’re as meaningless as the dirt you’re made of.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="01e7fee5-cfcb-46fb-9e96-142d448919e4">
      <Text Style="AllCaps">Banks</Text>
      <Text> enters. They pick up the manual.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c92cbd7a-48ec-4eec-8e30-6e95d28edac8">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5cd7bd61-d383-4b25-81a8-344432d802da">
      <Text>That manual is all bark but no bite to you?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82a8f730-1595-4dd5-b18f-7d8ddb2818b7">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="82c92dd2-718d-4933-b7fd-91c1d67c7080">
      <Text>Scout Leader Carpenter...? </Text>
    </Paragraph>
    <Paragraph Type="Character" id="619058a4-9c46-4cb8-98be-65cf86bd6a0a">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e0162ea-faaa-4fcf-a802-7df41cba0f96">
      <Text>What did this park ranger teach you?</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="17f3913c-5c78-4d6f-954c-c4e9ddbfa56b">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="602de73c-a044-45cd-8315-a4594d00b89e">
          <Text>PYRUS</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="6f30d8ce-4d34-428d-93c3-b1a5cf1e998e">
          <Text>To not... litter...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="4ff0dc56-a49e-4832-81e2-e349418955e2">
          <Text>BANKS</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="a97819f2-1391-4832-a1f3-0290a9bb5816">
          <Text>No littering...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="900223b7-e021-4405-b988-c4c940190959">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a15bd7c1-2baa-4368-939f-34cda595b868">
      <Text>I ain’t never a good scout that’s for sure.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="897fe861-5a13-453b-8184-aba8aacc7735">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a57b2b37-414e-40a4-a244-75e4c4bba6a8">
      <Text>I taught you to be sure in yourself that you have been and will always be a great scout.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b8d4a41e-e430-4dc8-951d-837745ea22d2">
      <Text Style="AllCaps">Banks</Text>
      <Text> helps </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> set up the tent.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b65696eb-8ca5-48ab-8150-f19e40cf9673">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e5b3432-ff30-4d38-8bda-3176a1fda69d">
      <Text>Has there been a ton of enrollment?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="573d7745-8908-41c3-9bf6-2415f88cda52">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc662643-16a8-4830-a355-ae9de4434320">
      <Text>Never quite as abundant as your class.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="66018891-fe61-451b-9717-427403b7950a">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af69ebe6-22cb-4afd-9bb0-1c2e27c73b01">
      <Text>Have ya been scouting anything exciting lately?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e233cb09-d675-4d54-8771-631c03615e11">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="337241e7-ad77-43eb-8e15-ff5daa610a9b">
      <Text>Nothing’s quite as exciting than your last Christmas in July jamboree.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="480d249b-93d0-49ec-8dca-258f17b97142">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bc793294-5f29-4759-b3c3-ae33866ea9c3">
      <Text>Ya don’t happen to have it-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e187d86-dc13-44a3-8c21-5d42bb22b782">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4bbbd93-0e0e-4b9a-aaa9-50bc93942d2f">
      <Text>I have fond memories of it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54c41307-6455-450e-ac91-b31479bd1fa2">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd7a61e8-7fdd-4206-acd9-146e79b82ff5">
      <Text>Physical memories.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="292343ad-ec2f-4bfa-964d-acbffe86ad48">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1409b91e-307e-4fec-9a3d-d5ef36e90234">
      <Text>Photosynthesis. Photosynthesis. Photo!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e4f478b-76de-4670-b159-4a5205ffa3e2">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b14724a-0ca1-4606-bd13-a12ba0f4fa53">
      <Text>Oh no...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7fd12f9c-98d6-4895-b049-90850a8b836b">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54935c82-f795-47e7-821f-6110ece91902">
      <Text>You were so expressive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e589dfb8-e1e1-4d22-90a6-53b30490d191">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c610c5a-3397-48da-b9b5-b0a6f6e971dd">
      <Text>I was so embarrassed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11744152-d96b-4936-8670-c3bc41896b35">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6036ac97-2f0e-4545-a2b1-0609532db22c">
      <Text>You were being yourself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="66b90563-cc4d-484d-bc68-31e3cb82e154">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37b5c7d4-cb59-4cf9-b65b-34f440e8d646">
      <Text>Look... Pears are not meant to wear ornaments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ca85fb3-adf8-40be-babd-26807632e4fe">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5b460d2-5d3d-44c2-afa8-953c0f1e45e4">
      <Text>Anyone is meant for ornaments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b53a3cee-11b0-4fd0-9b10-19b91775a10a">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af69ebe6-22cb-4afd-9bb0-1c2e27c73b01">
      <Text>Every ornament I held </Text>
      <Text AdornmentStyle="-1">turnt</Text>
      <Text> to crap.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d492c975-845b-40c8-89f1-15350c6a5373">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="48ca0b02-f5a2-4f32-a8a1-eadf1a46d075">
      <Text>Don’t say that about yourself. As for the food truck in town...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e74f093f-345b-439a-b691-2f787c200460">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2ea9c0e-9723-498f-8984-dd44d37f0b9b">
      <Text>Pineapples making pizzas. Yuck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d10563b-bbcf-4d09-a35a-d1936d578690">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6839dbd8-5adb-4dba-96da-8b06df4a0312">
      <Text>Pineapples and pizzas don’t go together.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe763312-a4e6-4436-ad56-72ee782e6e4f">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7a9445fe-edde-4b68-96a8-592c01b7989c">
      <Text>But stakes and dirt go together!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aef4634b-8fdc-4e48-854f-1bb25a9552f8">
      <Text Style="AllCaps">Banks</Text>
      <Text> hits the final stakes into the ground, stabilizing the tent.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c94118c8-14e8-4f8c-8503-79183aae06dd">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fc9ede8d-a238-41c8-938d-15726e05154a">
      <Text>Your wellbeing is what’s at stake. Holler whenever you need an extra appendage!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b7adb62c-c1f7-4bf0-846f-2df01581bf77">
      <Text Style="AllCaps">Banks</Text>
      <Text> walks off.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1238482a-b114-427a-827d-df4dee7e19b7">
      <Text Style="AllCaps">Reynold</Text>
      <Text> walks in, holding a pizza box. They developed itchy rashes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb78c619-eceb-4718-8bc1-3b59f58ae76d">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7616bd4c-fdff-44fd-8028-ee351230522d">
      <Text>I’m gonna rip ya leaves off and squash ya into pesto, Lil Herb. What took ya so long?! Ya left me to tend the camp!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e9fce93-eb6d-4dbe-8bbf-70b3b00a1ec0">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="59744d13-143b-4f03-801b-a6893a96d2ce">
      <Text>(Dizzily)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6410df1c-e717-4f67-9d92-2542c475385c">
      <Text>I barely could fend for myself-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4b9e978-2188-4a79-8141-905ba25eedea">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16bf34d8-e6a1-437f-aead-c37249be10de">
      <Text>Congrats on reaching the end of ya journey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="442812f9-d48f-40a4-9de5-15f8cd56c721">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="717fd251-239c-457e-bc03-aadb38be05ae">
      <Text>Feels like the end...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48af53b7-ba25-4f8c-809a-76a3b2c08810">
      <Text Style="AllCaps">Reynold</Text>
      <Text> profusely itches.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c454bc4-6275-4e65-b070-ea1be20296f4">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a18bc557-7391-46fd-9a8c-e85fc4c2cdbe">
      <Text>Woah there. Did ya make out with a Poison Ivy without telling me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2465e913-b230-4a08-b883-ad36bf4f2ee4">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4ef2bff6-b74b-4618-bb43-dd87a94e6099">
      <Text>Ew, no.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3c4859de-900a-49e1-ae54-97b67b0d23a3">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16bf34d8-e6a1-437f-aead-c37249be10de">
      <Text>Now, what ya itching to give us?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3265835f-6f72-4635-be86-ef4d144a5585">
      <Text Style="AllCaps">Reynold</Text>
      <Text> stumbles and falls, revealing an empty pizza box.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68602e44-7691-4ed8-95fb-14b1f1ac19f9">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a086df08-19f6-4464-93b5-6c06f5b51951">
      <Text>Ya ate all our pizza! Ya gonna come up with an excuse? Teens are the worst! Reynold? Reynold?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="08b1e01d-bb37-4b63-8615-f911a2f218b3">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3e3f669-2b47-4f45-a74f-2b2d38d69de2">
      <Text>Pesto-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="367d0c11-f5bf-452c-b85c-0e98a88e8206">
      <Text Style="AllCaps">Reynold</Text>
      <Text> pukes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c5e0f8f-689a-4c01-b87f-ab27216585f2">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1dfbc941-d6aa-4477-8616-9b721fe896b6">
      <Text>Look who’s talking...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="59af570f-0a51-4c76-9fd0-62226ee2caed">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ed820b3-1667-4fbc-873d-a89910641454">
      <Text>I hate puberty.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d53b7b49-f8bd-41e3-87a4-d6455ea8cc87">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bea9268b-ebec-4843-bae1-628681a450a4">
      <Text>Does puberty make you see angels?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be8bd365-e76f-459f-9bb1-ee4f04ce9faa">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="654e28a4-72cc-4a0d-8271-33b6f6fbef78">
      <Text>Aww...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="618d63d0-cad7-4ecc-95b5-2595f708fd19">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dca574e3-de8e-455f-a2cf-067df31f3c5e">
      <Text>Cause I see monsters.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="24e8b0d2-a7ec-4507-87ef-806be2db21c4">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93258887-c8f6-435b-a9d1-3ea817b40d0d">
      <Text>Ya still are a poop head. Get sunlight but don’t go to the light. Stay put. I’ll go and get medicine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="602770b1-ea4b-4249-afa2-e8f90a838720">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6855de7-c490-466a-a633-67bc7442e61c">
      <Text>Real pills this time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d243dd22-041d-40bd-ac99-8ff4fac68b72">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f4be724-eae9-487e-a0ed-8518c61201b4">
      <Text>No stimulant will ever fuck us that hard like ya mom’s pills.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f6cedae-488c-498d-af0b-6d3f8f747145">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b6844cbf-0662-4f3e-beca-70dda9fd4f48">
      <Text>My mom’s gonna kill me...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b13362d-3b46-47bf-92f9-4e80b322b002">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="feebbccb-32b6-4b82-9931-56085c6cf9ee">
      <Text>I’ll uproot everyone before I let that happen.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e0a7bacb-9732-4e12-8e76-dd3dafcb05e9">
      <Text Style="AllCaps">Reynold</Text>
      <Text> rests in the tent.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="abfccad9-ba8b-42a7-bd71-4c3c9f141cd6">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> heads back to the town of Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="24eace42-9d91-4030-b39d-76f38a1a6643">
      <SceneProperties Length="2 5/8" Page="21" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork Gate, Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="31683d88-2a46-4753-9728-586935744066">
      <Text>At the entrance of the town of Woodwork, a warning sign is posted. </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text>’s food truck speeds off in the distance. Distant sirens are audible.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="15ccab4f-5d5a-4607-ac93-ab8384a8ddc7">
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s apple-shaped phone excessively buzzes. They check.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f81f41ae-4bec-45ca-bad6-2097583520c5">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7c801710-2fe0-4fd0-a95a-29dcc47bd74a">
      <Text>72 missed calls? Come on, service! Signals are awful out here, ugh! Mom. Dad. What do ya want?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9722a0dd-1962-4b32-b05f-ecf4970a4b03">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> tries to call.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c64365b3-ce53-438d-acb7-9b96eb7ef483">
      <Text>PyruS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ea447bd-2924-43d7-ad16-05f5adbcefdc">
      <Text>No, no, no. Ya don’t do to me what I do to ya: ignore my calls!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7b8453b-9967-4e33-9e23-2c384e1095c7">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> repeatedly tries calling.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="44b7f608-79a6-406d-81a7-ed1cba54e3f3">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f3f29f6-c2a1-414f-966b-6f695e074f99">
      <Text>I probably should check my texts.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="694b1466-2eb8-4c92-ac97-c5c90993e0bf">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f75391c-25b3-4866-b7be-f0f3b894b100">
      <Text>“Don’t come into Woodwork. The town has been overrun by </Text>
      <Text Style="Italic">monsters</Text>
      <Text>.” Monsters? Ha! The mayor and their cronies are monsters, but these monsters are holding healthcare hostage. Is Matsu out of the vet...?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="2111b8b6-4d79-48ed-9de8-4a99bd88ed8d">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d07be0d2-3822-4ca6-98a7-24903539143d">
      <Text>“Grandma took Matsu </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> vet... Is watching over them this week.” Phew...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7b8453b-9967-4e33-9e23-2c384e1095c7">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> notices the warning sign.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4b3f0be-fabf-4539-a3cc-ed9d4e605e31">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="5ee0d87a-9d86-4497-a00b-1005ca579c2a">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6f0d1087-17c6-4613-a55e-528ffdaf9953">
      <Text>“No outsiders allowed in. The city is under quarantine. No plants can plant themselves in this garden. Do not come into the Woodwork.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7b8453b-9967-4e33-9e23-2c384e1095c7">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> dismisses the warning.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a6278f0-c686-4557-ab42-0c0ca6823150">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="07de0446-b30b-4905-940f-51c4da19d441">
      <Text>(Soliloquizing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="892f6c39-a25e-441e-9a19-35dc398918e7">
      <Text>I was born in Woodwork. I know every rock: igneous and sedimentary. I know the bullies who lie underneath, ignorant. I know those who skip them, sentimental. There is nowhere to hide in Woodwork. Nothing can come out of the Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c886f6d9-f6ec-4a60-9a3a-ebb254c52146">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> comes into Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8af52a9a-5b76-4c95-be79-2ead8936e58b">
      <Text>Unseen zombies are audible.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1411464-ac17-4f86-b8ef-c075b4a60098">
      <Text>Reynold (Offstage)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="a7ece388-da6b-474e-9437-65d292c5aa6b">
      <Text>(Echoing from beyond)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a91e0c50-c074-44a1-9497-88043eb0ea94">
      <Text>Come out of the Woodwork!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="57b19044-51da-4d80-a783-407451611d3f">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> goes to the audience and directs their insults at audience members who ate pizza earlier.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c45a9edd-000f-4815-a828-cfbad33b3b7d">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2eb93233-5720-4e81-aa4e-3771e27aa155">
      <Text>This is as queer as it gets... I know everyone in Woodwork has accepted their ugliness, but ya really </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> work on yourselves!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a3a1a23b-5276-484c-9f3a-bd5d1a865e45">
      <Text>The silhouettes rise, representing hordes of the sick populous.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ebe06013-0401-4ee1-bfaa-f4f9f2400c08">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9a016262-6e2c-4eec-9331-34609abfa9eb">
      <Text>Ya know me. Everyone’s favorite Pear: Pyrus! Ya all have that same rash that my Cilantro friend’s got... Oh... Uh, get away! Shoo! Don’t eat my aldehyde! I also taste like soap!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="edacdeeb-8d12-4a72-93da-b538d8b52e5c">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> runs about until they get to the town square with the hatchet structure. They grab the small hatchet by the plaque.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83b65eee-394a-4452-9b82-cee37c39b3ed">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ccadbdc3-a004-4490-a991-0e78460bdc02">
      <Text>This also feels like a replica. Does anything nice ever come out of Woodwork?! Stay back, zombies. It’s me versus you!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9a161a44-fc00-47e2-bf7e-3926f7f17d0a">
      <Text>The monstrous silhouettes have </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> backed into a corner.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b208458c-f54a-4f0b-83b6-3ae1d80c3862">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8f6ffef2-fbe5-4e03-b48b-13cb9abd20f1">
      <Text>(Giving up hope)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8737387e-d19a-4b96-87ec-dd8b5b0d5c90">
      <Text>Mom! Dad! I’m so sorry, Reynold! I’m sorry, Scout Leader Carpenter...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e47d4ff-7391-4a64-9ad7-5b10805f9ac2">
      <Text Style="AllCaps">Banks</Text>
      <Text> leaps in and comes to </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s defense.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b14eda70-e111-4cc2-b8f1-12de6f6a31e5">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="723df160-dfd3-4e41-b694-6736ca05d2fd">
      <Text>Back up! I have the Fire Safety Merit Badge!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fd6effac-9486-44f8-9bce-8e51a89e2676">
      <Text>The silhouettes give off a collectively disappointing sigh.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="671af944-e17a-4410-8a46-980ad5ec09a1">
      <Text Style="AllCaps">Banks</Text>
      <Text> gets </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> to safety.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed0480b7-9d99-4117-ad97-8891936cc75e">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a2e22df-b4d7-4b89-bb3e-6f7524e22797">
      <Text>I guess there is merit to fighting fire with fire as plants...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0945af30-d19a-4563-a6c2-a9674acac802">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42c76d43-4ea8-4852-bdc3-9da5036a64f5">
      <Text>I’m fired up. Woodwork is under lockdown! What were you up to, putting yourself in harm’s way-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1c538a2-15d7-4799-a9b3-1a60434ddc83">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8db32ba5-715a-4a1f-839a-d07419b7a6b7">
      <Text>My friend, he is sick.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1b3ff05a-a598-4717-9d6b-621b2ceef1a7">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f7e10496-efb8-47ce-9de9-0a5c66597639">
      <Text>He is one of them now.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7dd3adf-2978-4bc5-a25d-3263886fccf4">
      <Text>PyrUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="460a5638-5f5a-42f6-b4ad-7b6064e5b8b2">
      <Text>One of who?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90a891f7-b0b5-4b9e-83c7-3816858f93a0">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="30f29468-33be-4c81-a5f9-22958144ef28">
      <Text>Those zombies who almost ate your aldehyde.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="17a9f623-1fb0-4510-9884-d60a2bb132c3">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="66ac78fa-46fb-4bb0-9bb8-3916378a1e0d">
      <Text>No. He is resting at the campsite. I </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> go back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="884265d9-1650-4a06-b14f-ada2bcced8f3">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="95bc8fd2-487c-4c8f-b3ab-9226e8230cc5">
      <Text>It’s too late.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd37b1d5-72a0-4786-88f8-3228ce29d3a2">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="64f75084-ad58-4d51-8e3d-b9d4af80db0d">
      <Text>I’m not leaving Reynold in the mud! It is gonna be Reynold and me versus zombies!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="906dbdda-2b9d-4af6-b129-728e0f0f8e16">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> runs off. </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text> runs after </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 6</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="1" Page="23" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork campsite, Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c655035d-7e40-4562-8c5d-a0ebb294d927">
      <Text>The campsite seemed ransacked. There are vehicle tracks around. </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> is nowhere to be found.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6044fd29-a38d-4caf-8dbc-677f2a35507c">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d0cad56f-a87a-456a-a85b-aa4e687bb3af">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Chào</Text>
      <Text>, Lil Herb! Chaos?! What happened? Reynold!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c4f77b82-47c2-4782-ae2a-0d8b0a73abb5">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> sees </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>’s crop top.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a49d32b4-9e27-4716-b7e4-0e4257c02788">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4f341f18-cb63-4dbb-a229-3de2887a18b7">
      <Text>They cropped ya. Those monsters cropped ya! Reynold!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="32389c65-bc94-4ba7-9bbc-5d82e547f107">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> weeps.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="beed79d6-4cfa-4573-872f-0344f1d89b9e">
      <Text Style="AllCaps">Banks</Text>
      <Text> runs in and comes to </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s aid.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a49d32b4-9e27-4716-b7e4-0e4257c02788">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e55cc156-1df0-45b0-a24d-02242f786fa0">
      <Text>Where’s your friend?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea7859cc-e24e-4541-95f6-b35319c0f341">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="85c40600-e615-4450-8cad-a69220b7b2e3">
      <Text>The zombies got him...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79414286-a1f4-4dfe-af94-a124e99e9d65">
      <Text>Zombies wail in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c4dfdfa-ac80-454e-a26f-90de42fb28ef">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8bbde833-1bb7-4848-963a-1b5e8bbdfaf1">
      <Text>The zombies will get us next if we stay in this plot!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b82ce335-91d8-4aa9-865d-f4ad7ae7b460">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f968a303-fcb8-498f-b346-57d65eb96715">
      <Text>I won’t leave until someone answers for Reynold!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52399132-3e31-453e-8368-c42b9919970c">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69fd1b46-1376-411d-9c81-1a6d07229d8a">
      <Text>What would Reynold ask you to do?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32d12616-334c-46a8-a47e-f2bc32cb1745">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6fab4f42-6ffe-4dc5-a7ae-210bb922b305">
      <Text>To... move the plot forward.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0939d778-fc0b-4fd2-b517-50fe2122c406">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d29c539-6f12-4ad5-bae8-19390551b874">
      <Text>Move the plot forward, Pyrus. You are never alone. We’ll move the plot together.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="968c60f2-13ce-489d-97c5-cbbe9fa09978">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="04ac5bf1-0033-4581-9e29-ffc98e2c9dbf">
      <Text>Reynold...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="537b73e2-f685-4cf0-bbea-cc8a5665770b">
      <Text Style="AllCaps">Banks</Text>
      <Text> gets </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> out of there.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 7</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="1 7/8" Page="24" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork National Park, Day, a decade ago</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ccabc837-a93a-4d0d-9bd7-d45c4c0c2609">
      <Text>Woodwork National Park resembles lakeshore sand dunes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bedebedb-66be-4f38-bccb-355dc3d8874b">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> is a kid, dressed in a scout uniform. They sit alone, holding a dead pet that resembles a Lichen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a62b61a0-2b02-4d75-8ba6-da3261f4f758">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="3a881b2a-960b-480b-868d-f232362ab350">
      <Text>(Weeping)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="915cf7bf-c02d-4abc-a559-6cbc34db60ff">
      <Text>C 6... C 6... C 6...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cadbf297-fdd8-4a04-a87e-e83032758a6b">
      <Text Style="AllCaps">Banks</Text>
      <Text> runs in, as a scout leader.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="88499f29-d3dc-41ff-a8e9-ee49fa58d98c">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bcb9f2a8-d816-471b-b61d-c5e67f2c7698">
      <Text>Pyrus! There you are! Your troop’s been looking all over for you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="52e53451-4855-43fb-8211-3556d21ed7e2">
      <Text Style="AllCaps">Banks</Text>
      <Text> notices the dead Lichen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b738cf26-15f1-49bc-b728-b34b8f3314a1">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="78791bb4-afbc-4888-89cc-2c512a3f6316">
      <Text>Oh...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afcff592-d275-4ca2-90c6-bbc4e048ca52">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9a1b21ab-9694-4d13-8a7e-8908732e51c1">
      <Text>She’s sick...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e82722bc-7518-406f-b66b-6950d269a04a">
      <Text Style="AllCaps">Banks</Text>
      <Text> tries to feel the Lichen’s pulse, coming up empty.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01da0507-a97f-4be6-b0a4-f4380aa72771">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83cc3312-c684-41e1-a0f7-be5c35d11517">
      <Text>This Lichen is not sick anymore.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="640ab201-ba72-47b8-9f90-048b3e9c34a7">
      <Text>PYRUs</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3fdcc9b1-a689-4ea1-92d9-254d2a87e684">
      <Text>C 6! H 12! Oh shit... She and I can’t make sugar together anymore.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="df3a1874-8c18-42de-b86e-ebd556fad6b5">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aff90579-de3d-4ae4-9811-58deb5c8f90d">
      <Text>She may no longer bleed chlorophyll, but she’ll forever feed and fill you with sweet memories.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe906501-b380-483b-9410-c580f03c7894">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad34be8b-c0e5-4a6c-ae0b-302e81aaab03">
      <Text AdornmentStyle="-1">Cyano</Text>
      <Text>... You will be remembered.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0186d0c-e7e6-4109-b7e2-03c551e248e0">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5b0a86ba-0035-4289-a31a-d44eb50171ce">
      <Text AdornmentStyle="-1">Cyano</Text>
      <Text>... A beautiful soul comes with a beautiful name.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f686df17-4a1b-44e1-b0fe-6cd516cdc630">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f584ba19-ccb3-4781-a836-75c98e4ceae8">
      <Text AdornmentStyle="-1">Cyano</Text>
      <Text>... No </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a507a082-f245-46b8-9bcb-6a9dd3ab3a72">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd9718fd-0a67-4375-8871-41e9570ffff1">
      <Text>Come on. You, your troop, and the camp will honor her memory.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc7076a0-3f4c-4c0c-8916-ace7a6602b80">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49d3ec4f-41e7-455d-8961-af3048339ad8">
      <Text>I hate my troop mates! Why else would I need </Text>
      <Text AdornmentStyle="-1">Cyano</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7a7f5e6-619f-4aa1-8080-dd5c39998349">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4db5d762-d0c9-451b-a8d8-acb251b3077c">
      <Text AdornmentStyle="-1">Cyano</Text>
      <Text> was a wild Lichen. But your mates will reconcile. Share the sorrow. You don’t need to hold all this water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73edd40e-fe96-4e0b-a29b-c9a2be375183">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc6aedd0-42c7-4045-ab40-ba04ae3ce674">
      <Text>I don’t wanna be hydrated anymore!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d27bbde-2641-4564-a32b-f22d37cd9056">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93a3b98a-50b5-4f09-be9f-21d125799c3a">
      <Text>Don’t say that!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a5894cfa-36c1-47f7-b3a2-983fdb571e8b">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b1705721-0ed8-4310-9984-e24f5933f68b">
      <Text>You can’t tell me what to do anymore, Banks!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5f7ef1f-24c3-4a18-a3cc-3026d9512f45">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ae970a5a-0fae-4d98-8e62-52505e189598">
      <Text Style="Italic">Scout Leader Carpenter</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="38964e27-6d6f-42e4-8f37-c35f13a5e8a6">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4285e682-a2bc-4ca8-b1a4-a84d17de8541">
      <Text>No longer to me, you ain’t!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="64aa89ff-3fd4-4c6b-9c1c-f610103ebce4">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d9eea37-4965-455f-a680-4a7e59bf22af">
      <Text>But all the merit you’ve earned?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4676ccf8-3212-4640-8cfa-d7f723a2f20e">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6f5b19c8-f3ea-4cca-9e6f-185084708bac">
      <Text>There is no merit to losing a friend.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e609006-2a40-4d42-9592-6a17aaa7852a">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0bdef4e-c276-4ec2-a9fd-de70feff0253">
      <Text>No friends are lost here. When their lives carve out the way they are meant to, they come out of the Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b43f136a-4b63-4b3b-84b4-5e213fa82003">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03289659-2f6d-4aa3-b24b-75c115385767">
      <Text>This is Woodwork. It’s where plants get stepped on. Here, everyone fades into obscurity.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34654335-769f-4d89-9b19-a07fcce280c7">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d687393-0560-4348-ae47-ad567b86ee94">
      <Text>Under my roots, I’ll make sure that you and your friend will not.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ccabc837-a93a-4d0d-9bd7-d45c4c0c2609">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text> bury </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Cyano</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 8</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="9 6/8" Page="26" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS &amp; BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD &amp; PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork National Park, Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ccabc837-a93a-4d0d-9bd7-d45c4c0c2609">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> is in their present day attire.</Text>
      <Text Style="AllCaps"> Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text> hike through the sand.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8e5e1944-cce7-41de-8466-433bcd48b5df">
      <Text>Green light spotlights </Text>
      <Text Style="AllCaps">Cyano</Text>
      <Text>‘s burial site.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="267efcfd-5f8f-40be-ab2c-484b73f36c3f">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="27a57a34-6e1d-477e-bad2-60a9c6dd3d66">
      <Text>(re: </Text>
      <Text Style="AllCaps">Cyano</Text>
      <Text>’s gravesite)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d24fcd02-8bc2-41a4-8f60-f31fa52a5feb">
      <Text>Under my roots, I’ll make sure Pyrus and their friend will never fade into obscurity.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22db1903-1987-4b89-b5e8-0e325acdc024">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aecd535e-5e11-480e-b4ff-3ef934d93eef">
      <Text>Move the plot forward... But is there a plot where we can rest?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb1f1492-7ead-4005-a5e3-b8782c2b0afe">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="189b8f7c-70b6-46da-a895-6643497d1ee1">
      <Text>Rest your sights on this beautiful site.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="069a1af1-9b18-479f-ad2d-a7c7962f6c45">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c5d6cb8-b99b-4580-997b-0d8d8c02c437">
      <Text>Where’s the wildlife?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1d187bf-f487-41c1-8c85-7418a61be875">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d7dfcf5-fa2b-42b0-bd3b-8cce032e7ff7">
      <Text>Most are frolicking the Great Lakes. Do you have pets?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="515308b5-a5e2-45c0-ab14-140b9dc9dae4">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="845474c5-ef38-4b89-94d8-366a3b6f4cd9">
      <Text>When I graduated middle school, my parents got me a mushroom. We named them “Matsu.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="80ca90e3-e0df-4e73-a688-884127c98c84">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06499b73-339a-4855-b4df-3b907b0f2067">
      <Text>What a fun name.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="168f6389-59f2-4d34-b2ac-d7b3c815f4a6">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4c4aa27f-713d-4cb3-97a3-f3c9095b4b9a">
      <Text>The breed is from Japan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32ca1b37-98cd-44d5-95a9-cd4f4bc09944">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="11af5ac8-fa9e-4cc8-8510-866923ba7a55">
      <Text>Independent.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="80f5ef01-4bdd-4a2b-af7d-65a5603dad24">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ea71e4a6-02a5-48c6-8d3a-cba87903c0d4">
      <Text>Very disobedient.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ecc2682a-0963-4bc3-b5cb-50d8dcb81efb">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2351e9ad-7f03-4df4-b94a-1b21267e57ca">
      <Text>Ah. No pet is more perfect for you. Does the word “Matsu” have a deep meaning?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fc76ccbc-1da5-4286-9827-2f3e52e1da07">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f06e36d6-c376-4887-baae-90e89404caeb">
      <Text>As deep of a meaning as you, Pines. What’s the deal with these national parks? I ain’t get it. It’s all sand.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a3a79424-80ed-4091-94f3-1cfe99d7d954">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61c222d9-5f9a-4a3b-817b-d8a98c0e5ce3">
      <Text>Sands are ancestors to the dirt we plant our roots in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d9f9a91c-d8bb-403e-abc6-564a4a01523c">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1ab45a7e-c1bf-4875-916b-66d9f163700d">
      <Text>Ew. I don’t want to preserve anything, especially my ancestors.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63dcfc69-eef9-4a8a-bca0-7b5b3b459519">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5fe268cc-2f96-4dcd-9f14-93a6fbd842e2">
      <Text>I subscribe to Shintoism. Not just everyone, everything has a spirit. When we talk about connecting to the land, I imagine everyone as a person. Rocks, pebbles, sand, eroded histories. When we shift our mind, our aldehyde, will we be able to bear witness of what nature has to teach us about the past and the future.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="06644ec2-81fa-44f6-8fd9-33b59ed4bbbb">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> kicks a rock.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c48297df-4b6d-45d7-9dc6-cc65c6bb326f">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d43aad60-d94f-4ea7-bf1e-cb64432b4000">
      <Text Style="Italic">Being present</Text>
      <Text>... Have you kept in touch with the other scouts since you left?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e34977e-f7c3-4824-b731-91ef16aded19">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7e4de61-17bc-4b39-a886-a7ec1fd33faf">
      <Text>Most go to Tetra High Conservatory or </Text>
      <Text AdornmentStyle="-1">THC</Text>
      <Text>, so yes but I try not to.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e64b0874-6c98-421b-999e-caf9d5132e16">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f23c132-bbd7-4aff-9efc-3fb46f6f14dd">
      <Text>Why’s that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1834d107-a26d-4ab2-ae28-58795e12f9c5">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e9015397-76ed-44ed-8aeb-07d31a0f0eab">
      <Text>They’re still up in appendages about me getting all ornament-y.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c90cf1e-3b78-4559-bf79-70fd4cc055d4">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c51f38fd-dbd0-44ec-b940-bde748a840b2">
      <Text>What got you into ornaments?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cd2b84a8-11ac-4d93-a8eb-f69b201c7ec3">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fc45809d-6962-4f02-84d8-1a3317e31b5c">
      <Text>Right after the seed hatched, my parents took me to the circus.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="53a96eb0-10d5-46e9-8ea8-ea9bb496fba5">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c63b3cd2-a4c3-4b4a-847a-590b263747f6">
      <Text>Oh...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4feb9b81-2418-4213-a227-fa164822ad85">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="682acf7f-0dbf-4778-ab40-04dc491376d4">
      <Text>It was a fun time. I got to feed these elephant’s-ear plants, called Colocasia, snacks from the Peanut vendor. Personally, my favorite act was this group called “The Christmas Trees.” They sang and danced, like the others. But they did so in drag... </Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a2491fb-5994-4ba8-82c5-e5716d0bb63e">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="333be755-d090-41a4-a3c5-02cdaa1c7735">
      <Text>(Nervously)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9c9fdb0-ad64-4cbe-b83b-5e72b08699c4">
      <Text>There’s no need to drag this conversation-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18b5522f-28df-4cd6-9821-e510a5950534">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d7f847fe-97c2-447c-a9ad-5bbf576dec1a">
      <Text>I told my mom, stepdad, preschool that I wanted to join The Christmas Trees when I grow up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93856cdf-1053-4409-b10a-4945856da60f">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="92d617aa-c6e4-48db-9399-26025dcb5e8c">
      <Text>You reminded me of me when I was little.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d68c7d6-3f61-4281-a254-30031431f447">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4a8faf0-d91d-446e-9bc1-41a04bb24eb6">
      <Text>Is that why ya kept the photo...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f6a3660-c09f-40ab-8ce9-c30c7db9ea95">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b239c7f-4f94-4c96-b2af-1ae9c06e7409">
      <Text>Of you in ornaments. Yup.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f336e735-7547-49f6-ba25-52a6af6dcf13">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="676e9fa9-cf48-4dbf-b1fe-c43655d095e3">
      <Text>Where...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="103cc1c8-ad17-477e-84cd-839279389036">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bc487384-d9c8-491a-ae20-f5d0968037c9">
      <Text>It’s safe in my cabin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="049c641a-bfee-47f3-8012-407f860d0d9f">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9d29a6dc-9827-4166-992a-2d9cca558589">
      <Text>Are we heading that way?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4518a3f4-35f9-45e9-a12e-9cb7d0ebeb35">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f93f5de5-2ec6-4e45-bf3f-a39020f3422e">
      <Text>No. I don’t want those monsters to trail behind us and find an obvious safe zone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e62db0e9-d7a2-43b5-a931-38d36cff57e4">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e8b2a31-2f56-43d2-8227-f2424417443d">
      <Text>The safest zone would be the locker rooms at </Text>
      <Text AdornmentStyle="-1">THC</Text>
      <Text>. If ya can survive the air in there, you are immune to any and all diseases.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d12ab7dc-e39a-4a6d-8b78-cd98d942dfb8">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f65a077-69b0-45a1-b137-857ae9f89229">
      <Text>Has the conservatory been kind to you?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d6019c1-6cc0-4832-a892-3f415dd9c108">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f9023df-65c4-4789-9ea0-ca778c5a1aab">
      <Text>Not my kind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ab219f74-302c-4901-bb25-53f29c1eb8f5">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="82d12de8-0f22-415a-9be3-0922972e779b">
      <Text>You’re a Crabapple. Everything is an orchard in this state.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b87ef20-9c40-4551-859a-dd27e2432802">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5c3c5686-c9e0-4e5f-91f7-720830b52d0d">
      <Text>I’m a Fig. It’s queer for the backwards town of Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e95173f-5187-4c70-8843-3d41954ea412">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="193ffef7-b4aa-40fb-a408-47b951de45b9">
      <Text>More Figs will come out of the Woodwork. They are just in the closet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11c1e2c5-7b23-450f-ab9d-cf4439096138">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d28d9cd-806a-4a8d-a8c6-09ef6411d8f2">
      <Text>I’m ready to go back to </Text>
      <Text AdornmentStyle="-1">Salontro</Text>
      <Text> with the only plant who’s ever accepted me: Reynold...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c48297df-4b6d-45d7-9dc6-cc65c6bb326f">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56d95954-c908-4e33-ad72-4ed190759eda">
      <Text>I know everyone in Woodwork, but I don’t know anyone named Reynold...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="271aadb9-472e-4f07-ad68-fe55a481473e">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bfd12b73-045b-4274-b275-0381e48ec521">
      <Text>Reynold is from </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> town: Dirty City. My mom sent me down to the Lower Peninsula to be with uncle/aunty Malus.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="5233131a-81ce-49c5-a23a-7a6dcc549573">
      <Text>(Sarcastically)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bfd12b73-045b-4274-b275-0381e48ec521">
      <Text Style="Italic">Ya know how I’ve always been the good apple in school.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e35b75b-41cc-4ae6-a064-19a1f36999df">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="254c08af-151d-47be-ad9a-64d355ea2ab7">
      <Text Style="Italic">And everyone in your scout was a bad apple but you</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5d5d19c1-a6b5-48ff-94b4-e39bdf8ed7b1">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fef31bb5-53cb-465c-bf76-534e6570cc5c">
      <Text>There was one good thing I did for that Lil Herb. Reynold’s mom owns a salon and I got him </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> the house. He tried on crop tops for the first time!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff0d70bc-2746-4f6d-8562-6ca9b2814913">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b12613b8-8a29-4b72-a041-fdea64f27426">
      <Text>Who would object to a crop top?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b9fd51e-75cf-47d9-a4c5-872a44bc835e">
      <Text>PyrUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="449eb788-2026-43ad-9d63-65a5e94a1850">
      <Text>His mom. Reynold was the sweetest kid. As sweet a Cilantro can be. His mom didn’t take it well when Reynold came out. And plus, he called his mom a “</Text>
      <Text Color="#00000000FEFE" Style="Italic">con </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">đĩ</Text>
      <Text>” </Text>
      <Text Style="Italic">(Vietnamese: “Bitch”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc0196f3-3142-464c-a066-dfa9ccb14ea4">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8db2df6-34ba-42a3-ac73-13d168771dae">
      <Text>What does that mean?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e359f946-98f5-4323-8f66-c3c3b40ccaf5">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ee95646-6fcf-4b54-a33b-641d5daf26a9">
      <Text>I still don’t know. Reynold is a real son of a bitch for saying that to her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54dc9c17-5af7-4c6a-a9b3-5113c4ef2488">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c60eca0a-c8c6-4b65-82ad-29817bab4172">
      <Text>Did his mom accept him for who he is?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f51e9a5f-328a-4da9-8952-541e0f525e9a">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49785781-f5af-45df-bd57-6893ff75d156">
      <Text>She has. It took us getting into a lotta trouble to do that. We shut down my aunty/uncle Malus’s </Text>
      <Text AdornmentStyle="-1">FigLeaf</Text>
      <Text> nightclub. Underage drinking. Long story.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="519dd42c-c947-4658-a173-114ab9dcf914">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9c11448-4c6f-47e7-be67-b6410c511e39">
      <Text>I know there’s something strange in the water of Woodwork, but that doesn’t mean resorting to barley piss. Go on.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="074f5ae4-cb6d-4703-8dcc-c40ad296b2a4">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49785781-f5af-45df-bd57-6893ff75d156">
      <Text>Malus and Rau, Reynold’s mom, got into a spiritual conversation. Then, she earned her green card.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="000c39e8-ce52-418e-978c-4016bfecf82b">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e7485c26-695a-45bc-9bcd-9371a522cc68">
      <Text>Green card?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aed3c778-a975-49bd-af95-d57fd09129be">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> shows green markings on their hand and wrist area.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4db3bf77-8dc2-48e7-92f2-7e85f0ce199d">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1bd22088-d316-4cf4-9c0f-1600fd6d1be4">
      <Text>Not everyone is born on our soil. When an invasive species- I mean- </Text>
      <Text Style="Italic">Immigrant</Text>
      <Text> comes and stays on our soil, it takes a while for them to earn their green card. Anyways, she had a change of hearty nucleus and accepted Reynold for who he was. She hires me each summer to run the salon with him and I start a storm here and there. But, they love me. This whole poop-storm... I don’t know how to share this news with his mom...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3817793d-9aa3-46f9-9796-c4f9f216890d">
      <Text>Headlights from the food truck illuminate out of nowhere.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5fdb136-0700-4ff7-b176-b3cf18fea668">
      <Text>Pyrus &amp; Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35d9b7d4-1715-4b4f-8c23-8226c7476454">
      <Text>Woah!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1407986c-a597-4219-9f11-f99c4d529f72">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f2ae1bc2-81ee-4a99-80ce-6286acef383b">
      <Text>Is that a child in the driver’s seat?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36f0b7ac-028f-4965-be0b-747b508e0f13">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="308b8e5e-f8ae-4cd5-9942-e42c250ad8d2">
      <Text>Reynold?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="756b1bbe-c3f4-4716-815c-d91a934cdc88">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="81914350-3227-4e59-a81a-20fcd73853b5">
      <Text>That’s Reynold... I’m telling your mom, you seedling!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f61dbc78-48b9-4dc4-b3ec-2c7e22ba0d14">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="007e3e51-fa1a-4a41-9c45-38affd93170f">
      <Text>Relax. There is a guardian in the passenger side.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22dee622-4772-4dd9-b3a9-9aa0c795031f">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="509b0c53-1552-47a2-a061-1f146e9b8c23">
      <Text>I’ll make sure you pass, you Pineapple!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1dc71088-8ce8-415a-a84d-3480fc32b4d0">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="58ba3dc4-72cf-42fb-9083-a6aebcc28118">
      <Text>Pyrus!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea30f371-991d-44f6-909c-da8ed61ced07">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03a0a0d0-08ea-426d-ade2-5d93779daa21">
      <Text>Wait!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a296e2b-806a-4cc8-b6b2-9b9ddbb371a9">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="66b3f583-0cf4-4f96-8069-cf1b71a40386">
      <Text>You’re learning, young pear. How do we know Reynold is not infected?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d98ed65-e2f7-411a-bf3f-64fd26c4649b">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5977223-a002-4bc9-b2e3-7eb95d810acf">
      <Text>Breathe in...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4e2851e6-db19-4a0e-bb30-bd0534dfc3ed">
      <Text Style="AllCaps">Reynold</Text>
      <Text> gets out of the truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="486d9a66-619a-442e-a006-7c2dc2740a90">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="955e069e-7a84-443a-897d-105c331e2662">
      <Text>Breathe out...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef4b54fe-00be-4eca-b89d-f492c772eedf">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ceb40502-5c06-4c9b-9213-0d4b18c52bde">
      <Text>6 carbon... </Text>
    </Paragraph>
    <Paragraph Type="Character" id="be2a09a8-0f85-452d-a1c4-197d93c25208">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ceb40502-5c06-4c9b-9213-0d4b18c52bde">
      <Text>12 hydrogen...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c0054316-070e-4b9e-9799-cf88d9a88a6e">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ceb40502-5c06-4c9b-9213-0d4b18c52bde">
      <Text>6 oxygen...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e60678f-344f-4551-80d2-295687d4111d">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f5affe0-79f9-45ef-ac85-fe0cfcb7ea6b">
      <Text>Plus 6 oxygen molecules...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8fd60277-801d-4503-9b6b-3639dc9ac3c4">
      <Text>Reynold &amp; Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9694aef2-8c64-4249-ae94-ec1e903bdab7">
      <Text>Photosynthesis. Photosynthesis. Photosynthesis! I will always root for you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="05e565e1-4355-4f84-b1cf-466588b15c27">
      <Text Style="AllCaps">Pyrus </Text>
      <Text>and</Text>
      <Text Style="AllCaps"> Reynold</Text>
      <Text> embrace. </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> pulls out </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>’s crop top.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4f56300-e6ce-4861-b134-676106d6188c">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3b1dda6-95e2-4c35-ae6d-c257ea70a686">
      <Text>Reynold. Try not to lose another crop top...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86598c47-1fa4-4607-bbc0-3fb005f01e12">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7cd05a38-849e-44f0-bbe8-885ffb4d72fb">
      <Text>You’re the top of the crop!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5496cd7-2b70-4647-922a-aa2f9bb24ff8">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3b1dda6-95e2-4c35-ae6d-c257ea70a686">
      <Text>To top it all off: you’re alive! And the rashes on ya stem, they’re gone!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06ccf836-2722-4917-bef7-9d8216ecce58">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5fe81cd-d23f-4ddf-9018-65005c531a61">
      <Text>Mom came through with the ointments. It cured my ailments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da39017b-a019-4c03-8aa2-601fce386d86">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bb27550e-1c49-4e02-b48f-bd0a32c1e713">
      <Text>And a deal is a deal. We find Pyrus and you batch up those ointments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="204efef0-77fb-4bdd-a77e-64d359379892">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e1243c55-a867-4ee0-97e9-d8241ff0488c">
      <Text>Batch it up yourself. You’ve caused these ailments!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="558e9374-98bd-4cea-a50c-440ab8426750">
      <Text>Pyrus &amp; Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bdd06622-6296-4c67-821f-e8b99eec4d79">
      <Text>Pineapples and pizza don’t go together.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4dd52685-2489-4632-9372-aca94b8641c9">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03c7879d-5efa-4775-a3ab-44130ab4d164">
      <Text>This Pineapple has brought me piece in mind for the first time in a long time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b3e9cf5b-8aaf-478e-a21e-29554abe2388">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4597ab5f-837b-4125-8a31-d516354c7b2f">
      <Text>Ya stems are fine, but you’re </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> ya </Text>
      <Text AdornmentStyle="-1">aldehyd</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff05b971-7964-468b-be81-3ca9079e4018">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c029f42-6e7b-4c77-9d75-d6e341e99139">
      <Text>I won’t hide anymore. Alliance will be what comes out of the Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d6f5856-ec10-4941-a394-6d1dca162dd8">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e8fc448e-5b18-4cc0-baea-196f1816817d">
      <Text>You’re still naive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a21ba27f-e555-4628-95ef-939d1be1da5c">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ef0772d-83ad-496a-a3d7-28c1e71cddcf">
      <Text>Naive made us the friends we are today.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eced737b-6d9a-4a35-83cc-ea7d530ff4bb">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69c7e463-779b-45cc-a8ae-5e8f8688c8a7">
      <Text>Fine. I’ll mediate. Nothing will get done if we keep pointing appendages at one another. Reynold, do you know how to batch those antidotes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a6e66df-5af3-4b7a-8f21-296a652eb0bf">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8234adfe-f6dc-41e2-8d77-e5e8d49a3e46">
      <Text>My mom does...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f2373014-3bdd-4124-8311-62408e812108">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2f2a3fe-13d6-4d7e-96a5-1c258e991139">
      <Text>Oh crap-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93675c55-c7b0-4738-a30d-c249242d3680">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c33d985f-c448-4f14-9ffa-f0aa0244e14e">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a773f1d4-7e0a-4e61-bce6-9de08287089a">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="afde1cb3-614e-4f5e-bcb5-e7b8b0e8cc34">
      <Text>His mom is something. Remember?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="acde58b9-11b2-4257-a0ea-d549178b0235">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aaaff01c-c5d4-4bc4-8193-453edfe0cb26">
      <Text>What did you tell this park ranger?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d16b975c-5862-4ff6-b806-85129e5e92bf">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0130895c-cf85-4692-a122-664c2887c415">
      <Text>Banks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49936be4-2ae4-4f85-a2f4-6b6f145279cb">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0afae063-d99f-4dd3-9827-ce22f1db9e5a">
      <Text>Ya let him call ya Banks?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5bca2805-9f22-4ba8-ad77-861b4d08ebee">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b45817d-0d69-4b2b-92de-ff3e3b377152">
      <Text>Reynold, call your mom, so I go back to baking more pizzas.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f3dede7-36cb-462d-bbba-7f1131da99b5">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16d875d3-ff05-4523-b6ea-2016a386c151">
      <Text>Don’t you dare!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96536f20-a0c3-46b4-bbdf-403bb83edb55">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cbd9f82e-4646-4419-90bb-bae146c7c129">
      <Text>I kid. I’m retiring to make... </Text>
      <Text Color="#00000000FEFE" Style="Italic">bánh</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Pastries-related food”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d08ab23d-0675-4ad9-80e1-c9d9a28c03d2">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="202f3759-1165-492a-b453-119537abb055">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9c37280-f4ae-4f73-b18a-44d51c5b2960">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec83368f-4d31-4e50-ac18-57cc46f4352d">
      <Text>Is that how you say it, Reynold?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3981e122-9c56-4af0-bdcb-f967b992ccdf">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f39cfd8-35ea-4e7d-8317-6c33e0223965">
      <Text>You’re not helping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9da153f1-6883-4e8f-869f-6f572426c76c">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ea979afe-b8d0-482d-8a6c-113359ad3c48">
      <Text>Pineapples are not allowed to make anything anymore, at least in Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f768ed98-5616-48f7-9693-8609c9b4d13f">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="73f96692-b3f4-4795-a807-5a39eb32df41">
      <Text>Stop bashing Pineapples. Batch, batch, batch, Reynold!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fb176ccd-905b-41e8-bb7e-78154eea283e">
      <Text Style="AllCaps">Reynold</Text>
      <Text> pulls out his apple-shaped phone and dials.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8aa85f8f-8c2b-49ff-b86d-3c421615fe75">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="76d1d6d6-428c-467a-9ba3-74a3f61b4d50">
      <Text>(On the phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4b9bcca-4b96-4ec5-aa41-9b5b679878de">
      <Text AdornmentStyle="-1" Color="#3A3A0000FEFE" Style="Italic">Ch</Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">ào</Text>
      <Text Color="#00000000FEFE" Style="Italic"> me. Chi </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">có</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">khoe</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">không</Text>
      <Text Color="#00000000FEFE" Style="Italic">? </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Tôi</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">có</Text>
      <Text Color="#00000000FEFE" Style="Italic"> the hoi ban </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">vài</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">đieu</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">đuoc</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">không</Text>
      <Text Color="#00000000FEFE" Style="Italic">?</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Hello mom. How are you? Can I ask you for something?”) </Text>
      <Text>Oh... My Vietnamese is poor.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3da552c3-04be-4b04-9432-d9f652be740c">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4b9bcca-4b96-4ec5-aa41-9b5b679878de">
      <Text>And you said my Vietnamese was sour... That’s rich coming from you-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d4a24a45-c59b-480d-8b6e-d28a1df06b3c">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="488eaf82-7a88-43ab-8493-61364805ef0c">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Im</Text>
      <Text Color="#00000000FEFE" Style="Italic"> lang</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Shut up”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="56023ea1-292b-41dc-bfe4-310b2bd824f2">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0861087e-2e85-4349-905f-d12a8334b066">
      <Text>No, mom. I haven’t taught Pyrus any of the curse words.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b85b47a8-5af8-4bbf-b11a-3a2e9295d037">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c1018787-83f3-420c-a7c7-4d60993f956a">
      <Text>(Whispering and being punk)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="957aa8f3-cda6-4c87-b3d4-2f7593cb2f2c">
      <Text Color="#00000000FEFE" Style="Italic">Con </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">đĩ</Text>
      <Text Color="#00000000FEFE"> </Text>
      <Text Style="Italic">(Vietnamese: “Bitch”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="98829420-143c-4769-b8a2-e9ff9905dc96">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56f0a217-fc83-406f-b1c3-1b68241f9efe">
      <Text>Nothing! Anyways, what I wanted to ask was do you know what’s in the anti-fungal ointments? Uh huh. Hmm. Yeah. Nothing. Just your son being health conscious. What? Has Woodwork been hell?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="37d8e120-3701-42be-ba80-99513b17f487">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> tries to speak into </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>’s phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a5fbb456-f4bc-40f0-ab0d-b39bfe2750df">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="89f78a23-a404-4e62-b9d9-14210c7316fc">
      <Text AdornmentStyle="-1">Whatcha</Text>
      <Text> say about Woodwork?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49552251-a46b-4113-bf1c-6b9532d19dc7">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56f0a217-fc83-406f-b1c3-1b68241f9efe">
      <Text>Nah. It’s a blessing to be here. Pyrus and I are getting along just dandy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7b3c7a6-37e5-4b3c-aa0b-d0ba7b8c22a4">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="936d82e0-84a5-46ac-86dc-58d64f6b58be">
      <Text>Let her know you tried my pizza.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de8a7f42-95d9-413f-aca7-91b403efb111">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="53833ac7-8e50-4053-97ce-fb44ae91f0bf">
      <Text>That’s no one. It’s just me and Pyrus.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3aa6b7a2-fefc-45ec-82d8-1fb7756a0d29">
      <Text>PYrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b6d23ae-805c-40d5-b6a5-dc3b392fb2e7">
      <Text>Ya pizza crawled out from the bowels of hell-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0558f70d-effc-40dd-a93d-8235aa092f91">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="88d49efe-fd43-4ae0-9dc4-608d7b02238c">
      <Text>The food here is peace in my bowels!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="498a1679-2b3f-4db9-ae23-c1ada3c5fa31">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6bdd790e-1482-49a5-b6e9-c93740c9727c">
      <Text>I should continuing mediating...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="26a6ea3a-4207-459d-b837-015dcce8177c">
      <Text Style="AllCaps">Banks</Text>
      <Text> separates </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f95cdaa-e840-4c38-9510-67ff7a52b37b">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="67eea4f7-f8d2-4692-b505-17a89d670346">
      <Text>Pyrus is just speaking with a nice park ranger. No, they’re not picking a fight with them. </Text>
      <Text Color="#00000000FEFE" Style="Italic">Cam on, me</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Thank you, mom”)</Text>
      <Text>. I’ll be sure to bring home a souvenir. </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Nói</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">chuyen</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">sau</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nhé</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text Style="Italic">(Vietnamese: “Talk to you soon”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63f0cbf9-5c8c-4020-93a1-8c4f91b51973">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6decb9a-3a3e-451c-8b82-3c3c16c3dac1">
      <Text>And...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed506104-73d0-4582-a5ec-320d7d079383">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3519f6a2-288b-4baa-b244-ed736dbd9244">
      <Text>Mom knows some Lemongrasses that’ll supply us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1efdfd52-4aef-4032-9ea2-ba9b85084470">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="45eb201c-d68c-4fd6-a2be-26344c4f57d8">
      <Text>So, you and her do not know the recipe?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="79341e9e-eb2d-4cfd-bf92-003923bd74ec">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4d46491d-8941-4b70-992b-cd7918cfb831">
      <Text>So, it sounds like ya mom’s gonna ship it?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1a779bf-2738-4b2f-8d14-012701f0abff">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd098f5a-d3e1-4787-8a6a-e30f57242a14">
      <Text>Yes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5512b069-4874-4f76-b4fe-d00edff15371">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0468ac7-23d1-4a75-83e2-45f43d74fd16">
      <Text>Well, my parents are not answering my calls right now... Because of the whole apocalypse thing happening.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="189b54a1-9159-4806-8bf4-82dc37e7888d">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f36e878-8998-41ed-8a7a-6aaddd92a119">
      <Text>I have a cabin that the postal service goes directly to since I am a public servant. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="3c597c8a-b44e-4c71-aa2d-c29719778a4c">
      <Text Style="AllCaps">Reynold</Text>
      <Text> hands the phone to </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e9f72bcb-3a01-4342-83db-c288c13725c9">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e3099ac-811f-43cc-ba02-dfeeddd454ac">
      <Text>Can you text my mom your address?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="55d3464e-7678-47f4-a48c-bcc4047489f0">
      <Text Style="AllCaps">Banks</Text>
      <Text> texts then hands the phone back to </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>. The phone rings and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> answers.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ec271e9c-ae98-4c6b-80c9-da7c90e9137b">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="79d82d87-913c-4cc5-8efb-e0a34ad5f945">
      <Text Color="#00000000FEFE" Style="Italic">Me</Text>
      <Text>? Don’t freak out. That address is um...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5ab1fe22-1ead-445c-a30c-3bfcd4b0b6a5">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> speaks into the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="267894ee-cbcf-452b-b0e0-896a757fea1f">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5e8774e-2a7b-460f-af8f-eb5effa207f2">
      <Text>The cabin I booked for me and Reynold. Tents are so last century.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="12db8ed8-5ed7-44b3-9082-1969744ea4db">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1c13193d-dffc-4b40-92ea-400993425426">
      <Text>That’s the spirit, mom. Why be primitive when you can be effective!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d732d8a1-69b7-4170-a325-f7d7e7ab201d">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> mocks </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0bda2664-d679-4339-b124-c072016c4a4c">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="531e9cdd-25cb-45b2-a82e-5d3d9054180b">
      <Text>F off! That was not for you, mom. Ugh, okay, I’m grounded when I get home. Bye, mom!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ca48b0b2-65bc-4bfc-88fe-06c1af2da87d">
      <Text Style="AllCaps">Reynold</Text>
      <Text> hangs up his phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1263acdf-2620-4f52-81ad-20ab9ebcc5a8">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a3bcfea6-a5b5-44c6-b01f-629f3cffcfc4">
      <Text>Expect her to get a box of this antifungal stuff in the evening. Delivery is tomorrow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d68a2dda-7dc6-4510-82c9-6e47016f8ab2">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d51649cb-f986-4ab2-b6ff-4a7c835b78de">
      <Text>We can help pick up the package tomorrow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="794c19b5-4fd6-4560-bef7-945a61fb8bc0">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2a79086-5e06-4a3a-85b0-45d158110e6a">
      <Text>Woah. There’s absolutely no need! My home is a mess.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6df1d425-6daf-432c-a8be-bc588d2b48d6">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f3664455-ff8c-416a-96e6-0486f6a416d5">
      <Text>So, what now?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0138d02d-4637-4cb9-afcd-f4a47cb3e9ef">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7341c3e1-927e-4c68-957a-62fe1bb02383">
      <Text>We wait by-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4242884e-240b-4f94-a9cc-e8bab63519d5">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6cf59a46-583a-4788-871e-20725e534622">
      <Text>Oh no-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1fc2179-f2b6-4b6c-ae95-48874831f6d2">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="02c85cd4-0596-4c70-b4b5-4c5d5d873a71">
      <Text>Setting up camp.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="201b7d25-6cf2-42a2-a36b-65f054dbeffd">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d3cb5f8c-cf7a-42db-8ea1-9e304f65cda3">
      <Text>I can cook us up some grub.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="14899ff0-55c1-4e21-9486-dae4088625f0">
      <Text>Pyrus &amp; Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="662074ba-eef0-460c-852b-fcc1de746dbb">
      <Text>Oh no!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="29594b74-989d-4aca-8eb5-dd95202a555e">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13fd1cac-209d-4543-92d4-4163483dc678">
      <Text>I’ll help Joey. Pyrus, you help pitch the tent.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a409b7e8-64f4-4817-8667-d893f7c587de">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b27d4c0-8d7b-416e-90f7-ffc592812ec5">
      <Text>Pyrus, you remember what’s at stake, right?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c3d3b444-f27e-49e1-af7e-04cf64e6b40a">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1d52a621-0069-4dd9-aef9-296493435389">
      <Text>Ugh...</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 9</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="6 2/8" Page="36" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork National Park, Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5b487ef4-76b6-4af8-82de-dd65a254ee2d">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text> pitched the tent. </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text> made smores. They all sit under the moonlight, surrounding a pit of fireflies. </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> play a racing game on their apple-shaped phones.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8dc73d6-79ba-46de-8940-978d9a99260d">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d96bf797-dde4-4e75-a2de-5d85da476e4e">
      <Text>Rumor has it that the Moon is made out of cheese.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f97ddc17-d733-49d3-86cf-05061810e289">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e47bf2f-0ddc-4468-9abc-62b6ebe453f6">
      <Text>Reynold? I know ya don’t believe that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eea8f6bb-c9ab-4829-abe4-b9e6129c693e">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33d2530c-a426-4720-9469-e274f08ad3b1">
      <Text>And you won’t believe I just raced past you! Vroom!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="693fadc9-5d92-48f5-8e21-ecae3a8186bf">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="359a4eb6-c9d1-4c93-9e62-3452192cad4e">
      <Text>Distracting me is Matsu’s thing! 11th place?! Ugh. I’m picking the map this time. “The lunar surface...” Here we go!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f15b26d1-a4ea-4953-96c1-7b2c193d2cc0">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a159c68c-fc30-464f-a231-3d82d32662d9">
      <Text>The plants on the Moon... The stars out there... The Martians would appreciate a Pineapple making pizza.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6739a7ac-379b-4f6e-b071-b9f9ffa6184d">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="102158bd-7efe-4f41-abc0-43a1b072a798">
      <Text>They’d appreciate not hearing your desperation.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c33ced82-fc8d-4b4e-aafe-c307fa41fcd3">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b58a213e-22dc-4d85-8a7d-994042cce32e">
      <Text>Funny cause there’s no sound in space... You’d make a killer space ranger.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c96d6ca-b2c3-48a0-8872-4e480e2b71e0">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4513d6ee-222a-4784-a6f2-78927cd82d44">
      <Text>I’m satisfied with Earth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="858c88f2-f39d-4083-96d5-4e20fffa0fe5">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b326ea06-deca-40b3-a10d-80583b867ec5">
      <Text>You can’t let a mind so out of this world go to waste. I’m sure you’ve heard a bajillion campfire stories. What’s your favorite one?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="430de4ad-6eca-404f-8be6-c6139dfe1cb0">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b326ea06-deca-40b3-a10d-80583b867ec5">
      <Text>Do you know why fireflies’ bellies light up?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="307f9aa1-661f-41ab-b805-8c87422f8123">
      <Text Style="AllCaps">Banks</Text>
      <Text> uses the campfire and their theatrical physique to represent the origin story of the fireflies.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93c6fbb9-c244-462c-a334-8a6bcd7497f5">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1205f0de-eb5b-40cd-bd11-ebc7ee889d54">
      <Text>They say that the fireflies are the broken spirits of an enlightening creature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ca7bbc1-2fe8-4d8b-a472-86640fce817b">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0a2fe27e-d3e4-4f3e-bee9-0e39858264be">
      <Text>Who’s “</Text>
      <Text Style="Italic">they</Text>
      <Text>?”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e12a319-705b-404e-9e52-ed7a19afee6d">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f575075f-9371-493b-8314-38e2a9ef0cb9">
      <Text>A White Pine I’ve encountered on my journey told me this fable.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32e40120-7621-40af-9dcc-e0a2038f22c3">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4e1ec36-fd2b-4ce7-bdb2-fc2b36e370bf">
      <Text>White Pine making up myths.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67071731-0280-43e6-ab16-8dffde0a0228">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba1c03d4-fb9f-4ac5-b0ef-0da3841296ee">
      <Text>I wholeheartedly believe in spirits. This is no myth to me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="47017f1b-622a-4f58-95c1-42e2a04e01c7">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b500e67e-9016-40aa-a254-173d99550b80">
      <Text>Who is this “</Text>
      <Text Style="Italic">enlightening creature</Text>
      <Text>?”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d3eefdc5-47fc-4467-9fbf-2423afd35da4">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a3fb34e6-4749-4470-b160-3334a09fbc43">
      <Text>The brightest of them all. The creature that built the Sun, but they grew weary in the feat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="875811a5-9301-4412-a2e7-9770f05f7175">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4e921f1d-5e3c-4e1c-be01-78a21cbe297c">
      <Text>Of course. The Sun’s sturdy so that birds don’t break it when they fly into it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="35db5985-8e86-4873-a044-b49ae300219c">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c722d036-622a-4cc9-bd1d-cc71f1a5c1ec">
      <Text>The Sun came to life. They are alive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9f53f17b-96e0-49dd-9478-3bcd4144d8e5">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eb81b408-b29f-49b7-82c4-78320e304ba9">
      <Text>Oh... really?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62774a3b-cb97-4191-a189-5a3bd67004f4">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a851bf9e-8939-4af3-b6ba-39aec36a64ca">
      <Text>This creature could not sleep. They could rest. They regretted making light that could not be turned off.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="468d7b3d-839e-461d-a72c-f1627e41e368">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0999c0ab-4eb0-4880-bec9-c700c72eef63">
      <Text>I’d grow restless, too.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c5d1e9d-369a-49f2-8768-f0e030376751">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="506818cb-a78d-451d-ba4c-b8d2350e9d19">
      <Text>The creature made a deal to the Sun. If the Sun rested for half the time, the source of light for the world would be this creature’s broken spirit known as “</Text>
      <Text Style="Italic">the</Text>
      <Text> </Text>
      <Text Style="Italic">fireflies</Text>
      <Text>.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="21492fdc-616a-4711-b6b0-bf5fe015b2ea">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="131246fd-d01f-4504-a266-ca5b0a2d4fc9">
      <Text>So, why are these fireflies preys to everyone?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5ac16ca-642a-4cac-a3cf-c04047088014">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d360d85b-e6fc-42a3-a166-e1b2fd202c80">
      <Text>They’re not eaten. They’re just sent onto the path to the after-world.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b8ff316c-c362-4c33-a3e2-4dc136328689">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="94664ca7-429f-4165-9cf6-6a42b0d8b46d">
      <Text>Where they would assemble themselves?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3c1f176-2d66-4a17-8783-120b8b9d847e">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b676666-fe2f-402a-87a8-53b18368e60c">
      <Text>Maybe. Light does not replace others, but build upon one another.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e0b6ba6-01a6-43a7-ac40-36492bbf883d">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9c32dec7-77a3-49dd-a142-822321c541c0">
      <Text>That’s the most sense you’ve made thus far.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ccfc134c-5dfa-4669-a0d7-4e812cd5e301">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0c2cf27-6bda-43c6-91b4-623e757b792b">
      <Text>You have no sense of curiosity for the meaning of </Text>
      <Text Style="Italic">all this</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e9603da1-4d39-456b-8200-ec2043eb7be2">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0328b844-5ede-459f-8dce-a7bd0f1267f6">
      <Text>I am pretty sure there is a scientific reasoning behind their light-up bodies.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee8c6a43-6f19-41dd-862c-4e645a80e450">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ae4e9c97-b0e0-4b7e-b670-ce0d9572c4f1">
      <Text Style="Italic">You with the college education</Text>
      <Text>...</Text>
      <Text Style="Italic"> Clearly</Text>
      <Text>, it looks like you know the science.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cd6ffad0-3479-4693-ba79-c9b5b3955d70">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4bf6c68d-41b0-4b12-864d-76f38bcd111b">
      <Text>Photophores?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32d4113c-484c-4dc9-b344-768e1a1acd79">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d8a7d47-2ad1-4bd5-8d09-79498e9fb4e2">
      <Text>Actually, the photophores are organs reserved for marine animals like squids. Fireflies emit luciferin chemicals in their bodies.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e85ffb03-ba7d-4746-a808-ff65976057a3">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5df1b75-5051-416f-ab1d-048834d60220">
      <Text>Tetra High Conservatory never taught me that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="79c6211c-e3a9-44fb-baef-b7d15dc8e463">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b03b341-3cc7-41d7-a5e4-5b12509ca802">
      <Text>I don’t Tetra High offers AP classes. I’m getting ready for my Advanced Placement exams in a couple years!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c3ec2dc-9bb0-4b7e-bec3-6ff98ac214bf">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42fc9588-1cd0-4b2b-abcc-2f4894727839">
      <Text>Reynold’s brighter than every firefly combined.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f63900d5-77a9-44eb-9682-6ae865e18059">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="560aeec2-cdda-47e6-a20c-b3d31628319c">
      <Text>Reynold gets it from his </Text>
      <Text AdornmentStyle="-1">poindexter</Text>
      <Text> mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c5cad576-5721-49d9-9e18-05ec78cba4f8">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee7a2c4d-bd67-40eb-b896-c8a42b1dd13b">
      <Text AdornmentStyle="-1">Unpause</Text>
      <Text> the game right this instant!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="de2a410e-927d-47b5-9d58-876aeaa1cbea">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> resume playing on their phones.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4161c2e8-baec-4fc8-a2a5-a0ef3d32df83">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="735350a1-a6f8-4ba6-8048-3f7ce995bae1">
      <Text>How are your parents?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d3da41d7-1859-466b-8cc9-f2d26d48540b">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="205a19f1-12ab-437d-b12f-e83814f20365">
      <Text>I don’t know. They’re more focused on their other baby.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1245488-d742-42d3-812b-a536965a57be">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="02d034ae-c5f5-48af-be72-b2b2ddacafe7">
      <Text>How many siblings?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b3b4fee-ab10-4554-b07b-68934a966b85">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a7bd29e6-75d9-47e1-8239-de6413317a28">
      <Text>I’m an only child.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7b9c673-114d-4133-8361-8f069776d8f1">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="011f7679-925e-4245-bbf0-579d6056340a">
      <Text>Their other baby...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7d1268c4-b448-483a-854c-ac3d30d6bed4">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="536a8e9e-f5f0-455a-afc0-ac5ccefea46a">
      <Text>Y n’ Pizza.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="057048f5-0d5d-45f9-9395-b30f03cae76e">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f98dd129-4a83-4385-af67-83ad1bd99389">
      <Text>The pizza chain.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5de12634-528c-42eb-8239-ee2bfac31c16">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b34623cf-15a1-4a68-83ac-c9b1c4e451cd">
      <Text>My entire childhood was chained to the family business. You feel me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0ad40f7-d2b0-4dc8-b059-e83629a0a5f8">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08c0dd18-fe57-4bfd-ae04-b60a45e2978c">
      <Text>I feel you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93a87074-da7f-4044-934f-1e8e676533a9">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="484778f6-2241-4a10-a0bb-7238c105c158">
      <Text>It was never about my feelings for them. It was about how the </Text>
      <Text Style="Italic">market</Text>
      <Text> felt.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68b93eda-4a80-42a4-809c-c8e809d626ab">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="200de584-7ac3-4a55-a29f-f2802db70655">
      <Text>And the market fell anyways.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5dfb9ccd-f582-4821-bec0-89e90f66a980">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7a0ad2a8-464e-4396-966e-4f1e0adea5a0">
      <Text>You’re right. The market crashed. My parents generously gave their employees permanent vacation hours.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="109b3491-ab6f-4a78-8020-76c77b8cdc7c">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27db137b-6069-40ed-a9ab-8a6b9ddd70ea">
      <Text>Your parents laid them off... Go on.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d0fb19d-4399-47ab-a5b5-fe7e039cd9af">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b24883fb-1a9d-413f-96ae-9be97b64827d">
      <Text>I took a leap year from Redwoods and traveled the lower hemisphere. It’s a rite of passage to visit where my ancestors came from. There, pizzas are made with love.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1f8cbd2-706e-4869-bda4-65dacfac98fe">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="713b85b1-a114-45b8-87a3-e7db921bf4e3">
      <Text>There are Pineapples out there making pizza? Yuck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a050d49-b95b-4921-a7fc-54386140d99c">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="071fcbc5-4922-48dd-be85-940fa5266440">
      <Text>I’m releasing the Venus Fire Traps cause you won’t shut up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d84127c-e734-48b2-bc11-f6a474df2212">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5b499dfe-7317-43a8-aaf3-67fd35c5520c">
      <Text>The pizza here are made with so much batter and fried as deep as the Sun.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ba2d40f4-00f1-43b2-b90c-c86cd42de3cf">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f84fc9c-f1af-447e-a9a2-18a60ff41854">
      <Text>You’re just salty.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad4e33dc-7716-4e5e-99ab-264fb7e411e7">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49abe5af-45d4-4877-8637-970a1e762fb2">
      <Text>Salty! The pizzas here are so salty! Good point.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af1488c1-d7c5-4af9-aad9-6ce91aecd317">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f1d613a7-4c59-499c-9ad4-e74ffa31b782">
      <Text>And you needed to make a statement with your interpretation of pizza?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="157b533d-0bb5-4df5-b62e-ecee6fd96294">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="042c2db2-cf19-4f82-b895-703b1ba49b0d">
      <Text>I thought the fungi would do that for me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="58d7acc4-581f-4591-a3e7-d5165fefdaf1">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="efba0ddb-4d59-4e17-bbaf-8c6d5effe8bb">
      <Text>And look at where we are...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ab5f3088-a9e0-4cf4-8ef4-92be6ed0ef2d">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="41df0e55-d0a4-4616-82ef-83e287efc6d7">
      <Text>I studied in Florence, thinking I came out disciplined. But alas, </Text>
      <Text Style="Italic">ho molto da </Text>
      <Text AdornmentStyle="-1" Style="Italic">imparare</Text>
      <Text> </Text>
      <Text Style="Italic">(Italian: “I have much to learn”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4b301528-8a95-40dc-bbed-a794b4fc64e3">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed224c67-099a-45d2-a094-e5f654b3adc4">
      <Text>You have much to learn.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a543f795-699c-4667-845d-429376e5c298">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b24883fb-1a9d-413f-96ae-9be97b64827d">
      <Text>I don’t regret taking a leave and purchasing this food truck with my college fund-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1ab94702-db7e-48e5-8415-8da14e3a0e6c">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3558b7b7-4833-4022-8321-e61940f8492a">
      <Text>Parent’s money...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="521ce1e2-8112-4bc9-a114-57d9ae35d691">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7dab7fad-0269-46da-ad09-829ee1e489e3">
      <Text>You can’t be surviving on a park ranger’s salary.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="443f173e-6783-42a4-8a38-725336049525">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f50ec78a-7b3f-46a2-8013-c8a5b13a2241">
      <Text>I got enough bullshit to manage around these parts.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4b1ffa0-8731-43db-9a39-5b97f1329db3">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eb0eea69-9d5f-46ec-b5fd-e2fdf1a7866e">
      <Text>How are your parents?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="253159c6-2e63-4719-9618-939ae1342f2b">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e6eb59d-c347-4a92-bda1-31231835db93">
      <Text>My family are a humbled bunch.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a16b6e68-3da0-4072-8489-2505a6143fc9">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d146bf5-3e0c-4800-abff-79dbc690b51a">
      <Text>Is that all?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8ac6e53-6ddc-42ed-8b08-d4ca85cae358">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7a23edc6-93e1-4b29-a347-b75db708673d">
      <Text>We’re boring...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4561efbe-b9b6-4035-af1b-aa018f2098ad">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b83a6d85-22f3-43e8-9d27-a467f68e2ddb">
      <Text>And I bore my hearty nucleus out talking about my family. There’s more to your story-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dc0599f8-2081-4e17-afc0-e58fb46c12e5">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="82029aa5-586a-427c-a68d-66340e94e320">
      <Text>(Distracting </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d4d9778-cd09-4e5e-a058-9c75a571462d">
      <Text>Smores? Are you in it with the Ryes and Cocoas?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad45401a-c4f5-4100-9538-aebe3ad73d6c">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ade2729a-1660-4a28-bbb2-7f9a2487057f">
      <Text>Fun fact: Most companies in the Heartland and the Amazons are subsidiaries to my family’s multinational fast food corporation. The Ryes and Cocoas are underneath us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e79052e-dce6-43cb-91a6-f90dccca2bfd">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf60d454-86a9-4c86-869b-eef29d233dcd">
      <Text>Everyone is beneath you, Pineapples.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed30dd39-62ba-4186-a6c0-2fb21eebae13">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b2bc7937-b549-46b9-9497-49616888bf32">
      <Text>That would be the Coconuts. I am as grounded as you, mini Pine Tree.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d15e3a7c-b8f8-4433-ace4-e9f377f6eecc">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8909ed3e-2e9a-4b22-98cb-25156cf701d1">
      <Text>That’s unfair!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="684f4b1a-9a79-4a43-94f5-4a267e4acaf9">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3fca0b33-1b8d-4baf-a520-f795790fa5f0">
      <Text>It’s what ya get for picking a Pine Cone for ya vehicle. It got too much air resistance or something.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f6a0cfa-95d1-44cc-85e9-c814b7657897">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5362405-c540-45dc-a6a2-14a882be7203">
      <Text>At least, I can drive a real truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="12ec5045-fba1-4610-a60f-57b9a1748e69">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5493de3-49b9-44a7-a960-4f3cb14ad11e">
      <Text>Not legally...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2694806-698e-40ad-9179-b2049271f146">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="beb2005d-f011-4155-a9e5-892a72c87e88">
      <Text>Are you two playing Super Potato Kart?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="64ab3075-0190-4dc0-9fd6-8e19bc1c8b5a">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e99cd476-2d5f-4055-bf1f-0277fa82cc9d">
      <Text>We just unlocked the Piranha Plant character-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b0b89a8-155f-483b-846a-3e73a09b88a1">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="50efe7a2-a923-4927-b1c9-91cb4735509d">
      <Text>Say no more. This Pineapple likes their spiny shells!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="73d4b32f-1b3d-49f0-8027-825cf7c3a710">
      <Text Style="AllCaps">Joey</Text>
      <Text> pulls out their aphid-shaped phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fdd39002-7e1e-400f-b1bf-45f954f1c321">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="543f8560-20d0-460b-8671-f6eda52d50ce">
      <Text>Look at this peasant!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="359d8e03-6717-46a9-bffb-e776cf48de80">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="940487f2-3055-4c6c-a981-e113e4b4aadb">
      <Text>Aphid phones have a more fruitful operating system than those apple phones.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe162417-33a5-4e12-9564-03effe36916a">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e39f2e0-4af9-438c-a5ee-aaad4ff3fd5c">
      <Text>Prove it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="beefac51-7960-4d45-a8ec-20ea31ae8c75">
      <Text Style="AllCaps">Joey</Text>
      <Text> joins </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> in the racing game on their phones.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c188b954-aaaa-4d51-8b84-1fc1fc57fbda">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="43ac3f62-3333-4faa-90ed-e665c32e15e0">
      <Text>This Pineapple is lapping us!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b390bb46-f450-4d39-a30d-737677b05d59">
      <Text>Time passes to where </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text> are passed out.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7dc5a1b2-13c8-4c60-9ca7-561bd234ef52">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> takes </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>’s phone. They forward </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>’s address to </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b1b7a6e0-0d9a-40fc-a71f-f017daf7db07">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8e3be417-684c-4dad-8ed2-0c8dba0afd9a">
      <Text>Text message... Banks’s address. These are coordinates? Ugh...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cf1dc493-0d29-4c60-926b-0241ad1d0b65">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> rummages through </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>’s belongings before they find a map. They sneak off.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 10</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="4 7/8" Page="42" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Banks’s Cabin</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a64ff67c-006a-44d9-a4af-70d3c14a905c">
      <Text>The cabin may have file cabinets or desks. There is a Christmas stocking hanging around.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="105047bd-40f6-4720-8952-0a25be085a39">
      <Text>Using the hatchet, </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> bursts in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d15ed1e4-fd38-4b64-b79d-6ab3f9f8cf90">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8e2c7833-aa5f-4864-a6d3-8017ae44843a">
      <Text>(re: hatchet)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15b3d8dc-bcc9-4918-9d55-2e0d736ab4c4">
      <Text>Ya may be a replica, but ya sure did a hatchet job. Whatever, I’ll tell Carpenter that this was Reynold...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="105047bd-40f6-4720-8952-0a25be085a39">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> searches about.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a5751e9c-8900-441f-a2eb-22f1eae31386">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8808f044-5404-4da4-9f65-9547552f5c04">
      <Text>Now, if I was an embarrassing photo where would I hide?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="882bab59-774b-4ef5-af81-a0f9c82da2b6">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> notices the Christmas stocking. They check what is inside. They pull out photos. These photos are of </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text> and their family, each decorated in and showered with ornaments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9c99ae2-4489-432c-b97e-c9bc16659ec6">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="41f250a7-4c3c-4bfd-be51-0670596cb507">
      <Text>Oh my Veggie Tales... Banks was a part of The Christmas Trees?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e223a965-17d9-49a5-914f-4ce1c3e048ef">
      <Text>The door swings open. Behind is </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1ff19912-b772-4fc0-852b-67b926ea3265">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c1a08cc2-9439-46f7-96a4-aa23117886d6">
      <Text>Holy night! Park Ranger Carpenter, how’d-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="413e2b9b-657d-4e6e-aa79-1a267782ff60">
      <Text Style="AllCaps">Banks</Text>
      <Text> nabs </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>’s hatchet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de21836d-9a2d-48b8-b043-5bac3715561f">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a9de7dbf-7303-435d-8075-7ef18e2ce939">
      <Text>Banks. It seems everything will eventually come out of the Woodwork...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e31d7cc7-4a71-47f0-8302-3ff8314044af">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff13e977-50f3-4a3f-9273-e67175eefeb1">
      <Text>How ya know I’d be here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d8666e6-c031-4759-b752-259530dc76ae">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5a319d70-8d0a-4118-9028-463fc7534f1d">
      <Text>There’s been critters sneaking into my cabin. I installed an alarm on my radio. But, you’re easily my top ten critters.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="527a48f5-171e-42df-ada4-98af7f90460b">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="2b21ade0-3708-409b-a83c-e4367ba8ce72">
      <Text>(re: The Christmas Trees photo)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b44aa3e-b233-4fb6-9313-1be4d78e5606">
      <Text>I didn’t know this about ya.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3daabcc6-04e7-4bbd-a94e-accbe8f585e3">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9b8216a-8c92-4518-a3c9-258df7971e0e">
      <Text>What’s there to know?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="03ab46cc-4661-4bf8-bc14-9eed834117c7">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ae3193c-2fa4-4d10-acf6-fa3c27fa9fd7">
      <Text>This is why I remind ya of yourself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c4a2216-14f0-406c-b95e-2841b5b70e56">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2bc6c92-726d-4366-98f2-cc1dd575fd1e">
      <Text>Ornaments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="10e6dc66-7627-4984-87ec-08256802a942">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8fb42f0-3ee5-4bfb-bb10-86f7a8708c80">
      <Text>No... Yes. I have a family who tries to support my ornaments.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ee17a50-648b-4ba0-9a91-336b6f7014a7">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="12c82c2b-13ed-43d1-b267-b33f1a36261b">
      <Text>Let’s orient away from this place. You need to get some shut-eye...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ca55e7e9-4913-45aa-9c9b-01f2a77d5fa4">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0ce59a9f-12db-418b-b3e2-355cd07c42d6">
      <Text>Ya had ya sights on something. Both ya eyes. The world lost sight of ya talent. I’m grateful to have experienced it with my family. I need to know! What was it like to be one of The Christmas Trees?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e223a965-17d9-49a5-914f-4ce1c3e048ef">
      <Text Style="AllCaps">Banks</Text>
      <Text>’s backstory unfolds through physical or shadow puppetry or other creative means.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b2cba98f-e322-417a-97a7-1bdb9f8afba3"/>
    <Paragraph Type="Character" id="f140e89d-078f-4a90-b573-34d470a30aa3">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0b1f105f-f6f0-47a2-83c3-0ca9d91cfc86">
      <Text>To countless seedlings everywhere, my family was the first drag they’ve ever experienced. Which circus did you attend?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c636ebae-ba7c-4432-8ce5-e9f33b74ca87">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="59cc0cc9-66f3-496d-a2ba-7e05625cddfa">
      <Text>The Juglans.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7aa6d88-82b2-4754-a558-ca8a9428a2c0">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2c9b7f3-7de4-4db0-863c-3dda537bbd7f">
      <Text>Everyone in that circus was walnuts. I loved, loved, loved prancing around with ornaments.  My family toured around the globe. I felt my place in this world. No matter how queer and drag you are, you will find a community that wouldn’t drag you down and instead lift you up on an aerial rig... until my family got a contract to tour the Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e4475ec-3df6-4276-8478-4beb5de77a97">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a98b5edb-3db3-4718-a51e-1b0ff932d5a2">
      <Text>What happened here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf9a4530-f01e-4d99-992e-1772a12d3f80">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5b3edd8-04d1-4fcb-8035-b2d460494a49">
      <Text>Not this Woodwork. The nation of Woodwork across the pond.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e097967-7814-4530-bca7-200b3079e4b9">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="abf1cb08-5496-44ed-a937-021b95597dce">
      <Text>Yeah... This state likes to name cities after other countries. But... Nothing can be as backwards as our Woodwork.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61f09e48-e379-47e6-8105-228a20a27b9d">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71820a37-5721-4e13-a4ec-0e745e7dcb14">
      <Text>The Woodwork across the pond was historical. We were the first of our kind to stand with pride in the capital’s town square. The locals were kind, fine like any other garden. Public sentiments were becoming more and more progressive. But, the devout royals and their militants... They addressed me and my family with homophobic obscenities. A little child. They banned us queers from coming out to the Woodwork. Being ornamented there had my image dragged through the mud.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f7596b9-3888-44ff-85e8-4dde0cf627cc">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="65704f65-4339-4e50-9eb5-12cd57bb3907">
      <Text>Drag looked perfect on ya. More importantly, ya looked truly happy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9466296f-6667-4580-b62b-3c8eb506577b">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f9b9640-8c00-48cb-a541-ae846a6687f9">
      <Text>I’ve since have had a hard time looking.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33989be0-ff10-4d33-a74f-2d965d068ef2">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fede7bfe-6e7c-48a0-bb8e-e0d92290de0e">
      <Text>Ya did not lose half ya sight due to a freak accident, did ya? It wasn’t because ya were mauled by caterpillars, was it?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="154c74f4-e031-4a1e-9648-8204cd801b7b">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1bbc4bcc-4ac7-4789-97d5-818caa14a458">
      <Text>Woodwork pulled the rope light from under me, this little Pine Tree. After dragging me through the mud, the royal mob gouged out my most prized ornament.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e223a965-17d9-49a5-914f-4ce1c3e048ef">
      <Text Style="AllCaps">Banks</Text>
      <Text> points to their eye patch.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1fe89af4-3f97-4b1c-906e-dea86df3db8a">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6fa6d2de-36b2-409a-93fd-7815ceed41d5">
      <Text>Our Woodwork in the Upper Peninsula is where </Text>
      <Text Style="Italic">I</Text>
      <Text> come into this great unknown with its untouched natural beauty. I need no ornaments than this uniform that can weather out any storm.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb4a9eda-5596-4a74-85e5-fd7856916ed4">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="399392a3-49db-4564-8b35-b6618a280aea">
      <Text>Crawl out of the Woodwork. Everyone needs to know ya and The Christmas Tress still have the spirit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fedad836-156f-46bc-827a-868b449c0fca">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c298b458-9fc1-4ce5-85b1-11753a4bfa77">
      <Text>I’m happy to be a park ranger who is unabashedly straightforward.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a9b9907-fdea-438a-8a12-ae288c0816c1">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="399392a3-49db-4564-8b35-b6618a280aea">
      <Text>But, ya ain’t a straight shooter who is unabashedly queer.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ba5c18bc-dabc-42fc-9ba3-c4a15733d6f6">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d204612c-9239-4731-8d4c-578702dde099">
      <Text>You’re calling me un-unabashedly...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2eacb4ec-494e-4520-a11e-4678e279af7a">
      <Text Style="AllCaps">Banks</Text>
      <Text> searches through their desk or cabinets until they find a photo of </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> in ornaments. They get ready to leave.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="815e0d26-9079-4fd8-b37a-571954014721">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee6ef5f3-24ed-4d9d-9ed5-7b58807ea831">
      <Text>See ya in the morning, Banks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de8b9e65-ff2d-4ea2-9fbf-e2853baa4858">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7c305a09-5990-484a-b371-25c0d19c6d70">
      <Text>Will you?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="22b5b794-aeea-41ac-a83b-cf93e0806fba">
      <Text Style="AllCaps">Banks</Text>
      <Text> is about to leave.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="41360b56-c580-4bcc-b347-4bd87d63633d">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32212032-bdc5-4095-8dbb-132737945cb7">
      <Text>Matsu... My pet mushroom. I named them after your kind. Matsu means “pine.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="54c69125-537f-4242-8cba-8cd0c65299e3">
      <Text Style="AllCaps">Banks</Text>
      <Text> puts a bloody bandage over their eye patch. They revisit their spiritual journey to Japan, over a decade ago.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b7e4dc02-fdbf-443b-b42e-d16cb6bd10b9">
      <Text>A silhouette of a Japanese Black Pine, </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Thunbergii</Text>
      <Text>, towers </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4c858d4f-92fd-45e8-8d76-960d933fe3ce">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aaa97c20-de84-4dde-9067-c635badc1dd4">
      <Text>Are you who they call “</Text>
      <Text AdornmentStyle="-1">Thunbergii</Text>
      <Text>, the Black Pine of Japan?” I’ve traveled far to regain my sights. No doctor in the world could fix my cherished ornament. But the world... They told me to seek your wisdom and guidance. I want to go back to touring in my family for The Christmas Trees freak show... I am not meant to be without every ornament.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="59a2945e-ab74-49c3-9447-ebbbf9ce871d">
      <Text AdornmentStyle="-1" Style="AllCaps">Thunbergii</Text>
      <Text> drops a leaf with markings to read.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60f2cd35-4b1d-4c51-b792-aadb76a5b5a3">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b2dded79-5d17-4f82-88a5-bfb46cdf746b">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61d509c1-088c-4f4d-bbeb-bf53730f868a">
      <Text>“There are no ornaments for you...”</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8a83c7f9-102b-42f5-88ed-14659f601855">
      <Text>(to </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Thunbergii</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="19b7c7db-4352-4675-9395-a52774e03d14">
      <Text>Here...? Then where?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cce249fd-c2fd-4bc1-96c2-fd897704c3d8">
      <Text AdornmentStyle="-1" Style="AllCaps">Thunbergii</Text>
      <Text> drops another leaf.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fcae9a51-22b4-47f4-a250-10b924ec4c1d">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d3e13f97-edd6-4273-86cb-8ad8a5a38a7d">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54b7268a-54f4-48a9-b620-26d49aa3efa6">
      <Text>“One truly knows if they’re meant for ornaments when one can live naked in content.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="4317c373-d43d-4b30-b8eb-fbf231700d71">
      <Text>(Angered)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9fceb6e4-3fcd-497c-8145-1484786af262">
      <Text>You’re saying I should lose my sight altogether?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9f535f48-3b27-4e07-8596-2aa22a22e1d8">
      <Text AdornmentStyle="-1" Style="AllCaps">Thunbergii</Text>
      <Text> drops another leaf.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a26ba1e-bef8-4fd4-8529-34e973f8682c">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="a6547bb7-ae0d-4205-8611-e87e2e0dbc9a">
      <Text>(Reading)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="12eb4a17-3988-4426-9a38-09c440a0116b">
      <Text>“Never settled. You’ve been sightseeing your whole life. A site where you can lay your roots is all a tree ever needs. Loggers may come to cut you down, but lovers will carve you up. Wood works in mysterious ways...” Woodwork...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4ec27270-7cb0-4a8f-95db-540b47d6567c">
      <Text Style="AllCaps">Banks</Text>
      <Text> returns to the present. They take off their bloody bandage.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a1b5ed3-2ac4-4361-9ace-c9b4f74bbe75">
      <Text>BANKS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2cc26eb-c4d1-4619-930a-fa9bdbd37b97">
      <Text>I settled here. I lead the scouts, so that you kids will know that if there’s nobody in sight who accepts your ornaments... Nobody to see who you’re meant to be, there are always spirits on site that will stick their pines out for you. Get some shut-eye, Pyrus.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4a68f561-eb42-4fe1-96c1-5bfbb65752dc">
      <Text Style="AllCaps">Banks</Text>
      <Text> departs.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="adefb4d4-cb2b-4119-b5eb-b1d2b81f5d26">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> looks in the same desk or cabinet and pulls out ornaments.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e223a965-17d9-49a5-914f-4ce1c3e048ef">
      <Text>The door swings open. Behind is </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> and daylight.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db14374a-ce13-429f-9def-660ddd35dfc0">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf227d08-550d-4449-be95-5f1aa705099c">
      <Text>Again, holy night!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1535ec1a-6603-4595-b212-7f397b074703">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="deb7ecd1-b12d-4d8f-bdcb-e2e2a8bdca71">
      <Text>It’s day! I was looking for you. What are you looking at?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ebf744ea-f816-4568-96ef-837f635085e5">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="883b85b7-0e11-4fe9-85f7-b1618209a569">
      <Text>Ornaments...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f7979029-4d1d-491d-ace8-a96d0e1c24ae">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b66cadd8-a47a-45a8-bb77-6b146e7f2e95">
      <Text>Merry Christmas in July... Well, you </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> leave before the others wake up.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eed8640f-4efc-4156-9a6f-7eae719a96a3">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> stows away the photos and ornaments in their clothes.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 11</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2f895fe4-214d-48b2-9619-2aefca098c59">
      <SceneProperties Length="7 5/8" Page="47" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork National Park, Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c655035d-7e40-4562-8c5d-a0ebb294d927">
      <Text>The campsite is in the distance. The food truck is parked near the edge of the cliff.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eed8640f-4efc-4156-9a6f-7eae719a96a3">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> enter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf8e3efc-f71d-4052-a8f5-ad492eac35be">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="047257fb-209d-464e-9cc0-263170a16a7c">
      <Text>So hard to find camp.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="adaf6da1-194c-43d8-8f10-3bdf30d70133">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1cbb5926-6d2a-4652-85cc-e3171093f529">
      <Text>We’ve been walking around in circles.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb1d75a1-2ebb-4663-b3e4-1331fe3cc202">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0ea201a-2acb-4f9d-929f-1e41d3fbc742">
      <Text>Maybe they’ll find us if we make a crop circle.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eed8640f-4efc-4156-9a6f-7eae719a96a3">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> playfully dance in a circle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff23afa7-0c59-4bd2-adbe-0fbdd5ebfa94">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fbaf2c8c-5eac-420b-9e16-d7858d8b601b">
      <Text>There’s the food truck! The camp must be near.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="38b65eb1-5f49-43be-be7a-517d14244333">
      <Text>A monstrous shadow looms overhead. A horde of zombies is audible.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2fe878c-2743-4556-8572-fbea963581be">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb8bf894-8de2-444c-8dd2-1c44985a1a0f">
      <Text>Did we just... Summon these monsters?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="506f8528-95ef-4e5d-9852-f33062250771">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="904af2b9-506d-4a69-8494-0a41a6028799">
      <Text>They don’t hear us, yet. Hide.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e10cb83-7a62-40ca-afe1-d445869524bd">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> hide in the food truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1cc5d04e-9fd0-436e-b146-92f247635927">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6791110d-f4d4-40fd-9863-535e3b2e3385">
      <Text>If we just shut up, we’ll make it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="10fffe02-42dd-441d-b0ed-bb602e10b5e5">
      <Text Style="AllCaps">Reynold</Text>
      <Text>‘s phone rings.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f06b2b4c-787f-4456-aea3-848d3d48f1cc">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b808078-3a3f-4e55-a6e9-17440736d65b">
      <Text>Does every cliche zombie trope have to happen now?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="25938be3-87dc-451f-9327-232b2f0460cd">
      <Text Style="AllCaps">Reynold</Text>
      <Text> picks up the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5d0ef296-52dd-4fba-b2b6-1465c3a561b7">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="afa7a0cd-b140-4c14-b5c8-fed729bace57">
      <Text>I </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> pick this up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27e5335c-8467-46fe-8d45-23156800311c">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0ee7ee5-2820-4bda-a8f3-0b0fcf54b6a5">
      <Text>Seriously?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c914867-2e92-41db-b808-b4d7068a336d">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27638c63-ab40-41c1-bfcd-4f7f72f88a16">
      <Text>It’s mom. Otherwise, it’ll be the last of me and you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a90e978-7902-42e4-9811-09f63fabfb55">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7604ec8c-8541-4178-9de3-72185e39b497">
      <Text>The last of us... I knew it’d be ya mom who’d get us killed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d1b375f-4f14-4a87-bc8b-0987dd757ac5">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="488eaf82-7a88-43ab-8493-61364805ef0c">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Im</Text>
      <Text Color="#00000000FEFE" Style="Italic"> lang</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Shut up”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="99a04c94-dc03-4f6d-b526-d3eeb4ff1a98">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7867d4ed-8b2c-4ba0-b6ee-1056053a7bea">
      <Text>Ya shut up!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8a0f60fc-8049-463c-8c34-9f71de6b70d3">
      <Text>The monstrous shadow looms over the food truck. This causes the food truck to regularly wiggle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e414cff-f127-45da-80f0-51fe9ae2ca09">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="28c27ade-0329-467a-af4f-cdeef0ca27c2">
      <Text>(On the phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5db64f6-11a1-442f-ab7a-770f5a667b8c">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Chào</Text>
      <Text>, </Text>
      <Text Color="#3A3A0000FEFE" Style="Italic">me</Text>
      <Text>. We’re on our way to picking up the package. Pyrus is...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f6be3dcf-ad9e-4f7f-9d1f-88b17d7ac9c0">
      <Text>The food truck abruptly shakes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0821d984-f15f-4d55-864a-bd5258350d36">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3194431-fee7-4005-8dd5-857aa3d7a801">
      <Text>We’re getting hammered!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30be375f-06bf-44f7-8f01-943bcd89fae8">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01c034fd-0981-4965-866b-11b3abd6da00">
      <Text>No, no, no. We’re not drinking. Okay. We’ll drink responsibly if we do. And as a bonus: we won’t drink and drive. Of course, I’m too young to drive. There are no vehicles in the park.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="90102f65-3fca-4a42-9b5b-89dc21e4d3e5">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> tries to honk the zombies away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5d002d8a-0ea2-4382-9071-fc1148a1ac18">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="bfaa0cf5-7b41-4536-aa3f-0da8e1862064">
      <Text>(in a New York accent)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b250451-2d39-4200-a056-f5b8252d986c">
      <Text>Hey, I’m </Text>
      <Text AdornmentStyle="-1">livin</Text>
      <Text>’ here!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c8da3b3b-c389-4839-8b46-c06c0924f852">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dc3a2254-fde1-47a3-9adc-aeb10f420296">
      <Text>Pyrus is just playing Potato Kart. I beat them in the Grand Prix at 150 circuits last night. Aww... I’m proud of you too, mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7acbca9-ba36-453d-a714-503b5bb14e3b">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d0d00d8c-e562-4b96-9840-e41de67f4839">
      <Text>Eat my poop, Lil Herb!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b9702f3c-c6fe-449b-9313-587cfdcce12f">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6f3c7475-e0f1-4082-b33e-b2da8b682ce5">
      <Text>Mom says to watch your language.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7e50fdc7-0f5f-4bb0-ab09-0ef5bce0cd14">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> notices the key in the ignition.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="701dbac6-9d03-4576-94bc-cdf4b3e66c16">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd743e91-05d7-49f6-8ddc-9f78f1a159b9">
      <Text>The keys are still in the ignition!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94a3a5a5-723a-4e0f-8519-fba818e1a7f5">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f67b186a-2845-435c-9b22-d82cd2495db4">
      <Text>Pyrus just gets really into it...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed007003-c162-4714-a569-a2f49292ddd1">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d6231de8-8ec4-4323-91c7-111e7aec1948">
      <Text>We’re gonna get eaten alive!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22bc2966-20ec-4622-ad59-05d218849a26">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="67eea4f7-f8d2-4692-b505-17a89d670346">
      <Text>We’re getting eaten alive by aphids. We ran out of bug spray. Ship them? Yes, that would be so... </Text>
      <Text Style="Italic">fly</Text>
      <Text>. </Text>
      <Text Color="#00000000FEFE" Style="Italic">Cam on, me</Text>
      <Text>. We’ll make sure to get some rest, so we don’t end up looking like zombies. </Text>
      <Text Color="#3A3A0000FEFE" Style="Italic">Tam </Text>
      <Text AdornmentStyle="-1" Color="#3A3A0000FEFE" Style="Italic">biet</Text>
      <Text Color="#3A3A0000FEFE" Style="Italic">, me</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Goodbye, mom”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="62157809-0099-43c3-8f01-5f541540cec7">
      <Text Style="AllCaps">Reynold</Text>
      <Text> meticulously adjusts every mirror and object.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2d1a576-afe4-4f72-8bf9-84f5548d0dc7">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="346834d9-e2ba-41be-b960-1e6a7fcea52d">
      <Text>What are ya doing?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b4b4b9f-c70e-4773-9283-def04d0795d3">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac92617d-029e-42cc-9af9-d7f14ba78e53">
      <Text>We’ve been playing too much.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="07d006f2-e48e-48d1-89b4-0c0e43b5d9c2">
      <Text Style="AllCaps">Reynold</Text>
      <Text> turns the ignition. The food truck is not starting.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bed3570-ed64-4de3-9f10-dac84e8845e6">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb9f5cc6-3809-428c-8cd1-a6ddc4c99b16">
      <Text>No </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef7547b6-00ff-463d-ae42-7d66beb74421">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ccd6819-491c-4967-800a-3a43c44362c9">
      <Text>Ya piece of crap.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="856766f9-22ab-42ca-9b05-e1eb37a4bedb">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f886e52-145b-4462-90f5-842184ce1a8a">
      <Text>What is this thing running on? Corn oil?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="62157809-0099-43c3-8f01-5f541540cec7">
      <Text>The food truck drastically rocks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="964db289-650b-45ec-88b8-733988b1a39a">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="925e643b-d1d7-4aed-bdd8-78736f960599">
      <Text>Why Joey, why would ya think it’s a good idea to park by a cliff?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ad1ed47-6647-4825-a9c6-423db7d5e2c7">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6fe19ebd-277b-41b3-bbf2-47a4e46a2546">
      <Text>There won’t be a cliffhanger in our plot.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a21fec3-7aff-4628-a475-56852a32a9e0">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13ad6327-3882-4349-b5f7-34684bd85590">
      <Text>Breath in, breath out-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="62157809-0099-43c3-8f01-5f541540cec7">
      <Text Style="AllCaps">Reynold</Text>
      <Text> hyperventilates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7793bb9b-f085-4106-9532-1180a247757e">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4088b874-071e-48a6-84a3-c644e88261d8">
      <Text>C- uh 2? Helium. Osmium?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="524fe1cd-a2b5-478d-afc1-916121ed3f89">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="724e949e-a8d1-4f31-aa1d-3092ab4b2330">
      <Text>Your chemical formula is too reactive and brittle. It’s giving me hives!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b1e4b62f-3f71-49e7-83a5-4ec75be200dc">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="480e94a5-6b58-4a92-a49d-db9dbe5f5d87">
      <Text>Let’s combine hivemind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0100c2f-e41f-4dc4-b329-a8b2e46366c0">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d68eee69-6bb2-441f-acd7-d3e35511632a">
      <Text>You need one to work.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8af1f30-de35-4c7c-827a-29f38765db5f">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="875226e5-8f46-44ec-b1c2-47c54dbb3205">
      <Text>Puberty has done wonders on ya, ya poop head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00c95efa-9d1c-45bb-9e6f-067437ad0a4f">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a1fd179-3287-47d8-81cf-d4bc87c5d674">
      <Text>I know how you feel the first time we met. I will never amount to anything.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d6e15d5-0f58-4a37-8112-7f0064d73848">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="031b61a2-fa24-404f-b26b-07d9e7520b63">
      <Text>Not cool. “Amount to Anything” is my song! A Cilantro once told me that I will amount to everything despite believing the opposite!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7dd7d376-775c-4bfd-8711-da5f72921d9b">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> unplugs and reconfigures the wires in the food truck. They turn the ignition and start the truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd1427da-f1c4-476c-95ec-ccab2bd6e878">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="11d044cd-6c55-443c-bcd8-71cb4a658e11">
      <Text>You’re playing?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72035272-f98e-4da7-b34d-350aef439387">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c9c24719-f975-4280-8d37-489392d9091f">
      <Text>I cheated in every badge, except the Automotive Maintenance Merit Badge. My parents are mechanics...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="97c58341-97d2-4aee-bb2c-251f9a3d654c">
      <Text Style="AllCaps">Reynold</Text>
      <Text> pulls the vehicle in reverse and hits the gas pedal.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b5a8928-f778-4f2f-a837-f3c22222a3ac">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f3a2264e-4252-4499-9665-15c2714de2f3">
      <Text>This is for you, Matsu... You, </Text>
      <Text AdornmentStyle="-1">Cyano</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="25433227-80f1-40c5-bc6a-c19b7395f3cc">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c48b6223-2fcc-4e73-b8ef-00fe29289255">
      <Text>Driving without a license for you, Matsu! Cyan- Who?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="90102f65-3fca-4a42-9b5b-89dc21e4d3e5">
      <Text>Fruit or vegetable juice abruptly hits the back windshield.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="def2bbb9-ac1d-4ba7-a4a7-70780da1072b">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c460ac3e-bcae-475f-b8b6-3097f246a347">
      <Text>Ya just ran over my gym teacher!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aef7a69a-256e-4e22-972d-ea243be34d0a">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="688524e6-1b77-476a-bd39-4d146c99869e">
      <Text>Should we administer physical aid?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="678eb3d2-ed00-4a76-baf8-3fb371a3a386">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="09348df8-bb92-4263-b3ee-18de387cf029">
      <Text>Nah. That’s what they get for disqualifying me in our dodgeball tournament.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3322c3db-3be0-4c75-9d25-b8549ea14dd2">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="075176b4-a3df-494d-ad87-004584108220">
      <Text>You’re tormented by a </Text>
      <Text AdornmentStyle="-1">DQ</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96f0a691-f904-4efa-8fe9-0bd8d5fa01e1">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75c95ff6-9de1-4f33-bfce-50ba0e2f6755">
      <Text>It ain’t fair that I lost to a Daisy!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="de40d296-ddfd-4eab-aa32-5d2a6b7b8210">
      <Text>(Muttering)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75c95ff6-9de1-4f33-bfce-50ba0e2f6755">
      <Text Style="Italic">Teacher’s pet</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="5e630730-5507-4350-8862-2b5838179527">
      <Text>(Noticing and pointing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ea8671a-5490-44fc-a104-19f6d4a5bcb5">
      <Text>That’s the Daisy! </Text>
      <Text Style="Italic">I’m down to administer aid if the intrusive thoughts overcome ya</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b06c6221-32e9-440c-a493-0b98730f2133">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4f9bb98a-c48d-43fe-a615-322bf9ef521a">
      <Text>Besides the accident with your gym teacher, I strive for a perfect track record.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="899429ff-fc69-4418-bfc9-dbbf5222a99e">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8d56957-8e46-4b90-8dc9-4bfe1ed2ae17">
      <Text>Lil goody two-appendages.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e5dafe1-f6ed-4ba6-9e72-1e46c20848ee">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8eafc64f-e23f-4b06-bc0d-6068554089ee">
      <Text>Should we pick up the other two? Joey and Banks!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2550f66b-55a2-4773-87f9-e59e016b0611">
      <Text Style="AllCaps">Joey</Text>
      <Text> reveals themself from the back of the food truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7d9ac7e1-d8e9-4e05-88d7-b5aedd20b7f0">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8817b56c-cac0-4e4f-ad4d-9424f9ff5c06">
      <Text Style="Italic">One</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3facece2-fe60-4156-bdf5-a68811db587c">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> scream.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a06b7d6-1476-42f5-8009-89012e04e209">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f408c2a-eea2-4e2a-b826-331b8e1d0f20">
      <Text>You were going hammer and tongs a moment ago and now you’re reverting back to fear!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c90e222-e1b5-411c-beff-0f37cf88954d">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37b73761-3026-4bf9-b2e1-d99b99842e4c">
      <Text Style="Italic">It’s more sickle and shear</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27e1f7af-9bb5-4970-a62e-84c560108b8f">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e472e555-fffd-40f3-9b99-ddabff912801">
      <Text>What are ya doing sleeping in here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb2f0df8-4ecc-49a8-a6ca-f635314438dc">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="011e0726-cf80-4263-b9cb-4ce8092563dc">
      <Text>Sleeping out in the wild, that’s for the other Pineapples. I’m a greenhouse Pineapple.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="40699f34-0fa9-4df5-a1da-750d376abd23">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="53393300-0d83-4029-8064-f57b20db8f04">
      <Text>Ya just slept through the whole ordeal?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f0a71ff5-6dc2-4e05-9811-f62e7c3cd97b">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b6a89e48-56e0-4fe3-92a4-05d1d7aa5d65">
      <Text>Your body makes the worst deals as you get older. Appreciate the body you two have now.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0daf2772-30ee-43f2-bc96-36f39c2491e0">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="840d2e05-6e69-4ee2-9167-db32bdd52fe1">
      <Text>I got an axe to grind with you... Oh, the hatchet! Banks confiscated the one I had!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bcb803f6-6f3a-405d-8397-7434c9d0dc0f">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee1d32c4-f43b-4257-bc90-e04eae09b373">
      <Text>Banks! We need everybody on deck. We </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> locate Banks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6816282a-1392-4bf5-97ee-404b4257913e">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d52270e-7533-4bc9-b9c4-430130645dec">
      <Text>About Banks...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a7a9ac5d-cadf-4ab5-8206-9130925c7c10">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c00cf769-c475-4642-9594-d5c1871d7fe8">
      <Text>What about them?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bc739de-660f-43fc-9dd1-ee8dcb94fce0">
      <Text>PYRUs</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a380ee40-6a53-46bc-a78e-ddb282a112cc">
      <Text>They bailed on us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f81fb4fa-0648-4fd7-bcaa-4ec6a81cf863">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4ae7b0d3-01e4-48c2-98e1-debbc176de43">
      <Text>Last I checked Banks was not hay.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="80f41da4-05ec-4643-97ab-f6a4753a9b9e">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83cbef57-5be5-4daf-92ed-98b479eb5da4">
      <Text>That’s the last bale of straw, ya evil Pineapple!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f52ede5d-1578-4841-8ef3-d945b21c9e43">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bb627a3c-9a12-47c6-9684-224289d5da78">
      <Text>Hey </Text>
      <Text AdornmentStyle="-1">hey</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">hey</Text>
      <Text>! Get along you two or I’m turning this food truck around.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d610dc42-812b-48f8-bcb0-94519a11bea4">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e305d820-6011-4b4c-9eb8-d5e7b5d99b7f">
      <Text>Sorry... Wait, </Text>
      <Text Style="Italic">it is my wheel</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e650297b-a7d3-4dd4-a004-9f8ad9f28845">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f27cbd3e-6542-4b67-8a2c-fd14ad9773b2">
      <Text>We won’t be able to turn around anyways. The hordes gaining on us!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c83521af-87b4-4db4-af71-88fe1f65252d">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2eca6ed-5689-4c74-9cfa-6e88380e7381">
      <Text>Do you have Banks’s number?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1fabf3db-9726-4934-8d9a-30d0494fcc73">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="12b0fcce-a138-47ca-8ee4-b833fdfc4be0">
      <Text>Banks only has radio.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cfb92dea-50dd-43c1-8a69-abefb4d63c58">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db1c0687-4298-4f96-8997-b3771222532a">
      <Text>Banks wouldn’t mind if we stopped by their cabin with a party?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d8dd81d1-b59f-4bff-98ff-1208b11373b1">
      <Text Style="AllCaps">Banks</Text>
      <Text>’s cabin is in view. There is a box on the doorstep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3863b6f1-da66-4812-8c21-a3c29594d4f4">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec96569a-af8e-416d-8dab-0c6afc2e8cf6">
      <Text>My mom pulled through for us!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bef84a1a-9134-491c-ab22-ee886569b172">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e205bdc7-d27d-4b55-9922-5797756663cc">
      <Text>Go get the ointments, ailment spreader!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="40ac95d2-eb11-4a12-9f45-22d9302eb747">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed0add89-e92c-49e1-8905-ebb7b81ed03a">
      <Text>Joey, perform the walk of shame...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bf92dde4-5181-43c4-a8c0-556dbec98d8d">
      <Text>The horde sounds closer.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1f892078-51d5-4064-80b2-16a1c5604daf">
      <Text Style="AllCaps">Joey</Text>
      <Text> goes out and gets the box. They run back into the food truck.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2aea1fc5-f68e-4bb2-8117-6f63aa4ccaab">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b7fc83d-d176-4dd4-93f2-6cb1e963b40f">
      <Text>They got the delivery person!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="24a77983-257e-4481-8747-13f07c2bfd46">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4103b20-4b4f-4ab9-98f2-f86e99721ded">
      <Text>Not </Text>
      <Text AdornmentStyle="-1">Tarax</Text>
      <Text>! You’ll be back to being the sweet Dandelion we love in no time!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8fa1fc8-6c49-4fb5-8199-1f409b3dae6a">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d1089380-27c9-4969-ac1a-37aee167eacd">
      <Text>Ready to give the zombies what they came for?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe2c4360-7a5a-4387-b3f8-a9f2a2815fe8">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f46873f-5e32-4a40-bb0b-7ba2f488afc8">
      <Text>Skincare!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a0ba8ae0-d2f4-4b15-a648-e3b965853fcb">
      <Text Style="AllCaps">Pyrus</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text> get out of the food truck with moisturizers in hand.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="960fe731-9bd6-41c3-a0cf-91c7b7527169">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="281ff011-1e2a-4acd-951a-3a91dc767f48">
      <Text>If you have suffered a fungal infection as a result of the lack of health regulations, you may be entitled to skincare compensation!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="960fe731-9bd6-41c3-a0cf-91c7b7527169">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="be283764-69d3-46a7-a1ee-034ecec41591">
      <Text>(to the audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b35b36fe-4ddf-4492-adf8-172a8310587b">
      <Text>Who here is infected?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8091fa2-cab3-471b-a3ab-0c73113b6b3d">
      <Text Style="Bold">Audience Engagement</Text>
      <Text>: </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text> moisturize the hands of audience members who raise their hands. </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text> insults each and every audience member they come across. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ba91b20-d127-48c7-9767-9aa778721454">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac505726-9738-491a-817d-20a2281330c9">
      <Text>Ya look horrible but we’ll fix ya. Zombie? More like </Text>
      <Text AdornmentStyle="-1">zom</Text>
      <Text>-bye! Let’s take the pandemonium and pandemic from ya face.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fac1c331-ce25-4c5f-a920-10e699771fe0">
      <Text>The zombie horde audibly shifts to an angry mob.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e03aaa6-a209-4a93-9cad-06200f34966b">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d8bbe61a-f871-41c0-88fc-1c8be0c422e1">
      <Text>Everyone is cured!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ae2b5053-459b-4576-8c9b-80c438eb2865">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3ba43f8a-2198-44d4-8752-3c7aabc9a66b">
      <Text>But everyone’s still mad!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f51847af-3592-487d-a47b-4bc0a9322706">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="97f99aed-d92f-4c6d-986b-9f8a30d6fde3">
      <Text>Bullshit always works on them!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f0eb7f7-a121-49b7-92e9-c95a72873c27">
      <Text Style="AllCaps">Joey</Text>
      <Text> tosses bullshit into the audience.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c11456c4-cc5e-41f1-aedd-301ee841040e">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05e48f28-3246-48ff-a86b-7b5e11e8ad47">
      <Text>Woodwork may be backwards, but we ain’t sellouts.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4785107a-b69e-4573-8380-5ea4658103ac">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4c34b26-6999-4f5a-949d-cf6f47e26ce8">
      <Text>I’m sold on this friendship we got going.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="25df8f48-b824-4748-8699-7340ae3730af">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="321c5035-68a3-4eec-b4a1-f91c61a2165c">
          <Text>Pyrus</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="3b76b0bd-1332-4713-ada5-9877763772da">
          <Text>Friendship?!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="cd4e7cce-aa9c-4b51-b73c-cf3ad9b79c06">
          <Text>Reynold</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="85d07e3b-4d44-4eab-a543-e8eacc6b2881">
          <Text>Friendship!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="3cf26ed1-d89c-4ee9-acd2-72e794cdfd30">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0ff19205-622c-420a-818b-13e31904fab9">
      <Text>Reynold... You’ve been the best apprentice I could ever hope for.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e4313624-38ab-4338-b158-48fa759debd1">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="41d6a502-e569-4266-b6d0-3eec585ed433">
      <Text Style="Italic">The best unpaid plant in the Pineapple family business</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f0eb7f7-a121-49b7-92e9-c95a72873c27">
      <Text Style="AllCaps">Joey</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> hug, but </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> soon detaches.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c01a5194-1074-432d-90f8-f059cf60f83e">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f69a94c-226a-4ea2-933b-2ba3ff075dc3">
      <Text>Ow, ow, ow!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="55da708f-9a9c-4317-8af9-b7357f9254b8">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="45008ef2-b9d5-4ba4-839c-6607b757b885">
      <Text>Forgot... I’m a P-I-N-E apple after all... Now get </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> here and save me a slice of life!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e33772c6-2eb4-4568-b2de-252b719985a3">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8130fe0-3078-4983-b5e8-aea97e0962e4">
      <Text>We’ll make sure you have a proper plot, Joey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e9146b4-beda-439c-bfac-eb0aceea47c4">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd6ccde5-2565-4927-bb5b-743c47602249">
      <Text Style="Italic">Move the plot forward</Text>
      <Text>, Joey.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f0eb7f7-a121-49b7-92e9-c95a72873c27">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> escape.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6df9c528-fb31-4874-9be3-54f96384c928">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a3d3f88-a3f4-4f75-8bea-c29419f4031c">
      <Text>Peel me alive, Woodwork!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="47083445-b54a-4033-b2a0-1b52c4b2848c">
      <Text>The shadows engulf </Text>
      <Text Style="AllCaps">Joey</Text>
      <Text>. A glorious light also emits nearby.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="a9d6b08a-34fa-4195-861b-c89013e6eacb">
      <Text Style="Bold+Underline+AllCaps">Scene 12</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8158d9d4-0383-4860-87f2-87c081f2a3a0">
      <SceneProperties Length="1 6/8" Page="55" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="REYNOLD &amp; PYRUS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Woodwork, Evening</Text>
    </Paragraph>
    <Paragraph Type="Action" id="312141b6-254f-4224-a57b-c379c367dac0">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Reynold</Text>
      <Text> wander through an empty town until they reach the town square.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d2adf56-ca30-4745-b6c5-b1101e40f63f">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ceb40502-5c06-4c9b-9213-0d4b18c52bde">
      <Text>Breathe in, breathe out... 6 carbon... 12 hydrogen... 6 oxygen...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e60678f-344f-4551-80d2-295687d4111d">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f5affe0-79f9-45ef-ac85-fe0cfcb7ea6b">
      <Text>Plus 6 oxygen molecules...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8fd60277-801d-4503-9b6b-3639dc9ac3c4">
      <Text>Reynold &amp; Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9694aef2-8c64-4249-ae94-ec1e903bdab7">
      <Text>Photosynthesis. Photosynthesis. Photosynthesis! Let’s get our plots in a row.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72b52c66-7ce9-4e9c-8f3a-2f0265755aaa">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37a8386f-c2a9-4e79-bb47-d8acaeb801ac">
      <Text>Green is in the horizon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a2cf15c-c0ea-4554-b183-274fd06012c1">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af6ccc84-fa54-42d0-91e8-453cde6d776a">
      <Text>Blue is above.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3fb1d91e-bf55-4976-8349-6a4e10209c72">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="70a56386-beeb-493a-9a72-a2f92bd1c775">
      <Text>Lil Herb, you’re the Cilantro I knew you’d grow up to be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cee77178-adf9-4fd0-bcf2-045f7ef27521">
      <Text>REYNOLD</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7dac88bf-edc9-4f62-a1e0-dc6796403a8a">
      <Text>We’ll always make a great pair, Pear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c8d0989-c07b-4dfc-af5a-6490eebc7351">
      <Text>PYRUS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7df70929-9466-49d8-b8f1-a8167d76d19e">
      <Text>Though, an apocalypse is an unusual way to test the water...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="587dc644-f1e7-4283-a282-e820ad40057e">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c967f482-2c08-4a58-8bab-185a3d356f26">
      <Text>Forget camping... Let’s go rowing next time!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7da243ce-a2c6-4eec-82a4-bec75ef342b8">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b6e61f58-56b7-400a-806c-9bb6b2e574b5">
      <Text>Was this the camping trip ya were hoping for?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bae29bd4-b118-4517-9fea-abdeca32e8ba">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="030c6dd7-6b64-41e5-80ae-85b5fd82f540">
      <Text>I never felt so alive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7f9afafd-197e-4fdd-8363-1297e79d2208">
      <Text>Joey (Offstage)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="de54b341-2030-4cb1-9df1-a75778ec04a9">
      <Text>Me neither...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="49240186-01d5-40bd-a63b-1836765c771b">
      <Text Style="AllCaps">Joey</Text>
      <Text> limps in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ba5fdd51-5db6-4d26-8548-403a36fb20f9">
      <Text>Pyrus</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32b62d66-6e80-4270-815b-a882d8aeae70">
      <Text>How?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4a7ab14-40c1-4fcc-9efb-a16d21889429">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="be4b9d0d-27fd-4eaa-80f9-8a89036ebaab">
      <Text>Christ-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="17c76021-d990-493a-90a5-604c502d676f">
      <Text>Reynold</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="acb00cfe-1d99-4eb2-8cb8-8e597c5f398f">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27ee9eb0-722e-4521-a559-2ceb4f4f03b2">
      <Text>JOEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75c35139-e5c5-4bef-bcb6-0066823a507d">
      <Text>The Christmas Trees... The group never toured Woodwork when they were active. Before the mob could drag me, they couldn’t believe their eyes when they saw a Pine Tree in drag. This Christmas Tree saved me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3b0753c9-9044-4d01-bdce-39b740373ab4">
      <Text Style="AllCaps">Banks</Text>
      <Text> strolls in, wearing dazzling ornaments like a Pine Tree drag queen. They place the hatchet back to the structure.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b899f4c6-32a9-44e0-a2d3-73ee6711662e">
      <Text>A supportive crowd is audible.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e427b505-901a-4a41-a097-8fcc330e6053">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> reconnects with Banks. They take out the ornaments that they stowed away earlier. They offer them back to </Text>
      <Text Style="AllCaps">Banks</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3040f42e-e6e8-45b5-a3b0-8616f1ddf98c">
      <Text Style="AllCaps">Banks</Text>
      <Text> puts the ornaments on </Text>
      <Text Style="AllCaps">Pyrus</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="48cfd61b-d273-42b6-a07f-f35a476bec74">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="39f8b8b4-0541-4132-ad59-b011c5bb9d11">
      <Text>Everyone is meant for ornaments...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="07de0446-b30b-4905-940f-51c4da19d441">
      <Text>(Soliloquizing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aabcd6c9-40fe-4ed3-aa3a-4b10ca176718">
      <Text>Due to life’s obscenities, I moved to Woodwork to join in on the obscurity. To be anonymous. Joey... Like you, I was born to not be in my family’s shadow. We are born to form our own shadows. Woodwork. Where you can start fresh, starting at obscurity. No financial security or to know financial security. No community or to find community. Because of you, I have earned my due to leave obscurity. Let’s not let this soliloquy </Text>
      <Text Style="Italic">drag</Text>
      <Text> out... It’s Christmas in July and I’m yours truly, National Park Service Ranger Banks Carpenter, the Christmas Tree!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="71aaf3eb-5988-44e7-b97d-f8f81a31c9e6">
      <SceneProperties Length="4/8" Page="57" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BANKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="COMPANY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PYRUS &amp; REYNOLD">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline">10. “</Text>
      <Text Style="Underline+AllCaps">Come Out of the Woodwork</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ad8e052d-9310-40fd-a40e-7b1f0eed78be">
      <Text Style="AllCaps">Pyrus</Text>
      <Text> solely sees </Text>
      <Text Style="AllCaps">Cyano</Text>
      <Text>’s spirit frolic in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2836f637-abf1-444c-b466-619fc1f582bb">
      <Text>Pyrus &amp; Reynold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ebe046c6-10b5-4ad7-9037-7be4afcd4bb3">
      <Text>Woodwork...
Works its way from the conclusion.
The town is backwards.
Understood?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="756afd14-4956-4d28-93a6-8574c7424cc7">
      <Text>Joey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d640d29d-c098-4679-94d8-221c1624f7e8">
      <Text>It’s the place to come out of obscurity.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34e54c47-3a07-4da7-a234-23a4409c76d1">
      <Text>Banks</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c94e6364-1f48-4f70-b210-474b53e3a1d6">
      <Text>It’s the space to come out with queer security!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e59e7f8-7c54-4147-994b-900e6e60a41a">
      <Text>Company</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="294a6e2b-abfe-41d6-a258-023afaf00004">
      <Text>A sign to leave the great unknown.
It’s time for a brighter tone.
Coming out has its perks.
Come out of the woodwork!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2502d682-05c1-4175-bd10-512b8da4c672">
      <Text Style="Underline">End of “</Text>
      <Text Style="Underline+AllCaps">Come into the Woodwork</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="a3172081-1aa2-4f43-8d7a-8ffcbf054f4c">
      <Text>End of the Plot</Text>
    </Paragraph>
  </Content>

