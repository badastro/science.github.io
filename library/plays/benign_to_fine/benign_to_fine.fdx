<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Label="Scene 1" Type="New Act">
      <Text>Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Train</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CONDUCTOR">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">1. “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">I Need a Break</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> and</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"> Vinyl</Text>
      <Text> sit in different areas of the train. They are about to exit Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Oh no...
I will not stop to say goodbye to the state of ohio...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics">
          <Text>I cannot wait to just end my career.
I have stated this enough.</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics">
          <Text>I cannot wait to just start my career.
I do not state this enough.</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Magazines...
I will not write for you no more.
I cannot make these long hours.
I will never ever let that break me.
Life will never let this break me.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> shows off their guitar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Musicians...
I am honored to join your ranks.
I’m writing new hits on long tours.
I will open up my life with a big break.
Life will open with a big break!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> grow aware of one another.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics">
          <Text>I need a </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">friggin</Text>
          <Text>’ break.
A fucking big break.
Let me break it down for you:
I need a break!</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics">
          <Text>I earn a biggest break.
A </Text>
          <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">friggin</Text>
          <Text>’ big break.
Let me break it down for you:
I’ll get the break!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> joins </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text>’s seat.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The train abruptly stops.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Conductor (Pre-Recorded)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Emergency brakes!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">End of “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">I Need a Break</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Y’all need a break.</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>I will break you!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Conductor (Pre-Recorded)</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Thank you, Benzene. Fuck you, Vinyl. I can hear you all from the front car. Your words and song moved me more than trains ever could. I need a break. A permanent one. But before I go, here is a message from the Governor of Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HYDROXYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">2. “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">No Agency (NO Further Assistance Needed)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hydroxyl (Pre-Recorded)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sorry, not sorry your plans are derailed. The federal government has failed you. They have no agency. Despite that, the local government will not fail you. The </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">EPA</Text>
      <Text>, or East Palestine Authorities, will cheer you on. I am Hydroxyl, your esteemed Governor of Ohio. Your godsend.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Hell no.</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Go to Hell!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hydroxyl (Pre-Recorded)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">I do not see any problems.</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Look in the mirror!</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>HYDROXYL</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>I’ll smash your face into a mirror!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hydroxyl (Pre-Recorded)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I see solutions. Solvents in Ohio. Stay well.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BenZENE &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We shall poison your well!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hydroxyl (Pre-Recorded)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m poised to say... There is no further assistance needed.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The intercom hangs up.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">End of “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">No Agency (NO Further Assistance Needed)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We need you!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Hydroxyl (Pre-Recorded)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Tough shit!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The intercom hangs up again.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Awkward silence.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>That’s it! I’m walking.</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>Stupid... Wait up!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> follows </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> into Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 2</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="4 3/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ohio</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> wander.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh shit oh.</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Ohio</Text>
      <Text>... You mean.</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl (OFFSTAGE)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m mean. I’m sick. I’m tired. I’m done.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’re so reactive.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Fuck I am. Why aren’t you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s not in my blood.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, Chloride is in mine.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Chloride...?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">You</Text>
      <Text>’</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">ve seen those vans around</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh! Are you a </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">PVC</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic"> and the Chlorides</Text>
      <Text> employee?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">I’m a member of the Chloride family</Text>
      <Text>, a proud and hardworking supplier for plumbers and electricians everywhere.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How long have you been apprenticing for the family business?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No longer am.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How come?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Instead of fitting pipes in, I keep busting them out.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> pulls out a few </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A renaissance Chemical... </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Pipe down.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> drums with the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Have you stuck the artist dream in your family’s pipe and had them smoke it?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> blows into the </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">PVC</Text>
      <Text> pipes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It’s a pipe dream that will be bursting into reality soon!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Wildlife calls back. An eagle cries in the distance.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That’s a sign...?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What is your sign?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">C2H3Cl</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m cancer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Ain</Text>
      <Text>’</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">t that </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">sump</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">’</Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">n</Text>
      <Text>. You look more like </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">C6H6</Text>
      <Text>. But, I can see you are one.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’re not seeing clearly. I’m born a cancer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Sorry... Looks like we’re both born cancers.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We’re bored cancers to/in Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Can I play your guitar?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You can play with my pipe.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ew no. It’s probably been somewhere.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No shit. It toured all over Wayne County from the Armageddon </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Beachparty</Text>
      <Text> Lounge to the Olympus Theater in </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Menjos</Text>
      <Text> Complex, Detroit.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Sure</Text>
      <Text>. May I hold your guitar?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>How bored are you?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Immeasurably.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You sound like </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Dopamine</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Who?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Dopamine is a member of the Detroit music scene. They write tons of dopey love songs. It makes that Chemical immeasurable.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’re immeasurable.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>We sure are not. I’m no </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Phenethylamine</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Have you written one?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A love song?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Wouldn’t dream of it...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>A hate song?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now this Chemical’s talkin’.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I can sing, too...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> hands the guitar to </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What do you hate?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(Erratically strumming)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Michigan!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Stop. You’re supposed to lead up to that state. Start small.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Midland.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now, what’s your reason for wanting to get out of Midland? </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic">Friend</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Were you trying to get out of uh...?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Detroit. Yes, I’m getting out there. To New York. You?</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oh... Anywhere.</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>OK...</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Oklahoma... Definitely not there.</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My oh my.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Michigan... Ohio... Michigan...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What do you have against Michigan?</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene (Offstage)</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I’m distancing away from my work life.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Work and life don’t rhyme together. Work and life don’t go together.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>So, Vinyl, you definitely are a musician.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Shut the fuck up. What job didn’t strike a chord in you but instead a match?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I am an editor at </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">Dow</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The nature magazine?!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nature isn’t what it seems...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Benzene? What is your dream?</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>To be in the nature.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Your name is already in a nature magazine. That isn’t enough?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nah... I wanna get dirty and soiled.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Like Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>It beats Michigan.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="2 7/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BENZENE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BENZENE &amp; VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VINYL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">3. “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">Take IT Out on Ohio</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">”</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> strums the guitar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Oh no.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Ohio, yes. Take it in.</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> breathe deeply.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>There is not anything out there quite like ohio.
This place leaves me in a speechless state. oh </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">oh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">oh...</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> takes back the guitar.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Italic+AllCaps">Because there’s nothing in Ohio</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>stop taking it out on ohio.
</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="8" Style="AllCaps">
</Text>      <Text>There’s no one like the citizens living in Ohio.
These folks leave us in a thoughtful state of being. oh-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Nah, these people are assholes.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Don’t take your anger out on Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Fuck you and ohio!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Don’t take it out on me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Quit shitting on Michigan!
Fuck all things Ohio!
Let’s take it out on Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Oh no </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">no</Text>
      <Text> oh.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Fuck them! Fuck Ohio.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>There is nothing low as taxes in Ohio.
Their economy leaves none in a taxing state-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Really the wealthy class owe-</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text>Benzene</Text>
        </Paragraph>
        <Paragraph Type="Lyrics">
          <Text>stop taking it out on poor ohio-</Text>
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text>Vinyl</Text>
        </Paragraph>
        <Paragraph Type="Lyrics">
          <Text>I won’t. Oh no.</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Fuck then. Fuck the whole world...</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Don’t take it out on the world.
Start taking yourself seriously.
Blame life on Ohio!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Let’s take it out on their soil.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> kicks dirt about.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> falls for </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text>’s passion.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene &amp; Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Oh </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">oh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">oh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">oh...</Text>
      <Text>
</Text>      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="8" Style="AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Fuck Oh. Fuck Ohio!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">End of “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">Take It Out on Ohio</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Usually this is where we smash the guitar into the ground...?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ohio’s bedrock ain’t worth a touch of my guitar.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> come across a stream.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What about a riverbed? Also, fuck the Ohio River!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Vinyl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Nothing compares to the Grand River.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Grand Rapids was the first city to introduce fluoridation into the water. Sick people.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If only they were governed by the people of Flint. Flint had the right idea.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A canoe becomes present nearby.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Right... You thinking what I’m thinking?</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">BENZENE</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>After that raft!</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Character">
          <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">VINYL</Text>
          <Text></Text>
        </Paragraph>
        <Paragraph Type="Dialogue">
          <Text>That is an empty canoe!</Text>
        </Paragraph>
      </DualDialogue>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE &amp; VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Take it out!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> pull out the blanketed canoe.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Benzene</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="">gotta</Text>
      <Text> admit: Ohio got some hidden treasures.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Hmm... Where does this river lead to?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Water usually leads to civilization!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Do you see paddles anywhere?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You sit up front and strum. I’ll steer by hand.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You can touch water, but pipes go too far?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Pipe up and start strumming!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Benzene</Text>
      <Text> sits in the back of the canoe. They feel the water.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You really trust nature, huh?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>With my life.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>VINYL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Where didja learn to row? You’re such a cancer.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>BENZENE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That makes for a good steerer!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Vinyl</Text>
      <Text> sits in the front of the canoe.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold+Underline+AllCaps">Scene 3</Text>
      <Text AdornmentStyle="0" Background="#A6A6CACAF0F0" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps"></Text>
    </Paragraph>
