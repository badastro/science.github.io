    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20130619T182900" DateTime="20130521T181210" Id="3" Name="" Range="1122,1122" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">These are ScriptNotes.  They can be accessed through the Navigator.  You can anchor them in your script or you can make a General Note that won't be tied to a spot in the script.</Text>
      </Paragraph>
    </ScriptNote>
    <ScriptNote Color="#RRRRGGGGBBBB" DateModified="20130617T162715" DateTime="20130521T181210" Id="4" Name="" Range="1872,1872" Type="" WriterID="" WriterName="">
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
        <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Arial" RevisionID="0" Size="12" Style="">to create a blank line/space you can insert a hard return by holding the SHIFT key and then pressing ENTER.</Text>
