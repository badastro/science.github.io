<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">

  <Content>
    <Paragraph Label="Scene 1" Type="New Act">
      <Text>ACT I</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Bold">SCENE 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Childhood Backyard</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="1 6/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ENSEMBLE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SUDO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SUMA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SUMA &amp; SUDO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="THO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="XENA &amp; ANTON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">1. “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">Natural Causes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Xena</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Anton</Text>
      <Text> dig a grave. </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Suma</Text>
      <Text> and </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Sudo</Text>
      <Text> enters, lifting a rabbit-sized coffin. They lower it into the hole. </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Xena</Text>
      <Text> and </Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Anton</Text>
      <Text> cover it.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Xena</Text>
      <Text> &amp; Anton</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Cause and effect.
</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Suma &amp; </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Sudo</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Where do we go when we die?</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Tho</Text>
      <Text> climbs out of their grave. They have a horned nose.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Tho</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>It is getting too dark.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">End of “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">Natural Causes</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Sudo</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ah!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">THO</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Meow?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Suma</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>What?!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Tho</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I am a rabbit. You don’t understand me.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">SUDO</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>No, I understand you.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">THO</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You do?!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Suma</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The vet told us you were braindead.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">THO</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Well, that vet is dead in heart.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">Sudo</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>That horn you have, it killed-</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">THO</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I know, killer horn, right?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Suma</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>The horn must have burrowed into my noggin.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ensemble</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">“lyrics”
</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>this is a lyrics element
it is in all caps
It helps distinguish
From regular dialogue
To insert a hard return
so you can break the line
wherever you want
press </Text>
      <Text AdornmentStyle="-1" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="AllCaps">shift+return</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>RIP CHARLES (late 20’s, handsome and charismatic) exits the train, and peruses the terminal until he sees...</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>JANE RANDOLPH (white, late 20’s, classic blonde) at the top of the stairs. </Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The action continues as Rip and Jane leave the terminal.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>ensEMBLE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>If you see any flag icons in the margin they are ScriptNotes and may contain useful information.  Go to Tools &gt; Show Navigator.  Select the ScriptNotes button at the top.  Then you can either click on the ScriptNote icon on the script or select the ScriptNote in the Navigator window to view the note.</Text>
    </Paragraph>
    <Paragraph Label="Scene 2" Type="Action">
      <Text>The terminal breaks away as we...</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>transition to:</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="4.00" RightIndent="7.38" SpaceBefore="12" Spacing="1" StartsNewPage="Yes" Type="Action">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">SCENE 2</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="6/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JANE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RIP">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>ext. HARLEM Street</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The music continues as Jane leads Rip down the street.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>riP</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Now, where are we going?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Jane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Not much further.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RIP</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>I don’t like surprises.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Jane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>You’ll like this one.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>A freshly painted sign over a club reads RIP’S JOINT. A worker is putting in the final light bulb over the sign. The sign lights up. </Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RIP</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Rip’s Joint?!?</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Jane</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Welcome back, baby.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>RIP</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>My own club?  </Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(then sings)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps"></Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>see above is a script note
If you click on it
You will read
How to create a “soft Return”</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>We move into Rip’s Joint.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="5/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BLACK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="BLUE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SAL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>int. rips’ joint</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The club itself which comprises a bar, a small stage and some cramped tables</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>BLACK AND BLUE (extremely short Black vaudevillians) appear on stage.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Black  </Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Ladies ‘n Gentlemen!</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>blue</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Boys ‘n girls!</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Rip dances onto the stage, dressed to kill.</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Jane smiles as she watches Rip. She starts to sit on a stool just as SAL TRIGIANI (Italian, late 30’s) slides in and holds the chair for her.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>SAL</Text>
    </Paragraph>
    <Paragraph Label="Scene 3" Type="Dialogue">
      <Text>One day, I know you’ll love me.</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>fade to black:</Text>
    </Paragraph>
    <Paragraph Type="End Of Act Info">
      <Text>end act one</Text>
    </Paragraph>
    <Paragraph Label="Act II / Scene 1" Type="Act Info">
      <Text>act iI</Text>
    </Paragraph>
    <Paragraph Label="Scene 1" Type="Scene Info">
      <Text>scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <SceneProperties Length="3/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="RIP">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
              <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style=""></Text>
            </Paragraph>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>int. the HEART OF TIMES SQUARE</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Rip sings and dances his heart out.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>riP</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>So now you get The gist </Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>of how this works</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>If you have any problems</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Call tech support</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The writer starts typing madly knowing that all he now has to do is add the words...</Text>
    </Paragraph>
    <Paragraph Type="Transition">
      <Text>THE LIGHTS FADE TO BLACK...</Text>
    </Paragraph>
    <Paragraph Type="Act Break">
      <Text>THE END</Text>
    </Paragraph>
  </Content>

  <Watermarking Opacity="70" Position="Diagonal Descending">
    <DynamicContent>
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No">
