    <Paragraph Type="Scene Heading" id="6df478ec-908e-4475-ac45-d34715b30114">
      <SceneProperties Length="3" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEWEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DEZ">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DEZ &amp; BOOKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="S VOLUME &amp; SCI-FI PAPERBACK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="S VOLUME AND SCI-FI PAPERBACK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">1. “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Checking In</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d53a174a-0667-4b41-9c01-e0642c6d2dbd">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20f80fae-dded-4db2-8a1a-37cde168a569">
      <Text>Hey you all.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6ba88522-803c-4ae0-9cfa-3796a1774bd1">
      <Text>Just checking in...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1a492740-31cd-45c5-b52c-0951d6371fcd">
      <Text Style="AllCaps">Books</Text>
      <Text> cheer.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="903022ab-a7cd-4290-b19f-d2fa1a584ea2">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="83cde1fe-3438-4f80-82bc-f043248e3c4f">
      <Text>(jaunty)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="976027d2-3ba1-4fcd-8842-f19ffa87caf6">
      <Text>Smell that dust and print ink
breathe in that catalog stink
thrill to another library day...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d9155410-587c-43b2-aaa7-2c0afc6c22a3">
      <Text>S VOLUME AND SCI-FI PAPERBACK</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7469d8c1-37c0-4326-845e-0582b7578a4d">
      <Text>Hey, hey, hey, hey...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72fca06d-d474-4ee0-a201-8fc556d7fd22">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1f17fd36-a104-4ce8-aa66-0d77bd9b7489">
      <Text>So what if the floors creak
so what if the walls leak
We’re here for the patrons who come anyway...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a3bdfdb-4cd9-4e9a-bd0e-5dc8220e8ee8">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bb260797-fe26-4875-87f9-cb497bdb1b20">
      <Text>Yay </Text>
      <Text AdornmentStyle="-1">yay</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">yay</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">yay</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d56e13fc-9e36-43eb-81ca-32dbc0f9f07c">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4f20e71e-16e0-424d-b58e-937d0364647b">
      <Text>Huh, the new intern is late. Yes, they are our only applicant this year. These past few years. We just have to make of what we have. Isn’t that why you are still here, on this shelf? </Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa715dc3-0702-4b50-b1fe-53e2f11eb218">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1ec09a9f-25a0-4df4-83ff-88dbc22258a8">
      <Text>So check in to knowledge and wit
check in to find where you fit
Check in for book friends
You can carry away...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="13dbe671-fd77-4fb6-857e-2b016d9d4e7b">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e9beff15-75d4-4b8f-b5c3-f4c9ad8d4af7">
      <Text>Check out today...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="baa64f32-1bbe-4da2-8712-d82acf6fabc5">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5dad44be-7ace-471d-bc73-34a6265753e7">
      <Text>I check in to work here
and smile to my pals near
Let’s all check in for a library day--</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4c4416e-7c36-44eb-b5d5-ce62376cbc86">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6b31ba48-dca0-4d39-8c1f-d8fac6cf4a2e">
      <Text>--a Library day--</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4fec02ec-ff70-4f10-9d56-ef021210ba9a">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c4a39c94-a69e-4759-89e5-ea4c9f039bc6">
      <Text>--a library day--</Text>
    </Paragraph>
    <Paragraph Type="Character" id="795f847d-8a22-4321-935f-09ed7dcbd283">
      <Text>Dez &amp; Books</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6a8ae0e8-aca4-4754-82ab-72ecd7a5e7b3">
      <Text>--A library day!</Text>
    </Paragraph>
    <Paragraph Type="General" id="12afd713-a2fc-403d-9dbe-b26e7942f082">
      <Text Style="Bold+Underline+AllCaps">
End of “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">checking in</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="42d48c4a-ab15-4532-be98-f214df61bbea">
      <Text Style="AllCaps">Dewey</Text>
      <Text> enters, looking at their phone as though they were mapping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bcfc914b-51a4-434e-96e8-a57cc7f8cf5e">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eeb9440a-1cd3-44e3-81f0-63467843082b">
      <Text>May I check in?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93c13beb-37c4-4497-b4fe-26fd873acf88">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38fbc53c-1d7d-487a-9f6a-8ac029af4af0">
      <Text>Check out the newcomer!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83af2cb6-5f09-432d-a3a4-5c5d2c38ab88">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eb3116c0-5c0e-4d48-bdb3-08cd29e89db7">
      <Text>Who’s talking?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18530211-26ed-4a68-8a20-fabcaf7ca59a">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="965e7d6f-3cf4-4d18-ac96-f4f4fdc1f2ae">
      <Text>The books. It’s always the books.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb936723-3543-462d-8258-507ef6f1943c">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0a20fcf1-0955-46fd-bc58-c6d5a5cff0db">
      <Text>The books?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="114d56a6-c19a-402a-a840-2762273e554f">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5a866ee-32f4-4071-b6ec-ef757bf24054">
      <Text>Who else gives off words besides our own mouths? You act as though you’ve never seen a book in your life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="803586c4-2659-4d14-b765-d7360ba9cb66">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25c15d0d-0f54-4cc1-89f9-90c660ab770c">
      <Text>Twenty years ain’t that long.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ec51e115-794d-47c4-863a-fe35c55e1b02">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08347c9d-83b8-446a-82e8-dde1e852db86">
      <Text>You’re kidding...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cb7adecf-428a-4949-b9d4-bc5d20b259c6">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="07666056-240a-469a-9754-8f8bf4e72adf">
      <Text>I’m Dewey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c3b1b1ca-28c0-4f23-bc61-7a26c9252c8e">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="09205d12-8d98-4b5a-8a8f-851e07251c76">
      <Text>Dewey. I’m Dez. Head librarian. The first thing I ask you to do is to hold this book.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="df6c9db9-04f8-4f13-842f-75e109f6ed30">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="81285bff-a407-445c-9201-ad5a040eab38">
      <Text>I don’t know how it feels...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9078acb-7191-417c-a25e-3aaec811204d">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aaff2c73-b01e-48df-9473-583e504a72f1">
      <Text>To have responsibilities?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6fb3937-7a76-4165-bd30-f556542dc093">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf5e1876-d699-4f34-b38b-88014a480106">
      <Text>To hold a book...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22a8c8e4-4ca1-4624-9e22-8134a25ebad7">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="004b033a-e34c-4207-8d1d-5b8a4abba909">
      <Text>That’s what this internship is for. We put a book on hold the old fashion way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e88784d-af05-4315-89a8-5157815cda0f">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="321de84b-29b0-44d2-b549-9bdae778b5b6">
      <Text>Not that hold. But </Text>
      <Text Style="Bold+Italic+Underline">your</Text>
      <Text> hold.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="574395d4-c95e-46a3-9a1f-e138d28d62bd">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7c895058-7a77-437f-befe-3efbcf6fe38e">
      <Text>Wait. You’ve never touched a book before...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="624046b8-2395-470e-b2d2-103d8fe4c9a5">
      <Text Style="AllCaps">Dez</Text>
      <Text> reviews </Text>
      <Text Style="AllCaps">Dewey</Text>
      <Text>’s portfolio.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bc385b2d-842e-401c-b0ba-c2880c467957">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7a4099b-7ca2-4a54-ad74-0b52a9c90d92">
      <Text>Well, I’ve always wanted to.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="924367c7-cf6c-45ab-8760-fb3d982770c3">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38ca957e-12ac-48bf-a58d-13254678fe92">
      <Text>451 area code...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8593772a-be4a-4759-a25e-0d5019e1d7d8">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="31f445b5-14ab-42d7-9bea-18b9ab0292c5">
      <Text>It’s actually 415. San Francisco.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e691b59d-2883-4789-a338-38be6b8db911">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2163991-1088-4c74-baa4-aceec0ab6a5e">
      <Text>Do they not have paper books where you come from?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="53011a94-58dc-44bc-a715-f548323dbc2b">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c72dfc7f-21d3-4722-9994-795e4c89d1b6">
      <Text>Everything is automated now.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16c98262-2842-4a5d-a29f-21a2c209ea03">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5d57e15-752c-46ab-bf4b-8b6a60dd1adf">
      <Text>You should have applied elsewhere. You’d automatically fit in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e809632-39d1-4355-af25-674942c3569a">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="22d814bb-26c6-4674-a7bc-30057f94e0a9">
      <Text>Your library is non-competitive. I put it as my safety choice cause at least my grandmama lives here. I do wish that Arbiter is by the harbor, but this town is in the middle of nowhere!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb9756f5-2705-4f86-9522-a9f2e2283065">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="80d80b8f-31b1-4804-970e-26587c9bb341">
      <Text>That’s the heartland for ya!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73d2097a-5b61-4873-a76e-3c793927732b">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b6d6648-6d1c-44f2-9c77-c315259de6a3">
      <Text>Ugh. I could’ve been with my college friends, interning in New York City or Seattle... They speak to me more than these piles of dust.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb769c6b-7649-468e-8499-d174c1971712">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5758c5ff-fcf6-4f30-b79a-5bb28a8046f7">
      <Text>Who you calling piles of dust?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2a5ec2f-f76b-41fb-b38a-bab0cd0ac8ab">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3208d4a1-e0e6-459e-bf22-65fdb1fdf82d">
      <Text>If you don’t want to become a librarian, what do you want to go into after college?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1b166c1-98af-4abb-88be-e0948c2083db">
      <Text>DewEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0071eff-66ad-4c64-ba12-2e83602891a3">
      <Text>Middle management.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c40e4807-8116-4b46-a9e7-f705c5d6377e">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e03fca4b-b50c-411c-a931-459719253d9d">
      <Text>Seriously?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5382997-eb78-4c62-835d-5d86f2c606ae">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a62019f1-70f1-45bd-a5b1-485600fbd507">
      <Text>But not upper middle management. And not lower middle management. Middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> management.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0da9e9b0-c5e3-459d-a447-7a0820c5eb67">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d0335779-b994-47ee-b2e1-00005b01d689">
      <Text>But why?</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8105d6d8-8891-4367-ba39-fcc0a8beb8ba">
      <SceneProperties Length="1 1/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEWEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">2. “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Middle </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Middle</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps"> Management</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1ec2e2bb-a4e8-416c-bd2d-91b3306171a9">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0df2e15a-b19f-4599-bcdb-0dfd16ea37c2">
      <Text>At my college, we’ve been told
A job can be hard to hold</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8b4dc316-6a13-43e4-874d-185640e2f07b">
      <Text>The chance of C-suite chair is pretty thin</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ab614a18-f3b5-4658-b752-175c540ded8c">
      <Text>And curing cancer? Hah, don’t even begin!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0ca09886-1fbf-45cb-8c76-44bc9b29a076">
      <Text>But there’s one role I know that I can win</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="081d6459-d72f-477a-bd92-81ce8d7388bd">
      <Text>And now, new friend, I’m thrilled to loop you in!
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="969b82ab-16f6-4c00-b2d2-23e3d028019b">
      <Text>I will supervise three people</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4d8fe241-ef99-413b-902c-ce7789995700">
      <Text>Or maybe four or five</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="eeac29f6-8a2f-4e53-91f9-379942ed972d">
      <Text>I’ll give out praise like stickers</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8afc7c7f-9196-4581-9f0c-0f9f430ed40a">
      <Text>To help them all to thrive</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c872952d-9151-4490-826b-8e18a9716476">
      <Text>I’ll comment on a work chart</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="aeb3b1ff-aca0-4b02-9628-26100fffdeca">
      <Text>I’ll lay out who does what part -</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8acff8d1-7f33-48a4-bd37-77ad6c5860ab">
      <Text>Oh, everyone will love our little hive!
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6d8cbc93-5315-4dcc-9780-213387bdd70c">
      <Text>I will be middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> management</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="34ce35af-720a-4d24-bb94-964be4b54b6b">
      <Text>With middle management flair</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f9c7bc6f-5fff-42a8-b862-79167f48af0e">
      <Text>And as a middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> manager</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7e17eed6-53eb-4af1-a2b5-45a73bb599f6">
      <Text>I’ll wear a watchful stare</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0b075488-fe93-44df-8e22-6e2220e57e7a">
      <Text>And I’ll get middle management updates</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a30bc62f-ef5a-4e13-b2cc-85aee6ed285c">
      <Text>With a middle management tag.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="72507a03-ba2c-485c-8ecd-e0439478194c">
      <Text>I’ll go to middle management conferences</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="00f4711c-6de4-4b1a-9190-a2be1cb71b6e">
      <Text>Get middle management swag!
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4e812dbc-87c1-428d-a472-4242f2d01136">
      <Text>I will call each of my teammates</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ee271cdb-230d-4c55-8088-5e4899485556">
      <Text>Each hour on the dot</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5556fe84-e349-4929-934e-80054256a26f">
      <Text>To find out if their projects</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4578be01-0914-47ad-9a0f-ffc27c44c15d">
      <Text>Have progressed or not.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="734f1a4b-a867-4949-b018-fbae60a29a47">
      <Text>I’ll update all the spreadsheets,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9bda6e6a-8582-47f2-a330-6a6d87d22f6e">
      <Text>I’ll schedule daily pod meets –</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="930e3a82-baa8-49a5-b1e8-644468cc9cbd">
      <Text>I’ll be the greatest boss they’ve ever got!
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="517fa6a7-da3d-447b-be9c-94e1aa1acdde">
      <Text>I will rule middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> management</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9168ebb2-6f80-48fa-b302-3528676f8a1c">
      <Text>With a middle management smile.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1c724d51-d673-41af-b75e-76792b09bc0c">
      <Text>And as a middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> manager</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b65d38f9-9475-4e40-8bcc-28c836a4b962">
      <Text>I’ll offload every file!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a529ac80-7e6f-4fa9-9e9a-52ed37dbfe1a">
      <Text>I’ll go to middle management offsites</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6524b574-4dd6-4dde-8450-10d682ecfc7e">
      <Text>And build middle management tools</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2f8bba64-8f36-41f3-8694-3e685a18367a">
      <Text>I’ll soak in middle management hot tubs</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="50f1e40a-856c-4cd7-b2f0-468f75debe0c">
      <Text>Next to middle management pools!
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="443bb8f5-1afe-481a-a400-77041c59746c">
      <Text>And if dark days arrive when I wonder</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="62552e57-a279-43ac-9f01-fa54bd3618ee">
      <Text>What is my life for?</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b889898f-a193-4fc3-827e-3d153368df5d">
      <Text>Should I have spent it building telescopes</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="80339096-dde4-4729-8332-a8bba62c733b">
      <Text>Should i have joined the Peace Corps?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="ba5c26e1-d4f5-4254-a6ab-20ba9ad75efc">
      <Text>(pause while </Text>
      <Text Style="AllCaps">Dewey</Text>
      <Text> thinks)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4eaa4f52-1c06-4e29-8150-f1ffc7afd482">
      <Text>I’ll take a yoga class
those bad thoughts will pass,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b6933ad5-1432-47fc-9665-905a9ff1c237">
      <Text>And i’ll return to where i was before:</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ea3c8cb9-6c75-4450-97b1-781546967246"/>
    <Paragraph Type="Lyrics" id="eddf5e99-de4f-425f-ac46-f7eede90dc3f">
      <Text>Right back in middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> management,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="eac6c388-45db-4ce9-ad2c-1eb506c48905">
      <Text>With middle management style,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6f081e34-830b-4c3d-9339-6ab0630de2a2">
      <Text>I’ll be a middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> manager,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="feab82e9-2a7a-409c-96b6-ff984ec69765">
      <Text>I’ll go the extra mile!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7753c757-fc6a-4075-9cef-9922edf8bea6">
      <Text>With ROI, I’ll circle back,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0c963dbc-7e24-4b96-94ac-062153d439fd">
      <Text>Put a pin in it, you’ll see:
i’ll be the very most middle manager,
the world’s most </Text>
      <Text AdornmentStyle="-1">most</Text>
      <Text> middle manager,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="93baeb58-9542-4ad4-b2ec-6d3016191797">
      <Text>A middle </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">middle</Text>
      <Text> manager, that’s me!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="d943a8a3-bf48-4a55-b0e9-fc303e3477ca">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">End of “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Middle </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Middle</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps"> Management</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="20102a2e-8eeb-48bd-a9ed-5353cc01dd98"/>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2c89c18b-e249-4b64-9765-89e2fd3fc3a1">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
