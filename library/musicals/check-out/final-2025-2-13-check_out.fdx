      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="7/8" Page="11" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TONI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">4. “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Write my Name</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2fb655b6-f808-4341-9cb7-1966418d621f">
      <Text>Toni</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="aada8149-42c9-4a86-9ff7-bf2df3009e6d">
      <Text>I loved to visit this library as a child</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3e9108ca-1ba6-4972-90ae-fb49089072c9">
      <Text>With a backpack and my card and a new Sharpie.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="51e8d7b2-0885-4270-9a82-0a01d13a84ef">
      <Text>I’d write my name in marker, pen, spaghetti sauce--</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="39884be3-83e1-44fc-8371-83cbf3921c71">
      <Text>To return a book without my name would be a tragic loss.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0af5128b-db62-4829-8063-d147095feb9b">
      <Text>The fellow tore my card up and suspended me.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="00f7192f-bee6-4fda-a198-abbf947a87e0">
      <Text>That day I swore to find a way</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a4ceeeb6-c511-4752-9be5-d3675ba577dd">
      <Text>That I would be free--</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="20b6ff97-cb10-413c-8755-2015d5c4b8d7"/>
    <Paragraph Type="Lyrics" id="96776b55-a3d6-49b9-9d5c-b01bbdfd1643">
      <Text>-To write my name on everything!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5226ed8f-d191-4955-92df-96ebbfdb943a">
      <Text>And I won’t stop</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="28cb16c5-8324-4b40-a363-6f79a0d6bcef">
      <Text AdornmentStyle="-1">‘Til</Text>
      <Text> it’s on top</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9441630e-c7ea-400c-b10d-da572ce14fbd">
      <Text>Of every park bench and swing!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="22cfce25-a115-49df-b9a7-5f2c8f075a0f">
      <Text>I’ll write my name all over every day</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1d2889a3-30ac-435c-8674-0a5199d791da">
      <Text>And no one will get in my way
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cfe9b398-9da7-497d-8ada-48e315a08329">
      <Text>So I grew up to found a tech enterprise,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cd115632-939b-42e4-9d18-d8754815695c">
      <Text>And I named it Toni Sexton Industries:</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="111204f8-fbb7-4de4-b679-e0a0f2ba0b87">
      <Text>My name in ten foot letters above our office door.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d6850f58-99bc-4490-88e7-2af87256c061">
      <Text>It’s even on the tiles of the bathroom floor.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b41579b8-f281-4882-b2c4-abf588380bc5">
      <Text>We’ve got a Toni Sexton phone, a Toni Sexton PC,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ea7f0cf9-bc70-4b38-a40b-75e18bb7b1cd">
      <Text>And all because this library</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3c07d005-0b2c-44b5-b07e-f2adb2e5a37b">
      <Text>Inspired me—</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3c00b2f8-9c54-408a-889b-56b3e2e352d2"/>
    <Paragraph Type="Lyrics" id="ec5024f3-bea9-4436-bb80-4dde4c7c4d15">
      <Text>-To write my name on everything!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4ee32d8b-f62e-45b8-94d4-167b8e447136">
      <Text>No, I won’t stop</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f0b9f3c-1b95-4535-9a9a-e0ddd1cc9768">
      <Text AdornmentStyle="-1">Til</Text>
      <Text> it’s on top</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e24d3227-62b5-4b29-b5c3-0ff722077aa2">
      <Text>Of every park bench and swing!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bfb422dc-f68f-4c84-9fa7-b3ec16d22368">
      <Text>I’ll write my name all over every day</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c9f2e04f-f963-4276-91a6-01bb52c1aa0e">
      <Text>And no one will get in my way
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="521b0947-bb25-4d56-b910-9fcaa94b9750">
      <Text>Now I’m back to write my name where it all began</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8ecb20e5-ae37-4f96-b88a-9bd00f01f0bb">
      <Text>To fulfill my childhood dream with a grown-up plan</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="748d5d12-e86a-46ad-b4be-d7d047b60d0e">
      <Text>In the Toni Sexton Library I will smile</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c2b1daa0-0828-4449-9b6d-f705d958f479">
      <Text>To see my name in every book and over every aisle</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e00717ad-87ab-460c-bdce-7d57581e7b64">
      <Text>I’ll save this institution with my money and my fame</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="68e5b6ef-47a3-4f30-8d56-3b2a1332a8df">
      <Text>And in return, I can finally</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1c15a469-fb0d-4619-abee-717e20c79e04">
      <Text>Give it my name—
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="394aa0b4-634e-4a73-90ce-f0c0a5e7814c">
      <Text>‘Cause I can write it on everything</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="df69743f-6cc4-4f51-98d5-2f95a8c83da0">
      <Text>No, I won’t stop</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d5165071-c392-427f-a74e-507983ed5ae5">
      <Text AdornmentStyle="-1">‘Til</Text>
      <Text> it’s on top</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="701eec73-c1ae-45b7-9b16-e8919c387b75">
      <Text>Of every park bench and swing!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c909a837-6a7b-4935-a42e-532ccc192ab8">
      <Text>I’ll write my name all over every day</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="51d9f10d-4ac0-4296-8451-884a5ae25b13">
      <Text>And no one will get in my way

I’ll write my name!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="e40259af-5fe2-4da7-b7f2-47a18db6d1ac">
      <SceneProperties Length="1 1/8" Page="11" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEWEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DEZ">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SCI-FI PAPERBACK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TONI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">End of “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Write my Name</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4e1bdd1-0c7f-45ed-aa8e-f0b7de770756"/>
    <Paragraph Type="Character" id="c4e1bdd1-0c7f-45ed-aa8e-f0b7de770756">
      <Text>Toni</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0eb274e-c3b6-4ea4-8a54-e3ceb4b6e6f2">
      <Text>And then, I’ll fire the dastardly intern who stole my library card!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fd921510-b401-4f03-82db-ff8549e450d9">
      <Text>DewEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7aca34cc-1846-4e49-a72e-e81fafd9ac37">
      <Text>You can’t mean... Dez?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f06b3221-5882-490f-b41c-5a9d15c5c21e">
      <Text>TonI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf83e980-cd19-497c-9a39-1bc939ff9274">
      <Text>And what’s this shrimp’s name?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="967dc161-b9c7-4283-9807-e53043296a0c">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="577741b8-4a03-4238-800d-42c772132fdd">
      <Text>Dewey. This year’s intern.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eee5ac53-5931-4c36-8c8c-45a40515e332">
      <Text Style="AllCaps">Toni</Text>
      <Text> pulls out their phone and types: “</Text>
      <Text Style="AllCaps">Dewey</Text>
      <Text>.” A section of the library gets renamed “Dewey.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="66d57a35-d75d-41f5-9412-b1ab31de2469">
      <Text>TONI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c9335b36-2a48-457c-b096-ab9cf5630bf1">
      <Text>“Dewey” in a library seems appropriate.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c0a0ba9-421c-44a6-a3a1-dd4d4e18e4c5">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c8dfc14-7c29-4d65-8ec1-4d370a24fefa">
      <Text>This tech is not the library I grew up in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83565549-9924-4dbb-b662-9fd267c5a594">
      <Text>TONI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dc33ebe0-125f-4ab1-b104-c1c57f63e565">
      <Text>This is the library society needs to grow in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d334f7ac-855b-42b1-832b-d1c61325da56">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1ec450a1-3ac8-4720-babb-5e491063e8ae">
      <Text>You’ll never grow up.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="83efa1c0-b4f3-46cd-a44b-4761c13ee53a">
      <Text>The </Text>
      <Text Style="AllCaps">Sci-Fi Paperback</Text>
      <Text> catches </Text>
      <Text Style="AllCaps">Dewey</Text>
      <Text>’s attention.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d6dacc89-21b0-42c0-8872-9928f33d463f">
      <Text>Sci-FI PAPERBACK</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7facccb5-25ee-4ffd-b9f1-ee3089c548e1">
      <Text>Dewey... Growing up may be a science but growing up perfectly is fiction.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db3301ee-e1db-4c6d-a152-d8450f25eaf7">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29fa34d4-4720-4c1b-ba38-c148d38d7bd2">
      <Text>What do know about me, you weird children’s book?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="252d5696-40a2-4ca9-ba85-7d224aa43d4f">
      <Text>SCI-FI PAPERBACK</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="813875a9-cf39-434e-a636-693cb7e2bdd2">
      <Text>Not you. Your grandmama.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="599c2d2c-d8f6-4fe2-bb38-8dc02aa62dc3">
      <Text Style="AllCaps">Dewey</Text>
      <Text> opens the book. The only name in the checkout list literally spells: “grandmama.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e0429b0-08eb-4c0f-b0b8-66ed502a2a69">
      <Text>DEwEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56103976-ad79-4571-9e0f-945c7db5b4db">
      <Text>Grandmama’s name is right here!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afae4ccb-7d19-48eb-a31e-25feb68d2e63">
      <Text>SCI-FI PAPERBACK</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9139cc3-188a-447f-a6b6-80c6a3911d7f">
      <Text>If grandmama grew </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> that childhood spirit, you don’t know who’d you be...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="53e8dd06-4ee2-4a1f-8c0e-318e3cd0d1b6">
      <Text Style="AllCaps">Dewey</Text>
      <Text> considers reading the </Text>
      <Text Style="AllCaps">sci-fi paperback</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="10dd1144-55d9-4465-8f94-400379c3e81e">
      <Text>TONI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a916953-30e2-48d5-b695-cce15e0fd963">
      <Text>If you had let me be a kid, I would have grown up.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="86bbdf36-973d-469b-8f54-6d289461008e">
      <SceneProperties Length="1/8" Page="13" Title="">
