        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c522469a-2221-4024-ab03-8eeff825853f">
      <SceneProperties Length="1" Page="19" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEWEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DEZ">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DEZ, DEWEY, AND BOOKS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="S VOLUME">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="S VOLUME AND SCI-FI PAPERBACK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SCI-FI PAPERBACK">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">6. “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Check Out</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a830f623-fdb9-4cb7-baa5-fd620cb549f8">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="24354af0-811f-4871-9ac8-22fc9bfd1aa5">
      <Text>So, Dewey. Are you ready to check in to your internship, and check out your first book?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="952eb594-807a-47de-8253-26129f8396ab">
      <Text>S VOLUME and Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="31daa7be-542b-43cb-a254-9899a50cdb24">
      <Text>Pick me! Pick me! Pick me! Pick me! Pick me!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4079d628-d85c-481b-9113-7fde975498c8">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f83b8e8-713e-496f-a369-fbccd6853287">
      <Text>Well..</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b4012c9a-20d9-4316-afce-701247425618">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8b3dd04c-bfa1-4b27-9253-17c31b151b1d">
      <Text>Smell that dust and print ink?
breathe in that catalog stink?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0eac7eb0-28aa-454d-bd7c-31a5c36208f6">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a8f7d302-c003-4015-95c1-2c03f58cc487">
      <Text>Yes! Let’s</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="dae12ae4-8e69-4b5a-b82f-71681afb4db4">
      <Text>thrill to another library day...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3db58a3c-3832-4660-8f15-b6f3ab7f4fc0">
      <Text>DEZ</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="884667cd-f289-4bce-9680-5089c0c332fb">
      <Text>Library day--</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51ccff3a-f92a-4e2b-887a-5dddda738923">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2fefdcd7-a3d0-48f9-8f0d-37212f76ad33">
      <Text>Library day--</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c8157c7b-f109-4c44-af20-3e3d136b26ba">
      <Text>DEZ, Dewey, and Books</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="99cae42c-64f9-42de-9b3b-5bde52775097">
      <Text>Library day!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0847149-8fc2-4311-918a-e8e4fb2d24d2">
      <Text>DEWEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a29b704f-8b14-4bef-952b-4dcbbc4e1f0c">
      <Text>All right, it’s time. Science Fiction Paperback, I choose you!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee7d936a-3d63-49a9-8692-b650905adcb9">
      <Text>Sci-FI PAPERBACK</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93794ca1-b7e5-405b-afdb-5d1d2bd9e268">
      <Text>Yes!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e654269-08d8-4c5f-b0be-f4e3ccc8fcf3">
      <Text>S VOLUME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="30263573-b3c3-4e40-9562-81d64a6a4c6d">
      <Text>Scraping Scorpions!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0ec1016-c5bc-4bcc-9f5d-8fff9249fcd2">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0dc4249-0c1c-48c9-b775-0d3c6f293193">
      <Text>Here we go...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="521c64ea-6054-4027-8f6f-847ef9a7de54">
      <Text Style="AllCaps">Dez</Text>
      <Text> checks out </Text>
      <Text Style="AllCaps">Science fiction paperback</Text>
      <Text> and hands it back to </Text>
      <Text Style="AllCaps">Dewey</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c8157c7b-f109-4c44-af20-3e3d136b26ba">
      <Text>dez</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6ce560ad-b226-44df-838d-46d7dde69bfb">
      <Text>Let’s all check in</Text>
    </Paragraph>
    <Paragraph Type="Character" id="614b5371-3bfb-4acf-83f1-ba8b150b32ba">
      <Text>DEZ, DEWEY, AND BOOKS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6ce560ad-b226-44df-838d-46d7dde69bfb">
      <Text>It’s a library day
A library day
A library day
A library day</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="19a5a79d-79a7-45d7-aaf1-fe68ffed704e">
      <Text Style="Bold+Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Check Out</Text>
      <Text Style="Bold+Underline">”</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="cc3e0680-e468-4e97-aa5e-5498e6180f98">
      <Text>Checked Out</Text>
    </Paragraph>
  </Content>

