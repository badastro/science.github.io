    <Paragraph Type="Character" id="f9e86fb7-926c-407a-8ce8-581d99fcd164"/>
    <Paragraph Type="Character" id="f9e86fb7-926c-407a-8ce8-581d99fcd164"/>
    <Paragraph Type="Character" id="f9e86fb7-926c-407a-8ce8-581d99fcd164">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9be48959-ab03-4bf0-a24f-e3a4fff15986">
      <Text>Well, take a chance and meet us in the middle. Check out a book just this once. Take your pick-</Text>
    </Paragraph>
