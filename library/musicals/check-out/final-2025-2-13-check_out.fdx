            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">3. “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Pick Me</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b89c9944-62c8-434e-b04f-91a787a542d3">
      <Text>S Volume &amp; Sci-Fi Paperback</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6f271e39-518f-4512-b797-b48366e9e25e">
      <Text>Pick me! Pick me! Pick me! No, pick me!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="20397bb9-353b-4e39-8068-8ff33d842d61">
      <Text Style="AllCaps">S Volume</Text>
      <Text> elbows </Text>
      <Text Style="AllCaps">Sci-Fi Paperback</Text>
      <Text> out of the way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c1a15bc9-73b6-4356-bcb9-91ddaf50fde9">
      <Text>S VOLUME</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c34d3b87-7197-4eef-83a5-c6b0e96ec74f">
      <Text>Pick me, pick me, pick me!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="84f06b8c-e944-4db6-a554-cb004d271c71">
      <Text>I’m a sprightly, stunning volume to swiftly start.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="24d8946b-9b37-4a6f-9ee4-2d4575495e66">
      <Text>Reading me will make you a lot more Smart.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d47462c3-ed5b-4d44-92f0-c199fc3e4534">
      <Text>you’ll Search for Saltine</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="596168ad-7982-4d14-b930-dc816f3d501e">
      <Text>you’ll end up at Sardine</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="37056abd-3b77-4040-a73b-065f9c8c43cf">
      <Text>But you’ll have to check out to begin!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2d283f66-8f1e-4f4b-9ef8-2f195d4f65c2">
      <Text>So if you want to read about Salad</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c19ad639-3796-4577-b718-69af01aff5de">
      <Text>And then Salamander</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9ee62325-f010-4b4e-aea4-15cd6fd277b2">
      <Text>Check me out and give me a spin</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cfa19462-dfe5-41d3-868f-f0f9e7b056d0">
      <Text>Sci-FI PAPERBACK</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="de8a017a-a829-4540-ac49-a031a5127c4f">
      <Text>Pick me, pick me, pick me!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ae0ee8bc-5157-4a14-ac9b-2490c6b24f8a">
      <Text>I’m a science fiction novel with attitude</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9a2086e2-54df-4a9d-be61-684ad0203ba0">
      <Text>My story’s fast-moving and will leave you glued</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6452a7a9-42d3-44ea-a9f0-efc9a88c7b4c">
      <Text>you’ll fly into space</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="008e4006-a82f-4fd9-af0e-650705532661">
      <Text>For a starship race</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a9ed4287-c7f1-4d66-8dd7-c5cd54563557">
      <Text>But you’ll have to read me now to win!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="85c906b3-a50b-45b7-9633-800f162e237f">
      <Text>So if you want an evil robot</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bb7340fe-82dc-4d1d-81d9-f23f383c6679">
      <Text>With your alien,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="61798a7e-6b88-45f2-88d6-b0fe6d620bde">
      <Text>Check me out and let me in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f04a9395-ee5d-476f-8908-1b3ad7fb8968">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bcfea79a-3e16-4ec5-95af-e1d4caa9ef44">
      <Text>And pick me, pick me, pick me!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="46fd92ae-7dba-400e-81d1-51e0f62989ea">
      <Text>I’m a longtime cataloguer who stacks with ease,</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="92927839-30d0-4b8b-8ea8-792e5ca3c97a">
      <Text>I’ll find any map or magazine you please.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cb81784c-7b74-43f1-a364-78ea91fc5050">
      <Text>I’ll teach you how to file</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0b756cfd-5111-4ca2-8202-89433eadff01">
      <Text>How To own every aisle.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="51852cb4-68c3-4c7a-be9e-09d48c1633f1">
      <Text>But you’ll have to decide to check on in</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="01bbeb77-8889-48d4-b7d2-b62448e5179e">
      <Text>So if you want to fall for these books</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1632d563-5ffb-47aa-88c8-f89de3e0d71e">
      <Text>And your internship,
Check us out and give us a spin--</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa3ec0ae-a0a8-4923-978d-72099eefbdb4">
      <Text>Dez &amp; BOOKS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d89df1ef-a120-451a-8455-b2c8895855d7">
      <Text>Check us out and let us in!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="4074c3bd-64d3-4c88-a894-7b3cdf09d579">
      <SceneProperties Length="6/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DEWEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DEZ">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TONI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline+AllCaps">End of “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">Pick Me</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="637529c6-a08f-408f-86d3-b645e4207e2f"/>
    <Paragraph Type="Action" id="637529c6-a08f-408f-86d3-b645e4207e2f"/>
    <Paragraph Type="Action" id="637529c6-a08f-408f-86d3-b645e4207e2f"/>
    <Paragraph Type="Action" id="637529c6-a08f-408f-86d3-b645e4207e2f"/>
    <Paragraph Type="Action" id="637529c6-a08f-408f-86d3-b645e4207e2f">
      <Text Style="AllCaps">Dewey</Text>
      <Text> point at none of the </Text>
      <Text Style="AllCaps">books</Text>
      <Text>. Instead, their finger lands on </Text>
      <Text Style="AllCaps">Toni Sexton</Text>
      <Text>, who barges in, self-importantly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="009e2c65-296b-40e4-a3c5-9c908c46a57b">
      <Text>Toni</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b31b2ed8-5e00-46fd-b4d0-b7bea86bfb65">
      <Text>Thank you for picking me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="167b7937-3a66-4f31-8046-ccf0435f2214">
      <Text>DewEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bc0d7f9d-e070-43a9-bb75-25343f31a4f8">
      <Text>And who are you?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a0f64de4-17b8-4ae2-98ab-cccb64629b5f">
      <Text Style="AllCaps">Toni</Text>
      <Text> opens their mouth to speak.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e7c50bfb-e809-4d1f-898a-1260d4864d46">
      <Text>Dez</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="816eab85-98fc-45e1-abc9-262fd7b7966a">
      <Text>(Flatly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="accad9ee-cb53-4a42-83df-0f7548732de4">
      <Text>Toni Sexton.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="facdaf45-6873-499c-8c93-b3bded46a06d">
      <Text>Dewey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5da80344-bb13-4826-8012-fc435140f71b">
      <Text>Toni Sexton! Shouldn’t you be running your tech empire? What are you doing in Arbiter?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a7b9b8fe-7305-4096-8802-57dad951e9d9">
      <Text>Toni</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03f42f4d-421e-4553-80bd-9dad45d36f1f">
      <Text>Arbiter Township Library’s newest board member! Just bought my seat today! Now that there’s finally a new intern at my hometown library, I can fulfill my childhood dream!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c12b13ce-b89b-4912-93be-c99ded21a789">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats/>
      </SceneProperties>
