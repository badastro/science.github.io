<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20260824T113304" id="b2cc9d95-f925-4d8b-97ad-03463d8a83a5">
    <XRef DateTime="20260815T054842" id="3c1e211b-b305-451b-8468-b316e06811aa"/>
    <XRef DateTime="20260815T054948" id="579954c4-fa36-4223-aabf-f3ce7cb4cb3a"/>
  </DocumentRef>

  <Content>
    <Paragraph Label="Scene 1" Type="New Act" id="03254032-ba6b-4137-a15f-5226dbf7d214">
      <Text>Prologue</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Elk Lake House in Elk Rapids, August 2008 - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="93d78288-cd47-42a1-bc05-4a7a4a908f37">
      <SceneProperties Length="4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">1. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Overture/The Mitten Song</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79621969-d8c4-48e3-8a84-1fee599aa112">
      <Text>In the wooded backyard are tents where the </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> family is camping next to Elk Lake’s rocky shores.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79621969-d8c4-48e3-8a84-1fee599aa112">
      <Text Style="AllCaps">Petey</Text>
      <Text> (30s, man who’s seen better days) crawls out of his tent. He puts on mittens. With a melodic yawn, he bangs pots and pans. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b381cf5-6334-45bc-83d8-d4ac4aed8158">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="aee1e9f7-332a-4c33-aab4-da31549b1a92">
      <Text>Wakey </Text>
      <Text AdornmentStyle="-1">wakey</Text>
      <Text>, sun.
Let’s wear our mittens
and cook ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text> eggs with lotsa bacon
for our godsend, Michigan!</Text>
      <Text Style="Italic+AllCaps">
Slept well, hun</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ef686414-65c4-47fe-b18f-a0e378ba4214">
      <Text Style="AllCaps">Lizzie</Text>
      <Text> (30s, pregnant narrator) crawls out of Petey’s tent, ready to smack her noisy hubby.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="238fcebc-fec6-40be-93f0-bd789fcd8499">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Overture/The Mitten Song</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="76bbb514-e185-421f-ae54-f5cced7d3e2d">
      <SceneProperties Length="9 1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AUDIENCE MEMBER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY, PERRY, SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JASPER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JASPER &amp; MICHIGANDERS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MICHIGANDERS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY, CHERRY, PERRY, SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VANDAMS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY &amp; MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">2. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Life is Complete</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74596edf-3b0a-411c-a645-60dae77421f2">
      <Text>Lizzie</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8fe9e75e-f694-4c92-8246-46a415dd8682">
      <Text>That’s the love of my life.
But every morning, he’s public enemy number one.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9a50caa9-ca59-4a82-b4c1-f0bae066934f">
      <Text>The three </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> sisters - </Text>
      <Text Style="AllCaps">Cherry</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Perry</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Shelby</Text>
      <Text> (pregnant) - crawl out of their tents.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4d19f78-bff2-4aa0-b21b-0b32961dd324">
      <Text>CherRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b41af3f0-ad4c-4fcf-bf02-79f7768d88d6">
      <Text>To his wife, lizzie...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c27a53db-761d-4911-ab9d-8e4547f30dc0">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bb174e77-5f98-4cb6-82e2-b2481de07509">
      <Text>And one two and three goddam sisters!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="88ccff7d-5948-4c81-855e-015c28641887">
      <Text>ChERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6b13d6b8-e47a-4693-9696-119aab97e43c">
      <Text>The </Text>
      <Text AdornmentStyle="-1">vandam</Text>
      <Text> sisters!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="424da45c-ae3a-4f36-b11d-eee9910715e6">
      <Text>CherRY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="498cc770-9c2e-49cb-a166-58014f83c91b">
      <Text>Cherry!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b180c210-9482-4be8-8c4c-a31c10f61454">
      <Text>Perry</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="99981a0d-fa88-4673-a429-c5dd9a18d416">
      <Text>Perry!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3cf85738-a244-4c5e-8738-5011cd42273f">
      <Text>Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="17ab3352-718d-420c-9621-ffb92a0ad017">
      <Text>Shelby!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a007d6e-7c96-44da-883f-751f49f1473b">
      <Text>CherrY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b8061bf2-e9b2-4c91-b9df-68c6b391d6d3">
      <Text>Wet willy!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e4a19120-57ba-4256-a0d5-32c60eb06738">
      <Text>The sisters give bro a wet willy!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bb4d86a-56cd-4376-9faf-9634d6f4db5a">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cb62a9b0-bd15-4a7b-825d-59dd738b9b44">
      <Text AdornmentStyle="-1">Eeeekkkkk</Text>
      <Text>!!!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eedc3177-9093-4355-a556-b56b80f24e8b">
      <Text Style="AllCaps">Granny Milly</Text>
      <Text> and </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Grampy</Text>
      <Text Style="AllCaps"> Willy</Text>
      <Text> are lost, wandering in the audience. But they’re old, so they don’t give an F.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9cd0df7-1878-472a-8923-67eff3c1f2a1">
      <Text>Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d6c6b75c-9168-4955-bb69-353da7a33efd">
      <Text>Or wet milly?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2fc0bf5e-0245-402f-91c3-72de00036acb">
      <Text>Petey, Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9677b76b-b4ab-44fc-8c96-6e5ae2b22a9c">
      <Text>Ew... Mom and dad, that’s gross!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="00ef1514-549f-421c-a078-3ea62a5efd03">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="b73f0b30-ee8e-4134-8d8d-e1b23a97795e">
          <Text>WILLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="35c35d91-cb76-4d76-be7b-02a7fe86e977">
          <Text>What?!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="a8275a39-76e6-4ab0-a407-3344093abb1c">
          <Text>MILLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="ae1d8527-8f1c-42f3-adf8-a71ea8d03167">
          <Text>Huh?!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="7a7d74bd-3e41-4880-a443-03302303cbbf">
      <Text>CHERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0562f3fd-dcab-458e-b6ec-797d65166911">
      <Text>Go put on your hearing aids.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a754db1b-1828-4126-9eb3-1d32845dc708">
      <Text>Willy-Milly tune their hearing aids.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1b97067-1f6f-4dde-9d26-8cd1185951f5">
      <Text>WillY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c6580e36-4786-45b7-b1f1-d036f71fc9fc">
      <Text>Great!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b071c0fe-3ea6-42d7-836b-34df46566e31">
      <Text>Willy-Milly turn their attention to the audience they frolic in.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="6180e28a-b0ab-4233-8474-dbb1650af4a5">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="636f26ac-bcb2-4adc-b34b-ecc3e699cd6f">
          <Text>MILLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="ef523127-2ce7-44f6-9ef3-316c8b3a1c0b">
          <Text AdornmentStyle="-1">Grampy</Text>
          <Text> Willy.</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="1262e70e-a1ef-4322-88de-fed7955155fd">
          <Text>We’ve got company.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="b6e06daf-a22a-4705-80b6-32350debbbd8">
          <Text>Willy</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="ccb5f10a-d879-46ea-a0a9-14d689a3ce0a">
          <Text>Granny Milly.</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="42518579-1731-4304-9f66-ddec760dca7b">
          <Text>Real good company.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="b278cd66-b9db-4371-acea-3975bf8dad58">
      <Text>Willy &amp; Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="afb1c5ac-9e54-4017-bc9e-f1410cd791cf">
      <Text>Isn’t life somethin’?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="70a14b1d-8fdc-4619-b7ea-55270048ecd4">
      <Text>Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fdcef8fc-4b86-4999-8511-78d459e84ac8">
      <Text>You have come a long way, friends.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b0982eb-f28e-44dc-8868-9097a7bf6dd0">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a0c702cb-29dc-45e6-9168-aa62df29fa89">
      <Text>To the greatest bay in all the great lakes!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="55dca278-4621-4902-9d34-9129071f43f5">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2c10d89d-ece2-4b0f-83b6-3faee0ee1ec8">
      <Text>Baked your kids fresh cookies,
Make yourself comfy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2e36146e-beb4-4c42-8c08-bf56a5948ea0">
      <Text>Milly hands out cookies. Willy removes his shoes. The pit pukes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eae13a5a-8b7a-4685-92a6-36d79a01d7b4">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="90a2ef29-7756-4bb4-ae73-cdae614dbae4">
      <Text>Ugh! Ya scaring our guests with your clam feet!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1557a2f1-82d4-48dd-b934-c99de497b693">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4909de34-ae41-4f3a-b9ef-421c1c00e1a7">
      <Text>I’ve been working out. My feet have mussels. M-U-S-S-E-L-S? Get it?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="baf90134-3260-489e-9a9e-9e9285f9e20b">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f8225c50-c5bd-490a-9dec-df7b94f52bd6">
      <Text>Your dad jokes are getting old, </Text>
      <Text AdornmentStyle="-1">Grampy</Text>
      <Text> Willy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a07b59ee-83b6-4371-8618-775677a0eb26">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d0feb90-9981-4016-882b-23e0867a9a36">
      <Text>Not as old as you, Granny Milly...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b484870-a234-4ef7-a774-83959a639e28">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="44aa32e4-95b1-498e-b20c-6874d975a8a2">
      <Text>Shush! The guests are gonna think we’re Midwest silly instead of normal silly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e9352c7-24f6-4ccb-9811-6cb1e27a0c35">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1d60e6d7-109f-4dd1-ad47-718e68e71085">
      <Text>Ma! Pa! Who are you talking to???!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c5fa3e4-9db5-439d-8ac4-f7f7bfd03738">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2b497e0-798d-4602-aad8-3d0e047b7ffd">
      <Text>You should put ya parents in a retirement h-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="014bf81f-389b-44d4-a961-56d339048b69">
      <Text>WillY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="867db046-3e9d-4a5d-89fe-1c80690e5d51">
      <Text>Our hearing aids heard that! Maestro?!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="538d21ed-2a55-4831-8f7e-9f833de30097">
      <Text>Life is complete with our crazy family!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="388663b2-94ce-45e3-9b8c-ff83f385a45b">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> family members get ready for the Harbor Days Parade.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e03e32a-6fe0-4cb2-9194-d8b796407ad8">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3223a88f-162b-4241-afc2-cacc3378c579">
      <Text>Welcome to Harbor Days with the </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> family! What is Harbor Days you ask? It's an Elk Rapids tradition lasting four days every August. That's all I know. I've been attending these since Petey and I were high school sweethearts. We even found ways to still go while we were tailgating at Michigan State...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4dc1a166-8e51-4f73-bf7b-64e6ccda897b">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="150d06f3-4fcc-4393-9102-3cb19f9a68a9">
      <Text>(to audience)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f8e48c1-3db5-477f-a78d-1aea471f7b82">
      <Text>Go Green!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="270fd0f5-77bd-4b57-b2ba-3c6633a6e1bb">
      <Text>AudiENCE MEMBER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="258624fe-c4ac-439e-b06a-7707958d86b0">
      <Text>Go White!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c6e0ef71-2d1c-4a08-be09-763082d9f42a">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b2bc17c-fba1-454d-b4e3-3f4bc5ffc3fd">
      <Text>...and I still have no clue what Harbor Days is even about.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8dfdaad-4c02-495a-bcec-718714cc888a">
      <Text>Cherry</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0cc3ba3e-f584-422a-9708-9fe95c4bd076">
      <Text>It's about the parade, dear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="491f2210-0f70-44dd-8b68-6d9c4cc0c35b">
      <Text>PerrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="44bbd5df-ef2a-43d8-9287-9b0801e0af56">
      <Text>Nah, it's about the carnival!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="77e11161-ca19-4fe9-a003-760dcf762f73">
      <Text>ShelBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2681d553-421b-4324-b31a-34e54e53a515">
      <Text>Actually, it's about the fireworks, yo!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd26e966-328d-4ff7-bd63-f01ef2c80c6c">
      <Text>WillY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13925a1d-71b9-4890-a4ec-705a170f9ed5">
      <Text>It’s about the Lake House.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fa76aab1-ced4-4ba1-bae9-ea0d887dc07e">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33c73484-60d9-42a7-879e-29308ecbee8a">
      <Text>My genius Milly-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8cf8ab9a-a5dd-4907-9ad1-6a71cc515110">
      <Text>Milly</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ea289b19-44fd-401d-8972-53ee75427312">
      <Text>Aw...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4a1ed85-033d-4575-9e91-7df02d76560b">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5515c94-f18b-40b0-9f94-bb5c49673639">
      <Text>She invented the </Text>
      <Text AdornmentStyle="-1">automative</Text>
      <Text> toilet and we flushed our profits down the toilet for this Lake House.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="855b51cb-f12e-4d21-a365-621b45fa9a06">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f7924b7-1401-4193-8e99-164c3c3858c1">
      <Text>That ain't how you use the idiom sweetie... Well, my creative Willy here tends to our garden.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f303367c-718e-4b96-8995-33d0bf9a392c">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0a8b423f-bb46-409d-b505-b3b50356d8d8">
      <Text>Did you put a turtle in the koi pond?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27106bc4-d5d1-4f64-9fd1-1481ca45ca28">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c43f552d-2b95-4ff1-97b6-9050d148ab26">
      <Text>No, dear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0d238ad3-3853-4275-9cf4-3eadc1cf057d">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba017972-b46b-4b59-81a4-7eb42c76bf6c">
      <Text>Not </Text>
      <Text Style="Italic">deer</Text>
      <Text>. Turtle. She ate all the koi fish!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="59b648e6-f758-4aca-ae4c-331a0cd8d21c">
      <Text>CherRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="460f6cee-c759-47a0-aee7-c1deb556286d">
      <Text>It's probably my son, Jacob. Little teenage rascal... He's hiding somewhere.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d888de8-6f73-47c4-92b1-bd583b61f259">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6e63fcfa-d21e-4157-b5cf-09fad5286c6f">
      <Text>That's Petey's oldest sister, Cherry </Text>
      <Text AdornmentStyle="-1">Jacobowitz</Text>
      <Text>. Her family is currently in Kalamazoo. She's a costume designer and her hubby used to play hockey with the Grand Rapids Griffins.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c41dc9f-0eb8-4d57-b8ec-54c2bebe002a">
      <Text>Cherry points to Kalamazoo using her hand as Michigan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96cb0499-2676-40e7-ad29-3d3cf521ace1">
      <Text>CHERRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2ae8703-dcaf-4107-b64f-27f137a391b6">
      <Text>The only pucks I give is winning the Most Creative Award at the annual Grande Parade.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ef53cda-9a85-41b4-b205-39ed03aee04d">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f099112b-e61c-441e-a0a4-dc6f2aaeda7a">
      <Text>Ever since they were little, Cherry would make the family wear elaborate costumes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3994c4e4-1460-4701-9ba7-0961e0d89b63">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="31bfee12-7e02-4f7f-9fde-d4027193be4c">
      <Text>What's this year's theme?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="42c490b6-51e9-4cbe-b58f-e9b49a03cfac">
      <Text>CherRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f7bb8c21-d4a2-4c1d-baec-73ff2801d5d8">
      <Text>2008's theme is Red Wings.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="95665204-82d2-4970-8ffa-19f424c71ad4">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cbe05112-1512-42c9-b134-d15b4e47256c">
      <Text>They just beat Pittsburgh Penguins...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be463923-4b9f-4e94-b50e-e1336d2e09f9">
      <Text>Shelby</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86670b97-a20b-4f00-b91e-3c1cd79fa352">
      <Text>...to win the Stanley Cup. </Text>
      <Text AdornmentStyle="-1">Woop</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f05c0edf-ebfa-4830-8e66-432a77cdcddc">
      <Text>CherRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e90fa3e3-c900-4363-8019-224e7ff56f60">
      <Text>And we will win this year's Most Creative Award again!
</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e275d2c0-7dcd-4ecd-b241-efd1fef71b7c">
      <Text>No one beats the </Text>
      <Text AdornmentStyle="-1">Vandams</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea43a18c-8c2f-4d77-b470-a01bb3dbc64e">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3cb78d4d-7a99-4c7c-be16-8d4f60299a3d">
      <Text>No one beats us like this 2008 recession. Michigan's been hit hard. Everyone's </Text>
      <Text AdornmentStyle="-1">budgetting</Text>
      <Text> tight. The shipyard up in Marquette fired me and Petey. We can only hope that we don't lose our house.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f620f481-9dd9-47b1-a9e7-d7f35626d698">
      <Text>PerrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86a9141f-4f7b-476a-bd5e-5b687279a12d">
      <Text>If this scavenger has kept her den, any other coyote can.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96cc3cde-0bb4-4649-bebc-6cad0dc363c8">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9fd3c6c0-181e-49fa-a1fd-a0f75eccef2b">
      <Text>This is Perry. She and Petey are Willy and Milly's middle children.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e68cc266-37f6-4281-bd6a-a138a39227ee">
      <Text>Perry</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e6a25804-ff56-4ee1-abb7-4c7e8c30334c">
      <Text>I’m in the middle of greatness!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c5d5275e-9dd6-49a6-bbb4-ee3606259613">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="466e248c-7777-46b1-91cf-8c4bbacebca2">
      <Text>Single. Can never hold up a job.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a23fb11-aae0-4c30-91d0-e42a0e6bfbdb">
      <Text>PERRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="53ca99b9-587e-4435-9459-ade574a2baff">
      <Text>Greatness I say! But actually I'm singing it up at Lansing's Impression Science Center!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c41dc9f-0eb8-4d57-b8ec-54c2bebe002a">
      <Text>Perry points to Lansing using her hand as Michigan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="19fffb49-a2c6-4a3c-aef2-f954e5a39151">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a202613c-6956-42a5-9107-cd1860e528cb">
      <Text>Are they paying you? Welp, she's the smartest person I know.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6669b9d7-9e26-4763-b6fa-32d7bad4cee2">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ba7d1a7-ce22-4c6f-bf10-052fcfef800e">
      <Text>What does that make me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c411750-9f38-42c7-98fa-93fbfce6903d">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1736f994-8256-411d-8c0d-724c6f82575e">
      <Text>Pregnancy </Text>
      <Text AdornmentStyle="-1">sistahs</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b247968-6752-4312-8160-e2df5417f0bd">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="de40b1bf-c538-46e4-95d5-ee662648583b">
      <Text AdornmentStyle="-1">Whoo</Text>
      <Text> yeah!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7bab5fb1-19f2-4cac-970c-ed5f6e4272b6">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5878334-9085-4227-9d65-9a01efae7c7c">
      <Text>And finally, Shelby, Petey's youngest sister. How's Ford in Dearborn holding up?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c41dc9f-0eb8-4d57-b8ec-54c2bebe002a">
      <Text>Shelby points to Dearborn using her hand as Michigan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a6d1b0ed-e654-4a2c-81f6-7f57d6cde5a6">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fff363d5-720f-48a0-83e2-d77cdf13ee44">
      <Text>The assembly line is fine, thanks to my husband. He was able to get his Kurdish buddies job during a recession. Sure, they're getting paid minimum wage but what more could one ask for in a time like this?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1773a5d1-7f9d-4188-b733-456413b317fb">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e0669abb-b31c-4cdb-81a7-40e00c7de250">
      <Text>Yeah... </Text>
      <Text Style="Italic">Nothing more American than illegals taking our jobs</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e61fe7e0-4af6-4553-a01b-1f526729e22e">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff79e162-9c73-4953-b73e-4f383dbb949c">
      <Text>Petey... Her husband ain't coming to Harbor Days because of your attitude.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86057adf-4f20-46dd-8103-1a7534e1af5f">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="739db4cb-056f-4c28-972c-c160ae32b7cf">
      <Text>He got his citizenship on our harbors thanks to their marriage. He's gonna dump her once the coast is clear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51afd469-3a1f-4e16-aefe-a4c4c41ecfa5">
      <Text>Shelby</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf8a1dc8-5dee-481f-832b-6502bbe4e795">
      <Text>Immigrants are who built the coasts, harbor, the country...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7c3e753b-5b3c-4401-a802-89f89597afd1">
      <Text>The communities of Michigan from the Amish to the Jewish, the Christians to the Muslims, the farmers to the automotive workers, the college fans to the trade school students make themselves present.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34644112-8279-434f-9e05-7cb46c24c2fb">
      <Text>MichigaNDERS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="04cd8dfa-063d-4aa2-aabc-daabaee913fa">
      <Text AdornmentStyle="-1">Ope</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1d50abb-40d6-44cf-ab2b-a6355421a97e">
      <Text>CherRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="42073645-2a91-469b-a2a7-6410f98e6227">
      <Text>Life ain’t complete...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dfadcfc8-e73b-4dbb-bf8e-8af83d5e10d6">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c4f8df10-2938-453a-89fe-a1bad7deb911">
      <Text>Without...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="8e7321a7-6a62-419e-b51f-dff256074c98">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="c6143836-bad2-4d57-8f4d-5e634aae1dee">
          <Text>CherrY, PERRY, SHELBY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="18a7f436-eb38-458f-a5c2-1b5ee3f67243">
          <Text>Community!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="32262114-f5f1-421f-ab26-10f0d3ce1712">
          <Text>MichiganDERS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="9d31586f-87a1-432f-84b6-dcb76e00d6bc">
          <Text>Community!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="5e808d97-1c67-4866-9b65-de97b528d2b2">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e0a329f0-9a70-4909-8b32-e8ba82d7f232">
      <Text>Ah!!! We’re full grown adults!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36b1b09c-def9-4540-b471-b399a7d25b9f">
      <Text>MichiganDERS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="941cd564-de5f-4760-b7a1-1c9e9580ef21">
      <Text>The world sits on our furniture!
People can get anywhere with our cars!
Our cherry farms are the cherry on top!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="758d5cd9-7431-4fea-88bb-45745b05f1fb">
      <Text Style="AllCaps">Jasper Tran</Text>
      <Text> (30s, Vietnamese man) opens up the </Text>
      <Text Style="AllCaps">Banh Mi</Text>
      <Text> restaurant.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3611819c-c1a3-4707-bd40-e780c30fb0cb">
      <Text>Jasper</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1c1d2084-954b-4dfb-86b0-919ea504f33c">
      <Text>And let’s not forget!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="bf21a03e-c3e6-406b-aa6c-f214dcc4c454">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="7b451bba-f662-45cb-a7b2-f5a178da7b3a">
          <Text>Petey</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="36d6dbc0-1984-4530-8dc9-80ed4eb0899a">
          <Text>Elk Rapids has the best Vietnamese restaurant!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="49e21100-14f2-4715-b4f4-db873c11b4fa">
          <Text>CherRY, PERRY, SHELBY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="79aa0a97-2600-4b54-89f9-68b83fa4ba88">
          <Text>Michigan has the best Vietnamese community!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="b55c6520-dd51-4b57-8a4b-982d1d08ecea">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="eba57fa1-6e0f-4b5b-949f-1bab7e409f8f">
      <Text>In the whole world!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7565f8b-e416-4fd2-b431-f495b6ecbd81">
      <Text>MichigandERS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="803fbc1e-25e2-4ec7-a83f-d273fbb3efe3">
      <Text>Life ain’t complete without Banh Mi!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2910683a-81eb-489d-a8e5-9298da3be230">
      <Text>Jasper</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f7f42939-2498-4a22-96d1-5531769215fc">
      <Text>Banh </Text>
      <Text AdornmentStyle="-1">miiiiiiiiiiiichigan</Text>
    </Paragraph>
    <Paragraph Type="Character" id="26be5d5a-b7b6-4ae6-8722-9e98c1623766">
      <Text>MichIGANDERS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="93098ee2-3244-47bb-933b-8bf3a58eaa5c">
      <Text>Say that again!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="addb5066-187b-44b8-b8e7-6545168e1fd9">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1e1386be-f88a-4e49-8457-12526fa20251">
      <Text>Banh Michigan!
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4f69af47-c920-4728-abf8-c23b14f45190">
      <Text>BANH </Text>
      <Text AdornmentStyle="-1">MIchigan</Text>
      <Text>, a Vietnamese family-owned restaurant in Elk Rapids, Michigan. Home to Banh Mi Thit or the </Text>
      <Text AdornmentStyle="-1">Nuong</Text>
      <Text>, Banh Mi </Text>
      <Text AdornmentStyle="-1">Heo</Text>
      <Text> Quay, Banh Mi </Text>
      <Text AdornmentStyle="-1">Xiu</Text>
      <Text> Mai, Banh Mi Ga </Text>
      <Text AdornmentStyle="-1">Nuong</Text>
      <Text>, and home to our latest Detroit-style Banh Mi-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06428db3-29dd-4ff4-8d15-d1e582482d3a">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bc2b6bc4-4095-43d1-ab61-f86bd7b734e6">
      <Text>And it’s what I called home. Jasper!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b9b01bcd-3921-4527-8c2f-e7075a608589">
      <Text>JASPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b967b9e-4364-4580-8531-bf6553a8f23d">
      <Text>Petey! Happy Harbor Days to you, and Lizzie, and your soon-to-be baby!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da097d0a-0b0c-4cdc-b146-738acfb0c92d">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d86395d-a9bc-46f5-8122-b03429bc52f4">
      <Text>If you could put Banh Mi in baby formula, you've got yourself your youngest customer.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5be2d03-2e55-4d9f-9dc7-7243702dc073">
      <Text>JASPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="17672c96-23eb-4e50-b64d-95e768d13ad7">
      <Text>Way ahead of ya!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4838dce7-6060-4d01-800a-8c2352902f14">
      <Text>PeTey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f004f6a-1045-4b2d-b435-22121d52d196">
      <Text>After the parade, come on by the Lake House for a swim for o' time sake.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0aebdab1-db91-4eb2-823b-f7aaa40b6e19">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0bbef6f0-e38d-471a-9c2d-d8afec2473a0">
      <Text>Kosher Banh Mi for Cherry's son Jacob and sourdough for Willy and Milly?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4dfe4204-e06e-4fa9-974b-c10fdb387764">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7b5a74f7-95c3-4a80-b6fe-57ff6a2159e7">
      <Text>You're always able to make Banh Mi for everyone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eecc4b41-7887-46c4-895d-380fef589d04">
      <Text>JASPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b428927f-01e7-474b-9211-f1cb861dfb7f">
      <Text>Cause Banh Mi is you and me!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="16686d39-8cf1-40f2-9ca4-a9e71561acb8">
      <Text>Willy drives in the Ford Model T.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d81c9d3-8069-4034-ad03-3f55c911d508">
      <Text AdornmentStyle="-1">VandaMS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e2deb1c2-106c-4199-a8be-b023c0068b57">
      <Text>Life ain’t complete without...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c8ca8b6-8404-467c-8e77-b2c4717bb35d">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="211050d9-dd72-4bc8-b912-42b79296b1c2">
      <Text>Our FOrd Model T!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8758b62d-1f05-44ea-97b2-3611d6539be4">
      <Text>MichiGANDERS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3297d8d7-4abd-4690-9a1c-d1744ea7f73a">
      <Text>The Ford Model T!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="d1284725-c4f2-47bc-8d79-5ce66cd397c1">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="adcdbbf4-8cc3-4b0f-a19e-a890bf4dfe89">
          <Text>CHERRY, PERRY, SHELBY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="261cad9f-fc23-46eb-866d-8535d0517275">
          <Text>Daddy got some wheelies.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="a7da7662-74f2-4d49-903f-923814cd39de">
          <Text>MichigANDERS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="8bfb9eef-e101-4f83-a2e8-964fe955eb4f">
          <Text>Willy got some wheelies.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="045091cd-9131-4ba6-bb66-5ae19311c204">
      <Text>WILLY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="30e722f1-30d4-41fb-8e3d-a859d7589a18">
      <Text>This baby’s just a century young.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="86115e8d-0691-4b3e-abb0-35dab2e0b329">
      <Text>Liz, Petey, Shelby, and Jasper hang out by Elk Lake.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f20628b-540b-4356-a749-ad14f23b6314">
      <Text>LizziE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9b202df-db10-4c3c-a9cb-6a03d8ba4c16">
      <Text>Watcha naming your daughter?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27ef3054-2a3c-44e8-9e5e-65e4e413da0b">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e17bbec-c333-4f49-8a40-bd302559b4dd">
      <Text>Lulu! It means “pearl.” And your </Text>
      <Text AdornmentStyle="-1">ibnuki</Text>
      <Text> (</Text>
      <Text AdornmentStyle="-1">إِبْنُكِ</Text>
      <Text>)?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bf11d326-14a9-41b6-b273-28588ddc9bdb">
      <Text>Petey looks disgusted.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb8e015c-246e-4b07-833d-4e4186fdd933">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7fa0b147-1438-4db7-ad17-ac9cd22162e8">
      <Text>Lulu is </Text>
      <Text AdornmentStyle="-1">jameela</Text>
      <Text> (</Text>
      <Text AdornmentStyle="-1">جميلة</Text>
      <Text>). No clue.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63a1af60-f08b-4a6b-bd39-bd821d329872">
      <Text>JaspeR</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="946c8c1f-3904-4ed5-86a1-01555cc942a1">
      <Text>I bet Petey’s got an ace up his sleeves.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6b93ad6-d2f1-4181-8334-7d4c6fcc5d54">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eaa81e16-2eb0-412f-b2bd-eb5832a83195">
      <Text>More like </Text>
      <Text Style="Italic">stone</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="949810e7-5193-4622-afe6-c0dfb9a94cf5">
      <Text>Petey and Jasper hop into Elk Lake, splashing each other.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="50ce0327-41fb-490b-bbf5-7e7e50804ec2">
      <Text Style="AllCaps">Amanda Wayland</Text>
      <Text> (20s, all business) briefly peaks in from a bush.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4420d326-e9ef-42d6-838d-6e2f9f730e81">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2adb82d-fc8c-4e8e-b5df-97ae0097722d">
      <Text>Such a shame a happy family completes this Lake House when it’s missing something. I mean, look at this water. Disgusting. Freely flowing when it should be cooling my supercomputers. The air... too pure to breathe. It needs the spicy flavor of nuclear power. All families are incomplete without pure dread. The Great Lakes do bring out the worst. The </Text>
      <Text AdornmentStyle="-1">Vandams</Text>
      <Text> will burst.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b9e0808-e9d5-4efa-a82a-b6eaf3a4eeeb">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f8dd9a0-3c4f-4787-a8aa-174e10824d1a">
      <Text>We won’t name our son. A rock in Elk Lake will!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6953b7cf-c552-49bd-900a-9cb7ea083599">
      <Text>Petey dives into Elk Lake.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="82279fd2-89a4-4f4f-95b7-e82031f28063">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="a83500b0-b124-48b1-936c-6e386e423b94">
          <Text>JaSPER</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="0adf7a4b-07d1-4674-9d97-5737be98fde5">
          <Text Style="Italic">Jasper</Text>
          <Text>! </Text>
          <Text Style="Italic">Jasper</Text>
          <Text>! </Text>
          <Text Style="Italic">Jasper</Text>
          <Text>!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="52b31877-3f3a-42e9-8cf2-089ee07dd53f">
          <Text>LizZIE</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="3d74b744-61c8-499d-b1ce-4c01112846f1">
          <Text>This </Text>
          <Text AdornmentStyle="-1">gotta</Text>
          <Text> be a joke...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="3f1139be-97a7-4885-b4d1-9aee6618bed2">
      <Text>Petey resurfaces with a heart-shaped, Elk-marked Petoskey stone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8998b969-9386-420a-913e-b493f9b7032c">
      <Text>Michiganders assemble into gospel.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f0a4083-b90d-4695-96b5-fdcea686ae38">
      <Text>MichiganDERS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7294a4f3-66d1-4b64-8145-3dadf7ada7b4">
      <Text>Petoskey...
Petoskey...
The jewel of Michigan...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a62d3389-3a5f-489f-b015-186d583e222b">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5032dd22-e004-4314-93d0-e95116ca2c95">
      <Text>We ain’t naming our son that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="416d3275-6c35-42ac-be4c-41576f15b5f4">
      <Text>Jasper</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="34ac5de5-92a0-4eee-9a54-fef28ffdab44">
      <Text>How about naming your second kid, Jasper?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74c17643-d732-4953-90b2-3fd08e127bbc">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c1e391a9-4581-43f1-9ae0-0649a7819c06">
      <Text>We don’t have to name him that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c693ac5-97c9-4455-81ad-d4a53cb87815">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6ab9058f-e953-4429-896d-a8011ac9ee42">
      <Text>It does sound like Petey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d104321-19f8-4789-a7d4-62240d977350">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6fde7836-0aeb-4e3e-bab7-f4bb8c8c71d8">
      <Text>My name just needs an o and a key-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="096c0b8e-fba7-4a6a-a54f-bca54865c75c">
      <Text>Liz kisses Petey. They join the rest of the family, marching in the Harbor Days Grande Parade.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="21f27f7d-5129-4168-9db9-a89236a406e6">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="88fa13b6-f216-423d-855d-0dfb5df4a8e3">
          <Text>LizzIE</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="718411a4-6674-482d-98ba-f6f2716f8d7d">
          <Text>ISN’T LIFE BEAUTIFUL?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="cf7dda0d-2e88-43d1-882f-a79be98228b4">
          <Text>PETEY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="50e9e2dc-2309-4700-aeaa-f7ee7d823f99">
          <Text>ISN’T LIFE WORTH LIVING?</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="3a41774a-5e14-41b5-8149-f7d51ec2c1a2">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="9c1332aa-08ad-4886-b9f7-70314d773b22">
          <Text AdornmentStyle="-1">VANDAMS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="148ef06c-648c-428e-82fb-76a8ccb3b0d2">
          <Text>LIFE IS COMPLETE WITH OUR</Text>
        </Paragraph>
        <Paragraph Type="Character" id="654b663e-bf7c-46a5-9a46-c897890c6f95">
          <Text>Michiganders</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="7aaab379-f479-444e-a3c1-1663d4b3e015">
          <Text>LIFE IS COMPLETE WITH THIS</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="fb4cc635-1732-4f31-a0a7-cb737e017023">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="92f3ddd0-a3b6-4040-9624-51f87635e10d">
      <Text>CRAZY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b86e5795-3afa-4348-b593-f2683a3353f7">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a945eb4c-753e-42a0-abb8-87356de81852">
      <Text>SASSY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06124577-b84e-426f-b077-26744588a62c">
      <Text>CHERRY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bfdd2147-0700-4637-a7a3-22c91bc204d2">
      <Text AdornmentStyle="-1">WORKY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c9ac81d-e3d7-46db-ac83-404040aa80eb">
      <Text>PERRY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="28cefe98-dbfa-46bc-b05d-7d218cc72d2d">
      <Text>NERDY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ab157d8-fc0f-41e5-a987-39c248220eb4">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="72d8a149-2be9-49f1-acb1-ed5ddd9923ef">
      <Text AdornmentStyle="-1">DERPY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b3b24da5-d4cc-4903-ad9d-8732d8805342">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0da978ec-5353-4114-8bb4-95f01ae94e55">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f006c07-3eb6-4753-913f-e4971a88a540">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b356917f-3719-40c7-a15d-800a5bc63f90">
      <Text>LOVELY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="88e540d8-a410-4aa8-b8f3-626ace854b31">
      <Text>JASPER &amp; Michiganders</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7e7ca645-ff02-41eb-b272-8a3e758cb042">
      <Text>WELCOMING...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1376fa60-4d4b-4620-856c-2129e5bf7cde">
      <Text AdornmentStyle="-1">VANDAMS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="694812d4-3bc5-4de3-89a1-7b5f62e7bee6">
      <Text>FAMILY!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">lIFE IS coMPLETE</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="17683d49-5f99-4150-98f2-644a3bf7af24">
      <Text>Liz’s phone rings. She answers.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4312a1e9-b956-4f32-9738-1cbc88ea58ff">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d453b11c-8df8-459a-8f4c-6f24b98d37ad">
      <Text>No! Please! Life is incomplete without it!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b851fe47-9961-4322-9aa8-a5562f9fd7a6">
      <Text>Liz slams her flip phone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b5f212ae-f4b0-49a4-83f0-f664f6228736">
      <Text>Petey looks upon Liz. She nods. He holds her close.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="536cd71a-f015-4232-acfc-940cdc2d4f7d">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9780151a-20cd-4d70-a7bf-2e735cd424e1">
      <Text>Our house? No </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text>. Rest assured, all that matters is that we have our lives ahead.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66297aef-44a6-466a-aed5-f295a914332a">
      <Text>Liz lets go. She exits with everyone clearing the parade.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d5d7118-4a9e-4b6e-ab87-2122f3cfcd32">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9eb259ba-31f5-42b9-a18d-9d17ba873f95">
      <Text>We ain’t losing our house... I’ve got my life insurance... Let’s trade.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ac08647-4274-47cb-a9e2-7433512579c3">
      <Text>Petey sobs as Elk Lake turns into the Mackinac Strait.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="ff2224c8-4acc-4956-867a-17fd275c56b8">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Mackinac Bridge - Evening</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="5da96831-1e73-4f5e-baff-daeadd78b157">
      <SceneProperties Length="2 1/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DETECTIVE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MACKINAC GHOSTS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">3. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Body of Water</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea63b1bf-24a6-45d2-afce-760620b293e5">
      <Text>Out in the rain storm, Petey walks onto the foggy creaky bridge.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc7baf2b-c7a9-4d4d-946e-c8327e0eb657">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="16c9082a-a1ff-4c15-aba3-950d9a921f87">
      <Text>Every living thing is made of water.
Every machinery needs the flow of water.
All the weather take the heated water.
All the seasons bring the cooling water.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5e847502-5598-421e-aad1-ce6aa2cbb18a">
      <Text>
I bring nothing to the world unlike water.
I’ve brought nothing to the world but tears!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e24705a-1abe-47b1-b3ae-c1099a769cb5">
      <Text>The </Text>
      <Text Style="AllCaps">Mackinac ghosts</Text>
      <Text> manifest, resembling those who died there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="710467a8-aef0-4aaa-ac4c-65d856bec541">
      <Text>Mackinac Ghosts</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ca14799f-4c1a-474f-b0aa-3fe036b058d7">
      <Text>Drink it. Drink the water.
Think straight. Think straightforward.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a3746364-5333-4efd-8403-259d920bb617">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e0cb639f-f4a8-48ed-9cb0-8b1aa5144c62">
      <Text>I bring nothing to the world.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d9c2131-1f38-4cd0-b30b-e2745a03e7c0">
      <Text>MacKINAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a323d004-edec-49c4-9d2b-aa9bf6578d64">
      <Text>Cherish. Cherish this one life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b1182f5-a4f7-4a0a-806f-ebe60c8585d0">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c7d4c310-9599-47a3-aed0-ca9bc1a03614">
      <Text>Just tears!
Help!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="36833490-8118-4974-954e-f773b6bbf0c3">
      <Text>The Ghosts steal Petey’s stone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e0c9ee0-fa89-4037-87b1-ef28f5f8bf43">
      <Text>MacKINAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f202f10-18b8-4892-81eb-b32aa187fd1b">
      <Text>Help? Hell, help yourself!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fff6f0f9-4b0e-4851-bdb7-bf5edaaae2a3">
      <Text>A Motherly Ghost returns with a Petoskey necklace. Petey wears it.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="efaaf29d-b64b-4960-bcf3-ae54235c206a">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="8afd3422-a1d2-49d1-99ce-c3d4798fe68d">
          <Text>PetEY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="46627810-e27a-4eb4-aee0-c8983d71ea7c">
          <Text>I choose life!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="fc38a0b7-19b5-4174-b28d-a610e1fc1db1">
          <Text>MacKINAC GHOSTS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="043523c9-2165-4d4f-b58b-2dfd533f2bc6">
          <Text>Take it in.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="1b9d2bb2-5b14-4188-b0a5-08249a0393c4">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bfa8e3f2-9af3-4dcb-bf01-c7bc1b71ccbb">
      <Text>Drink the great lakes water.
THink pain. Pain you’ll cause.
Happy wife. Baby in sight. Dying ain’t right.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91b6f23a-4491-40cd-9d39-d0a963a8c6e5">
      <Text>MackinAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="dabda508-cd44-4dd0-b4ad-578e930d4079">
      <Text>Drink it. Drink the water.
Think straight. Think straightforward.
Cherish. Cherish light.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0602267e-0104-4bbe-9abe-920c775b792f">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6f1da93a-6d6e-418a-8ef1-89a45ce65d35">
      <Text>Help myself to this great water!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea63b1bf-24a6-45d2-afce-760620b293e5">
      <Text>Petey drives the car away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="81437fff-e1f2-4fe3-a38c-a36203cec0a6">
      <Text>Morning approaches with emergency vehicles. The orchestra wails.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="74f971cc-6952-4d68-b752-8f7637491a81">
      <Text>Liz rushes in with the </Text>
      <Text Style="AllCaps">detective</Text>
      <Text>. She stops in her tracks, kneeling.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8f115da-d90e-4619-b81f-b7c193b68236">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cb62de14-ded4-4df0-a67b-b80b9a1f570c">
      <Text>Life is a complete... disaster...
Life is incomplete without pete-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="39050aed-a8d8-448c-9b79-a0de8331b83a">
      <Text>Detective</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="21fd06b8-806e-45db-bdc1-8b7b936b40b4">
      <Text>we are sorry to report the car submerged under mackinac bridge is identified as yours...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6678b727-d48c-450b-84c8-8cc415b549b3">
      <Text>LizzIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f5b175d-67aa-4ded-a0bd-849c4b2f96c6">
      <Text>And...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="961f5e5a-7433-4bc7-bc62-cbe748225cf1">
      <Text>DeteCTIVE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7b357f53-4d48-4980-9121-f14f17f43b76">
      <Text>No bodies.
Nobody.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d72ebc19-97cb-4ec8-9f63-e6b289f17fa9">
      <Text>The Detective hands the Petoskey necklace to Liz, then leaves.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b2f97e8-2862-4013-b3a8-bc19deebf25f">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="63de5d6e-f4c7-4000-8085-bca4f35e2a85">
      <Text>Nobody loves me like this body of water...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3f4f4793-5a1f-4f2d-9676-29a5be2314d7">
      <Text>Petey manifests.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fb8853e-07c2-4ccc-8d01-c65f35159b31">
      <Text>MackINAC GHOSTS (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="da292368-40ef-4d81-b0d3-7ab4683c3fec">
      <Text>Nobody...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c90c7940-fb39-4d07-9b08-381b21b0056b">
      <Text>LizzIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bcf62caf-69a8-4e5f-921f-ec77dda69381">
      <Text>With my last tear, i’m out of water in my heart.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb2ac63f-2809-49ca-b3e7-b47aae098907">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4971d25d-e381-4167-a949-355105b83ab9">
      <Text>You are my soul.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fb8853e-07c2-4ccc-8d01-c65f35159b31">
      <Text>MackINAC GHOSTS (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="47780a1d-f796-433e-921b-a4cfd38cc037">
      <Text>Nobody...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7427b1e6-f88c-4032-9826-c6fc963c5483">
      <Text>Petey closes Liz’s hand, sealing the Petoskey. Then, he vanishes.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Body of Water</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0441ba7-f820-4ecd-aaea-22711984df91">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7220863f-4550-40f4-a0fb-edf473f228d1">
      <Text>Water is under the bridge, but I’ll never set foot on what double-crossed my heart. Bridges are supposed to unite lands, not divide souls. Our house has been spared thanks to my hubby’s life insurance. But I didn’t mind losing </Text>
      <Text Style="Italic">what</Text>
      <Text> is called home when it meant losing </Text>
      <Text Style="Italic">who</Text>
      <Text> I called home. I just wanna sink like a rock...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="146e192f-c1ea-4f78-8b84-11334fb862a1">
      <Text>Shelby, bruised up, enters and embraces Liz on the ground.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="832cf046-0aee-4245-97c7-20cba678b406">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc6436a0-622d-4e30-847d-cd80f95c5c15">
      <Text>Every rock has a soft spot, like my son...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="17b1bb41-0e8b-475c-a395-ab4028affb4c">
      <Text>Liz places the necklace down. Shelby helps her leave.</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="da1b48dc-a3cf-4bcf-9bdc-ed21a5117b1b">
      <Text>End of Prologue</Text>
    </Paragraph>
    <Paragraph Label="Scene 1" Type="New Act" id="03254032-ba6b-4137-a15f-5226dbf7d214">
      <Text>Act I</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="13" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Elk Lake House in Elk Rapids, August 2019 - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8a75dc57-df67-4dfc-968a-373d7d95060b">
      <SceneProperties Length="3 7/8" Page="13" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CHERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY, PERRY, SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU &amp; PETOSKEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETOSKEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY &amp; MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">4. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Yoopers and Trolls</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3925c769-fd1f-4662-ba42-4beea7327409">
      <Text Style="AllCaps">Petoskey</Text>
      <Text> (11, farm boy in a flat hat) crawls out of his tent. He puts on the Petoskey necklace and mittens. He bangs pots and pans.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2905e4bd-218c-4882-9554-3d2df7d38f07">
      <Text Style="AllCaps">Lulu</Text>
      <Text> (11, city gal in a headscarf) crawls out of her tent and trolls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b288904-0ea1-4660-948f-7511b20342c2">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d445b832-2849-4d9f-a6e8-bbae0e9aac5d">
      <Text>...Petoskey!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46d5b972-a97a-4e92-9c44-6e75edb1609c">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f0c9159-d087-4174-a87a-026eae048ff2">
      <Text>Lulu!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="94edb39b-7f12-4f13-a555-5c8a21494a8f">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="84b1f99a-d5d5-4341-b0ea-1be71bdadf71">
          <Text>LULU</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="a4d31934-dcc0-427d-aad1-c652e0ee4f56">
          <Text>Shut up, Yooper!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="1817269e-253e-4b58-abb8-635a4a9c10dd">
          <Text>PETOSKEY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="26879b02-e2cd-4c0e-86f6-4a9379b01cdf">
          <Text>Pipe down, Troll.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="2905e4bd-218c-4882-9554-3d2df7d38f07">
      <Text>Cherry, Perry, and Shelby enter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="10d9a769-21de-4d20-a2af-577cf8fdcd1e">
      <Text>ChERRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e00994f-5a1f-4ef9-b817-3e3798909cf2">
      <Text>Kids at it again?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d5f8c31-dcaf-471e-bb3d-fe7262f50d51">
      <Text>ShelbY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="505049dd-7f98-4c05-b698-3dfa857239eb">
      <Text>With my daughter, you betcha.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1b78f5d-01ea-4438-9736-d149ecfaf85d">
      <Text>PerrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7074598-5535-4bf7-9016-4376fa179c2a">
      <Text>Let’s be responsible... and place some bets.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bbdfb9e3-1939-4b89-aba3-6e81818cb969">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d061848-ddc0-46d0-8880-06edfe0ecede">
      <Text>Let’s go Lulu! Your inheritance in on the line!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a5b9ed7-2658-4e51-9790-fabb3de4c9f9">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="274bff92-f727-4723-b153-8833cbc65648">
      <Text>Holy wah! Another day to go fishing!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f01ecb60-8eb1-4792-9f2d-a83505db3bc4">
      <Text>LULU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4e3b8d50-4ddf-41b7-a942-fe932a3a510d">
      <Text>Yeah no... Today, we go bird watching.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3cf46395-edc9-47fe-9757-208f3f252867">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="eb877ffb-9560-4461-a809-dec9ae9eb4da">
      <Text>Aren’t you from eh... Dearborn?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5611455d-1576-4012-8b1b-d745d72e1cb9">
      <Text>LULU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="43a3e750-1734-4577-bdc0-d4d4dc7aa82e">
      <Text>I ain’t into deer, you wild Yoopers...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="165b04f4-9c3a-45c6-ae7b-f12d16b5ed56">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f5af0dcd-0423-4f9c-86fd-8807f9995ae3">
      <Text>Under the bridge.
OVer the mitten.
Yoopers and Trolls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="698388c2-ea6a-4cd5-8e33-466cfc7a3983">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="581cd1c4-c621-4301-95fe-d00a6219109c">
      <Text>Eh, crazy trolls...
Let’s go stargazing!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5cf0a55-49b9-4ad9-a705-c0a6ce8db7e2">
      <Text>CherrY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="be5bcdfe-2e45-4b76-87a3-c46bcf4638bb">
      <Text>What about ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text> mosquitoes?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3b08c883-c677-428c-b83f-9dc221957730">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f2655c79-8dad-4eb9-b9e1-38dbdc3c0b22">
      <Text>Let’s just watch </Text>
      <Text AdornmentStyle="-1">WCMU</Text>
      <Text>-TV!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e49df76d-8fe0-4318-9701-356d63bcee44">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="536612fc-9542-4b8d-b512-27deefe9ed44">
      <Text AdornmentStyle="-1">WLUC</Text>
      <Text> is up there!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8f2b003-b490-4a4c-9e9a-cb7997bb6734">
      <Text>ChERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="349358dc-ad46-4933-acd2-97a902097ee9">
      <Text>Wood-tv 8 is better! (mosquitoes!)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33300aa7-146a-4bbf-9d1c-8f4d3ef0cb0b">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="90ec0598-14d0-4262-84f6-dff33b6dc6e6">
      <Text>I will bite. I am down to go kayaking!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15fffbfd-dda0-440a-89fa-86df0faa3c28">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="97e05acc-c4c5-47f0-9f8f-d3081e36a604">
      <Text>Under the bridge.
OVer the mitten!
Pine river, the fastest in Michigan!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1ab03339-cac9-4f36-a7fa-ff9f77a068e0">
      <Text>Petoskey draws his water gun, but Lulu sprays him first.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="85f8e729-824b-4b60-8e4c-435b3b24b86e">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="8b794efd-caf4-4167-9999-c36d937a8d49">
          <Text>PetoSKEY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="9546c2ab-b283-4f04-a47b-ffe1290db3f9">
          <Text>Attack!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="61c532fb-b6d3-4c69-a347-349b2f92479f">
          <Text>Lulu</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="5c753ad8-8deb-4ec4-9650-4ded40331203">
          <Text>Too slow!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="c07ca9db-ff20-4e4b-be20-a79124a6451b">
      <Text>PetosKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d7950faa-f260-46a7-834c-f78168129fef">
      <Text>I’ve got backup!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a01bb437-c8f8-4096-ba62-e28fe10feffc">
      <Text>Cousins</Text>
      <Text Style="AllCaps"> Jacob </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Jacobowitz</Text>
      <Text> (adult actor), Twins </Text>
      <Text Style="AllCaps">Liberty</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Bailey</Text>
      <Text>, and the </Text>
      <Text Style="AllCaps">others </Text>
      <Text>open fire (water) and ambush Lulu before retreating.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bd2aca3-0f42-4e93-82fc-88d13d23226a">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1b5c7de4-0b89-4df2-8677-9b9a71a9a0fc">
      <Text>You will never stay dry!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1b5c7de4-0b89-4df2-8677-9b9a71a9a0fc">
      <Text>Under the bridge.
OVer the mitten!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4a4033d-3872-472e-9da6-12b47d7179c0">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2fd9dfb4-8427-4372-8714-e4e681c9b89d">
      <Text>Thank you, cousins!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ca297756-9cc5-4591-81e7-19e2b311851c">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ef5c3406-3dd5-4313-8920-a45545a87dfe">
      <Text>It is a sin to target your favorite cousin.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1478fce5-8170-4fc4-9d5f-6e28f8e538df">
      <Text>Jacob hands a towel to Lulu. They hug before he exits. She dries up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bd2aca3-0f42-4e93-82fc-88d13d23226a">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="10ceec0a-b076-4555-861a-4c90488375e2">
      <Text>(Repeating)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b00e5c52-ad0e-4fd1-970e-35dfdd8671da">
      <Text>YOopers and Trolls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f966809-de86-4830-a69d-17a02cfc2fdc">
      <Text>LULU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="11bcf359-3906-4c0d-a064-e5a68599d17c">
      <Text>Holy crap, I hate </Text>
      <Text AdornmentStyle="-1" Style="Italic+AllCaps">hate</Text>
      <Text Style="Italic+AllCaps"> </Text>
      <Text>camping with you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9eedd2bf-a54c-487d-874c-0904206c4f73">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6d6988d1-399b-4f0d-9672-63611ae843b2">
      <Text>No one likes your hip hop trash.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61a20149-5ef2-4de6-b8c6-6ac1940cd0bb">
      <Text>LulU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f85222a3-0130-480a-8b18-373966929f14">
      <Text>Take it back, country boy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74b8aa81-e3e7-4db1-b1bd-b4269ee1a22b">
      <Text>PetOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6adc42e1-6f0e-45fd-a5bf-2881adde25b2">
      <Text>You first, city gal.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54151c6e-c68d-407a-9efa-844611674158">
      <Text>Lulu &amp; PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="afa784c5-ebdc-401c-9ed1-4511809feae4">
      <Text>Another Harbor Days...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9eb7e27b-248a-4f07-bca6-f1ddc6a13ff2">
      <Text>LulU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="43b10af0-fd7e-4188-9e02-bde9ce30ea3f">
      <Text>...with this wild yooper...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7934f29c-5038-43a5-a558-5c9669b311a2">
      <Text>Lulu and Petoskey wrestle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d48aad2-2be7-4462-a45b-ed4c82a3a048">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0f994c66-90f9-471d-9324-11bb372b28d5">
      <Text>Stay under the bridge, troll!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bd2aca3-0f42-4e93-82fc-88d13d23226a">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="669af6a1-5475-4f4e-a3f0-14c4e63b2166">
      <Text>Yoopers and Trolls form a bridge!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82a5b31e-b9be-4a6f-b8af-204a7bfb3846">
      <Text>WillY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="26fc6f23-828b-4589-a165-f5decde99a99">
      <Text>Stop fighting!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Yoopers and Trolls</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b21cba56-d095-4603-8b57-2286ff66df42">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f778b6ee-dce3-48b6-ad19-0417122d579f">
      <Text>(Narrating)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57adb668-5455-49cd-a0bd-da48653223bf">
      <Text>If my rock and his cousin Lulu ain’t fighting, I’d assume aliens have replaced them. The whole family’s weird. There’s cousin Jacob </Text>
      <Text AdornmentStyle="-1">Jacobowitz</Text>
      <Text> who is making it on Broadway. Then Liberty and Bailey. Twin cousins from Hell... Michigan. I’ve heard from my in-laws they are angels.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b08b0a6a-5d76-4f09-aa51-99a9cd95b723">
      <Text>Liberty and Bailey go buck wild and chase everyone around.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f31f2c4-8d8a-4d81-88ea-3d171f5436e7">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4c1ddf3-315d-4fc4-8e83-3ea885492c08">
      <Text>I don’t remember the other cousins Petoskey mentioned. They got many cousins, aunts, uncles- I wish I could meet them all but that Mackinac. It’s a bridge I cannot cross. Its watery depths crossed my heart and made many hope to die.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9b51b2c4-d295-4def-b054-c4eda6b93a25">
      <Text>Cherry drives in. Petoskey sits. Then Perry takes over and gives him homework. Then Shelby and Lulu shove Perry and Petoskey out. Then Granny Milly respectfully takes over and lets him in the car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="97b40690-f875-46a0-8022-0603bcd0b7eb">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4c1ddf3-315d-4fc4-8e83-3ea885492c08">
      <Text>Fortunately, my son is able to. His aunties have no problem taking turns driving him from the U P to the L P. After Harbor Days, Granny Milly drives him home or insane. He is said to hear a man’s voice whenever they cross-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="90d0e8c2-f56a-4a7a-9d22-1328e006cc93">
      <Text>As Petoskey naps in the car, he awakens to Petey’s song.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fa329934-a8e0-461a-9810-b7c96c021c11">
      <Text>Petey (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="142d2340-c4fc-4e95-82fd-ab360e72b05b">
      <Text>Wakey </Text>
      <Text AdornmentStyle="-1">wakey</Text>
      <Text>, son...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d27b40e2-ae54-4145-bfce-d23e4d7ed32d">
      <Text>Jasper takes over for Milly. He drops off Petoskey in Skandia. Liz sees Jasper become his godfather.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbaf0b22-bc0b-422f-812a-5ed545dd8e62">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba64ae48-9adc-40a3-89c0-f5ce3e65c701">
      <Text>Whenever Milly wasn’t feeling well, Petoskey was Jasper’s problem. Ugh, boys...</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db3a9f1e-f41c-4a9e-9a0e-819fec875793">
      <Text>
Then the real problem came in 2020. We didn’t see it coming. No longer saw another of Milly’s inventions from automatic toilets to magnetic pet hair removers. No more crazy ideas. </Text>
      <Text AdornmentStyle="-1">Grampy</Text>
      <Text> Willy canceled family reunions in 2020 to 2021. He needed to grieve alone. I worry for him and the Lake House. I’m thankful for our home, living off hubby’s life insurance. But life still take lives. I needed to see everyone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ce514daa-0ef3-4fa3-9cd4-5f57fee852dc">
      <Text>Petoskey looks at photos of Milly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="89013f58-ad53-4ad6-a06e-ad0883d627b8">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62fc3626-dd61-4b34-9b65-63fd74d951b8">
      <Text>Son, I know how much Grammy Milly meant to you.
So, would it mean the world if I went to this year’s Harbor Days? August two </Text>
      <Text AdornmentStyle="-1">ol</Text>
      <Text>’ two </Text>
      <Text AdornmentStyle="-1">two</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94336a25-2d1c-42c9-8da3-2ae6713f7cda">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54e5c3d3-79d3-4430-8be7-df4f57c09420">
      <Text>You’d cross the bridge?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6515b1a4-3c26-47aa-a814-e861d19c9c9c">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a8b5dd9b-af43-4765-a037-608360b5e5d4">
      <Text>Nah. We’ll take the long way through Wisconsin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54ac0807-d8b6-4eff-b125-5ecd2d45d305">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3da2b0ec-a51a-4d37-aa68-8882ed4529dc">
      <Text>That’s not fair! Everyone’s cheesy there...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="526fb537-9f50-4c72-bf81-112031300724">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b65ac22-2a5f-41ad-b77a-1bee85aa6721">
      <Text>Let’s get a </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">moo</Text>
      <Text AdornmentStyle="-1">oooove</Text>
      <Text> on. For Milly’s sake.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4e667da8-f441-43d6-bc69-ff92c08aa55f">
      <Text>Liz and Petoskey exit.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="5594b819-4a2e-45c7-ae33-47dac613b1ca">
      <SceneProperties Length="1/8" Page="16" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Int. Elk Lake House - Living Room, August 2022 - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8a75dc57-df67-4dfc-968a-373d7d95060b">
      <SceneProperties Length="2 3/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY &amp; MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY, MILLY, WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">5. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">It Would Be a Shame</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2e2b1dfb-4314-4e8f-a348-a5e84fdb257d">
      <Text>Willy stares longingly at a photo of his late wife Milly.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ad315372-f9ba-46ac-84dc-a50b415d93fb">
      <Text>Amanda Wayland knocks on the door. Willy goes open it, then slams it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c38ea8b-1f89-4875-acc8-77be68898d91">
      <Text>Wayland</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a5c4734d-a578-4ec1-b579-afa65cfcb978">
      <Text>I need your Lake House!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="13d18335-55e5-4a0d-97e0-2cd8bca33d4e">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="db90e4b2-1f23-4ebf-9c85-8d157172796d">
      <Text>You damn vulture.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3567fc66-0efb-458f-83f0-21e74e82662e">
      <Text>MiLLY (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="59cb508e-12b3-4e60-b317-ad8afddc3326">
      <Text>Who are you calling a vulture?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="47984fa7-3696-4989-a7ff-2b3ff862c692">
      <Text>Willy opens the door again. Wayland nabs Milly’s photo and sets it on her tablet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8150871b-66b7-4cb8-80e3-042cb33161da">
      <Text>WaYLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7c82725b-8f73-4f2f-ae17-391bf6bb83a1">
      <Text>And you need your wife back.
my name’s Amanda Wayland of Turkey Ventures...
and I can bring your wife to life!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bd7ef54-e468-404e-86fa-609ffa49ca37">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bed31fd0-a636-42fc-b3fc-9cc3e4bb9759">
      <Text>She did not believe in alchemy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f70e1d12-64e9-4ddb-a92e-2d12103b0aba">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="50a86a84-fe61-4eef-a96a-bbb9c53b463b">
      <Text>This is not alchemy.
It is technology!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="230f8d50-5026-47c3-a56e-fd150f516d42">
      <Text>Milly shows up behind Wayland.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c778183f-41aa-4d76-86e0-5a28f80c1766">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="670b5f70-fd6c-4427-ac7d-700d2ef72f0f">
      <Text>So proud of you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a3f4de18-216f-4a7c-a79c-c7a320a34efd">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="435b927a-8d65-4162-83f1-4d9d865ae0c4">
      <Text>(Raising the tablet volume)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ab2817e0-8991-48d9-b427-7ecadb9d1c40">
      <Text>You heard that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15077605-680f-45fe-ae7a-516c6367db01">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9cd215a6-f67c-4da8-b632-3aba67f79a89">
      <Text>I love you!!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="425f63b0-33da-410d-b97b-fe357f94558c">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b2cae7fc-4d29-4404-8554-b90fb8ab3763">
      <Text>I’d love for you to let me build a data center by your lake.
so, she can get the water she needs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e0e7ac7-d38b-42a9-8ccd-3487f9500364">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c1715834-f098-4bde-8694-b60dddfdc9d7">
      <Text>Do not bring shame.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ae49778-3f1d-4492-8398-ebbd74ebb699">
      <Text>Willy looks at the disapproving violinists in the orchestra.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74ace816-01ed-4c2b-ace8-1d8ad46dc2ae">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="649782af-6030-43b3-8681-ceae6f56365f">
      <Text>Don’t be ashamed to say “no.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="03bde0a3-0afb-458e-8216-dc204f76fbb0">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c50fda60-5018-4f6a-a312-34f8e4daa3c2">
      <Text>No.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e36e6ded-f337-4005-b00f-bc857600c054">
      <Text>Milly disappears.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9c398926-879c-4573-8fc8-63eefabcfddc">
      <Text>Wayland expects it. She “respects” his choice. Before going, she nabs a photo. Outside, she sets it</Text>
      <Text Size="10"> </Text>
      <Text>on</Text>
      <Text Size="10"> </Text>
      <Text>her</Text>
      <Text Size="10"> </Text>
      <Text>tablet. Petey enters the home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8dc2443-39a7-451c-8c2b-acb5ca259eeb">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c13b3bb9-cdc5-47ec-a0d8-a31ed83f0a33">
      <Text>Wasn’t my life worth more than my house?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e519e66e-cdee-4b21-9b76-61345f62e7bf">
      <Text>MilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1ca06f36-63d9-411a-8bc0-30cccc20d72a">
      <Text>It’d be a shame...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a545533-8759-4ce1-8353-ee63d9f79d21">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7a69d6ed-7975-40be-be35-5d4795074d94">
      <Text>Wasn’t my breath worth more than some lake?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bddcf31-ef0a-481c-8030-c0e87ffbf727">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a86b2c24-0a06-49e1-a7f0-4dcd230c8625">
      <Text>It’d be a shame...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f312d657-d643-4ffa-baad-84401f9ccfa0">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="45225bbd-90e9-48a9-aa8e-aad85562b8c8">
      <Text>Wasn’t my heart worth more than these rocks?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a39fcb7d-39b7-49fc-bd86-10a0d011e34f">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fcb80c38-9acb-4058-a0ff-399408128eed">
      <Text>There is no shame in forgetting them.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ff0b8143-8354-4a18-a356-85a1de2df9aa">
      <Text>Milly joins Petey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="080afa13-dfcd-41c0-acee-12bc499c5233">
      <Text>Petey, Milly, Wayland</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="007fddb5-5fcc-470a-abaf-9a8717cf5826">
      <Text>Shame...
Shame...
Ashamed...
Only shame...
Nothing stays the same...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74a89d2b-0566-4bb0-9017-2c6db446c4dc">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7b396199-f3ba-4c6a-a43d-a9d417ad7cb0">
      <Text>It would be a shame if I chose the house before my family!
It would be a shame if I make...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9630f972-2bfa-4e09-a728-11245f2aa650">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="10e0fb76-03e6-43e9-b3f9-69dd89f6d890">
      <Text>Bring back your wife!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8731e0d3-80e0-4005-91fc-b77dd037672b">
      <Text>Petey &amp; Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0a3501eb-5213-4fae-bc03-fd1234e8857e">
      <Text>Don’t be ashamed!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d942f7af-ae8e-4f41-8b40-bd2659a09d9a">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f8a76117-d3f9-4064-a2a9-70cbbaafd58f">
      <Text>It’d be a shame if I make the...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05e9fba0-b443-4faa-8b49-92212d0984d0">
      <Text>Petey &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0bf5281b-903f-4c36-9726-a2febb28a2c3">
      <Text>There is no shame.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3821f22-8b38-4f4b-8331-bba8de76a127">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="416434b3-096c-4665-bb7a-98d9119cd42b">
      <Text>Bring back your son!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="758b89b2-c926-4051-b2ef-180c5074e38b">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c5aad746-132c-4d96-9753-1427897bee7e">
      <Text>It’d be a shame if I make the same...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="31d885a5-4d99-49ef-a75d-f02317754c23">
      <Text>PetEY, MILLY, WAYLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="063e842c-16c7-4f1b-ad8b-d6aef4bd25bf">
      <Text>Nothing stays the same...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="dbaa8750-bebe-4667-84ff-eb246327f912">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="e3004508-d458-4f22-952f-b58ed26543f4">
          <Text>WilLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="2b195340-836b-4c79-a1a3-694982eca083">
          <Text>It’d be shame if I make the same mistake...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="50829ae5-4766-4a7b-9b5f-cc0bcc183f18">
          <Text>WayLAND</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="b0283dcd-3479-41c0-a38a-ac20096a05f8">
          <Text>It’d be a shame if you made the same...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="32ad1c47-5d6d-40d4-bb2d-7124327c1d56">
      <Text>PetEY, MILLY, WAYLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="06cd2717-e1b5-4a06-8d39-98d8b5910616">
      <Text>It’d be a shame!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="df868c92-dacc-4612-970f-0db1c8a67acd">
      <Text>Milly and Petey vanish before Willy hugs them. Instead, he holds a tablet, displaying a contract.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">It Would be a Shame</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="19" Title="">
