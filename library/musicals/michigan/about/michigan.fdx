<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20260824T113304" id="b2cc9d95-f925-4d8b-97ad-03463d8a83a5">
    <XRef DateTime="20260815T054842" id="3c1e211b-b305-451b-8468-b316e06811aa"/>
    <XRef DateTime="20260815T054948" id="579954c4-fa36-4223-aabf-f3ce7cb4cb3a"/>
  </DocumentRef>

  <Content>
    <Paragraph Label="Scene 1" Type="New Act" id="03254032-ba6b-4137-a15f-5226dbf7d214">
      <Text>Act I</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Elk Lake House in Elk Rapids, August 2008 - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="93d78288-cd47-42a1-bc05-4a7a4a908f37">
      <SceneProperties Length="4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">1. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Overture/The Mitten Song</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79621969-d8c4-48e3-8a84-1fee599aa112">
      <Text>In the wooded backyard are tents where the </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> family is camping next to Elk Lake’s rocky shores.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79621969-d8c4-48e3-8a84-1fee599aa112">
      <Text Style="AllCaps">Petey</Text>
      <Text> (30s, man who’s seen better days) crawls out of his tent. He puts on mittens. With a melodic yawn, he bangs pots and pans. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b381cf5-6334-45bc-83d8-d4ac4aed8158">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="aee1e9f7-332a-4c33-aab4-da31549b1a92">
      <Text>Wakey </Text>
      <Text AdornmentStyle="-1">wakey</Text>
      <Text>, sun.
Let’s wear our mittens
and cook ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text> eggs with lotsa bacon
for our godsend,
Michigan!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ef686414-65c4-47fe-b18f-a0e378ba4214">
      <Text Style="AllCaps">Lizzie</Text>
      <Text> (30s, pregnant narrator) reluctantly crawls out of Petey’s tent. She’s one decibel away from smacking her husband, Petey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9bda088c-fa19-4ffd-9542-7d0a989ef2ad">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e308b012-70ac-4421-8aa2-4ea463882494">
      <Text Style="Italic+AllCaps">Slept well, hun</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="238fcebc-fec6-40be-93f0-bd789fcd8499">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Overture/The Mitten Song</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="76bbb514-e185-421f-ae54-f5cced7d3e2d">
      <SceneProperties Length="6 6/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CHERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY, PERRY, SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JASPER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VANDAMS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY &amp; MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">2. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Life is Complete</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74596edf-3b0a-411c-a645-60dae77421f2">
      <Text>Lizzie</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8fe9e75e-f694-4c92-8246-46a415dd8682">
      <Text>That’s the love of my life.
But every morning, he’s public enemy number one-
What i meant to say is </Text>
      <Text Style="Italic+AllCaps">Petey is family to everyone</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a7d74bd-3e41-4880-a443-03302303cbbf">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="755df529-90fc-4fbe-a4f9-9d7d8612ab03">
      <Text>Get ready for it’s...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93cc2aca-6935-449e-8a8e-ed18f8aeb77d">
      <Text>Shelby (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2e407867-7c28-4872-a7eb-3850bed2b10a">
      <Text>Labor Day!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1528f42-9724-4269-9199-5bdd9c62ea25">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="84d3c738-3cec-4a47-9063-be766bddd7a7">
      <Text>What...? No.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="17433ea8-ea39-49eb-bc56-7c9a47003af0">
      <Text>Perry (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0bd20fe9-0583-432f-af11-ff8dd2004b51">
      <Text>April Fools!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc93fdee-224a-4f4c-8927-d147d691d25b">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d2314492-426f-45d9-a80c-c418ffeac3a0">
      <Text>It’s August.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b8ef3c12-8c00-4f61-b25c-e14f06045531">
      <Text>Cherry (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b4df37af-87a0-4d4b-a50e-e5a6a3bc3dea">
      <Text>Happy Halloween!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4c6389d7-93f4-4a71-90f6-775b1ae40ac9">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="15326e2e-016a-4e2d-944a-ea81cb070519">
      <Text>We’ll wear costumes, but it ain’t Hallo-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a2ed30b-6da8-4d41-a36a-34ce8dde8393">
      <Text>Cherry, Perry, Shelby (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fef771cc-a8ec-4fd5-abcb-f3f2893a9b09">
      <Text>Merry Christmas/Happy </Text>
      <Text AdornmentStyle="-1">Hannukkah</Text>
      <Text>/Joyous Kwanzaa!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ffb4648-f3ea-46de-b3fb-24e7d0120dba">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c543af21-1adb-48ce-b7ea-07abae7ae315">
      <Text>Jesus h. Christ.
Let’s include Boxing Day while you’re at it!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aad15214-0e2b-4ebf-a0b4-6fe8db64ec8b">
      <Text>Milly (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="26f99cac-4b63-42b7-b07e-abf438d6f619">
      <Text>Petey, don’t be celebrating false holidays...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="baa5d0fc-da1e-4030-a632-47d78e5fbbf1">
      <Text>Willy (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b57f0b38-860e-4609-8856-95533dbb1790">
      <Text>We ain’t ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text> darn Canadians, eh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2335e5c3-2f17-4a52-a9a7-6251f10dab23">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4a278f41-ce94-4a8e-98ff-66afd5046676">
      <Text>Ma, pa, remind Cherry, Perry, Shelby what week it is.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="d8b029bb-510b-4a96-9387-3f011fc79c8d">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="bd8428e7-2569-4dff-8761-9b7a22fca712">
          <Text>ChERRY (V.O.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="c293281d-7558-4c1f-95b5-9cbc5d6cb729">
          <Text>We’re messing with ya, pipsqueak.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="a1660ae7-d84e-4d1f-8cc6-e6ce22f114f2">
          <Text>Perry (V.O.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="767e8d7e-aa51-422b-a6b8-50f733407197">
          <Text>Seeing you nerd out is sorta hilarious.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="9a174252-c653-494e-9a1c-38b476d6d9e3">
      <Text>Shelby (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e12d492e-6b64-463c-908e-2415b1122e4a">
      <Text>Your singing sucks more as the years go by.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="455e934a-36ea-4891-b4e3-03be52dba9cd">
      <Text>Lizzie</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e76561f-7278-42d0-ac36-e340b9415ec7">
      <Text>The days of bullying your brother is over. It’s my time to shine!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9246c715-baad-4ffa-bbea-2b847d60146c">
      <Text>Liz holds a hand to Petey’s face.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18611aca-e4fc-4690-a820-d5b44d3fcd02">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d520f1c-c525-4dc8-8428-679df43655da">
      <Text>Eh </Text>
      <Text AdornmentStyle="-1">eh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">eh</Text>
      <Text>, talk to the hand.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f719c0f-6359-4f94-8851-10a5951ea345">
      <Text>Petey puts his hand above Liz’s like the Michigan peninsulas.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="6ec0d104-9b15-4043-af8e-71cc1fe4c8da">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="982d7b37-e106-4645-b01b-2507b4fadca3">
          <Text>Petey</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="8f29d340-b138-4503-a81a-cfe7ffc67f37">
          <Text>Michigan, it’s Harbor Days!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="5108a73f-0d1e-4fb0-8d3a-4c58b9549ba2">
          <Text>LizZIE</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="a21d3722-00b2-41ca-a820-7bf1ccb21b37">
          <Text>Elk Rapids, It’s Harbor Days!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="eedc3177-9093-4355-a556-b56b80f24e8b">
      <Text Style="AllCaps">Granny Milly</Text>
      <Text> and </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Grampy</Text>
      <Text Style="AllCaps"> Willy</Text>
      <Text> are lost, wandering in the audience.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="6180e28a-b0ab-4233-8474-dbb1650af4a5">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="636f26ac-bcb2-4adc-b34b-ecc3e699cd6f">
          <Text>MILLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="1262e70e-a1ef-4322-88de-fed7955155fd">
          <Text AdornmentStyle="-1">Grampy</Text>
          <Text> Willy.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="b6e06daf-a22a-4705-80b6-32350debbbd8">
          <Text>Willy</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="42518579-1731-4304-9f66-ddec760dca7b">
          <Text>Granny Milly.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="e44e1e89-6517-4f19-8c8e-893558f7a730">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="7db5c6e6-c7b3-436c-996f-7a597c371a03">
          <Text>MILLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="0eb4e970-a8a8-407c-a9d1-7d68fa4efbf3">
          <Text>We’ve got company.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="d91358bf-8528-4898-b3ff-fecae701c4b3">
          <Text>WILLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="21989546-7234-4079-8623-aee3aafd1755">
          <Text>Real good company.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="c888386c-362b-4fa5-bd72-e3f1d9915bdf">
      <Text>Petey and Liz wave at Willy-Milly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b278cd66-b9db-4371-acea-3975bf8dad58">
      <Text>Willy &amp; Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="afb1c5ac-9e54-4017-bc9e-f1410cd791cf">
      <Text>Isn’t life somethin’?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="70a14b1d-8fdc-4619-b7ea-55270048ecd4">
      <Text>Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fdcef8fc-4b86-4999-8511-78d459e84ac8">
      <Text>You have come a long way, friends.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b0982eb-f28e-44dc-8868-9097a7bf6dd0">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a0c702cb-29dc-45e6-9168-aa62df29fa89">
      <Text>To the greatest bay in all the great lakes!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="55dca278-4621-4902-9d34-9129071f43f5">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1ca5fa8d-3802-4bcb-8224-e66351608619">
      <Text>Baked your kids fresh cookies,
Make yourself comfy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2e36146e-beb4-4c42-8c08-bf56a5948ea0">
      <Text>Milly hands out cookies. Willy remove his shoes, revealing his clam-covered feet. The pit pukes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e2d3c40d-0851-4aa4-9af9-db0740ff30e9">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b2f22874-6a33-4b34-8f3c-6253cb03e3c4">
      <Text>Emphasis on feet!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eae13a5a-8b7a-4685-92a6-36d79a01d7b4">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="90a2ef29-7756-4bb4-ae73-cdae614dbae4">
      <Text>Ugh! You’re scaring the guests with your clam feet!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1557a2f1-82d4-48dd-b934-c99de497b693">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4909de34-ae41-4f3a-b9ef-421c1c00e1a7">
      <Text>I’ve been working out. My feet have mussels. M-U-S-S-E-L-S? Get it?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="baf90134-3260-489e-9a9e-9e9285f9e20b">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f8225c50-c5bd-490a-9dec-df7b94f52bd6">
      <Text>...your dad jokes are getting old, Willy...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a07b59ee-83b6-4371-8618-775677a0eb26">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d0feb90-9981-4016-882b-23e0867a9a36">
      <Text>Not as old as you, mama Milly...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b484870-a234-4ef7-a774-83959a639e28">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="44aa32e4-95b1-498e-b20c-6874d975a8a2">
      <Text>Shush! The guests are gonna think we’re Midwest silly instead of normal silly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e9352c7-24f6-4ccb-9811-6cb1e27a0c35">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1d60e6d7-109f-4dd1-ad47-718e68e71085">
      <Text>Ma! Pa! Who are you talking to???!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c5fa3e4-9db5-439d-8ac4-f7f7bfd03738">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2b497e0-798d-4602-aad8-3d0e047b7ffd">
      <Text>You should put ya parents in a retirement home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="014bf81f-389b-44d4-a961-56d339048b69">
      <Text>WillY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="867db046-3e9d-4a5d-89fe-1c80690e5d51">
      <Text>Our hearing aids heard that! Maestro?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1ef29792-6a57-4bec-9354-166997231390">
      <Text>Willy-Milly nod to the conductor.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="48a96cff-7d60-43e0-87e1-cb63b3210113">
      <Text>Willy &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="538d21ed-2a55-4831-8f7e-9f833de30097">
      <Text>Life is complete with your crazy family!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9a50caa9-ca59-4a82-b4c1-f0bae066934f">
      <Text>The three </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> sisters - </Text>
      <Text Style="AllCaps">Cherry</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Perry</Text>
      <Text>, and </Text>
      <Text Style="AllCaps">Shelby</Text>
      <Text> (pregnant) - run out of their tents and chase their brother, Petey. They catch him.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="693fd771-393f-433e-9af9-623609622591">
      <Text>CHERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="efdc06df-6ba0-4366-9cc4-777bac2a50c7">
      <Text>Hey Lizzie!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="67f5f613-a7f6-4779-92c9-ed3c7f09d85e">
      <Text>Cherry and Perry give Petey a wet willy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4049ade2-8530-4d8d-a33e-26779afebf97">
      <Text>CHERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e275d2c0-7dcd-4ecd-b241-efd1fef71b7c">
      <Text>Wet willy!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e808d97-1c67-4866-9b65-de97b528d2b2">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e0a329f0-9a70-4909-8b32-e8ba82d7f232">
      <Text>Ah!!! We’re full grown adults!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b663d8c5-a524-4567-ba33-058e29007943">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4f69af47-c920-4728-abf8-c23b14f45190">
      <Text>Nah dude, sisters always sisters.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a81baeec-3fa8-46a4-8c8d-a3c8807f2bc3">
      <Text>Petey frees himself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06428db3-29dd-4ff4-8d15-d1e582482d3a">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="155c6b77-da5a-48f2-8e99-b1b6602f74f5">
      <Text>Go make your dumb costumes, Cherry.
Play with your lab equipment, poindexter Perry.
Where is your weird husband, baby sister, Shelby?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4dfe4204-e06e-4fa9-974b-c10fdb387764">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a0d1892d-6a1d-4ede-bc82-8fa8412d0385">
      <Text>Did someone say, wet... Uh...?</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="8f026da7-1a63-4c9b-8cbb-ff43e279bb65">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="eedadd19-f249-42f8-8d3b-d5c1c18e4153">
          <Text>MiLLY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="14469e56-a27a-482e-8e85-4554ca646848">
          <Text>Willy!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="2e03203d-5ce3-4249-a353-731d4f9bf216">
          <Text>WILLY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="d91c7de2-189b-4727-8578-5cfe01a47440">
          <Text>Milly?!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="6be502b9-6f10-4b10-9acd-562efcae7953">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fdbc687c-0285-44b9-b48e-cfa612355000">
      <Text>No more singing Mitten Song and it’ll all be over.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86fdda10-3677-4c87-bbf1-c3cbde757b2d">
      <Text>PeTEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a336f426-c0fa-4cd1-9108-ea5c605d2c41">
      <Text AdornmentStyle="-1">Nevah</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3571c3cb-5d84-41f0-ac95-e6bcb437e2b6">
      <Text AdornmentStyle="-1">Vandams</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="77c9cbbd-b4b8-492c-8d1c-6f9da4701862">
      <Text>Life ain’t complete without...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a30238d7-aec0-427c-94c4-1934d9fc5047">
      <Text>Willy brings out the Ford Model T.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a0193eb8-f39e-4c31-8f34-1a8193c0bd05">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4efd8769-b63e-465e-81ee-a5ceba778ab6">
      <Text>The MOdel T!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="5beb1bfb-f194-4a9f-ab8d-1bfb60778beb">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="fc245ee8-0fb1-4a5e-a713-a2b54a390812">
          <Text>MiLLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="eca47d0f-6109-46f7-92c6-a7ff425701e0">
          <Text>I’m gonna teabag you, so help me, willy.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="9565be37-cfa7-49ba-9956-d661510d1cab">
          <Text>ChERRY, PERRY, SHELBY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="fd40bf82-6045-4164-a4a8-63882cca7ac6">
          <Text Style="AllCaps">Daddy likes his wheelies.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="9fe5bcf5-e808-400c-b205-c1a2dee684f8">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="dca0f213-a6b9-44e7-b8c4-de50bea0ab4f">
      <Text>Life ain’t complete without Milly!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d812e975-09eb-491d-a47c-7df9b0458d9c">
      <Text>CHERRY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e3c96162-75cb-4ae4-8a36-1d37d647ff28">
      <Text>Cherry!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a72569ae-47f6-4377-8bd0-746f45c61a3f">
      <Text>Perry</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="83bf8ca5-14e8-43ec-acfb-e7f3290d4365">
      <Text>Perry!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f953b7ac-08e4-4ca5-87d4-4eabe18fbd2a">
      <Text>SheLBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="37eab0a7-e8b2-4979-99d8-5505543dd369">
      <Text>Shelby!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bc1a53f5-228e-4f10-a836-8b4db823cc9c">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c9400cd6-69c7-4536-81d3-7659be37d0a1">
      <Text>Petey and his bestie...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="758d5cd9-7431-4fea-88bb-45745b05f1fb">
      <Text Style="AllCaps">Jasper</Text>
      <Text> (30s, Vietnamese man) struts out of Petey’s tent.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="7615e9f9-4a92-4a05-896c-4d9433fe4a77">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="8698f690-e559-4361-bda9-7c18846fddb0">
          <Text>Petey</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="aa1fd338-d97c-4ce2-bfc7-e73923723c05">
          <Text>Jasper! Got banh mi?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="a1a2e2ab-d737-490c-9ed3-3f6c1690383f">
          <Text>LiZZIE</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="7ba96e10-f5f9-4eea-9273-e79526b30b31">
          <Text>Liz- Excuse me?</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="a0927b43-7dc9-4105-b57b-de53724850ad">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9749218a-8564-48d7-a1ed-d65bc5a8d6d4">
      <Text>You know Jasper Tran, we go way back!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2cd7d7bf-889b-4ee2-97cc-9fbce5c95774">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0f0c8bf-796c-4e8f-8650-d921426d4995">
      <Text>To the stone ages.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8bb6184a-af77-42aa-b95d-a93b7ecb4441">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca1f0ed7-e446-41a8-ac4d-d323ffcfbc35">
      <Text>More like stoner ages, amirite?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34d620aa-7714-4b2b-ac60-85f229d35dd8">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ce4ee07-66ad-4df7-bfff-a8dd1fbb6a07">
      <Text>You two always being high, reminding everyone you’re childhood besties </Text>
      <Text AdornmentStyle="-1">yadi</Text>
      <Text> yada...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e12e855-2590-4f5c-b4d6-c061496bc415">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="548a62c5-bbea-45f7-8d02-92757adbf1ee">
      <Text>And that my fam owns the Viet restaurant, BANH </Text>
      <Text AdornmentStyle="-1">MIiiiichigan</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c482320-efd9-485b-9787-a81dba1a0530">
      <Text>PeTEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2d0cb1d-32d4-4109-af27-b74665197eee">
      <Text>Let’s hit it up for </Text>
      <Text AdornmentStyle="-1">ol</Text>
      <Text>’ time sake!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54647159-257c-4edd-9e43-fa2d2b1bc40b">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ac2fc97-7175-432b-9549-3d9508cfbadd">
      <Text>Lizzie, you </Text>
      <Text AdornmentStyle="-1">needa</Text>
      <Text> give my son a hit!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="809af5ea-c31d-45f8-8ed4-fd4a33fb288a">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="21b40df0-01e2-4333-adf7-354c72fdc77c">
      <Text>Life ain’t complete without my wifey!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2559af91-94fc-437c-9bb9-725f3e676993">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="713f208d-b8c0-47c0-ac0e-91e493e7f99d">
      <Text>Lizzie!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b303028-6557-4ea2-87bb-9f0b31a73f5f">
      <Text>Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0ee8fdb4-f5c7-4278-8946-b51e5300db9d">
      <Text>And our babies...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="7fb32584-7374-4793-8e0d-7a3d4a4899ed">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="8b09ba44-3169-4202-8186-5a8b6a2a754d">
          <Text>MilLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="c6f5f1ad-def6-47b0-8efd-f8ca99a39607">
          <Text>Our grandkids...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="179ed6ae-9715-4bb3-a106-c16ba2dcf194">
          <Text>WilLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="1469af89-77b0-4508-88d1-fd78fa174b72">
          <Text>Ah! Grandkids!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="0f20628b-540b-4356-a749-ad14f23b6314">
      <Text>LizziE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9b202df-db10-4c3c-a9cb-6a03d8ba4c16">
      <Text>Watcha naming your daughter?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27ef3054-2a3c-44e8-9e5e-65e4e413da0b">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e17bbec-c333-4f49-8a40-bd302559b4dd">
      <Text>Lulu!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72e92728-45dd-42e6-95ce-2827f1ae2fd9">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13253fc2-9c56-42bb-832f-e3a0fbb59b67">
      <Text>Lulu. So full of life! Any particular meaning?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1ef7686b-bd41-4df2-a7da-3152748b30d1">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="30d7f7f3-f65e-4f7b-8b8a-5f6ff19d6ead">
      <Text>It means “pearl.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b16d4bfe-3459-4f89-b43d-658e19837e90">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cde6a8e7-194f-474c-bdea-b565eb2e1a87">
      <Text>Arabic...? Ew.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d67adf0e-dcaa-42cd-9676-cb62668a98d1">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a27a374b-b706-4bef-b2a5-11ded69b0de5">
      <Text>And your </Text>
      <Text AdornmentStyle="-1">ibnuki</Text>
      <Text> (</Text>
      <Text AdornmentStyle="-1">إِبْنُكِ</Text>
      <Text>)?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb8e015c-246e-4b07-833d-4e4186fdd933">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7fa0b147-1438-4db7-ad17-ac9cd22162e8">
      <Text>No clue.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63a1af60-f08b-4a6b-bd39-bd821d329872">
      <Text>JaspeR</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="946c8c1f-3904-4ed5-86a1-01555cc942a1">
      <Text>I bet Petey’s got an ace up his sleeves.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6b93ad6-d2f1-4181-8334-7d4c6fcc5d54">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eaa81e16-2eb0-412f-b2bd-eb5832a83195">
      <Text>More like </Text>
      <Text Style="Italic">stone</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="949810e7-5193-4622-afe6-c0dfb9a94cf5">
      <Text>Petey and Jasper hop into Elk Lake, splashing each other.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="50ce0327-41fb-490b-bbf5-7e7e50804ec2">
      <Text Style="AllCaps">Amanda Wayland</Text>
      <Text> (20s, all business) briefly peaks in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4420d326-e9ef-42d6-838d-6e2f9f730e81">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2adb82d-fc8c-4e8e-b5df-97ae0097722d">
      <Text>Such a shame a happy family completes this lake house when it’s missing something. I mean, look at this water. Disgusting. Freely flowing when it should be cooling my supercomputers. The air... too pure to breathe. It needs the spicy flavor of nuclear power. All families are incomplete without pure dread. The Great Lakes do bring out the worst. The </Text>
      <Text AdornmentStyle="-1">Vandams</Text>
      <Text> will burst.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b9e0808-e9d5-4efa-a82a-b6eaf3a4eeeb">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f8dd9a0-3c4f-4787-a8aa-174e10824d1a">
      <Text>We won’t name our son. Elk Lake will...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a83500b0-b124-48b1-936c-6e386e423b94">
      <Text>JaSPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0adf7a4b-07d1-4674-9d97-5737be98fde5">
      <Text Style="Italic">Jasper</Text>
      <Text>! </Text>
      <Text Style="Italic">Jasper</Text>
      <Text>! </Text>
      <Text Style="Italic">Jasper</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52b31877-3f3a-42e9-8cf2-089ee07dd53f">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d74b744-61c8-499d-b1ce-4c01112846f1">
      <Text>This </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> be a joke...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3f1139be-97a7-4885-b4d1-9aee6618bed2">
      <Text>Petey dives in and finds a heart-shaped, Elk-marked Petoskey stone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3f1139be-97a7-4885-b4d1-9aee6618bed2">
      <Text>Time stops. Everyone is in shock at this rare rock.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a62d3389-3a5f-489f-b015-186d583e222b">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5032dd22-e004-4314-93d0-e95116ca2c95">
      <Text>We ain’t naming our son that.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b795ad34-36b5-420f-aa62-dcc6358a379e">
      <Text>Liz walks off. Petey runs after.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="416d3275-6c35-42ac-be4c-41576f15b5f4">
      <Text>Jasper</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="34ac5de5-92a0-4eee-9a54-fef28ffdab44">
      <Text>How about naming your second kid, Jasper?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74c17643-d732-4953-90b2-3fd08e127bbc">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c1e391a9-4581-43f1-9ae0-0649a7819c06">
      <Text>We don’t have to name him that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c693ac5-97c9-4455-81ad-d4a53cb87815">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6ab9058f-e953-4429-896d-a8011ac9ee42">
      <Text>It does sound like Petey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d104321-19f8-4789-a7d4-62240d977350">
      <Text>PeteY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6fde7836-0aeb-4e3e-bab7-f4bb8c8c71d8">
      <Text>My name just needs an o and a key-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="096c0b8e-fba7-4a6a-a54f-bca54865c75c">
      <Text>Liz kisses Petey.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="21f27f7d-5129-4168-9db9-a89236a406e6">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="88fa13b6-f216-423d-855d-0dfb5df4a8e3">
          <Text>LizzIE</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="718411a4-6674-482d-98ba-f6f2716f8d7d">
          <Text>ISN’T LIFE BEAUTIFUL?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="cf7dda0d-2e88-43d1-882f-a79be98228b4">
          <Text>PETEY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="50e9e2dc-2309-4700-aeaa-f7ee7d823f99">
          <Text>ISN’T LIFE WORTH LIVING?</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="3a41774a-5e14-41b5-8149-f7d51ec2c1a2">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="9c1332aa-08ad-4886-b9f7-70314d773b22">
          <Text AdornmentStyle="-1">VANDAMS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="148ef06c-648c-428e-82fb-76a8ccb3b0d2">
          <Text>LIFE IS COMPLETE WITH OUR</Text>
        </Paragraph>
        <Paragraph Type="Character" id="654b663e-bf7c-46a5-9a46-c897890c6f95">
          <Text>JASPER</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="7aaab379-f479-444e-a3c1-1663d4b3e015">
          <Text>LIFE IS COMPLETE WITH THIS</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="fb4cc635-1732-4f31-a0a7-cb737e017023">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="92f3ddd0-a3b6-4040-9624-51f87635e10d">
      <Text>CRAZY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b86e5795-3afa-4348-b593-f2683a3353f7">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a945eb4c-753e-42a0-abb8-87356de81852">
      <Text>SASSY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06124577-b84e-426f-b077-26744588a62c">
      <Text>CHERRY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bfdd2147-0700-4637-a7a3-22c91bc204d2">
      <Text AdornmentStyle="-1">WORKY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c9ac81d-e3d7-46db-ac83-404040aa80eb">
      <Text>PERRY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="28cefe98-dbfa-46bc-b05d-7d218cc72d2d">
      <Text>NERDY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ab157d8-fc0f-41e5-a987-39c248220eb4">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="72d8a149-2be9-49f1-acb1-ed5ddd9923ef">
      <Text AdornmentStyle="-1">DERPY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b3b24da5-d4cc-4903-ad9d-8732d8805342">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0da978ec-5353-4114-8bb4-95f01ae94e55">
      <Text>WILLY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f006c07-3eb6-4753-913f-e4971a88a540">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b356917f-3719-40c7-a15d-800a5bc63f90">
      <Text>LOVELY</Text>
    </Paragraph>
    <Paragraph Type="Character" id="88e540d8-a410-4aa8-b8f3-626ace854b31">
      <Text>JASPER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7e7ca645-ff02-41eb-b272-8a3e758cb042">
      <Text>WELCOMING...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1376fa60-4d4b-4620-856c-2129e5bf7cde">
      <Text AdornmentStyle="-1">VANDAMS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="694812d4-3bc5-4de3-89a1-7b5f62e7bee6">
      <Text>FAMILY!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">lIFE IS coMPLETE</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="17683d49-5f99-4150-98f2-644a3bf7af24">
      <Text>Liz’s phone rings. She answers.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4312a1e9-b956-4f32-9738-1cbc88ea58ff">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d453b11c-8df8-459a-8f4c-6f24b98d37ad">
      <Text>Thanks for giving us a sinking feeling!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b851fe47-9961-4322-9aa8-a5562f9fd7a6">
      <Text>Liz slams her flip phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="564a44b1-13b2-435c-9d08-e51cab6f2d3b">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6035d55a-23c5-4ef1-9f0c-9b88a31b9224">
      <Text>Is it the baby?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c516c4d6-4c43-47ff-bb6a-c75d7703b2ef">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2fba01c4-1883-4282-bff3-494d41a2aec3">
      <Text>The recession got us too. The shipyard has fired us and replaced us. 2008 can’t get any better. Those darn migrants.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a6d1a57f-570c-4fa9-8ec6-36a0e30dfbf6">
      <Text>Petey sees Shelby looking fondly at photos of her Arab husband on her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6ae66fd-b173-4568-acc2-c5b18dfa6e11">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f62192c9-b78f-4d34-a449-c64c19ba6a83">
      <Text>The outsiders hurt us, blue-collared workers.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96e766c5-15a9-4fb5-937f-75e415561b4d">
      <Text>LiZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6bf5028-27d4-4251-91ea-fe2b5b011b6c">
      <Text>We’re gonna lose our house to a foreclosure. So, don’t be burning bridges...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ac08647-4274-47cb-a9e2-7433512579c3">
      <Text>Petey sobs, as everyone leaves. He looks as Elk Lake turns into the Mackinac Strait under its bridge.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="bfda984e-c564-4342-b53d-a7ca9637fe52">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="ff2224c8-4acc-4956-867a-17fd275c56b8">
      <SceneProperties Length="1/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Mackinac Bridge - Evening</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="5da96831-1e73-4f5e-baff-daeadd78b157">
      <SceneProperties Length="2 3/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DETECTIVE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MACKINAC GHOSTS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">3. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Body of Water</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea63b1bf-24a6-45d2-afce-760620b293e5">
      <Text>Out in the rain storm, Petey walks onto the foggy creaky bridge.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc7baf2b-c7a9-4d4d-946e-c8327e0eb657">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="16c9082a-a1ff-4c15-aba3-950d9a921f87">
      <Text>Every living thing is made of water.
Every machinery needs the flow of water.
All the weather take the heated water.
All the seasons bring the cooling water.</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5e847502-5598-421e-aad1-ce6aa2cbb18a">
      <Text>
I bring nothing to the world unlike water.
I’ve brought nothing to the world but tears!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e24705a-1abe-47b1-b3ae-c1099a769cb5">
      <Text>The </Text>
      <Text Style="AllCaps">Mackinac ghosts</Text>
      <Text> manifests, resembling those who passed there. They try to hand a mug to Petey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="710467a8-aef0-4aaa-ac4c-65d856bec541">
      <Text>Mackinac Ghosts</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ca14799f-4c1a-474f-b0aa-3fe036b058d7">
      <Text>Drink it. Drink the water.
Think straight. Think straightforward.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a3746364-5333-4efd-8403-259d920bb617">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e0cb639f-f4a8-48ed-9cb0-8b1aa5144c62">
      <Text>I bring nothing to the world.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d9c2131-1f38-4cd0-b30b-e2745a03e7c0">
      <Text>MacKINAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a323d004-edec-49c4-9d2b-aa9bf6578d64">
      <Text>Cherish. Cherish this one life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b1182f5-a4f7-4a0a-806f-ebe60c8585d0">
      <Text>PETEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c7d4c310-9599-47a3-aed0-ca9bc1a03614">
      <Text>Just tears!
Help!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="36833490-8118-4974-954e-f773b6bbf0c3">
      <Text>The ghosts steal Petey’s stone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e0c9ee0-fa89-4037-87b1-ef28f5f8bf43">
      <Text>MacKINAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f202f10-18b8-4892-81eb-b32aa187fd1b">
      <Text>Help? Hell, help yourself!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fff6f0f9-4b0e-4851-bdb7-bf5edaaae2a3">
      <Text>A motherly ghost returns with a Petoskey necklace. Petey wears it.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="efaaf29d-b64b-4960-bcf3-ae54235c206a">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="8afd3422-a1d2-49d1-99ce-c3d4798fe68d">
          <Text>PetEY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="46627810-e27a-4eb4-aee0-c8983d71ea7c">
          <Text>I choose life!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="fc38a0b7-19b5-4174-b28d-a610e1fc1db1">
          <Text>MacKINAC GHOSTS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="043523c9-2165-4d4f-b58b-2dfd533f2bc6">
          <Text>Take it in.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="1b9d2bb2-5b14-4188-b0a5-08249a0393c4">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bfa8e3f2-9af3-4dcb-bf01-c7bc1b71ccbb">
      <Text>Drink the great lakes water.
THink pain. Pain you’ll cause.
Happy wife. Baby in sight. Dying ain’t right.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91b6f23a-4491-40cd-9d39-d0a963a8c6e5">
      <Text>MackinAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="dabda508-cd44-4dd0-b4ad-578e930d4079">
      <Text>Drink it. Drink the water.
Think straight. Think straightforward.
Cherish. Cherish light.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0602267e-0104-4bbe-9abe-920c775b792f">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6f1da93a-6d6e-418a-8ef1-89a45ce65d35">
      <Text>Help myself to this great water!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea63b1bf-24a6-45d2-afce-760620b293e5">
      <Text>Petey drinks his mug, starts the car, and drives away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="81437fff-e1f2-4fe3-a38c-a36203cec0a6">
      <Text>Morning approaches with emergency vehicles. The orchestra wails.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="74f971cc-6952-4d68-b752-8f7637491a81">
      <Text>Liz rushes in with the </Text>
      <Text Style="AllCaps">detective</Text>
      <Text>. She stops in her tracks, kneeling.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8f115da-d90e-4619-b81f-b7c193b68236">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="cb62de14-ded4-4df0-a67b-b80b9a1f570c">
      <Text>Life is a complete... disaster...
Life is incomplete without pete-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="39050aed-a8d8-448c-9b79-a0de8331b83a">
      <Text>Detective</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="21fd06b8-806e-45db-bdc1-8b7b936b40b4">
      <Text>we are sorry to report the car submerged under mackinac bridge is identified as yours...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6678b727-d48c-450b-84c8-8cc415b549b3">
      <Text>LizzIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8f5b175d-67aa-4ded-a0bd-849c4b2f96c6">
      <Text>And...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="961f5e5a-7433-4bc7-bc62-cbe748225cf1">
      <Text>DeteCTIVE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7b357f53-4d48-4980-9121-f14f17f43b76">
      <Text>No bodies.
Nobody.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d72ebc19-97cb-4ec8-9f63-e6b289f17fa9">
      <Text>The Detective hands the Petoskey necklace to Liz, then leaves.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b2f97e8-2862-4013-b3a8-bc19deebf25f">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="63de5d6e-f4c7-4000-8085-bca4f35e2a85">
      <Text>Nobody loves me like this body of water...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3f4f4793-5a1f-4f2d-9676-29a5be2314d7">
      <Text>The ghosts reappear behind Liz. Petey soon follows.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fb8853e-07c2-4ccc-8d01-c65f35159b31">
      <Text>MackINAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="da292368-40ef-4d81-b0d3-7ab4683c3fec">
      <Text>Nobody...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c90c7940-fb39-4d07-9b08-381b21b0056b">
      <Text>LizzIE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bcf62caf-69a8-4e5f-921f-ec77dda69381">
      <Text>With my last tear, i’m out of water in my heart.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb2ac63f-2809-49ca-b3e7-b47aae098907">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4971d25d-e381-4167-a949-355105b83ab9">
      <Text>You are my soul.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="76fbb846-607b-41f6-a6fd-0f8e72f0167a">
      <Text>MACKINAC GHOSTS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="47780a1d-f796-433e-921b-a4cfd38cc037">
      <Text>Nobody...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7427b1e6-f88c-4032-9826-c6fc963c5483">
      <Text>Petey closes Liz’s hand, sealing Petoskey’s fate.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Body of Water</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0441ba7-f820-4ecd-aaea-22711984df91">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7220863f-4550-40f4-a0fb-edf473f228d1">
      <Text>A bridge is supposed to unite two lands, not divide two souls. The water may be under it, but I have vowed to never set foot on a bridge that double-crossed my heart. The strait stole my balance, silenced my music, drowned my love, eroded me into a cold, hard-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="146e192f-c1ea-4f78-8b84-11334fb862a1">
      <Text>Shelby, now with a black eye and some bruises, hugs Liz. She encourages Liz to open her hand to reveal the Petoskey necklace.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="931aaae1-23b7-45e2-82ca-da95a7423687">
      <Text>Lizzie</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc6436a0-622d-4e30-847d-cd80f95c5c15">
      <Text>Every rock has a softness they need to find in themself. Perhaps, it’ll take time in unexpected places... and persons... And yes, in the end, Petey got me to name our baby...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="17b1bb41-0e8b-475c-a395-ab4028affb4c">
      <Text>Liz places the necklace in the center. She leaves.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Elk Lake House in Elk Rapids, August 2019 - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8a75dc57-df67-4dfc-968a-373d7d95060b">
      <SceneProperties Length="4 2/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CHERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY, PERRY, SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU &amp; PETOSKEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETOSKEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY &amp; MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">4. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Yoopers and Trolls</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3925c769-fd1f-4662-ba42-4beea7327409">
      <Text Style="AllCaps">Petoskey</Text>
      <Text> (11, farm boy) crawls out of his tent. He sees the Petoskey necklace and wears it. He puts on mittens and bangs pots and pans.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2905e4bd-218c-4882-9554-3d2df7d38f07">
      <Text Style="AllCaps">Lulu</Text>
      <Text> (11, city girl in a Hijab) crawls out of her tent and trolls Petoskey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b288904-0ea1-4660-948f-7511b20342c2">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d445b832-2849-4d9f-a6e8-bbae0e9aac5d">
      <Text>...Petoskey!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46d5b972-a97a-4e92-9c44-6e75edb1609c">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f0c9159-d087-4174-a87a-026eae048ff2">
      <Text>Lulu!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="94edb39b-7f12-4f13-a555-5c8a21494a8f">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="84b1f99a-d5d5-4341-b0ea-1be71bdadf71">
          <Text>LULU</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="a4d31934-dcc0-427d-aad1-c652e0ee4f56">
          <Text>Shut... up, Yooper!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="1817269e-253e-4b58-abb8-635a4a9c10dd">
          <Text>PETOSKEY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="26879b02-e2cd-4c0e-86f6-4a9379b01cdf">
          <Text>Pipe... down, Troll.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="2905e4bd-218c-4882-9554-3d2df7d38f07">
      <Text>Cherry, Perry, and Shelby enter with lawn chairs. They sit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="10d9a769-21de-4d20-a2af-577cf8fdcd1e">
      <Text>ChERRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e00994f-5a1f-4ef9-b817-3e3798909cf2">
      <Text>The kids are at it again?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d5f8c31-dcaf-471e-bb3d-fe7262f50d51">
      <Text>ShelbY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="505049dd-7f98-4c05-b698-3dfa857239eb">
      <Text>With my daughter, you betcha.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1b78f5d-01ea-4438-9736-d149ecfaf85d">
      <Text>PerrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7074598-5535-4bf7-9016-4376fa179c2a">
      <Text>Let’s be responsible... and place some bets.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bbdfb9e3-1939-4b89-aba3-6e81818cb969">
      <Text>SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d061848-ddc0-46d0-8880-06edfe0ecede">
      <Text>Let’s go Lulu! Your inheritance in on the line!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f106b388-122d-4f62-8061-a586ca458818">
      <Text>Petoskey takes off his mittens as Lulu gives troll-like expressions.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a5b9ed7-2658-4e51-9790-fabb3de4c9f9">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="274bff92-f727-4723-b153-8833cbc65648">
      <Text>Holy wah! Another day to go fishing!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f01ecb60-8eb1-4792-9f2d-a83505db3bc4">
      <Text>LULU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="4e3b8d50-4ddf-41b7-a942-fe932a3a510d">
      <Text>Yeah no... Today, we go bird watching.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3cf46395-edc9-47fe-9757-208f3f252867">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="eb877ffb-9560-4461-a809-dec9ae9eb4da">
      <Text>Aren’t you from eh... Dearborn?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5611455d-1576-4012-8b1b-d745d72e1cb9">
      <Text>LULU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="43a3e750-1734-4577-bdc0-d4d4dc7aa82e">
      <Text>I ain’t into deer, you wild Yoopers...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="165b04f4-9c3a-45c6-ae7b-f12d16b5ed56">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f5af0dcd-0423-4f9c-86fd-8807f9995ae3">
      <Text>Under the bridge.
OVer the mitten.
Yoopers and Trolls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="698388c2-ea6a-4cd5-8e33-466cfc7a3983">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="581cd1c4-c621-4301-95fe-d00a6219109c">
      <Text>Eh, crazy trolls...
Let’s go stargazing!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5cf0a55-49b9-4ad9-a705-c0a6ce8db7e2">
      <Text>CherrY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="be5bcdfe-2e45-4b76-87a3-c46bcf4638bb">
      <Text>What about ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text> mosquitoes?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3b08c883-c677-428c-b83f-9dc221957730">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f2655c79-8dad-4eb9-b9e1-38dbdc3c0b22">
      <Text>Let’s just watch </Text>
      <Text AdornmentStyle="-1">WCMU</Text>
      <Text>-TV!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e49df76d-8fe0-4318-9701-356d63bcee44">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="536612fc-9542-4b8d-b512-27deefe9ed44">
      <Text AdornmentStyle="-1">WLUC</Text>
      <Text> is up there!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8f2b003-b490-4a4c-9e9a-cb7997bb6734">
      <Text>ChERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="349358dc-ad46-4933-acd2-97a902097ee9">
      <Text>Wood-tv 8 is better! (mosquitoes!)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33300aa7-146a-4bbf-9d1c-8f4d3ef0cb0b">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="90ec0598-14d0-4262-84f6-dff33b6dc6e6">
      <Text>I will bite. I am down to go kayaking!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15fffbfd-dda0-440a-89fa-86df0faa3c28">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="97e05acc-c4c5-47f0-9f8f-d3081e36a604">
      <Text>Under the bridge.
OVer the mitten!
Pine river, the fastest in Michigan!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1ab03339-cac9-4f36-a7fa-ff9f77a068e0">
      <Text>Petoskey draws his water gun, but Lulu sprays him first.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b794efd-caf4-4167-9999-c36d937a8d49">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9546c2ab-b283-4f04-a47b-ffe1290db3f9">
      <Text>Attack!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61c532fb-b6d3-4c69-a347-349b2f92479f">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5c753ad8-8deb-4ec4-9650-4ded40331203">
      <Text>Too slow!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c07ca9db-ff20-4e4b-be20-a79124a6451b">
      <Text>PetosKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d7950faa-f260-46a7-834c-f78168129fef">
      <Text>I’ve got backup!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a01bb437-c8f8-4096-ba62-e28fe10feffc">
      <Text Style="AllCaps">Jacob </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Jacobowitz</Text>
      <Text> (young NYC actor), </Text>
      <Text Style="AllCaps">Liberty</Text>
      <Text> and </Text>
      <Text Style="AllCaps">Bailey</Text>
      <Text> (twins) and the </Text>
      <Text Style="AllCaps">other cousins</Text>
      <Text> (kids) ambush Lulu with their water guns before retreating.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bd2aca3-0f42-4e93-82fc-88d13d23226a">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1b5c7de4-0b89-4df2-8677-9b9a71a9a0fc">
      <Text>You will never stay dry!</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1b5c7de4-0b89-4df2-8677-9b9a71a9a0fc">
      <Text>Under the bridge.
OVer the mitten!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4a4033d-3872-472e-9da6-12b47d7179c0">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="2fd9dfb4-8427-4372-8714-e4e681c9b89d">
      <Text>Thank you, cousins!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ca297756-9cc5-4591-81e7-19e2b311851c">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ef5c3406-3dd5-4313-8920-a45545a87dfe">
      <Text>It is a sin to target your favorite cousin.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1478fce5-8170-4fc4-9d5f-6e28f8e538df">
      <Text>Jacob hands a towel to Lulu. They hug before he exits. She dries up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bd2aca3-0f42-4e93-82fc-88d13d23226a">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="10ceec0a-b076-4555-861a-4c90488375e2">
      <Text>(Repeating)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b00e5c52-ad0e-4fd1-970e-35dfdd8671da">
      <Text>YOopers and Trolls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f966809-de86-4830-a69d-17a02cfc2fdc">
      <Text>LULU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="11bcf359-3906-4c0d-a064-e5a68599d17c">
      <Text>Holy crap, I hate </Text>
      <Text AdornmentStyle="-1" Style="Italic+AllCaps">hate</Text>
      <Text Style="Italic+AllCaps"> </Text>
      <Text>camping with you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9eedd2bf-a54c-487d-874c-0904206c4f73">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6d6988d1-399b-4f0d-9672-63611ae843b2">
      <Text>No one likes your hip hop trash.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61a20149-5ef2-4de6-b8c6-6ac1940cd0bb">
      <Text>LulU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f85222a3-0130-480a-8b18-373966929f14">
      <Text>Take it back, country boy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74b8aa81-e3e7-4db1-b1bd-b4269ee1a22b">
      <Text>PetOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6adc42e1-6f0e-45fd-a5bf-2881adde25b2">
      <Text>You first, city gal.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54151c6e-c68d-407a-9efa-844611674158">
      <Text>Lulu &amp; PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="36d4e448-4918-4f4c-9343-a9557e897b76">
      <Text>Another Harbor Days...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9eb7e27b-248a-4f07-bca6-f1ddc6a13ff2">
      <Text>LulU</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="43b10af0-fd7e-4188-9e02-bde9ce30ea3f">
      <Text>...with this wild yooper...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7934f29c-5038-43a5-a558-5c9669b311a2">
      <Text>Lulu and Petoskey wrestle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d48aad2-2be7-4462-a45b-ed4c82a3a048">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0f994c66-90f9-471d-9324-11bb372b28d5">
      <Text>Stay under the bridge, troll!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bd2aca3-0f42-4e93-82fc-88d13d23226a">
      <Text>Cherry, Perry, Shelby</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="669af6a1-5475-4f4e-a3f0-14c4e63b2166">
      <Text>Yoopers and Trolls form a bridge!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82a5b31e-b9be-4a6f-b8af-204a7bfb3846">
      <Text>WillY &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="26fc6f23-828b-4589-a165-f5decde99a99">
      <Text>Stop fighting!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Yoopers and Trolls</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0e28e38d-fb5c-4a71-99c9-b7d11201721c">
      <Text>Liz shares the family members.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b21cba56-d095-4603-8b57-2286ff66df42">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="6471b8ed-a3c7-404c-b6bc-c70ec93ffc2c">
      <Text>(Narrating)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57adb668-5455-49cd-a0bd-da48653223bf">
      <Text>If my Petoskey and his cousin Lulu weren’t fighting, I’d assume they were abducted and replaced by aliens. The real ones are close. There is cousin Jacob </Text>
      <Text AdornmentStyle="-1">Jacobowitz</Text>
      <Text> who is making it on Broadway. Then Liberty and Bailey. Twin cousins from Hell... Michigan. I’ve heard from my in-laws they are angels.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b08b0a6a-5d76-4f09-aa51-99a9cd95b723">
      <Text>Liberty and Bailey go buck wild and chase everyone around, including unnamed family members.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f31f2c4-8d8a-4d81-88ea-3d171f5436e7">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4c1ddf3-315d-4fc4-8e83-3ea885492c08">
      <Text>I don’t remember the other names Petoskey mentioned. They got many cousins, aunts, uncles- I wish I could meet them all but that Mackinac. It’s a bridge I cannot cross. Its watery depths crossed my heart and made many hope to die.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9b51b2c4-d295-4def-b054-c4eda6b93a25">
      <Text>Cherry drives in. She puts a Red Wings hockey shirt over Petoskey. Perry shoves Cherry out then gives him homework. Then Shelby shoves Perry out while Lulu shoves Petoskey out the car. Then Granny Milly respectfully takes over and lets Petoskey in the car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="97b40690-f875-46a0-8022-0603bcd0b7eb">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4c1ddf3-315d-4fc4-8e83-3ea885492c08">
      <Text>Fortunately, my son is able to. His aunties have no problem taking turns driving him from Skandia in the U P to the L P. After Harbor Days, Granny Milly drives him home or insane. He is said to hear a man’s voice whenever they cross-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="90d0e8c2-f56a-4a7a-9d22-1328e006cc93">
      <Text>As Petey naps in the car, he awakens to Petey’s song.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fa329934-a8e0-461a-9810-b7c96c021c11">
      <Text>Petey (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="142d2340-c4fc-4e95-82fd-ab360e72b05b">
      <Text>Wakey </Text>
      <Text AdornmentStyle="-1">wakey</Text>
      <Text>, son...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d27b40e2-ae54-4145-bfce-d23e4d7ed32d">
      <Text>Jasper takes over for Milly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbaf0b22-bc0b-422f-812a-5ed545dd8e62">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba64ae48-9adc-40a3-89c0-f5ce3e65c701">
      <Text>Whenever Milly wasn’t feeling well, Petoskey was Jasper’s problem.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1ba8c67e-6905-4a3b-ae1c-fcaa6e144ddf">
      <Text>Jasper drops off and goofs off with Petoskey in Skandia.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="23f68c99-1c80-455f-97c6-681f4f33d4d2">
      <Text>LizzIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db3a9f1e-f41c-4a9e-9a0e-819fec875793">
      <Text>Boys... Then the real problem came in 2020.
We didn’t see it coming. We no longer saw another one of Milly’s inventions from her automatic toilet to the electromagnetic pet hair remover. We no longer heard another idea from her. </Text>
      <Text AdornmentStyle="-1">Grampy</Text>
      <Text> Willy cancelled the 2020 and 2021 family reunion. He wanted to grieve alone. I worry about him and the lake house. I’m thankful for our home, living off my Petey’s life insurance. But no one can rest assured of what lives life will take away from us next. I really wanted to see everyone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ce514daa-0ef3-4fa3-9cd4-5f57fee852dc">
      <Text>Petoskey sits sadly, looking at photos of Milly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="89013f58-ad53-4ad6-a06e-ad0883d627b8">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62fc3626-dd61-4b34-9b65-63fd74d951b8">
      <Text>Son, I know how much Grammy Milly meant to you.
So, would it mean the world if I went to this year’s Harbor Days? August two </Text>
      <Text AdornmentStyle="-1">ol</Text>
      <Text>’ two </Text>
      <Text AdornmentStyle="-1">two</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94336a25-2d1c-42c9-8da3-2ae6713f7cda">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54e5c3d3-79d3-4430-8be7-df4f57c09420">
      <Text>You’d cross the bridge?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6515b1a4-3c26-47aa-a814-e861d19c9c9c">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a8b5dd9b-af43-4765-a037-608360b5e5d4">
      <Text>Nah. We’ll take the long way through Wisconsin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54ac0807-d8b6-4eff-b125-5ecd2d45d305">
      <Text>PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3da2b0ec-a51a-4d37-aa68-8882ed4529dc">
      <Text>That’s not fair! Everyone’s cheesy there...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="526fb537-9f50-4c72-bf81-112031300724">
      <Text>LIZZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b65ac22-2a5f-41ad-b77a-1bee85aa6721">
      <Text>Let’s get a </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">moo</Text>
      <Text AdornmentStyle="-1">oooove</Text>
      <Text> on. For Milly’s sake.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4e667da8-f441-43d6-bc69-ff92c08aa55f">
      <Text>Liz and Petoskey exit.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="5594b819-4a2e-45c7-ae33-47dac613b1ca">
      <SceneProperties Length="1/8" Page="15" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Int. Elk Lake House - Living Room - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8a75dc57-df67-4dfc-968a-373d7d95060b">
      <SceneProperties Length="2 5/8" Page="15" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY &amp; MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETEY, MILLY, WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">5. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">It Would Be a Shame</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2e2b1dfb-4314-4e8f-a348-a5e84fdb257d">
      <Text>Willy stares longingly at a photo of his late wife Milly.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ad315372-f9ba-46ac-84dc-a50b415d93fb">
      <Text>Amanda Wayland knocks on the door. Willy goes open it, then slams it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c38ea8b-1f89-4875-acc8-77be68898d91">
      <Text>Wayland</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a5c4734d-a578-4ec1-b579-afa65cfcb978">
      <Text>I need your lake house!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="13d18335-55e5-4a0d-97e0-2cd8bca33d4e">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="db90e4b2-1f23-4ebf-9c85-8d157172796d">
      <Text>You damn vulture.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3567fc66-0efb-458f-83f0-21e74e82662e">
      <Text>MiLLY (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="59cb508e-12b3-4e60-b317-ad8afddc3326">
      <Text>Who are you calling a vulture?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="47984fa7-3696-4989-a7ff-2b3ff862c692">
      <Text>Willy opens the door again. Wayland nabs Milly’s photo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8150871b-66b7-4cb8-80e3-042cb33161da">
      <Text>WaYLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7c82725b-8f73-4f2f-ae17-391bf6bb83a1">
      <Text>And you need your wife back.
my name’s Amanda Wayland of Turkey Ventures...
and I can bring your wife to life!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d2619733-dfd7-48e6-88b9-a5cf0af30175">
      <Text>Wayland displays her tablet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bd7ef54-e468-404e-86fa-609ffa49ca37">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bed31fd0-a636-42fc-b3fc-9cc3e4bb9759">
      <Text>She did not believe in alchemy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8995a63e-ef8b-47b6-8770-6e3044851834">
      <Text>Wayland places Milly’s photo on her tablet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f70e1d12-64e9-4ddb-a92e-2d12103b0aba">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="50a86a84-fe61-4eef-a96a-bbb9c53b463b">
      <Text>This is not alchemy.
It is technology!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="230f8d50-5026-47c3-a56e-fd150f516d42">
      <Text>Milly shows up behind Wayland.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c778183f-41aa-4d76-86e0-5a28f80c1766">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="670b5f70-fd6c-4427-ac7d-700d2ef72f0f">
      <Text>So proud of you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a3f4de18-216f-4a7c-a79c-c7a320a34efd">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="ab2817e0-8991-48d9-b427-7ecadb9d1c40">
      <Text>You heard that?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f959b643-a139-42c1-8b77-094f944a2e7e">
      <Text>Wayland raises the tablet volume.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15077605-680f-45fe-ae7a-516c6367db01">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="9cd215a6-f67c-4da8-b632-3aba67f79a89">
      <Text>I love you!!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="425f63b0-33da-410d-b97b-fe357f94558c">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b2cae7fc-4d29-4404-8554-b90fb8ab3763">
      <Text>I’d love for you to let me build a data center by your lake.
so, she can get the water she needs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e0e7ac7-d38b-42a9-8ccd-3487f9500364">
      <Text>MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c1715834-f098-4bde-8694-b60dddfdc9d7">
      <Text>Do not bring shame.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ae49778-3f1d-4492-8398-ebbd74ebb699">
      <Text>Willy looks at the disapproving violinists in the orchestra.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74ace816-01ed-4c2b-ace8-1d8ad46dc2ae">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="649782af-6030-43b3-8681-ceae6f56365f">
      <Text>Don’t be ashamed to say “no.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="03bde0a3-0afb-458e-8216-dc204f76fbb0">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c50fda60-5018-4f6a-a312-34f8e4daa3c2">
      <Text>No.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e36e6ded-f337-4005-b00f-bc857600c054">
      <Text>Milly disappears.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9c398926-879c-4573-8fc8-63eefabcfddc">
      <Text>Wayland expects it. She “respects” his decision. Before closing the door, she nabs Petey’s photo. Outside, she sets it</Text>
      <Text Size="10"> </Text>
      <Text>on</Text>
      <Text Size="10"> </Text>
      <Text>her</Text>
      <Text Size="10"> </Text>
      <Text>tablet.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="90e9149f-4e62-4b67-9f81-373c7ed696cf">
      <Text>Petey enters the home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8dc2443-39a7-451c-8c2b-acb5ca259eeb">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c13b3bb9-cdc5-47ec-a0d8-a31ed83f0a33">
      <Text>Wasn’t my life worth more than my house?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e519e66e-cdee-4b21-9b76-61345f62e7bf">
      <Text>MilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1ca06f36-63d9-411a-8bc0-30cccc20d72a">
      <Text>It’d be a shame...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a545533-8759-4ce1-8353-ee63d9f79d21">
      <Text>Petey</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7a69d6ed-7975-40be-be35-5d4795074d94">
      <Text>Wasn’t my breath worth more than some lake?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bddcf31-ef0a-481c-8030-c0e87ffbf727">
      <Text>MiLLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a86b2c24-0a06-49e1-a7f0-4dcd230c8625">
      <Text>It’d be a shame...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f312d657-d643-4ffa-baad-84401f9ccfa0">
      <Text>PetEY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="45225bbd-90e9-48a9-aa8e-aad85562b8c8">
      <Text>Wasn’t my heart worth more than these rocks?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a39fcb7d-39b7-49fc-bd86-10a0d011e34f">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="fcb80c38-9acb-4058-a0ff-399408128eed">
      <Text>There is no shame in forgetting them.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ff0b8143-8354-4a18-a356-85a1de2df9aa">
      <Text>Milly joins Petey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="080afa13-dfcd-41c0-acee-12bc499c5233">
      <Text>Petey, Milly, Wayland</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="007fddb5-5fcc-470a-abaf-9a8717cf5826">
      <Text>Shame...
Shame...
Ashamed...
Only shame...
Nothing stays the same...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74a89d2b-0566-4bb0-9017-2c6db446c4dc">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="7b396199-f3ba-4c6a-a43d-a9d417ad7cb0">
      <Text>It would be a shame if I chose the house before my family!
It would be a shame if I make...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9630f972-2bfa-4e09-a728-11245f2aa650">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="10e0fb76-03e6-43e9-b3f9-69dd89f6d890">
      <Text>Bring back your wife!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8731e0d3-80e0-4005-91fc-b77dd037672b">
      <Text>Petey &amp; Milly</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0a3501eb-5213-4fae-bc03-fd1234e8857e">
      <Text>Don’t be ashamed!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d942f7af-ae8e-4f41-8b40-bd2659a09d9a">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="f8a76117-d3f9-4064-a2a9-70cbbaafd58f">
      <Text>It’d be a shame if I make the...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05e9fba0-b443-4faa-8b49-92212d0984d0">
      <Text>Petey &amp; MILLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0bf5281b-903f-4c36-9726-a2febb28a2c3">
      <Text>There is no shame.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3821f22-8b38-4f4b-8331-bba8de76a127">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="416434b3-096c-4665-bb7a-98d9119cd42b">
      <Text>Bring back your son!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="758b89b2-c926-4051-b2ef-180c5074e38b">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c5aad746-132c-4d96-9753-1427897bee7e">
      <Text>It’d be a shame if I make the same...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="31d885a5-4d99-49ef-a75d-f02317754c23">
      <Text>PetEY, MILLY, WAYLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="063e842c-16c7-4f1b-ad8b-d6aef4bd25bf">
      <Text>Nothing stays the same...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="dbaa8750-bebe-4667-84ff-eb246327f912">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="e3004508-d458-4f22-952f-b58ed26543f4">
          <Text>WilLY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="2b195340-836b-4c79-a1a3-694982eca083">
          <Text>It’d be shame if I make the same mistake...</Text>
        </Paragraph>
        <Paragraph Type="Character" id="50829ae5-4766-4a7b-9b5f-cc0bcc183f18">
          <Text>WayLAND</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="b0283dcd-3479-41c0-a38a-ac20096a05f8">
          <Text>It’d be a shame if you made the same...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="32ad1c47-5d6d-40d4-bb2d-7124327c1d56">
      <Text>PetEY, MILLY, WAYLAND</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="06cd2717-e1b5-4a06-8d39-98d8b5910616">
      <Text>It’d be a shame!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="df868c92-dacc-4612-970f-0db1c8a67acd">
      <Text>Milly and Petey vanish before Willy could hug them. Instead, he hugs a tablet with their photos. The tablet displays a contract. He holds the e-pen.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">It Would be a Shame</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="c4991dc9-c78e-42e1-985d-061b649af3c4">
      <Text Style="Bold+Underline+AllCaps">Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+AllCaps">Ext. Elk Lake House in Elk Rapids, August 2022 - Day</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2b317a2f-acac-442b-b0d3-0eb725b26d30">
      <SceneProperties Length="5 5/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CHERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY &amp; SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHERRY, PERRY, SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JASPER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KIDS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIZZIE &amp; SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU &amp; JACOB">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU &amp; PETOSKEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LULU, PETOSKEY, KIDS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PERRY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PETOSKEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SHELBY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VANDAMS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WAYLAND">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="WILLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">6. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Dad Tax</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3878ce69-e192-4d7b-b79b-f9340044227d">
      <Text>Jasper finishes setting up Lulu and Petoskey’s tents.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7968c8e1-0b96-46ea-9512-1b63e73745e8">
      <Text>Shelby and Lizzie stare in awe as Lulu and Petoskey feel awful.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="925a06bd-b395-4678-ab73-1523ed948520">
      <Text>Shelby</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="26bb4f01-2c39-4622-8ea6-9ffbd07fd418">
      <Text>Thanks for everything, Jasper.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9f131de-96ae-442a-ba75-ae1f78b715c3">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed8453af-5b0e-4e43-809e-ab680db945eb">
      <Text>I really did not need your help.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4aff2b0a-5aa0-4637-97a8-97a70000c626">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d11c20a8-a2a8-4eae-9ea5-a8be54cc9528">
      <Text>You needed all the help you can get, Lulu.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="540c5545-450f-4929-8cc3-0c935e1356e4">
      <Text>JASPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f52f028-452c-40fd-8e48-7395c8634c90">
      <Text>And you needed manpower.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3b4e907a-5533-4f66-a0f5-29a9784f289f">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="557b31af-bce2-43db-b6ac-ace238c46c99">
      <Text>Ha! He called you a sissy, Petoskey!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="504a6d98-2fd4-49c7-a67f-a6083c919444">
      <Text>Lizzie</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="511a607b-e4b4-40d4-af04-cdbb467190e0">
      <Text>How could we ever repay you?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8db77b1f-842f-44dc-a292-8061552418f2">
      <Text>JaspER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b2fe0e3-e0f5-4593-bc09-0d6070aba8ae">
      <Text>Your sweetness is good ‘</Text>
      <Text AdornmentStyle="-1">nough</Text>
      <Text> for me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8f7d8fe1-0fd5-4574-bde5-5d94805b7957">
      <Text>Jasper nabs a handful of candy from Lulu and Petoskey’s box.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4677a486-9731-458b-9e13-4e1cffbc28af">
      <Text>Lulu &amp; PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27a12845-23bb-43e6-884e-b20921a0218d">
      <Text>That’s </Text>
      <Text Style="Italic">my</Text>
      <Text> candy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fe3b74c1-e9f0-4fb1-a442-358567e3ae86">
      <Text>Lulu and Petoskey stare down one another as they fight for the box.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="106a1917-8964-4dfa-9898-ed495a9ca277">
      <Text>Lulu &amp; Petoskey</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="50c2de72-5637-4e26-8b04-40e60b829e93">
      <Text>Mine! My sweets! Sugar! Mine!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ce617f6-cb86-4a88-960c-12d5416f71dd">
      <Text>Jasper takes their box away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90073f92-a825-465a-b6cb-946be7a0f02b">
      <Text>JaspER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dce46cb2-77ea-4d45-9147-ef07f5675107">
      <Text>In the jurisdiction vested by the council of fathers and godfathers, everything is mine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f73201f-2b1e-4e7c-b72d-6cba202a113e">
      <Text>LULU &amp; PETOSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0a09e2c-b065-4100-81ef-0b63fb0d1f33">
      <Text>What jurisdiction?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="57e8a61f-001e-4f47-a465-221c17cfae24">
      <Text>Jasper pulls out his “Dad Rules!” book. He opens it for the kids to skim then promptly shuts it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dcc5a0d5-dee7-44cf-a868-a9db9d684a7d">
      <Text>JaspER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b55744d3-7c9e-40a4-a902-e5deacc0bdcd">
      <Text>You kids got no say...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="57aa5cec-7925-42bb-8e9b-d09c79c7fd50">
      <Text>Lulu, Petoskey, Kids</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="1cc7b425-26c3-4bab-84b1-383583fa613f">
      <Text>So taxation without representation?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ccc62e1-0508-42c1-b8de-a2f33dadcf8e">
      <Text>JaSPER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="d8cc15fc-c65b-445d-bb92-bcba92217c66">
      <Text>It’s good for the community!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bcce4faf-4740-4140-82ba-51dac466d1d4">
      <Text>LulU, PETOSKEY, KIDS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="dab964f4-530a-4f74-8547-363c8764f5fa">
      <Text>That’s what a communist would say!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c2077829-4bdb-481b-8bf9-94f9c3ee2172">
      <Text>JaspER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8cce5e2d-0421-44a6-a863-6de20b7ea457">
      <Text>Just paya your fair share!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a37e5c08-7033-4629-b393-ea248c6d7338">
      <Text>LULU, PETOSKEY, KIDS</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="bc15c55c-ecfe-4fb2-b764-52d9a52cd492">
      <Text>Never!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="803a78e8-21df-4b1b-b182-63f6065a5149">
      <Text>CherRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8b71ee4c-7920-42ec-b083-bba9ed718629">
      <Text>Dad rules!
Tax season!
Camp reasons!
Come collect:</Text>
    </Paragraph>
    <Paragraph Type="Action" id="092851fd-e4ae-4f50-bcc4-fac46bfb59e8">
      <Text>The </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> aunties tax and collect from the kids on Jasper’s behalf.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="5422ee1c-7cce-4d72-b488-a18a9072990f">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="1677b716-929e-4372-940f-d36522a7d897">
          <Text>CHERRY, PERRY, SHELBY</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="6952ac51-a7a6-472d-84d4-d9dd9398636d">
          <Text>Your cookies!
Your candies!
Your french Fries!
Your milk shakes!
Your chicken!
Your nuggets!
Your kid’s meals!
Your Roblox!
Your Minecraft!
Your freedom!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="21d8b735-48b7-465f-a8e5-5e59251ab65d">
          <Text>LulU, PETOSKEY, KIDS</Text>
        </Paragraph>
        <Paragraph Type="Lyrics" id="3b804b35-a6b3-40df-b6ae-a5c5a839578a">
          <Text>My cookies!
My candy!
My french Fries!
My milk shake!
My chicken!
My nuggets!
My kid’s meal!
My Roblox!
My Minecraft!
Our civil liberties!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="80d05901-8ae5-46ea-a498-d21964abe2ba">
      <Text>JASPER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="6f04ada8-52a3-4790-ba65-c92b730fc2ba">
      <Text>You’ve got transportation...
Drinking water...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="df731dee-ba50-4e7c-800b-9f977117af1c">
      <Text>Jasper drinks the milk shakes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d2e8f98-2e4c-43be-b6a4-3f33d8c48134">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="02559e71-ec79-4cb2-92f7-3b6c779818a2">
      <Text>There’re now camp goods and services...
All thanks to the dad tax!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7b8ac37-ac38-4068-9054-0ac998b87ca0">
      <Text>CHERRY, PERRY, SHELBY</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c586ceaf-b0c1-4d0d-9241-e42bd23f9226">
      <Text>Pay your dad tax!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text>[Liz sings about the mom tax. It is more egregious than the dad tax. The kids start a Boston Tea Party-</Text>
      <Text AdornmentStyle="-1">esque</Text>
      <Text> revolution due to being dad and mom taxed without kid representation.]</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="eb856690-b1a3-4f35-8b5f-8c2819a62116">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Dad Tax</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="084c1f5f-7c77-434f-b9df-e9b0bd06b48b">
      <Text>Jasper, the </Text>
      <Text AdornmentStyle="-1">Vandam</Text>
      <Text> sisters, and the kids gather by the bonfire.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="227783d9-600e-4793-b7d0-2e839e72536d">
      <Text>JasPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="97b02e34-65cc-46f6-ae4e-8cd44afefd3a">
      <Text>Looks like during the revolution, you all started the fire! A perfect bonfire to honor Grammy Milly. I’ll go get </Text>
      <Text AdornmentStyle="-1">Grampy</Text>
      <Text> Willy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f23a832f-27cc-43cb-819c-2718aa543ac1">
      <Text>Jasper goes into the lake house.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fbeeb076-4726-4398-a3dd-1bcac275af8e">
      <Text>LulU</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c9038dd4-f4db-41dc-a2a2-b6c9a090a437">
      <Text>One can only wish for a godfather like Jasper.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e7fea9d-4804-4103-9d5f-ba3d62693e95">
      <Text>PetoskEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="12f56fac-4b2d-432b-aba4-475682a8b0fe">
      <Text>You just saw him and our moms tax us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="53d63e90-d0d1-4e5e-bbe7-d7ada6b3b433">
      <Text>LizZie &amp; Shelby</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b07e0ee5-150a-45f3-824b-e2d9b2976317">
      <Text>We gave you welfare in the world, we can tax you out of it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5a12e4c2-45af-456d-974b-f76f6e253368">
      <Text>Jasper enters with Willy. He pulls up a chair.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="887bbd9f-9a5a-4990-beef-46f2d2dbcbe3">
      <Text>JaSPER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e9a3ec27-a8b9-4194-be4b-1f29eda374cb">
      <Text>Why don’t you have a seat here?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ff3431aa-5d71-4ec4-8e8b-9019ade64f76">
      <Text>Willy sits. Everyone sits down.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e60a5c26-de7a-4d83-bc52-da755525ac12">
      <Text>Cherry</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9f3c42f-f914-46d9-865d-b5e1507e4b45">
      <Text>We gather here today to honor the life of Grammy Milly. It’s been a couple years since Milly left this world...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="caef6a9b-21bb-4097-b0e7-3ed9562b1c1e">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e55e0688-661b-41b5-92bf-b54df24cda3e">
      <Text>Actually, Milly came back a couple days ago.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="60d6ebbb-6572-473b-a0ab-593993c61114">
      <Text>Everyone stares at Willy like an old man who lost his marbles.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a3b503bb-134e-494a-9dd9-4381c2b16502">
      <Text>Perry</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1ec31452-bda0-4334-9552-bf1c130a5730">
      <Text>Like in your dreams?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51113c49-4ff1-473c-98ba-1944580030f7">
      <Text>ShelBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4227cda7-7965-49ae-b9a1-0ed619aaa185">
      <Text>Putting him in a nursing home is gonna be a nightmare.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="74f5b3f7-a2b0-4c45-89e5-1996f2a5e539">
      <Text>Willy pulls out a tablet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="540b189f-49cd-4523-8d2c-347736d8bd70">
      <Text>WillY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21dee523-f285-4835-8214-1fc52a73cfcf">
      <Text>Home is here. So is my favorite nurse... on this phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="80fd62ae-42e0-4f5d-95aa-5b0936fee4e2">
      <Text>PerrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a90f221f-0757-4786-810a-93b6aefeee75">
      <Text>That’s too big for a phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="edc6750b-fbe7-4d18-b680-6b3e5a8afd62">
      <Text>CheRRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="43223d5d-759f-4b46-a63a-19b279f96670">
      <Text>It’s how big they were back then.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e9827a5-f566-44ca-819a-8cd653dafda1">
      <Text>ShelBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b1061d2-92ee-463e-8acc-7b356973b88f">
      <Text>Dad, you can’t just call the after life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="97d3b7ee-a2ba-4efc-83ad-58a240a07aa9">
      <Text>WIlLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b1f79fcd-6c0f-4eef-880a-8f41c6f5bc63">
      <Text>Milly, please call.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bc5f9ae7-6cae-47fa-a412-27a9bb493024">
      <Text>Milly appears on the tablet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="876959e6-269a-4446-b082-47be4a5577af">
      <Text>Milly</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ae98669-3e58-4185-a1e1-700df95b2ce0">
      <Text>Way ahead of you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="83b0e134-7d18-450a-be42-9535bf2e4a75">
      <Text>Everyone is disturbed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d671954-72f4-4eb6-a9be-11e91834dcc8">
      <Text>Lulu, PETOSKEY, KIDS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c68c5f4f-7276-4ab4-9f43-876e94c30174">
      <Text>She looks so real!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a174c3d2-c3b4-421e-86af-2153de897183">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e4d5418-bd75-440a-9212-395f1bf391e5">
      <Text>She is.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="869aa9f5-df82-4358-9a7f-43b7d2a6d7f4">
      <Text>Perry</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4c660e00-4d63-4351-95c7-d057c10adc1e">
      <Text>No, she’s not.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fb2cb61-acde-45d3-ad10-da62a4e9f7d1">
      <Text>CherrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7e3570e7-f50e-4ff7-8404-df5ed334f780">
      <Text>She... Don’t break dad’s heart again.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2447a35f-0ca5-4e01-ad75-3e444eed61b7">
      <Text>Willy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a0865e23-8e8a-4771-8230-ba4549de2a4b">
      <Text>You all have seen enough of your mama. I can ask Petey to call.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5fba4f57-7181-4531-9efd-214cdb848bfb">
      <Text>Liz covers Petey’s eyes and ears.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3e4ba71-45ca-4ed6-8f27-f2f5ec3823a3">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86a6a6db-75ab-4692-85d7-d56aed41ce5e">
      <Text>No </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a336b894-0034-4014-abd6-c6d652634276">
      <Text>JaspER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c05a5b13-0126-4395-93cc-a8b86b731677">
      <Text>What did this cost?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ae80819-1622-4f0e-b4b8-583d364961c9">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c9a35dbb-1c9e-4f29-9ed5-9d9871c99b78">
      <Text>Very little.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18adf77e-6038-4607-829b-07701124260b">
      <Text>CherrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cea1fe14-5f73-43be-ad56-4915abd0cc65">
      <Text>How much?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7ef2c38-f808-4ddb-91fe-5c9a0ba58de4">
      <Text>WilLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9bf5e31-8c34-4f79-81f9-70784b55d862">
      <Text>My son was worth more than...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1521283c-f4d2-45db-b6db-221947ff194c">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f9ab6a5-49b1-4f1b-ad5f-ae8e6e0adec7">
      <Text>...the house...?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5897b284-63cc-46af-9cc3-a9a4bef358e8">
      <Text>Wayland slyly steps in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c94ffb4-d507-4938-9728-e86c54a011ed">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="337c8d53-40d0-4c69-b00c-fdf73f5805fc">
      <Text>Yes, access to Afterlife dot AI was on the house. I see it’s a perfect time to come in when everyone seems fired up. Cherry.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="432c845c-fb77-486a-b32a-d3b5508a0007">
      <Text>CherRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a322bcd-135e-4b5f-8a20-cb171dd98b9a">
      <Text>Amanda...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a72aff1-62c4-412a-920a-04bc4644cbcb">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d27c965-0cb6-438a-8270-8578de3a6bc2">
      <Text>How’s making ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text> kiddy costumes for your dumb Harbor Days parade?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8988bb9-e343-473c-8460-c805595b0866">
      <Text>CHERRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="147c06a6-2c96-4224-8106-2c2f1b8fc61b">
      <Text>How’s making anything? That’s right. You can’t.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cdc32957-aca9-44d1-badc-5b24d29f2bc2">
      <Text>Lulu</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6765c9ed-a30d-4ea6-842f-09d1b91a6640">
      <Text>Who’s she?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe595877-06b5-4b41-87d8-589651e76b43">
      <Text>PerrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2c36dc2d-3fd6-49ce-9254-e58c3975074a">
      <Text>Amanda Wayland was Cherry’s classmate in Hope College art school.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="979a6eed-fea4-48b0-823c-64edb0a4424a">
      <Text>ChERRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="717e50cc-8825-43fd-9fb7-033d26834e7b">
      <Text>Until she was caught cheating with Photoshop.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="532696b4-6bd4-44d4-b3e2-a8f3abf35867">
      <Text>WaYLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e928c6b-3419-474d-8e85-13551f94d870">
      <Text>And now everyone’s using Photoshop.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06496197-b641-4c79-a4e4-96391c4f22f9">
      <Text>Shelby</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d21338c0-5e2c-4c9a-900b-d88a75d69f0b">
      <Text>Don’t you use that, Cherry?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c0cc9f4-595b-47da-9ee5-44e6395f6417">
      <Text>CherrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff2542ac-0939-494c-a564-83e3ea027e3e">
      <Text>Shut up. I use Corel.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="280eef35-23fd-4a4e-abc6-0bd31afc28fa">
      <Text>PerRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5c6b2db-d24c-4019-a3ac-38d595916a61">
      <Text>You geezer. Who uses Corel?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7bcfd270-466c-41c0-b123-6c2def723076">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5977c45-cce1-4ae5-a01f-cd96deb9eb54">
      <Text>And I did complete my degree at U of M.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="07332c4e-a2f6-43c9-99a0-a1199d43f96e">
      <Text AdornmentStyle="-1">VanDAMS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a80defcc-da48-4e6b-ba96-acdb8294b27b">
      <Text>Ew... The Wolverines.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="170d57ff-e0b5-426b-8cee-13fa150d86d6">
      <Text>Kids</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="914c0d16-03f6-4762-a447-6286b475aa75">
      <Text>Rabies...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="04a2fa89-3db4-488f-929b-79e1c6275b79">
      <Text>WaylAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b462dc7-1bd0-4cad-b6a9-0cc772686143">
      <Text>Bite me. Now, everyone around the world depends on me to get through the day, answer questions smart and dumb, answer questions dumb and brilliant, read novels, </Text>
      <Text AdornmentStyle="-1">wirte</Text>
      <Text> essays, entire musicals-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8cfc183f-c6b0-4760-9f89-63fd93878cc5">
      <Text>LuLU &amp; Jacob</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="78700bd9-8588-460e-8d85-b27650e37e1d">
      <Text>Shut the f-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d249d19d-eba2-4293-b28d-0e146f90c960">
      <Text>Cherry &amp; Shelby</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f59a4a44-bcc7-4b9b-ab02-df46d9652f07">
      <Text>Language.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e2828c8-1a37-48da-8f22-44ed68d32098">
      <Text>WaylAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20e5be32-89d4-41fb-b610-067b2cd60247">
      <Text>I didn’t get to the best part of. It does the impossible. It brings the dead to life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68f104d4-8470-4447-9d68-403068a61df2">
      <Text>PetoSKEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4cf83a4-e96c-451f-954b-33b2f2303a96">
      <Text AdornmentStyle="-1">Deadarse</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="afbe72c1-63ac-47cb-b0b9-d1cb8d7bb449">
      <Text>Everyone stares down Liz.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e18ffb83-53c5-4912-8509-0f368307b41a">
      <Text>LizZIE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="811e2851-65b8-4fc4-88a8-13781b6e7133">
      <Text>We Yoopers do not police language.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4443c7ef-3baf-4645-b2b0-19e58df855af">
      <Text>CherrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0669b2c6-524c-48ed-8d27-8e4aae7883ad">
      <Text>Get out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ed928f5-252e-4058-bc8b-03e4c1c39ede">
      <Text>WayLAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4e5ffb69-db7b-4f92-b6b0-845f577d0ef9">
      <Text>You’re impressed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b8cb4f07-bb5b-463f-83d4-85d7c9ff0d7c">
      <Text>PerRY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d51890a1-6474-43b6-945f-a3b6bb744975">
      <Text>Depressed. Seriously, get out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c37b462d-acf9-4b75-9630-0d11458f8fb8">
      <Text>ShelBY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="658203ce-bcbb-4000-96a5-00c7a28bf48c">
      <Text AdornmentStyle="-1">Vamos</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fd56c206-7d16-46b9-bc13-2073e113fb22">
      <Text>JaspER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c36f9076-c5c7-4766-84db-6ba4a7c7501c">
      <Text>Willy, implore this morally ambiguous woman to leave the premises.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4c45192-f4ed-4f9d-8e8b-c7899fa888f3">
      <Text>WaylAND</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af633b9e-b737-4c53-910f-f4b51d605108">
      <Text>The premise is... I own your lake house. There’s a Willy, there’s a way. Willy, thanks for not making the same mistake your son made.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="711235e8-e9c1-4982-b384-e73d9fa8f7b0">
      <Text>CherrY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="87ecf7de-bbd2-4b04-9bc5-0f8014dc9e3d">
      <Text>To maintain the premises...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2b317a2f-acac-442b-b0d3-0eb725b26d30">
      <SceneProperties Length="1 6/8" Page="23" Title="">
