      </SceneProperties>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">4. “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">Life After (the End of the World)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Company</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Life before</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Thuy</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>We lived in a paradise</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>AdrIENNE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Made of wine and fish oil</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Company</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>Life after</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Moses</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>BUt now we got karen
to take us to the soil</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>Company</Text>
    </Paragraph>
    <Paragraph Type="Lyrics">
      <Text>We’ll rise above as best we can
to make peace with our fellow man
Take us to where it all began:
The beginning of the world.
The beginning of the world.
The beginning of the world!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General">
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">End of “</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#00000000FEFE" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline+AllCaps">LIFE AFTER (THE END OF THE WORLD)</Text>
      <Text AdornmentStyle="0" Background="#FFFFFFFFFFFF" Color="#000000000000" Font="Courier Final Draft" RevisionID="0" Size="12" Style="Underline">”</Text>
      <Text></Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Blackout.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>FIN</Text>
    </Paragraph>
