<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20260521T192316" id="91b3ee3b-fead-4120-b32a-a2a227ec2976">
    <XRef DateTime="20260521T192302" id="ff851067-eb61-4515-8e12-9eadf1c73d8e"/>
  </DocumentRef>

  <Content>
    <Paragraph Alignment="Center" FirstIndent="0.00" Label="Scene 1" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="Yes" Type="New Act" id="fba577a0-fa45-49c5-8f87-1e252331a4c7">
      <Text Style="Underline+AllCaps">Prologue</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="987c3cbc-adb0-4eed-895f-9c2ec73d05c3">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Solar System</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="93d78288-cd47-42a1-bc05-4a7a4a908f37">
      <SceneProperties Length="2 7/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CHILD NATURE 1">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHILD NATURE 12">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHILD NATURE 4">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE 1">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE 12">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER NATURE 4">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">1. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Mom, I made Earth</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="79621969-d8c4-48e3-8a84-1fee599aa112">
      <Text Style="AllCaps">Mother Nature</Text>
      <Text> 1 and</Text>
      <Text Style="AllCaps"> Child Nature</Text>
      <Text> 1 traverse the spacetime landscape.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8480041-62e5-4d2d-9ba9-461455018661">
      <Text>Child Nature 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e7d5fcc-b698-49a6-944d-6f766363e514">
      <Text Style="AllCaps">Mom... Mom, Mom mom!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dda7c62d-c026-40d0-b012-adc4abf56686">
      <Text>Mother Nature 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4ef6a9e8-34bd-43ad-bc73-5a90d091dd64">
      <Text Style="AllCaps">We’re getting warmer, dear!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a098e20e-cbdd-4157-8ceb-4d04c3aa494d">
      <Text>The Natures move past Mars, an empty space, Venus, Mercury, before reaching the Sun.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c3439c9-d27c-4a13-bd75-c846d7072518">
      <Text>ChilD NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f0228f0-3af1-4b4c-b17e-15dae3f0b42d">
      <Text Style="AllCaps">Mom! Too warm!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52cbf8ed-82f5-48eb-a6c5-1fb8c4776ab0">
      <Text>MOTHER NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b57f321-74c5-48af-a097-46b2392aafa6">
      <Text Style="AllCaps">Let’s visit another star system.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cc80caef-52a5-4187-9433-d8b153dc5d7c">
      <Text>As the Natures walk back through the empty space, Child stays put. They hide something behind their back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="945d5f67-d840-4729-babf-d59d73cbbd87">
      <Text>CHILD NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="698f28a3-1111-4fda-a09b-4d2d6836c597">
      <Text Style="AllCaps">Mom... Look what I made!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6cfdc0c6-ca88-4ced-815c-a29072feb7ba">
      <Text>Child pulls out a sphere of Earth with Pangea.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cb374928-3d69-43e7-8251-5f80c7636199">
      <Text>MoTHER NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="471a8ed4-6ef0-47ed-925e-81730ab2eeac">
      <Text Style="AllCaps">That’s nice, dear...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2639248c-20e7-4d7c-81f3-065f15c3ad52">
      <Text>CHILD NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f390de4f-26cd-4e35-a9e9-93a7035d3bfe">
      <Text Style="AllCaps">You don’t like it?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e7c02f2f-f174-4a26-bec0-6c2f523c8637">
      <Text>MOTHER NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a2654c5-d0df-4f6b-8743-e2601f705800">
      <Text Style="AllCaps">Mars got water. And the universe did all the legwork.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e6a398e8-8a10-448b-843e-26288a887040">
      <Text>Child sits down, defiantly. They violently set down Earth, causing the Moon to roll out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3c58d4eb-97d4-46d0-a39a-1723b31a1955">
      <Text>MoTHER NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5b6736b-6b62-43c0-ac93-bb932415d1ad">
      <Text Style="AllCaps">Be careful. Now, they gotta moon. What’s their name?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b45b210-03ec-4b82-8d2e-a4786e8ca474">
      <Text>ChiLD NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3288a01d-17fe-4b10-9f15-65787edd6569">
      <Text Style="AllCaps">Uuhhhhffff-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a73fa1e1-c775-444b-b754-8f83beeb71d3">
      <Text>MOTHER NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="edd1f648-46a2-4ef1-a9fb-3f0ab50b8567">
      <Text Style="AllCaps">Uuhhhhffff- earth?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eed6cd8e-26e6-4242-b93e-430f4b3a9967">
      <Text>CHILD NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="80c8bb5e-4845-45d2-bb40-30d61b31305a">
      <Text Style="AllCaps">Mom, I made earth!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86d0f21d-e153-4968-9101-37f9a61f3232">
      <Text>MOTHER NATURE 1</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57c4d492-e806-4796-a8fa-f4b8d75a7ffc">
      <Text>What a ridiculous name... I love Earth!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d284dabc-3476-4457-97b5-2b0845b3347c">
      <Text>Mother Nature 1 and her child hold Earth together. The Earth expands below them.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="ac2e0cfc-aa24-4c8d-bd99-aa1e1d38e815">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">mom, I made Earth</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aa968da6-e6e0-4380-8272-232d6efb5a55">
      <Text>The current Mother Nature (13th Gen.) narrates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69abee9a-4d56-40c7-99d6-9cb725156261">
      <Text>Mother Nature (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="1ebb340d-6903-4065-bd35-63a032ceb757">
      <Text>(Narrating)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="799f4c4b-8ff3-43c0-a006-19ef09696039">
      <Text>Earth is over four billion years old. Billions of moms lived on this space rock. But none are as messy as the Mother Natures. The original Mother Nature introduced the first bacterium.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1cd1b73a-8a6e-4d51-8a33-06be601eaeb4">
      <Text>Child Nature 1 draws a bacterium on a cosmic tablet. Mother Nature 1 takes a peek and creates it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a09bc6a9-cd7f-4405-9393-6d995105d1b3">
      <Text>Mother Nature (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="304d4161-5275-492b-9ac6-275675dd9a21">
      <Text>You see... She comes paired with her own germ- I mean, child. Child Nature would draw a creature for Mother Nature to make in their image. Then the Child would grow up to be the next Mother Nature. The previous Mother Nature passed away... And the cycle continued.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="63c2e170-142b-422b-aaf3-009d1f9919b0">
      <Text>Once Child Nature 1 matures into Mother Nature 2, Mother Nature 1 passes away. Mother Nature 2 conceives Child Nature 2. They introduce the fishes and corals. Then, generation 3 introduces the rats and dinosaurs and trees, then Child Nature 4 turns their cosmic tablet to reveal a...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6ddc5ead-dc60-4407-9160-d0880451e7f1">
      <Text>Mother Nature 4</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16520559-7962-4c6c-963f-3073a0ad3c1a">
      <Text>Ew... Watcha call that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="284b6029-8b22-4fdc-9b22-8aa117e3c937">
      <Text>Child Nature 4</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49ab2f48-0d7d-41fb-a426-576457f79e96">
      <Text>Cockroach!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7d1ee61a-ba98-4252-8668-cae738bb1179">
      <Text>MoTHER NATURE 4</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="691e19ad-4bd0-489d-bcc5-6867a35cd0b5">
      <Text>How is a name worse than the drawing? The cockroaches are a fad. They won’t last.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3de67212-917d-408a-8e1b-698e62b616d7">
      <Text>Mother Nature 4 creates the cockroach.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c29100db-4083-489f-8bd3-7049e09c4d92">
      <Text>Eventually, generation 10 has Child Nature 10 who draws most existing creatures nowadays.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="480eb2d0-c315-4bbd-ad3a-264c4af9b10e">
      <Text>Mother Nature (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e665264-789c-4a65-bd4a-918d477ac987">
      <Text>Generation 10 were a pair of overachievers. They created most of the animals you once saw. Then Generation 11 was just... burnt out. That child became my mother...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b8424a2e-9922-4647-9430-7f3cb9f3ab2a">
      <Text>Generation 11 is demonstrably lazy and had nothing to introduce. Child Nature 11 becomes the current Mother Nature’s mother. She turns Pangea into the current shape of the continents.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c282212-3327-474f-a591-3fc783842d61">
      <Text>Mother Nature (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b44f95ce-e176-439e-ad7a-ce888c610c08">
      <Text>Then, there’s me... I actually created something that didn’t last long. Can you guess?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5b00b21a-457e-4652-9e20-b89811217eb3">
      <Text>Child Nature 12 points to the audience. They turn their cosmic tablet to reveal drawings of homo homo sapiens.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="56351e99-f67e-44d2-a33c-a50babec6b08">
      <Text>Child Nature 12</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d4913e9-825a-4bc3-8a3e-ae8813abb204">
      <Text>Homos!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5cf8c4e9-c183-441b-b000-11ac1fbc85b6">
      <Text>Mother Nature 12</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f584f1ac-be63-4c0d-9484-e7c64c5f10e0">
      <Text>There’s gotta be a most respectable name... Homo homo sapiens?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1e4d6dcf-317e-4da1-b099-93000738efa7">
      <Text>Child Nature 12 tries to get the audience to say...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb7f0721-1bd4-4c86-be31-45711e5ac2fa">
      <Text>CHILD NATURE 12</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9bfff890-7354-4c9b-a9cb-7125d4ac379f">
      <Text>Humans!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b3acba8f-4759-459a-8666-5f376153bc91">
      <Text>Mother Nature 12</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ca7163d-f2a1-46b2-8768-8bcbb66fe6d7">
      <Text>You’ve got it!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b9ecab97-0c53-41ba-be1b-b7ef12161118">
      <Text>Mother Nature 12 creates humanity.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b9ecab97-0c53-41ba-be1b-b7ef12161118">
      <Text>Child Nature 12 grows up to become the current Mother Nature (13).</Text>
    </Paragraph>
    <Paragraph Type="Action" id="88e90a9a-f545-449f-804f-f73e5527b2d9">
      <Text>Mother Nature conceives a child whom they name True Nature.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="4e0cb58b-da8e-4d01-89cd-00236b9fb6dc">
      <SceneProperties Length="2 4/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MOTHER NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TRUE NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">2. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">In My Image</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="81266f6c-3214-4c3c-ae6f-15d38d223bf7">
      <Text>The history of humanity soar by in the background.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52909433-242f-4297-a2d7-2f3cf4eb0c72">
      <Text>True Nature</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c3e6d21c-2e64-42c7-8720-8c912e56053f">
      <Text>Mother Nature?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4231b986-adeb-40b1-8005-2e55edcd6fd7">
      <Text>Mother NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="48802a38-92f8-4863-bc8a-65b729f6ccef">
      <Text>Yes, True Nature?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da77c24a-7def-4d72-9606-5546ed46af9b">
      <Text>TRUE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0eda989c-0ee4-4daf-8242-2774038ce719">
      <Text>Who are those?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63cce265-b8ce-4ba8-a443-c026feb2c75b">
      <Text>Mother Nature</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c67a9730-6075-44f9-8693-e3d3ba8905fe">
      <Text>The picture of independence...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="71fd4d41-f05c-483b-8bcf-3314cf831e59">
      <Text>Figures of early humans emerge, working together.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="23a5a769-e0c1-478b-b932-78e0c244da17">
      <Text>MOTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e77a24c5-691c-42d3-a306-0b620fb7a5cd">
      <Text>Look at how they tend the soil
Sharing fruit and sharing toil
Hand in hand
they build a home
No one scared, no one alone
They are clever, they are small
Lifting up when others fall
They look up and see my face
Filling up this empty space</Text>
    </Paragraph>
    <Paragraph Type="Character" id="223abea6-b4de-4eab-a9bd-41ce158a425b">
      <Text>TrUE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="49fdc0fb-7751-40ea-837b-1bd1c0d67678">
      <Text>They look like us! They move with grace!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be4eb2e0-768a-41d0-b626-80ff2596c4ac">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c6879dd4-b05d-4747-8fee-640d53b19c9d">
      <Text>They are the crown of my design
A little piece of your spirit and mine</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e4c08a04-1322-4de8-8ace-0d918e9b8007">
      <Text>The tempo ramps up. Time speeds up as industries grow. Fires ignite, stone turns to bronze, then iron.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5afdec3b-b96a-4cf3-962c-0ec78a28343f">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="13ded377-17b3-455d-bccb-6b54986108a7">
      <Text>They build a tower, they build a wall
They stack the stones to make them tall
But look, they carve a heavy gate
To shut out those they learn to hate</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b4e89fa8-000f-427d-b75e-9f7901d5a47d">
      <Text>Humans begin dividing land. Weapons appear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27063976-b795-480d-824d-3f7ed90f0776">
      <Text>TruE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="0a68f91e-4587-42e2-9464-49df7ef0894d">
      <Text>Why do they clutch those sharpened sticks?
Why do they break the homes they mixed?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b86c0b3a-c7ea-4151-b0db-64be015ba93f">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5ca496aa-49cf-4610-abde-d872e3e54cc0">
      <Text>They claim the river, they claim the tree
They draw a line where all was free
They take too much, they want the crown
To burn the neighboring forest down</Text>
    </Paragraph>
    <Paragraph Type="Action" id="99f4e6b7-1571-427f-a0de-60232c0251a5">
      <Text>Factory smoke, pollution, and marching armies appear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="77a95004-368e-413d-999e-4f8268d3f1c0">
      <Text>TruE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a70bc954-bb3e-4a23-bb44-c9d1dcd86b30">
      <Text>The green is fading into gray!
Mother, make them look away!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67001d49-da56-4b2b-8eb2-69fa5af81216">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="142226d5-f3d7-477b-b3a1-915067c15d67">
      <Text>In my image...
I don’t see a...
In my image...
I didn’t see...</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="56dfea3c-a029-481c-86bb-867171f6c2f6">
      <Text>Fighting?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="30834977-ad39-4726-a53b-c4763fb071f9">
      <Text>Percussion mimics the sounds of gunfire and heavy machinery along with a blinding flashes of the War to End All Life.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dc3c8f71-6d67-4561-aeab-f100ddf20096">
      <Text>MotHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b7985ce5-242d-4a46-9798-603066ab08a7">
      <Text>Stop! Put down the fire! Put down the stone!
I carved your flesh from my very own!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c0f89e2-690e-40e6-a8d3-42537dc2bdb5">
      <Text>TruE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="e013d4b7-87df-4183-9eaa-d58724c036ef">
      <Text>They’re crying out, Mom! They’re trapped in the dark!
They’ve lost their way, but I still see the spark!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf972673-0e33-4e9d-9487-062feeca079b">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="a6f8c409-0ffc-4c9e-9802-9efd7b4f6b62">
      <Text>No, True, step back! The smoke is too deep!
The seeds of their anger are ours to reap!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c4340c08-1fae-4a13-9bc1-b16b3b0ec71c">
      <Text>True breaks away from their Mother’s grasp.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c25c623-b7cc-4458-9339-1c0dbbb65f5a">
      <Text>TRUE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="5b07079a-16b5-4a10-af51-e1c742f051ad">
      <Text>If they are made in your image, then they can still love!
They just need a hand, not a storm from above!
Look at me! Look at me! Remember your birth!
I am True Nature! Your piece of the Earth!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8f60fff4-a9b5-456d-9af0-06642c6532b5">
      <Text>True Nature tries to reach for humanity. Human figures turn their weapons away from each other and slam them down towards True Nature. Humanity with their warfare, diseases, and greed turn into the warm embrace of death.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9400642b-7641-4363-86f1-a90b176404d2">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="22085f3c-fd09-4470-9129-b9fccd795ccc">
      <Text>Tttttrrrrruuuueeeee!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="26235dcb-c567-4de8-873f-41bed42b8ef7">
      <Text>TRUE NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c0c7324b-addb-4df6-b89f-ab68c0621a1f">
      <Text>Mother... I held them...I wanted... to heal...
But they only know how to tear... what they feel...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="176a5a1a-46cb-41f5-b22e-7a8ea0a93c58">
      <Text>True Nature collapses into a shadowy heap. The human figures violently scatter and vanish into a nuclear blackness.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a3cfb5e0-2f3d-44ea-93b7-5dd6df2dcbe1"/>
    <Paragraph Type="Character" id="f995b4df-495a-45a9-a3be-48defe0862d6">
      <Text>Mother Nature</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fd40558c-ae39-47ab-a05b-2ec54aecf1cb">
      <Text>After 13 generations of the Natures, I was the first Mother Nature on Earth to lose her heir.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1c376001-f9ab-461b-8422-f21a31e0cdce">
      <Text>Mother Nature drops to her knees, crawling through the ash. She clutches what remains of True Nature’s shattered form to her chest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43e46a4e-bcac-464e-8bbc-0a072e42cee3">
      <Text>MoTHER NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="89e9d82e-379d-4a44-b3ff-e83fc66cf559">
      <Text>In your image...
I see the damage...
is done!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="88f357b6-fc14-448f-94e3-a1c124b0e21a">
      <Text>Black out.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="8ed09cbb-b597-4331-a50a-d38931b9d05c">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">In My Image</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Label="Scene 1" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="Yes" Type="New Act" id="a8fba8e0-494e-495c-9fde-4e13839b57e2">
      <Text Style="Underline+AllCaps">ACT I</Text>
    </Paragraph>
    <Paragraph Label="Scene 1" Type="Scene Info" id="3c2b4e8d-9541-47b6-98d4-4e4a6d24dd6f">
      <Text>Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="15bc3f00-0033-48d3-b049-e21c1968c3ab">
      <SceneProperties Length="1/8" Page="7" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Future Earth</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="e5859456-1acb-4192-912c-8ad9143b34af">
      <SceneProperties Length="2" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="SECOND NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Underline+AllCaps">3. “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Another Chance</Text>
      <Text Style="Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="513cb0a4-f060-4e69-9d0e-812d021b7e45">
      <Text>The stage vibrantly lights up. Extinct flora bloom across the landscape. In the distance, Mother Nature stands perfectly still, staring out over the horizon. She holds a broken artifact from the old world, completely lost in her centuries-old grief.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="513cb0a4-f060-4e69-9d0e-812d021b7e45">
      <Text Style="AllCaps">Good Nature</Text>
      <Text> runs onstage, currently taking the form of a hyperactive, shapeshifting dog-like creature.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="95b2b01d-d4c8-4c93-b11a-7d0e52656d12">
      <Text Style="AllCaps">Second Nature</Text>
      <Text>, a teenage diety, runs across the stage, completely out of breath and trying to catch up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62df0dd8-c376-4a33-934d-69f902fae787">
      <Text>Second Nature</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c03f00ad-0af6-44f3-b414-b82a65192d39">
      <Text>Good Nature! Good Nature, heel!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="57435c98-6239-4823-a310-dc03297446a3">
      <Text>Good Nature morphs into a kangaroo and hops away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f349f33-b3e8-4460-bf18-2d04e801a339">
      <Text>SeconD NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="8d5daa9a-1a52-45c9-903c-0fd6f310c781">
      <Text>Oh, come on! Shapeshifting is cheating!

Wait up, slow down, give me a beat
I’m tripping over my own cosmic feet
Mom says I’m fast, a brilliant mind
But I’m thirty years late and running behind
She named me "Second" to watch the earth grow
To paint every river and put on a show!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ac5855f6-8cb5-42f4-ad21-30c3b5b492af">
      <Text>Good Nature morphs into a dodo bird and squawks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b388a865-f640-4bfb-897d-0a8a145314df">
      <Text>SECOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="b97cebd1-9c2c-4290-bbcf-de86dc79edff">
      <Text>But look at you go, a brand-new design
A little bit yours, a little bit mine
We’re bringing back feathers, we’re bringing back scales
From microscopic germs to the largest of whales
They call it evolution, but we call it a game
Every single creature getting a name!
</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33e46210-b497-47bf-9299-326d81f328c8">
      <Text>SecOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="50312782-919f-40a0-b4ff-079f63a23896">
      <Text>Turn the page, clear the stain
A beautiful planet with none of the pain
Yeah, look at us now, we’re taking the stance
We are the spark of a second chance!
No wars, no cages, no fighting in sight
Just you and me bringing the darkness to light
We’re drawing a future where everything grows
We are the second chance that nobody knows!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0eb188a4-d0a0-43f6-a18d-289335211512">
      <Text>Second Nature stops dancing and slowly turns to look at Mother Nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69779d28-3293-45c1-b67b-475a2f131ede">
      <Text>SecOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="3816c759-80fb-400c-99fd-b3386d88597c">
      <Text>But sometimes Mom looks right through my face
Like I’m just a ghost occupying a space
She looks for the firstborn she lost to the flame
And she calls me her "Second"... but is that a name?
Am I a new spark, or a shadow of True?
Am I here for me... or a replacement for you?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4576be7a-03a2-4a36-abc6-139461d2f1d5">
      <Text>Good Nature trots over, morphing into a dog, and nudges Second's hand. Second smiles, breaking their gaze away from Mother.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9aae6207-8853-4f6b-ab5c-6641573fa336">
      <Text>SeconD NATURE</Text>
    </Paragraph>
    <Paragraph Type="Lyrics" id="c53a0799-2e6c-4226-9201-38e2a8066d75">
      <Text>No! Turn the page, clear the stain
A beautiful planet with none of the pain
Yeah, look at us now, we’re taking the stance
We are the spark of a second chance!
No wars, no cages, no fighting in sight
Just you and me bringing the darkness to light
We’re drawing a future where everything grows
We are the second chance that nobody knows!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="ba032b00-0513-4ff8-a072-250118eae1b3">
      <Text Style="Underline">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Second Chance</Text>
      <Text Style="Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e24deadd-c45b-4d0f-b602-0b5ce22cea86">
      <Text>Second Nature throws a stick deep into the brush.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6efb243b-3812-4b53-9f3e-d0e09759db93">
      <Text>SeCOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ddf1bd80-ee4d-4389-83cb-8ad7b3fa8ff8">
      <Text>Fetch! Go get it, buddy!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9d21f171-ffcc-4a07-a5fb-dd17738c9316">
      <Text>Good Nature bolts off-stage.  Suddenly, a </Text>
      <Text Style="AllCaps">snap</Text>
      <Text> echoes, cutting the music dead. Mother Nature snaps her head towards the sound.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f3258de7-8bac-4e8f-a8ee-e1fc78ab92eb">
      <Text>Good Nature yelps.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de766f69-5fde-405e-b84e-7d0e4793146a">
      <Text>SECOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c65201b5-5318-407c-809e-ec85cc3d0f9a">
      <Text>Good Nature?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="034e4d4d-c768-4b94-8a3c-2d08cdaed2cd">
      <Text>Second Nature sprints into the brush. Mother Nature steps forward out of her spotlight, watching them go with deep apprehension.</Text>
    </Paragraph>
    <Paragraph Label="Scene 1" Type="Scene Info" id="55522e63-d752-48e8-80a3-cafdb9430cfe">
      <Text>Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="dce29d57-7100-4f8d-85ec-5caeeba465f8">
      <SceneProperties Length="1 5/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="IMARA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SECOND NATURE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Future Australia</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f1386c72-c8b4-4e62-b4b2-099802dce720">
      <Text>The stage is plunged into a dense forest aesthetic. Thick brush and twisted vines dominate the space.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea43afe2-17e6-432c-bd59-242b91518425">
      <Text>Good Nature has morphed into a shivering fox-like form, with their leg clamped tightly inside a bear trap.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fafb4298-a116-431e-95df-f5a38d1fdc86">
      <Text>Standing over Good Nature, holding a crowbar and wearing scavenged gear, is Imara Truth, the very last human alive.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a04d0d0b-e0ac-4ded-9f1d-8c02281a4fa7">
      <Text>Second Nature crashes through the foliage.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afdf02f4-84fc-4730-b728-52d42ef2fa4f">
      <Text>SECOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="675fb8fe-0bd1-4804-94d0-3230e7fcc290">
      <Text>Get away from Good Nature!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f4fa70a2-29b0-43ad-a9f9-33ed4bb58e82">
      <Text>Imara flinches and raises her crowbar like a shield.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="849ca75c-e0a8-4d01-9d8b-fbdbb480ecac">
      <Text>Imara</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9922a66a-d80a-48e2-96c7-f731c848a2b6">
      <Text>I didn’t set it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0baa03b2-3c27-47df-9b07-22be86e9a668">
      <Text>SecOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5028cf3b-8237-43fe-bfa2-0d14a2a51092">
      <Text>You're a human. A real, living human. Mom said you were all gone!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a0bb0668-5772-4b23-b3ad-4c520e0b08b2">
      <Text>IMARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2810478-06df-48c9-9951-03043eb91c9e">
      <Text>She is not far from the truth. I’m not all here, mentally.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7167edc6-d019-47cb-80bb-ad9b963e0436">
      <Text>SecOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2d89eeb-2440-4f6e-9853-5e7b8f7dc430">
      <Text>You’re freaking crazy for building this torture device!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4045f0bc-87a5-4ebc-8b2a-c0facb18d7f4">
      <Text>IMARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c499460b-e6c0-43d9-a9a5-fe64e860ab3b">
      <Text>It’s leftover garbage from the old world! I was trying to pry it open before you came crashing through like a hurricane! Now shut up and help me, green diety!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a490f775-df10-40f5-a145-64fbe2761b9c">
      <Text>SECOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b3f42f8-fb16-42be-b070-97a5ae377ebe">
      <Text>You're... you're trying to help Good Nature? But you're a human. Humans only know how to tear down what they feel.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ece1ce0d-cc52-42ba-8de8-fdf40957dd2b">
      <Text AdornmentStyle="-1">IMARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8e8ff1b3-64d8-4a1f-9c15-3ba45420daf4">
      <Text>I don't know what crazy fairy tales you've been told, kid, but right now, this... watcha call it... is hurt. Grab that side of the spring.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d5faa173-9d07-48ff-b458-b45fb0bb74eb">
      <Text>Second Nature hesitates for a moment then sprints over. They grip their divine hands on the trap opposite </Text>
      <Text AdornmentStyle="-1">Imara</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15e1757a-8660-42ae-bd18-0d4617492c7d">
      <Text AdornmentStyle="-1">Imara</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="621d6f6e-b5f4-4ec3-918b-3aaf8de427ad">
      <Text>On three. One...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8f015589-f6b3-4e6f-9404-0d24da5fc074">
      <Text>SeconD NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c564c9a-9e1b-4046-a6ac-378d64c9b5e9">
      <Text>Three...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91dfa8ee-33f0-45a3-b7f8-8e3e9d430eb7">
      <Text AdornmentStyle="-1">IMARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b79d5837-23ea-4f7e-876c-1cc356374997">
      <Text>Two’s next.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a516ad3-96f9-4176-ab5b-e069aa8e16f3">
      <Text>SECOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a1e6bebd-3306-4f12-b3f7-122942412fb2">
      <Text>When’s one?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8738eaff-3c9a-4f58-9142-6bcd96d73d09">
      <Text AdornmentStyle="-1">IMARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2ea0992-5757-4fc4-9742-2446f6beafc2">
      <Text>Who taught you to count?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="65ad9ab8-19ce-44f1-abe1-81349e85529e">
      <Text>SECOND NATURE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c0cfe75-8afd-42ae-b090-1c7fa3cec468">
      <Text>Mother Nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="755976bf-38c8-40c2-aae3-84976a2e7544">
      <Text AdornmentStyle="-1">IMARA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dbefc420-e6cf-4db8-ad45-e0bae43adb8c">
      <Text>I don’t know how you gods live this long.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e6b194ac-3b30-40d4-a53b-2c7f3500581e">
      <Text>Second Nature and </Text>
      <Text AdornmentStyle="-1">Imara</Text>
      <Text> both collapse backward into the dirt, exhaling deeply. A heavy silence falls over the brush as they stare at each other—a god and a human, meeting for the first time in ten thousand years.</Text>
    </Paragraph>
  </Content>

