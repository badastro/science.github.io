<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20250602T224137" id="20c2f645-008d-4f96-9d6d-6179d0a77622">
    <XRef DateTime="20250510T005519" id="354b9a51-0b00-48b9-8778-06380c3c1a44"/>
    <XRef DateTime="20250528T101536" id="00164a78-ad41-4ad5-a0bd-f4c793057482"/>
  </DocumentRef>

  <Content>
    <Paragraph Alignment="Center" FirstIndent="0.00" Label="Scene 1" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="Yes" Type="New Act" id="bcb3d77a-d198-4296-b0b6-07103897909d">
      <Text>ACT I</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f99c8fdb-5cbb-43a3-9168-aa9cda3c4e78">
      <SceneProperties Length="1 5/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ERIC">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SYBIL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Bangor International Airport</Text>
    </Paragraph>
    <Paragraph Type="Action" id="013cdc6b-f103-405e-b691-80b56a24503a">
      <Text>It is a bright chaotic August day.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5aed2b23-dd99-49a8-adca-d97f4dfdb3ed">
      <Text>16-year-old </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Cát</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Lý</Text>
      <Text>, enters wearing a horse shirt, a backpack, and a 2018 exchange program lanyard. She holds a sign that reads “Nyberg.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93ee5afe-d2e3-4123-a24d-7068b9b5e5fc">
      <Text Style="AllCaps">Sybil Ma</Text>
      <Text> and her husband </Text>
      <Text Style="AllCaps">Eric Tran</Text>
      <Text> enter, searching anxiously. Eric holds a sign that reads “</Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Lý</Text>
      <Text>.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f3bd98c-97a5-4c68-bda2-a444ef1baf35">
      <Text>SyBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d1d002d0-e072-43c9-a3a6-7bffcb967350">
      <Text>Horse shirt... Horse shirt... Horse...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d0a82fc-19bf-48c5-b54f-f3697abf5b28">
      <Text>Eric</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a20b93f5-e698-4e11-a910-d36c1f1ea60f">
      <Text>We’ve past a dozen horse girls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7f630152-4f2a-4cd1-9d7f-75b0201d0dc2">
      <Text>Sybil</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f98c4382-188d-4007-aa48-dfb5fe16c488">
      <Text>Search an image of her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3af8cce-4454-4a78-836f-d1c7e030fb32">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ede96dee-7e89-45f1-8499-05dcdc2dee85">
      <Text>You know every Vietnamese person has a thousand others with the same name.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fea44f4b-67f5-47f2-b708-d4d7b90f4ae9">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a2524c4-4e52-4496-ad04-0b12755a2fa9">
      <Text>That’s a one-syllable language problem.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5d749e72-2ed9-41b2-acc9-d5325a71b3ef">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> puzzledly spots Eric’s sign.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="31869db1-752f-458e-9b59-38fe11f13575">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="820dc335-0c21-4456-afa7-0f931d9e0369">
      <Text>(Soliloquizing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03d4bf48-4170-4454-b985-62c0707418da">
      <Text AdornmentStyle="-1">Troi</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">đât</Text>
      <Text> oi. You </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> be joking. They promised an authentic American experience. Those who’ll give me an easy name cause they can’t say- </Text>
    </Paragraph>
    <Paragraph Type="Action" id="ef46dd6a-2d7a-47bb-9ca5-fc4f9a0b2158">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> reaches an audience member.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9f5217c1-483d-4932-8a58-05f4d0e13cfc">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71bbb374-9aa3-4f0c-8ff7-bad6855e5585">
      <Text>Can you say my name? </Text>
      <Text Style="AllCaps">Exactly</Text>
      <Text>! Just call me Cathy. Out of all the families, I get...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="ca7ade16-a111-4826-9605-8582f3295961">
      <Text>(Back to reality)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9bb15ee7-52dd-4e45-8d73-613f23d9ddc4">
      <Text Style="Italic">Noble</Text>
      <Text>? </Text>
      <Text Style="Italic">Question mark?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="09982a8d-bc6c-4551-8e5c-eb25888caa60">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d82df4c7-133b-41df-95e0-1947eeb65174">
      <Text Style="Italic">Hon. Let’s not start off correcting names.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8986c4cf-ff3e-4202-accd-e0b8f5ddd105">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="64aa18ef-07ef-44a8-bf02-24286256eed4">
      <Text>Xin </Text>
      <Text AdornmentStyle="-1">chào</Text>
      <Text>. I’m Eric “Noble.” It’s my adoptive family’s legal name. But I’ve taken back Tran.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66997e23-a85a-4e0a-a343-b53239e7faaf">
      <Text>The couple walks </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> to the car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1fd99100-6e5d-4440-ac92-583d03b3af38">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3087a0c1-4ea9-44e0-a2b3-bb0e70a0de86">
      <Text>I’ve kept Ma. I’m Sybil Ma. Welcome to Maine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37c6b481-25a9-47df-8f64-bd0732fd7be5">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ff52609-25f0-464e-a459-bcd2d7f7730e">
      <Text>Good day, Mr. Tran and Mrs... Ma. It is an honor to make your acquaintance. I am Cathy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="057f2aa2-5d8a-4502-a3d5-c44d784663f3">
      <Text>They drive. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> sits in the back, looking out at pines and granite.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91ab7029-a213-4044-87be-6641bcb1ea2b">
      <Text>ErIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="daafb31b-62dd-4aec-a12f-5bbe31bc6021">
      <Text AdornmentStyle="-1">Nhìn</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">gì</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="17e62cf3-025c-4412-889a-ad9af36e1499">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a61affb-8719-47f7-bb3b-9b9c52ca98b8">
      <Text>Nothing. I much prefer you speak English.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="850b85db-6bba-4624-86e5-e00668761520">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> takes out her phone and texts.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11290de1-c3c8-4ef2-b773-24d2c384ff1c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="57a0cd3b-723f-420b-ac8a-ae1a827d8ae9">
      <Text>(to herself)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5cae33bc-2728-4ab2-8b20-9ff3acf083f5">
      <Text Style="Italic">Dear Exchange Program Coordinator. I wish to report an error. My host family is </Text>
      <Text AdornmentStyle="-1" Style="Italic">Asi</Text>
      <Text Style="Italic">-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="55b3531d-963d-4578-a8a1-a6f7c41799fd">
      <Text>ErIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="60a54eac-07f6-4942-9232-3f55e686b9db">
      <Text>By the way, our son is excited to meet you. He’s a bit of a hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7108681e-b787-4d8c-972e-b0940f3df384">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b68e06ad-4e32-4433-b580-c637f35f70ba">
      <Text>The word is </Text>
      <Text Style="Italic">introvert</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9f3773e-6e4e-4495-ac1c-f4e5fead4438">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="87b08d8b-09a7-42df-9553-5ac96f317c48">
      <Text>(Sighing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="434229b9-04b5-46ed-821d-1ed345a047dd">
      <Text Style="Italic">This family needs friends.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="88e35002-0bb4-4f46-b7d8-a0c46c351db3">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f99c8fdb-5cbb-43a3-9168-aa9cda3c4e78">
      <SceneProperties Length="1 3/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ERIC">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SYBIL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Tran House</Text>
    </Paragraph>
    <Paragraph Type="Action" id="60324b0d-b581-451d-a467-348c828a2593">
      <Text>The house is cozy as can be with a living room and bedrooms.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e0bf63ca-128e-4a88-b957-2f5f0a1a6db2">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and the Trans enter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="42fc5ae7-07ca-4d15-a9d2-1d2aab0a4d08">
      <Text>SyBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dc1abe95-83de-462d-a986-86f2247cf023">
      <Text>That will be your room.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8f8fca0-ac11-41a5-b9f0-0d91060e3dd2">
      <Text>ErIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d001c30c-cd14-49e8-98c6-7cf5471181f8">
      <Text>Bathroom’s there with fresh towels.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4f34d2e-f9fc-415e-a52b-02ec17074661">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8945bd71-12ab-4058-aa6a-9febd305e468">
      <Text>Water here might be amazing. Thank you lots, Eric and Mrs. Ma.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe645f54-99d3-4088-b06c-19ecafcbeeab">
      <Text>SyBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5df22ca9-3965-4030-ab98-21d73a761d5b">
      <Text>Right.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eed90225-e04d-41b8-a9e1-7feba131e811">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1bc747e4-17b8-4adc-a155-be4b9c28b855">
      <Text>Your new classmate’s here!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="75ad7680-01be-4429-af17-04807a97f065">
      <Text Style="AllCaps">Morgan Tran</Text>
      <Text> enters with headphones and a Nautilus shell necklace.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="15b94cb8-b9ca-4f33-8c86-9839d494abbf">
      <Text>A beat as the teens lock eyes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34bb0fff-b76b-4601-abd5-6f3673378bd3">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9124e030-62f7-4a86-961e-55e677d732fe">
      <Text>A pleasure to meet you, Morgan. I’ve got Indonesian / </Text>
      <Text AdornmentStyle="-1">klepon</Text>
      <Text> for you</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b67656e6-6b6f-48e6-8463-ca997054a177">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eeb155f2-08b3-4e81-9964-db5ba2a7a962">
      <Text>/ No need. Mom - dad’s making salmon tonight.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="509ac66f-2599-4b6d-9592-8fc65d9d8fe2">
      <Text>Morgan hides away in his room.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af5e2e86-e9ca-4d02-93dd-45de17619595">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4006635-3438-4144-9f28-a1a98dadf358">
      <Text>Morgan. / </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">ă</Text>
      <Text AdornmentStyle="-1">n</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">đòn</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">không</Text>
      <Text>, </Text>
      <Text AdornmentStyle="-1">muòn</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">ăn</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">đòn</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">không</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c9fae9a-5cf4-42a5-84f8-15e92d8b1ca6">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed3ac088-daf6-46a8-9cbf-94571add5457">
      <Text>/ You said he’s adopted from Indonesia, right? / </Text>
      <Text AdornmentStyle="-1">Tiêng</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Viêt</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">cua</Text>
      <Text> ban hay </Text>
      <Text AdornmentStyle="-1">quá</Text>
      <Text>, Mrs. Ma.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86f37aea-727d-491a-bee7-dd47283c60a7">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d000e756-1c6b-47e5-89df-edfacbd3bcad">
      <Text>Sorry, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>. / He’s a hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a751f5d0-41e3-44b0-9fdc-a863f7767e7b">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0858930d-933c-460b-9bb9-55a94859bd1c">
      <Text Style="Italic">Cam on, Cathy</Text>
      <Text>. / </Text>
      <Text Style="Italic">Introvert</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eac08dda-bfb6-4fa5-8280-b08ac70c8738">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5a07a01-054a-4695-a47d-a0403067443a">
      <Text>It’ll take time for him to warm up to you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbe0cb71-e6e8-4f32-8a1f-efc71944b7a9">
      <Text AdornmentStyle="-1">Cát</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d8232bd6-0f18-4416-ab75-b34b7c813ebd">
      <Text>(Soliloquizing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e15c995-42f0-4fab-9029-d28d144b76ba">
      <Text>It’ll take forever to warm up an </Text>
      <Text Style="Italic">absolute zero</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="76f32a1c-2f43-4b55-851c-2b61a713ea14">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> unpacks her clothes, many plain as hell to try to blend in. She finds her parents has packed her horseshoe crab shirt as well. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e46ba60-2655-4b23-a4af-85b6433b0277">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6610e0f0-8a4d-464f-bab1-f9815aad5285">
      <Text>The pot calling the kettle black. My parents hid this in my luggage... I’ll keep it 100. This semester would go bad for horseshoe girl </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Lý</Text>
      <Text>. But not horse girl Cathy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="488685a5-31b6-46f9-b69b-2bfda8f898ce">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> throws the crab shirt in the trash. She puts on a horse hoodie and stiff jeans. She saddles up.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1d95ec20-79b9-441b-9467-9c913d335c0a">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f99c8fdb-5cbb-43a3-9168-aa9cda3c4e78">
      <SceneProperties Length="1 7/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HORSE GIRL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TRAINER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Horse Ranch</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2dd1fdbd-2cf4-430a-8658-d84eed2b280d">
      <Text>By the stable yard fence, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> stands nervously with the previous clothes, an attempt to seem cool.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7846f897-96ff-44ef-954c-7b3117e9336d">
      <Text Style="AllCaps">Horse Girl</Text>
      <Text> enters, looking fabulous in their boots.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e46ba60-2655-4b23-a4af-85b6433b0277">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27df918d-6145-4acd-a1ba-9f4ade8c8e0f">
      <Text>I am a horse girl. Not a horseshoe girl...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0effee08-c866-464b-aacf-0b129053aafb">
      <Text>Horse Girl</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2913df62-a0c4-426d-b380-78c3e175405f">
      <Text>Did you adjust the saddle fit on </Text>
      <Text AdornmentStyle="-1">Curless</Text>
      <Text>? The bridging be off yesterday.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6675bda-081c-4ec0-b4c4-cc483ac1e78c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f494329-dec5-4269-a8d6-eb660cb1096b">
      <Text>Bridging? Saddle fit? Half-pad? </Text>
      <Text Style="Italic">Equus </Text>
      <Text AdornmentStyle="-1" Style="Italic">ferus</Text>
      <Text Style="Italic"> caballus</Text>
      <Text>... This is harder than Latin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d588dc7-9dae-4ec5-9522-fc1d0d1e3a5f">
      <Text>Trainer (OFFSTAGE)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c676041-6df4-4a17-ba0e-26eaa75ecb86">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>... Um lie? Lee?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e57510c7-913a-453e-81f1-369370c21d9a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7656e41-df52-45d1-865d-99f7b898217d">
      <Text>Call me Cathy!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="34a0ed09-8459-4932-b7e1-a14482cd0149">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> walks off.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="968a86ba-5e21-4459-906f-fcc36d64ef1e">
      <Text>Morgan walks past the stables with a sketchbook in hand. He draws.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ae97294-95e0-4be6-8443-0e8cfe3b5af0">
      <Text>Morgan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9402a945-35aa-4c86-ae2a-1b844873187b">
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> trying to be a cowgirl... Haha, so sad.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e4a2a86-cdd5-4383-a06f-51c109082729">
      <Text>TrAINER (OfFSTAGE)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5abd702f-1262-44f2-a3d0-73ca73b8b3f1">
      <Text>Fix your posture! Heels down! Relax them hips!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1cd831be-7b40-4939-8e6c-a333efa06007">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> (OfFSTAGE)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86e5dd5c-c0a2-4a3e-9ccf-9e043263ffb9">
      <Text>Relaxing hard! Relax ah! </Text>
      <Text AdornmentStyle="-1">Troi</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">đât</Text>
      <Text> oi!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7fb4e67e-6b6d-4a23-8aff-e5b7dc210940">
      <Text>We hear </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> fall off the horse.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="405f422f-1490-4c0e-b335-8e50f2ba00f8">
      <Text>Horse Girl runs off. Morgan seems embarrassed. He goes to his car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b82e593-08d2-419b-b6de-6f7e16afcb9c">
      <Text>Horse Girl (Offstage)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="76d0f8c6-31d5-4413-9c29-422da0582017">
      <Text>How are you making out? </Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="3ea85ba6-9f91-43e6-b0dc-ec004fc72390">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="58cb689f-9fdc-4754-bfb6-4f3451ef866d">
          <Text AdornmentStyle="-1">CÁT</Text>
          <Text> (OffSTAGE)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="3d074f13-2711-4dc3-8550-1802bf6057df">
          <Text>What...?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="04471c5f-2280-4442-9f8c-cafc7b03f01e">
          <Text>HORSE GIRL (OFFSTAGE)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="e758c4a9-939a-4ede-9a57-96cc2a5f56ed">
          <Text>You okay?</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="da9e2a10-c064-4b20-ae4c-4e473d1fb561">
      <Text>Horseshoe Girl helps</Text>
      <Text Size="10"> </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text Size="10"> </Text>
      <Text>walk</Text>
      <Text Size="10"> </Text>
      <Text>in and reach Morgan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="197037d8-2fc4-4ac1-b94d-034ed564e371">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08c4e7fd-1c41-4678-b537-a9f803c3995c">
      <Text>I don’t belong on this soil...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d776419-2991-4be5-a899-721f171f802d">
      <Text>HORSE GIRL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4cc4e070-ee45-4b5d-b967-7581967bc8a9">
      <Text>Neither do me nor my buddy. We’ve got quirks. You just </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> find where you fitting. Morgan, you’re actually getting </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> the house.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="087dd4e2-dc1f-4d4d-b190-69d4ff6504b5">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca328049-28d6-41d1-b615-3db4368f70a6">
      <Text>She’s my host sister and I have to babysit her.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0f011bae-0ff8-4fd1-81c8-b23c4a71fefe">
      <Text>Horse Girl helps </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> get into Morgan’s car. They drive off.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b4a7607-66fb-44df-940c-f70eb7924b25">
      <Text>MorgaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ddea6a16-a708-4a66-9589-6b79e9b6bffd">
      <Text>Still trying to be a cowgirl?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3c5521d6-ce5c-481a-8539-be663c78b0e0">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3fd5cc27-7309-4bf5-a2fd-1f68bf71ccd9">
      <Text>Horse girl. They’re a specific subspecies. Hard to communicate.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5034425e-205d-422f-b7dc-32ffafa39fd7">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="734ed529-12e5-4b79-9b23-cb7c6572541d">
      <Text>Subspecies- I’ve not heard you talk that way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="08f57c6c-faca-4129-8ad5-5c265b0d9049">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35d7320f-fe82-4bce-a5a2-921100e7b181">
      <Text>I fell on my head real hard. / </Text>
      <Text Style="Italic">Ham choi </Text>
      <Text AdornmentStyle="-1" Style="Italic">thì</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">vua</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">vua</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">thôi</Text>
      <Text Style="Italic"> chu</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9f1c6d9e-3d0e-4647-8c67-56373cf5d47a">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="470472f9-7235-4c63-b1eb-c54be38fccfa">
      <Text>/ Let’s head home and get that checked out.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a439eb69-1807-4cd3-9f99-c1f76e8ac01a">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> sees the sketchbook. It is an abstract pattern drawing that embodies </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and the horse. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="e2c25ac7-be8a-494c-ab9e-bdfa475d884c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3441ed45-ab73-4469-a3ec-82b93c994a7e">
      <Text>I need to change...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b67cbe69-4d5f-49d5-8b29-661948f1756e">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="389926e6-0730-4984-8076-87f89a74d8d5">
      <Text>You don’t need to change. Your headspace just needs the right environment.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="61bcc1d8-4108-44e8-8fc9-c518e25f2348">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f99c8fdb-5cbb-43a3-9168-aa9cda3c4e78">
      <SceneProperties Length="2 4/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="RADIO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SYBIL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Bagaduce River</Text>
    </Paragraph>
    <Paragraph Type="Action" id="05db34fe-7855-45e3-b99e-7af5b36e7116">
      <Text>It is a cloudy September day.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="05db34fe-7855-45e3-b99e-7af5b36e7116">
      <Text>By the rocky algae-covered banks, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Morgan walk along it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c4ad322-79b0-4199-bb37-9d0a5d45e8e7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6719162b-f455-44ae-b386-2c9fa7ba7e74">
      <Text>The tidal range is amazing. Two meters. In Haiphong, we get half that. I wonder why.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a5d1e717-1fd0-4772-a40d-3f1f08c37032">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2429cd73-467e-4d22-8c30-b9af92cbbe0a">
      <Text>Ma can explain this when she gets off her call.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9941d375-c580-42e9-9197-9c0c40e01376">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6134c642-2d22-47d5-a32d-03836f5747d1">
      <Text>Life as a marine engineer must be fun.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f01c8c0a-3d3d-4716-9a1d-61deace61530">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d558bb74-eb10-4cfc-a01d-d594f5e76d36">
      <Text>Today’s actually a fun day for her. A phone call instead of driving two hours to Bath Iron.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3af486d3-607b-4445-bfef-e0d85dd60abe">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ababaf2d-29f8-47d8-8afe-c97d9f66a0f1">
      <Text>Maine has the weirdest names. </Text>
      <Text Style="Italic">Bath Iron</Text>
      <Text>. </Text>
      <Text AdornmentStyle="-1" Style="Italic">Lubec</Text>
      <Text>. Towns named Sweden, </Text>
      <Text Style="Italic">Mexico</Text>
      <Text>. </Text>
      <Text Style="Italic">Damariscotta</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="acece976-53bd-4f33-9ba1-007c0159cd6c">
      <Text>He stops and picks up something.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b63e6af7-0355-4a00-8aec-ee3c84375e76">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="850fa67b-1289-4e7d-947b-674ccd9ac826">
      <Text>You’re weird.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1226d534-8ef3-4410-b92e-6c1b21e721cb">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="abeee386-755b-4bdb-b66d-748bf04b2ad2">
      <Text>Says the hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="958ca19f-e308-4a0a-84c3-3b94134c0533">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="caaad825-a378-4017-afd2-da6be9f1d736">
      <Text>It’s no hermit. </Text>
      <Text Style="Italic">It’s your thing</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d8b2d482-874c-4591-9446-9b963e4beb57">
      <Text>He shows a horseshoe crab shell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a83badf5-1e5c-4f07-b268-e2eeba0aabdd">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b3e14ab-7016-4142-9e01-01631469e50e">
      <Text AdornmentStyle="-1" Style="AllCaps">Eeeeek</Text>
      <Text Style="AllCaps">! A Limulus polyphemus!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="fcb06123-547f-4ac8-9100-8db3fe569e46">
      <Text>(Recomposing herself)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b3e14ab-7016-4142-9e01-01631469e50e">
      <Text Style="Italic">That’s not my thing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72d0d59b-3806-4502-972a-50df0ce50c84">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="932d1fa6-bda5-4d08-a509-62c07b10ae29">
      <Text>No one in the house wears animal shirts.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b73c4db0-a532-481b-ba01-ae7d35380240">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83669e79-b872-4c56-bd87-149c476be0c7">
      <Text>You dug through trash? </Text>
      <Text Style="Italic">Question mark?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="330efc2d-ee5b-4ed4-ab5e-6ed4c01842a5">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="343b76c3-baa2-4c91-aed6-4098bfa03dfc">
      <Text>Your horseshoe crab shirt stuck out, okay. It’s your thing.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="58d9fb37-2185-4208-ab51-2c194cc8bbac">
      <Text>He hands her the shell. The first time they’ve genuinely connected.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f62307b-88de-4209-bc7c-14d6902054b7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a8340b5-5f9d-4f44-8ba3-db353bf73ddc">
      <Text>It’s... beautiful. The size. The condition. I’m surprised as they haven’t spawned for months.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fcd89ecb-66d5-4492-9f03-452a0d279136">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="072a32fe-15e1-4ce5-8de7-96bc8d5ba565">
      <Text>I can find shells any time. I’m okay at that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="685e4f80-7c83-43ab-9a9e-ac34645b1695">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef8fcd33-5153-432a-a0df-5b7f7e7dd76b">
      <Text>Where did you find Nautilus? Those are rare.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e8c4c48-b2eb-4605-a6d2-3ec30e2c6527">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4e02694-32a7-4fd1-a171-c159673b6198">
      <Text>I got it when I was little...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6669121b-a46c-4e34-8c73-a08e1fe80add">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0150562-27ef-42c0-9f1d-f6284d7984a1">
      <Text>The tsunami. I’m sorry.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da489c7e-72cf-45a0-a170-13f5b17339ba">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="55f643c3-0ad2-48e4-82bd-6991d204e285">
      <Text>I don’t remember- I just remember this shell. Rescuers found me washed up with it. It’s my good-luck shell. The one memory of my family.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d41d67f5-3b5f-4808-b476-ed68f7de3409">
      <Text>Sybil enters, done with a call.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ef4cf9e-1c90-47ac-a514-45c9a8e51ed6">
      <Text>SyBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="277566ee-cf4d-4fa8-9c26-9ef42f510579">
      <Text>Another find? Alright. The weather looks like it’s going to get out of hand. Let’s head home.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="664d17a3-0771-4513-9cbb-e684ebdf8082">
      <Text>They head into their car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dcb920ae-e8d7-4fd7-af85-da4870fa3b1c">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83bccc72-dc6b-4d98-bd1f-09634b508f2a">
      <Text>Can you explain how these tides are tides?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00f4165d-6ee2-4e48-b391-7974decc97d3">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5c1ea07b-0535-4131-9816-e6676ee28678">
      <Text>That’s the first.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f679a4d-2d1d-4921-bc75-27be79810a39">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0261ad55-54dc-4f03-b4f3-9dcfa70d462f">
      <Text Style="Italic">It’s for </Text>
      <Text AdornmentStyle="-1" Style="Italic">Cát</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="75d00cdd-4873-472b-99b2-97ec2e144cf6">
      <Text>SYBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2920ebb7-a2de-418d-ae91-9d8d419aae90">
      <Text>Makes sense.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d41d67f5-3b5f-4808-b476-ed68f7de3409">
      <Text>Time passes. It is now raining. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Morgan sit in the back as Sybil drives. They’re nearly home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a5e66cce-2172-45c7-8f0c-223052f3fad5">
      <Text>Radio (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f3bd94d-d138-43ac-99d5-002674ff5b57">
      <Text>A powerful earthquake rocked the island of Sulawesi today, triggering a 10-foot-tall tsunami that swept away houses-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9496ca5c-79c8-4f3e-9668-d93e4d920cd2">
      <Text>Sybil parks the car and switches the key off.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5953b101-5be4-4c89-b392-7679c1369969">
      <Text>SyBIL</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ebdb3d6-925f-41ac-9a31-5cf6e146550d">
      <Text>Salmon is spawning and warm inside.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c436dc7f-7dda-42d4-8bd2-885ee8f17db5">
      <Text>Sybil gets out of the car.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c0e843b8-0cdd-4126-a372-170d1e5b8a58">
      <Text>The breaking news breaks their connection. Too much for Morgan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="24969a57-a590-417c-8f95-2fcee6144625">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71c6b091-99ef-4948-b457-652c3759059c">
      <Text>Morgan? </Text>
      <Text Style="Italic">Question mark?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0eb3f5a0-16c4-4b38-aa39-27b351bc6498">
      <Text>He puts on his headphones and turns up his music. He quickly exits the car and heads to the house, sealing himself off.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4313521c-79ff-45c7-9275-80c122a4718d">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> looks at the horseshoe shell then her exchange program lanyard.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1a6f088-d36f-479b-8b13-5417344c58bf">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a671c1d0-5706-44d7-a3b4-9a5f0131ea20">
      <Text>Head home to your shell. He’s a hermit with nowhere to go. I have nowhere to go. Maybe, we both are lost here. </Text>
      <Text Style="Italic">Period.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="523a3029-ac63-4085-a56b-597e18f5f785">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="03bfb667-d167-448d-b0af-7fd700bda72f">
      <SceneProperties Length="6/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ERIC">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Tran House</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4bb4c2b9-933a-46e6-9e5b-051191a6f9f1">
      <Text>It is past bedtime. Lights up on the doorway to Morgan’s bedroom. Eric goes to it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6bba5f73-307b-4bb9-b167-7cc1bf92e01a">
      <Text>ErIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="24180083-9957-47a4-a637-0d8f6cdd547a">
      <Text>I don’t think it’s a good idea to eat salmon, especially around a bed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7586a86b-d275-4991-b734-2fa473f3d982">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> enters brushing her teeth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b85d55a6-c878-4fd4-82c9-e7198597487c">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="673f33b3-0f72-45fc-9466-b15778933ff5">
      <Text>Where does a hermit go when they got no shell?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ee72d71-c33d-467c-a4e1-bd41d0fc7d1c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="718980b5-2b4e-482e-af37-4b739b14fc30">
      <Text>(Mouth full)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb034d31-58af-49e3-8424-75c64b9d8e85">
      <Text>They die?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4305c967-3f86-4d55-b812-7c67a415ca4c">
      <Text>ERIC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2bfa614-6acb-43d5-8abf-69d5b05d57d9">
      <Text>No, they find a bigger shell. Whatever he’s going through, he’s a bigger man in the end.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="04780b47-27ca-4537-b001-924e87d67935">
      <Text>Eric goes off to bed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="149e7937-e2ba-404f-91e1-b9146f3c5c81">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> gets the horseshoe shell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="107fde52-e55b-4375-9838-eb058428ce28">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4aec7944-e0a7-4ddb-a1c0-f7e11b96b771">
      <Text>We’re both orphaned in this country. I am by choice, briefly abandoning my home. He is by tragedy, searching for... home?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="41636a49-69bc-4385-88d7-d4f97b3094e2">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> holds the horseshoe shell up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c1a5d145-81ed-4f1f-97e5-866ae101ccc2">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0119f634-66ba-4285-89f6-e9e5f86a0a65">
      <Text>I wish we could both feel at home. I wish for Morgan to be a bigger man in the end.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1a4a6233-0aa4-4da2-b04a-1749799d53c2">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> turns off the light and rests.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7d31e0c4-ddee-4ede-99e7-c40e7ef9a472">
      <Text>Black out.</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Label="Scene 1" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="Yes" Type="New Act" id="bcb3d77a-d198-4296-b0b6-07103897909d">
      <Text>ACT </Text>
      <Text AdornmentStyle="-1">II</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="5 4/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BAGADUCE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ERIC">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SYBIL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Tran House</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93d9405b-af08-49b6-baa5-fa19c0b9ec34">
      <Text>It is the morning of October 23.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93d9405b-af08-49b6-baa5-fa19c0b9ec34">
      <Text>A sudden snowstorm rages outside.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0775184b-7caf-480f-ba93-4822b8056219">
      <Text>The landline phone rings. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> wakes up and picks it up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20816337-ec48-47f8-86f5-26678e7397b4">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="301e0d34-beee-42e7-ae1e-3b29197e1818">
      <Text AdornmentStyle="-1">Whattttttt’s</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">uppppp</Text>
      <Text>? </Text>
      <Text AdornmentStyle="-1">Questioonnnn</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">marrkkkk</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a2b14cc-dae2-48aa-be6f-ed133198ea0e">
      <Text>SyBIL (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd54a034-2b6b-48fa-987d-ff2c68063405">
      <Text>The snow! Roads are awful. Snow in October?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="88af9c1b-4417-42c1-9768-641d35aa5b14">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> stares out the window. This is her first time seeing snow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43193ec4-ba86-499d-8251-d85b63cd9da4">
      <Text>ErIC (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b6fee5a-5f82-4817-90c4-f939af01ada1">
      <Text>Typical Maine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="28d971a5-5ab7-4258-b1c3-3808c706221f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25b9f3c1-22ec-4406-b568-62e52f9d1ca4">
      <Text>How is the ship... um?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="19041549-8cac-45f9-9be9-737db6146767">
      <Text>SYBIL (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b5ea534a-f958-4fbe-8c2d-926bddbf2326">
      <Text>The ship christening was fantastic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e6a911c-1145-4964-a0c9-8d58fbda0045">
      <Text>ErIC (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="04edbb90-f217-4a19-88f0-59c68c7ab515">
      <Text>The Nyberg legacy holds strong.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7893f7d-ebbd-48d7-9330-65d7196b53b1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c9a51a8-fcf4-4509-a084-adca92a224e4">
      <Text>Aren’t you driving your parents today?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa545636-f05d-4468-8362-bdc7380d6273">
      <Text>ERIC (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="495f69fb-c326-407e-9b8a-41908a1c1185">
      <Text>That’s tomorrow’s problem.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="19041549-8cac-45f9-9be9-737db6146767">
      <Text>SYBIL (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c57047ec-925d-42db-9e30-80f9c36d75a3">
      <Text>Go experience your first snow day without us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7893f7d-ebbd-48d7-9330-65d7196b53b1">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="91ee1ae0-469f-4b3b-bba7-d99013aa19ac">
      <Text>It’s okay. I can wait </Text>
      <Text AdornmentStyle="-1">til</Text>
      <Text> tomorrow.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="6635bcfb-ffb9-4283-8683-4e48e93f90aa">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="994861b0-644b-48ed-be2a-85ed10bc8162">
          <Text>SYBIL (V.O.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="5f3ded4e-921e-48b5-b9be-d906c3261921">
          <Text>No </Text>
          <Text AdornmentStyle="-1">no</Text>
          <Text>. A school snow day.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="30580655-139d-44a6-9222-9c92fa7d77d6">
          <Text>ErIC (V.O.)</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="7d69dae2-3ab5-4cef-a9fd-7fcd5467f647">
          <Text>Check the school app, </Text>
          <Text AdornmentStyle="-1">girrll</Text>
          <Text>.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="bdd0a52c-5684-42ef-86eb-4d2316e3c87c">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> reads her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbd9e7be-c2e6-4712-b233-f016be482452">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ca1208c-451d-4828-9a34-6bdf195d5783">
      <Text>School’s canceled? Where will I go?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15900659-e907-4de2-80bb-16f2af477a10">
      <Text>SyBIL (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="efbe86c3-ec9f-4d42-8af0-250d4451806c">
      <Text>Back to bed, dear.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4b4d7cd-ea96-4465-b5ee-d284b8ab3f11">
      <Text>ErIC (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ff40cf3-c250-4bee-93e7-06a84172d0f9">
      <Text>We’ll see you tomorrow, kiddo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="24333b35-1df2-495d-9f03-2490915011b1">
      <Text>SYBIL (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5b366749-57fc-4c96-9c20-0fe138f601f1">
      <Text>Wake up Morgan so you can drink your first hot coco too.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3e561d07-b106-4c96-82c1-a24c8e6ae343">
      <Text>ERIC (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5e122ee-5985-4c38-afca-743363305ba1">
      <Text>A hermit’s favorite drink I always say.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="df5a76a5-1b76-4f9b-9cf0-35d0e6412c90">
      <Text>The landline phone hangs up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef12c8b0-c6a1-46b9-981f-0fd0632a6aa6">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8d4e8f9-42c1-4ccf-b496-5c36682177dc">
      <Text Style="Italic">How to make a snowball</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="733d48b9-e4e5-4bde-87cd-979562bc2d0b">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> searches on her phone. She goes out and makes a snowball. She heads to Morgan’s doorway.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8be28b68-1f61-4619-a473-8497bd15743c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e872a546-6e20-43d6-b5d2-e1262eb41b90">
      <Text>Morning, Morgan. Don’t miss the snow! Ra </Text>
      <Text AdornmentStyle="-1">đây</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">cho</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">tao</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">biêu</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">không</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f5486b16-e22b-48f1-b458-4dca1c73a987">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> barges into Morgan’s room. It is empty. She finds his necklace abandoned. She picks it up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b5a2c20-5fa6-4245-82f3-bf8812d53441">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0ee3176a-04da-4e05-b989-c566adbfcf81">
      <Text>Why’d you leave this? You never take it off. You never let me touch it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="caa348e7-4052-4397-9b8a-135c369bd88f">
      <Text>A hermit crab pops out of the Nautilus pendant, startling </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="889f846c-f90d-4f2d-8bf1-451509f70680">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dbea5873-8107-428b-be32-0f6e09bafcce">
      <Text>Ah, a hermit crab?! Well... wherever you came from, it was probably </Text>
      <Text Style="Italic">somewhere cute</Text>
      <Text>. I can’t believe he’d hide you away from me! As a good friend of Bagaduce, I won’t keep you away from-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="256de2f7-ad13-4d89-84ab-cd8c533d4f90">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> holds the horseshoe shell. It suddenly becomes sentient, causing her to drop them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68f19c12-bab4-4ef7-84fc-34e519069e28">
      <Text>Bagaduce (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a0fc2da3-1862-4f6c-8de9-982ea6b3683a">
      <Text>Me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2766391c-2ef9-44ff-89c9-ef381ff76385">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6cd18797-dc90-4f64-b75c-44e13a9d8c52">
      <Text>Ah!! You- you’re not coming from anywhere good!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac8f8b3f-9973-4081-844c-7668744261bd">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b62557fe-edbb-423f-a824-7f5761d31682">
      <Text>I come from the river. I’d say it’s good as good can be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d002d9ae-7abe-4985-8cab-178c06ee3fd8">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2fa7209e-1769-4f6c-a202-ca55b7474339">
      <Text>Okay, spirit of the river... What I heard about spirits is that you’re all knowing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ca5b9a13-a4e7-48c0-bc48-200733a86a8e">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="90169966-ef0c-4eb7-b39d-53767f491200">
      <Text>Water knows very little. The spirit of the air is everywhere.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bbfe2f3f-667c-4ca5-8628-9f07831c42b1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8caffd8-d838-40ec-866d-13dc47f8d10e">
      <Text>Do they know where Morgan Tran is?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="984b8b45-c46a-470e-b906-b1f5eb547114">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42e39a17-77fc-4dcd-9abd-4fb7121c2ef0">
      <Text>He is in the shell of his former self.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78620f2e-0651-49d2-80d8-e4697b652627">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c1465650-c771-472b-85e0-adfa12eeeb8f">
      <Text>Don’t you mean </Text>
      <Text Style="AllCaps">he’s a</Text>
      <Text> shell of his former self?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="814787d0-fbc2-4c92-a36d-da44fb737867">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ac09185-4fc4-427e-a93b-4f454fc858a9">
      <Text>This is no riddle. He’s a literal hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01b78f07-7030-45a8-b255-5f5822c83638">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="837c4063-9643-4090-a955-76b4828a1548">
      <Text>What’s new?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86e98ab2-d1ed-4279-9e1d-a38f3d77bb36">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f98ea2d-2a22-45ae-b777-72feeb02b386">
      <Text>Put me on your head...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="447bcf49-dcda-4020-877f-2bef7dfabd1a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4c4bae8f-2608-4742-aa49-55d5e58dde16">
      <Text>That... would be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ece8509-66e9-46fd-b141-8a92dcc80887">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="79338db6-02fc-439d-baad-1fad12b4f176">
      <Text>Trust me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="112d82db-ea88-41a6-8555-2073cab0a45a">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> wears Bagaduce on her head.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d36c14ed-8c56-4df5-beb7-3ae701eb5139">
      <Text>A life-sized Morgan could reappear in a horseshoe crab costume or he could remain voice-overed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c1853f7b-513b-48a8-a288-99413ebb7909">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b453b134-f49c-4b17-9e78-e9e206a05799">
      <Text>Do not trust them!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb7b22c0-98eb-406d-9f87-57bde3865a39">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9604ca62-9fa4-4818-9cfb-65f3bff3f176">
      <Text>No </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text>. It’s not possible. But then... everything eventually evolves into a crab...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="109e9b9a-3386-4556-b282-25db884b3b4a">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4a72a9b-8b77-44c0-9ea9-f2b46f8c81ee">
      <Text Style="AllCaps">Cathy!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9dbf2fa4-8954-4213-b75e-ca4beefdca03">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8399dbc-ece7-42cd-9053-dfab95923a30">
      <Text>Okay, don’t get your shells in a twist. How...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a83e02b2-743d-43b3-944c-8295151c310f">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b0e68eb-1049-4997-af91-fd251977c46a">
      <Text>I don’t know! I lied in bed, saw snow, then-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cb227b9b-ec9d-4236-bbb3-4f8a027cb8e0">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0b668aca-6378-4e7d-ba0b-8ec516e26694">
      <Text>You saw the moon too right?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="411fc3c4-6e79-4f8c-9395-86d375e57635">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3148313e-57f5-42e3-a314-0796fc0bf1da">
      <Text>Yes, the moon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15b978d0-7ecc-4a7f-9fb7-7b911c80557e">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="02c3bbe8-75b2-4fe7-ad14-ce1027603628">
      <Text>Just making sure it ain’t a mistake.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33f534b6-f378-40c6-9a05-8ed6bcbad9dc">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a696e4cf-e9b9-45bb-917b-c25a4b9f50dc">
      <Text>I wished I could hide forever then poof! Next thing I knew, fingerless. Spineless-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9ee0b93b-144d-4ceb-996d-829d7ef4ee56">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b112ebb-7b60-419d-bfd1-c25c1041aa4c">
      <Text>No change there.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0d7be371-4c11-4e24-8ab8-06cf48b4c575">
      <Text>Morgan pinches </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f6e0f1c-467c-44f8-9088-646360be8fb9">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83b0becc-8dd0-408b-b98c-f45469838241">
      <Text>Ow! The pincers are wicked cool. And you can’t be cool. Turn him back, Bagaduce!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="79938add-6365-4ee3-9639-1d8fae15c087">
      <Text>BaGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5c8591e9-211e-4fd9-bf28-586ee7888cb3">
      <Text>Change is hard when you are a living fossil.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aac1182a-a3a2-4071-b3eb-a008645060ae">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f4a3aa25-a201-4bfc-beb8-5126543fc73f">
      <Text>Could you have at least made me fit in my Nautilus shell. It’s so loose...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8794a3ec-52af-4909-a990-17d390fbe260">
      <Text>BAGADUCE (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4a3a56c7-5b42-4edb-91fe-5c681b59afe9">
      <Text>You’ll grow into it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4a75aad-d461-494a-b918-2e3d3b6ee876">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="89282110-e974-4320-9489-1b740be7a156">
      <Text>But you changed him last night...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49cfc472-2784-4019-b1c6-301f5439723a">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="587946ed-0e0e-4ef8-bdb8-b449b1b3952e">
      <Text>With the help of the nearly full moon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dc43d6be-70ee-41cd-988f-d7acb656ad25">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="17350e01-53f8-448f-aa80-ab12c5c313ab">
      <Text>Another one is tonight. We can wait. I can find a board game your size, Morgan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46eb3b4e-1386-4171-b443-00c0924e9b3c">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15c470dd-f3d8-4313-a830-8e46ac93fd22">
      <Text>You must go to Relic Island!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="835b044e-1ddb-4159-be65-125536ad475b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="00ec5910-8146-4f9c-a692-7f714f99ceca">
      <Text>Have you heard of this board game, Morgan?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0305fb8-095a-4e0a-85a4-febf018ae791">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0e2e31ed-0a62-4507-bdb0-7e66f50b8da5">
      <Text>It is where you call upon the spirits to take me home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6c43a55-37ee-4bc3-ac53-25799a8fb1bf">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b90db6c6-0f6c-4865-90df-3dd11eadddcd">
      <Text>I think it’s a real place...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3cb47b8e-8aaf-4fde-957a-e5fa45e352d7">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e451a4bf-61f3-4d51-8b3d-903d5ca91a1a">
      <Text>You must reach the island and </Text>
      <Text Style="Italic">spark a light stronger than a hunter’s full moon</Text>
      <Text> or you stay a hermit forever.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="29ee012b-e0ec-4a2f-9cc7-e63456533db1">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ab5c4f80-3506-4f36-a6c8-416a05caeb8d">
      <Text>Forever?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7071a9c7-3687-402b-a4ff-76631b7803c3">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> researches on her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="70fc93bb-571b-4362-aac7-8b0a2691f605">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb80f4f7-a16b-4d80-903d-4d572b9bcd94">
      <Text>That’s tonight! I cannot seem to find where... Where is Relic Island?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0fb5aa25-251f-4592-845a-5c0219f7170a">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5140cf16-6498-4ec2-af85-f8f9fdea4afa">
      <Text>I don’t know. You’ve got them opposable thumbs. So get moving.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e4ac92fb-23e4-4e8c-a3af-055ca492d511">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="194a7d14-3bd6-4e66-8e07-beddc7c2d92d">
      <Text>You got ten legs...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c221ab9f-5e9f-422b-9b52-d4a0f6e6f68c">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff6a956f-4c56-4172-baef-243e09be08e3">
      <Text>I’m just a voice in a shell, kid...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c5455ac-5853-4884-a5a9-a6ca36c65ff7">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="944ce197-196d-4376-a3c6-60a4015c9f69">
      <Text>And I’ve got ten too...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="549befce-9d73-4f2a-881c-a47876d9e4aa">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8496627d-b780-4bed-b199-315c24a60f6b">
      <Text>We’ve twenty hours.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="582a5a0c-7b3b-4af5-9019-ada93b2a1ac9">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5793407-338d-4f7e-9e6a-93ffe473cce0">
      <Text>I can’t drive with these.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="48c69ea2-e76b-4f2c-9811-4da567660d2a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="297ec166-0deb-47a3-8e6d-d1ad3838d442">
      <Text>I still got my hands.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb1aace8-9c28-45e0-a8a8-abb90fc4aba1">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01b739d3-6277-432a-aa98-52b4e948be9b">
      <Text>Even if you had your license, snow’s heavy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91874266-c34a-4ecc-b2ab-aeacda332c3b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fec596d1-d6d1-4a01-beda-32428ee8109b">
      <Text>Let’s wait until it melts. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="b7f5e5e0-4f5e-4b96-8861-efe261d3bc9f">
      <Text>Morgan sighs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7dca8451-a14f-4502-a044-315f2163a36e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3443c7e7-6e52-450e-86af-7cbb2cfb70bb">
      <Text AdornmentStyle="-1">Mày</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">tuong</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">mày</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">nói</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">chuyên</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">voi</Text>
      <Text> ai </Text>
      <Text AdornmentStyle="-1">vây</Text>
      <Text>? I’ve survived the roads of Ho Chi Minh City on a scooter. An avalanche is nothing to me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="11100f8a-786e-4750-adc4-ff6645232dc2">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e9ead013-2296-44b9-8573-550b88488c4e">
      <Text>Besides a new shell that fits me better, I’m gonna probably need a new car after all this.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="56a2c9c1-c20a-41dc-a3ea-7ef4fcbcd319">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="073fc6a8-35e4-4b1f-a37b-70040d917958">
      <Text>Is the shell hurting?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b323c3d9-2ae8-41e2-8620-180e1076dd93">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="95b05c56-eacd-46be-973d-cf00fd50e455">
      <Text>A single wind might.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18e23939-4257-4684-bde9-e38bf7ae2689">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="600ffcb0-49d6-40b9-b0c0-d92ceab6da69">
      <Text>Copy, Hermit Boy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c968937-583a-4aac-8131-37b346424d12">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> grabs the car keys from Morgan’s room and puts on his winter coat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c0d26d3-fb4e-46b2-8f94-c7e688ef9c86">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="323de40a-b9f5-46f3-864b-1e241728d667">
      <Text>Where’d you stash your allowance? </Text>
      <Text Style="Italic">Question mark-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="595a29f3-6a91-4d82-87d5-b768ebd4a0e9">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="34b7a694-616d-4dac-8ad3-8d351d046250">
      <Text>I ain’t telling you nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1b5493bf-db19-4bcf-8c6b-02197b3d1c92">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e20b423-8ec5-4dd7-93b0-db6938673b17">
      <Text>The underwear drawer?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc46ae80-7f3b-4b19-b5f6-fb8fef811fa1">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c21b8219-084a-4599-a8be-efa427c520ae">
      <Text AdornmentStyle="-1">Noooooooooooo</Text>
      <Text>!!!!!!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9c96edf2-ca9f-4830-ac17-c763f557b4d9">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> grabs a stash of cash.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad874b85-befb-45fd-8315-266a85498285">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f96770e-a60b-48a4-8ec1-b8e37ef53e63">
      <Text>First stop: the pet store!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e13cbc46-52f0-4790-be62-6707782513fd">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> safely puts Morgan in her coat pocket and grabs her backpack. Bagaduce is still on her head.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5a7b7196-cace-41b1-9dc4-cf522f200a5c">
      <Text>They run out into the blizzard.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f1b6a785-fb15-4407-8ccb-ff72be9eacc1">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="2 2/8" Page="14" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BAGADUCE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="EMPLOYEE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Pet Store</Text>
    </Paragraph>
    <Paragraph Type="Action" id="895fb7c2-8499-4d8e-9e0f-c481cbc70d7e">
      <Text>The store has a hard time staying lit with the snowstorm outside. There are aisles of pet supplies, a fish tank section, and animal grooming counter.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="013f20b9-74d3-4164-874d-aab8ace31045">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> enters, looking like she survived a tightrope</Text>
      <Text Size="10"> </Text>
      <Text>over</Text>
      <Text Size="10"> </Text>
      <Text>a</Text>
      <Text Size="10"> </Text>
      <Text>canyon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="752e131f-92b9-48b6-85e5-92414a70bd88">
      <Text>Morgan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a8bca1ea-a066-4068-8d28-6fd4bd5ddfe1">
      <Text>I’d give you a D on a driver’s exam.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a12019f-0560-43c8-ad37-4d8e3a5e30ab">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="9721e3d3-7c6e-44f8-a312-da5067fe1807">
      <Text>(to her pocket)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ab77ecbd-5de9-4e94-a552-fd25c0b1f839">
      <Text>D is passing here. Are you naked?! Que- ques-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6753647f-6e46-444e-8df2-8c3fa8a2e424">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="831ed12b-1c83-49a5-8925-56d19f6768fb">
      <Text>Anything will pass for a shell but Nautilus. I don’t know. It’s been feeling weird to me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af2ce28d-7011-47d0-a5f8-83dcee95a20b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eeb0298f-6822-42eb-b17c-0373b08ae5e8">
      <Text>So I see some containers of shells labeled “small” to “medium” and... “assorted?”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="709bfac1-c7db-4502-8e70-d2f21210c772">
      <Text>BagADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6e0af3cd-be6f-4937-aec0-af5cea19f6ea">
      <Text>What is assorted? Modern retail got some hubris. It needs to be a progression to “large.” My boy is growing and the stress only makes him grow faster.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5fa24b74-243b-4523-a77c-56aef8d15dfb">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4e6cdeb-5859-48cd-b97d-30e21bacfedb">
      <Text>I’m a pocket crab! Of course, I’m stressed!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8568461b-7952-4c6f-b92c-e0e686e906b9">
      <Text>An </Text>
      <Text Style="AllCaps">employee</Text>
      <Text> appears, humming.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27db7b04-7ea4-440c-8142-c4774677b9c6">
      <Text>Employee</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="39eb7e98-0dc7-42d5-8dd4-954714f9327c">
      <Text>Sick hat! What’s the occasion?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c2e7b642-ab73-4384-8705-923858716f6a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b1c0200c-5f6c-4654-9017-8aef4e6a7d9d">
      <Text>Just a fan of arthropods!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d685b0f6-7c48-4198-92d1-78df3da7fcf5">
      <Text>EMPLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba41c514-c203-43f0-9e8b-708c54e3e47a">
      <Text>You’re in the right spot. Looking for a new arthropod friend? We’ve got great deals on these critters this snow day.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cabb7615-ff2c-4309-b0a4-b470ae434184">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56804231-08cd-441d-9c38-7c7d6b764e93">
      <Text>I need shells for my naked friend here.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="33911216-ff66-4db0-a5a6-05966b3151d9">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> takes Morgan out the pocket.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d96cfe1b-a02d-4af6-9958-eb40cfc659e4">
      <Text>The employee’s eyes </Text>
      <Text Style="AllCaps">lights up</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ba0d4704-aa43-42d8-ad30-019fbea9549d">
      <Text>EmPLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="36a247c4-52d7-45bc-ba27-ce31519dbf49">
      <Text>You’re really searching for the vibe, huh? Hermits are all about fashion!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f5d4edc6-4ac6-42f8-8906-4052a9b5ceac">
      <Text>The employee leads </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> to a fitting room display. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> playfully places Morgan on it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ff83ada-d6fa-4e5d-85da-c5bea5410b9d">
      <Text>EmPLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0529e2d9-2463-49ed-82a7-84f8924746b1">
      <Text>Ah honey. Nautilus. That is so Cambrian era. Let’s size them up and make them sparkle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf07118b-fbae-4fd1-9683-8330696fed91">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4a6a87c7-aafe-4848-ab94-f064d4dc75b2">
      <Text>Morgan enjoys patterns. Geometric shapes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48c66aed-e82e-4362-b5d7-4c342f744f57">
      <Text>The employee grabs several natural and brightly painted shells.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7f5722ae-f122-4f68-b53e-e829fdae6235">
      <Text>EmpLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b5497f97-2084-48d9-af13-0d344fc9328d">
      <Text>Morgan, lovely </Text>
      <Text AdornmentStyle="-1">lovely</Text>
      <Text> name. Shell we? </Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e683172-4a2e-48b9-9782-a6b39b448f59">
      <Text>A life-sized Morgan in a horseshoe crab costume may interact with the employee in a real fitting room.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bb29cdda-27c7-42fd-b0a2-4517861c32e0">
      <Text>A fun fast-paced pop song plays in the spirit of a makeover montage.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ed42f9c0-c1d6-46c9-a9c3-4a2a2ed6122c">
      <Text>The employee gets a glittery shell causing Morgan to scuttle away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5f302481-4ed9-4d2e-8d6c-935bb2a6946b">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> finds a plain shell which Morgan tries on but doesn’t fit.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="314c85a9-d5d4-4db9-ba4e-2122cf024435">
      <Text>The employee passes on a sleek black shell. Morgan tries it. It fits for a moment then he instantly gets too big for it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c122c975-4be7-4277-90ce-228502c94589">
      <Text>EmPLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="ce751e6f-4882-4a2c-87ec-d1d272dca415">
      <Text>(Sentimentally)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8306f690-5ec1-490d-aedb-bff893aa7d4c">
      <Text>They grow up so fast... Time to make an </Text>
      <Text AdornmentStyle="-1">XL</Text>
      <Text> section!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2fcc6ba6-35e6-465d-8feb-e500def2a60d">
      <Text>The employee writes an </Text>
      <Text AdornmentStyle="-1">XL</Text>
      <Text> section.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48b21e7e-9893-4f12-b146-6d0e8f3bd975">
      <Text>This montage culminates in Morgan find a few perfectly shaped shells.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="454ca63d-613b-4d4a-9ab3-448665469520">
      <Text>The employee asks the audience vote to for their favorite.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="79a0604a-5ad9-4b0f-b358-2a20fbe00159">
      <Text>EmPLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5f76ea57-9daf-492e-81c6-e51ac1e43602">
      <Text>Sea shells, sea shells by the C, B, or A aisle?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="babead71-8726-47df-b316-299fdc8632cb">
      <Text>Morgan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d745da0-add6-45f3-8f05-17e694b0f5ec">
      <Text>This one feels right. Roomy and safe... from winds and </Text>
      <Text Style="AllCaps">tsunamis</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c122c975-4be7-4277-90ce-228502c94589">
      <Text>EmPLOYEE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4f1547e0-8e86-4b6a-8ba4-5e5fb74326b9">
      <Text>Seashells! Fashion’s all about the perfect fit!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dd104eae-6cb7-457b-ba2f-44759f5d1801">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> pays for the shells and rushes out the store into the blizzard.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3c54434-ec5b-49c0-be7d-7a2c9f34f3dc">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="991725ce-2543-43dd-8451-aab41d148ad0">
      <Text>Now off to someone who can fashion out a map!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0cee531b-cf95-4d7a-a4e5-873bcac4ad68">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="3" Page="16" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT &amp; BAGADUCE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="DR. BAXTER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Marine Maritime Academy</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ac0b51c-f2af-4c2c-afba-11666018fea2">
      <Text>It’s a short time later in the afternoon.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7f5ff1b8-f412-450e-b7d3-ccae0a7720eb">
      <Text>The historic hallway has an office labeled “Dr. Heather Baxter, Professor of Maritime History.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="89e05ef7-cfe1-424c-ada4-c6d8663b0b42">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Morgan enter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2debd862-9c1a-4642-9507-8b264d110a58">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6fcaf8c2-76f8-41e4-8cab-b8b6833a9b83">
      <Text>This has to be her... and perfect we are just in time before office hours is over.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7f64952e-7079-4db0-87fa-04446af03295">
      <Text>Cát knocks on the door.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06e96f01-32e8-43a4-a5fa-f1f378c68cad">
      <Text>Dr. Baxter</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1dd8b634-950c-4aeb-a74a-664749e66834">
      <Text>Someone who knocks? You’re no student of mine.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c6892a95-09b2-4791-bb66-baa24c9fcf35">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> timidly enters.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37dda0a2-23d8-4998-b05c-f59ba40dd741">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b965ae5-b7b2-4bba-b845-6a4d66439b0b">
      <Text>Good day...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c4be300-c1bd-442b-a1e9-28d522d38975">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="be7cb7aa-1cf3-49e6-a8cb-3e330ca481fc">
      <Text>Why are you wearing that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f97a7abf-7880-4fe3-b458-0c0129896343">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee9255a4-6b8e-401a-9873-c148652ba9c5">
      <Text>This? I’m just a big fan of horseshoe-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e854b64-4f2a-4931-b743-260150043de9">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8437a4cf-9705-4c42-85b8-4a4444250bb1">
      <Text>Not that. What’s that lanyard say...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="4d4d7363-c7f3-4cd3-840d-0e4e233ea0ce">
      <Text>(Reading </Text>
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> lanyard)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c463316-113f-4dcf-904b-0f160c3e2a9f">
      <Text>“</Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>-” I’ll just call you Cathy. “Splake High School Exchange Student program.”
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="227bf151-bb29-4722-b8d4-1ef167763091">
      <Text>My nephew went there. Rather boring place he says. It makes these dusty archives bearable. It is that what brings you here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="841f8c9f-223b-4dbe-8251-d73479c34f6b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="46db5d40-93eb-4db3-9421-b2cf7b919c92">
      <Text>We need information on the islands going into the Bagaduce River.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a28f51c3-3c61-4d51-b63b-e016a4fc22e2">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0fbe0d9-5312-4002-9c6b-2fa811fedde3">
      <Text>Relic Island!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="baa252e1-4f19-47ba-a7d7-c73fc83aa5f5">
      <Text>Dr. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21e1b41b-dce7-4fe1-8133-186524e910fd">
      <Text>Is something squeaking in your pocket? Well, that answers the “we” you’re referring to...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3b2f281-fc83-4e9f-8afc-42b2a2da17c0">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="28e52931-1936-4c03-bf9d-b088e3b410ac">
      <Text>We’re looking for Relic Island.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a0c23180-2cbc-4250-82dd-97c06b0eb414">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="76739a7d-964d-4052-bec2-09b1749709b3">
      <Text>I don’t know what that is. There’s thousands of unnamed islands off the coast.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c4581f5-c6c0-4bc4-954f-c97e7dbd6cb8">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="99a4d3cf-1797-4d2f-8363-a275989cae4f">
      <Text>Do you where one can </Text>
      <Text Style="Italic">spark a light stronger than a hunter’s full moon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="721fbe5d-23d4-455f-9742-31773c3991dc">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="74e60b34-84e1-4acb-bcbe-ccaaec1aa2ab">
      <Text>I teach history not philosophy. Give me more context.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fefa9c60-401b-45e3-82e1-99f3985bf0dc">
      <Text>Morgan sees a poster or figurine of a lighthouse.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="12d372aa-5ed5-4582-bfb3-3eae0ef96bc7">
      <Text>Morgan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e480c3b-96b1-4750-a7aa-098e4536b39d">
      <Text>She’s a fan of lighthouses...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3fd2f238-60d8-43b7-9988-738f87b36e6a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d6e6107d-d3c6-42cc-ac86-0914648fe312">
      <Text>Lighthouses!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32619f6f-1a6b-4780-b0c9-613b8008fd53">
      <Text>Dr. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2dd1db0c-753c-48a5-961b-d5e6f7959f58">
      <Text>Lighthouses have a rich history in the Penobscot Bay. Used by European traders as navigation points.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8dc2fd1c-f9e1-44ac-8716-9eaa553e2b3f">
      <Text>Dr. Baxter pulls out a map and lays it flat on her desk. She marks where old lighthouses are.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b0b5484e-2ae0-4b47-bf5a-721f6a8147e7">
      <Text>Dr. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eac99ab6-94e1-4a54-a46f-4555e8caa512">
      <Text>Many lighthouses are empty now. Automated in the 70s. But they continue on. The locals say strange lights appear during the hunter’s moon. Old trading routes used to pass close by. It was considered a liminal space. Between worlds. Dangerous currents. So no one should go here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c8014d6-e205-4cbd-8c34-0015af447146">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="792993f2-de18-40fc-b5b3-1cd8174b8bf8">
      <Text>"Dangerous currents" sounds like a problem for a guy with no arms.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8bbd8990-7397-427b-b987-fae72d6e8dc1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7800120-05b4-4db8-9893-d9d283800594">
      <Text>Can you define liminal space? </Text>
      <Text Style="Italic">Question mark?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a6ded94-582a-4fcb-97dc-8255e512e59d">
      <Text>Dr. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3b63a8b-6f77-4083-ba5b-48c54fe66291">
      <Text Style="Italic">Question mark...?</Text>
      <Text> Alright, it’s a place to cross boundaries, like from life to death.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="757797a1-68a8-467d-9969-acba17e67bae">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6d155ec-d400-4888-83f2-8a6b7a567220">
      <Text>She said she doesn’t teach philosophy...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c04d2e9c-b55b-4a69-b42e-b50f78b5b258">
      <Text>Dr. Baxter crosses out a region of the Penobscot Bay.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4264c43b-7276-4e3f-8f4e-b14dbc09cb90">
      <Text>Dr. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d8dfdc95-9b94-4da1-900b-0341dcd446d0">
      <Text>A prime example is this channel here. Sailors called it "Annie C. Maguire’s Locker." Only fools dared cross it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a7328b5-c083-4b55-bb03-089e31660f01">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="797ed471-f2eb-4237-95f5-dcc4989d60aa">
      <Text>Another weird Maine name.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd7d3688-ef1e-4946-a937-21a93fafc98d">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8e2e1994-b8cc-4bdc-9071-13ecf428896f">
      <Text>You have an obsession with this perplexing riddle. Remind me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be343dae-db37-4943-8b17-daffd6518890">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> &amp; Bagaduce</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6aef1a4-fd84-43ea-b70e-386c6d3d3ac5">
      <Text>One must spark a light stronger than a hunter’s full moon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa633ade-e78f-44f0-ad65-5f7558fa0263">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a3d864df-2845-461c-8b1f-64234527cd09">
      <Text>Not to make a light of it. Who’s done that? I’ll check on my astrophysics colleague at Colby. Now I got to teach.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9e9d419-b954-4dfc-96a7-f0e854abf514">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d7fe47d-dfe8-4960-8be7-5991cb874db3">
      <Text>Isn’t it a snow day?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e266174-9ffc-492b-a489-9b277831ada8">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dbfc3766-6b17-4a8a-904d-e14520726394">
      <Text>I got to teach a theatre workshop. Rain or shine, drama never dies.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f18e88b8-ee3e-4573-983c-1b3f7b25b443">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> takes a photo of the map.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c42f9ac-656b-4c8b-b104-130775d837d2">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ddb2a162-e38a-4d78-b507-1ba50049c9a0">
      <Text>Cam on.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a77e727-330c-4158-81ca-0066e5992724">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fdac8274-037d-407c-9b3d-91e3ed5886d7">
      <Text>You’re Vietnamese?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f18e88b8-ee3e-4573-983c-1b3f7b25b443">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> nods.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8c1c656-47cb-4dca-92e9-2e7264706486">
      <Text>Dr. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ae24de2-69f7-4f3d-90e9-eea469a04c6c">
      <Text>When you enroll in this college, take my spring course. I have so much to share about the Gulf of Tonkin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f16cd021-247b-403f-aef8-322b5bf14d0b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2bf974af-4fb9-41de-aef9-b7ebe429684d">
      <Text>In terms of diplomacy, can you help remove a parking ticket? I didn’t know they still do that on snow days.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="04469de1-5fd9-4820-8a7f-7512117c17f4">
      <Text>DR. BAXTER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8199724-7215-4545-a941-fe6debc674ee">
      <Text>I’m powerless there, Cathy.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f18e88b8-ee3e-4573-983c-1b3f7b25b443">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Dr. Baxter go their separate ways.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="afd75057-69f5-40d3-a299-aa761910b324">
      <Text>Fade to black.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="b1e00c20-c2db-4667-86f7-5f11cc16d0fd">
      <Text Style="Bold+Underline+AllCaps">Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="3 1/8" Page="19" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BAGADUCE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT &amp; MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Penobscot Bay</Text>
    </Paragraph>
    <Paragraph Type="Action" id="52139bfc-f906-44ad-ab66-3944f1bcdec0">
      <Text>The snowfall is dwindling.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a83c1351-fd67-4e9c-98ba-139c9a1c6e93">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> is rowing the boat. She is exhausted.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74fbabac-cc39-4335-8c87-d12def1b9566">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fca30aca-5c44-4777-be04-c3943f8f05f3">
      <Text>You’re better at rowing than driving, I’ll give you that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="53c6100a-c6c9-4f61-b76f-5fbd4fe96b10">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="355fe60f-37ec-4706-b545-cfba3925df70">
      <Text>I was born on an island off Vietnam. Trust me, I can row.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7053217d-e46a-48b6-9a7b-a03f25668431">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="40b3a9c4-9319-4cad-8f82-a7a171f321b8">
      <Text>I still don’t trust this boat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4046c15-3b8c-4921-b7a9-e77d1d00853f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f5004d3-839d-418b-9752-29b9508bd8c1">
      <Text>They didn’t check our IDs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e2b4385a-a706-4304-b763-cbc2ff65f4ea">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e764fc8-fb3d-4689-b3b3-c7fbfda5c18c">
      <Text>Exactly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d55a09a6-65b5-463f-b83e-d936fbf50cfc">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f5004d3-839d-418b-9752-29b9508bd8c1">
      <Text>Just took cash. / It’s the Vietnamese way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9aac37bf-44ce-4cb9-8a44-988c184a155c">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6885619a-a475-4bc1-9f3a-07e8cccb87c5">
      <Text>My allowance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="64e7a10a-9d33-4a7e-bf33-9f59ebff6cb5">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="667057ed-3b7e-4cb8-b8cc-28f7937f3ca5">
      <Text>They gave me a discount for wearing Bagaduce.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96e4ae59-4c8e-4621-9c69-0474924b6fd2">
      <Text>BaGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2179ddc7-f647-4099-80b7-8fe8ede2ec55">
      <Text>I’m not just the spirit of the river, I’m also the spirit of fortune.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7848fbb6-5734-4666-9c3e-943d0aacf130">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="85198cd1-52e0-4072-871f-0f1f3a6e1ac7">
      <Text>No luck finding any island with such lighthouses.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="493e1c34-0cec-40a8-b065-09b371269b9d">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> looks at her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9357a599-93e0-4baa-ba82-084a2968f5c0">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="787ab2b6-bd36-4dc2-8479-0ffd36ee0d53">
      <Text>We’re... approaching “Maguire’s Locker.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7016f77f-9adc-4ebd-9c74-43c52a57de56">
      <Text>BaGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca798090-4605-4bd2-ab1a-010a0759adff">
      <Text>Row, girl! Row!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="95f01b7a-6086-4b72-87cf-5e318b1c6d80">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ebedbd38-81c2-45dd-9bb2-9ba60f07cce4">
      <Text AdornmentStyle="-1">Troi</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">đât</Text>
      <Text> oi. I’ve been rowing for hours!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="95e1f12a-2bb0-48b3-9981-df5e2bd90f11">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e6966c0-5642-409d-90e1-a7648ac859fb">
      <Text>These currents are not in our favors.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ae244e98-462c-4f49-b5f8-f618979b98d5">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a8ff95a-48ac-4067-b9eb-3a5f8644c6ca">
      <Text>That’s the full moon and high tides for you!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37a61b6c-7701-4f79-bccd-772437ee385d">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf556281-3e96-432a-85ed-b0c4c1985160">
      <Text>The historian said this was dangerous!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da705909-aaf8-42dd-9475-9b4d63731510">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0bd65fd3-165d-4e1b-9cfc-90a54ef2c8dd">
      <Text>To sailors with primitive technology. You have that ungodly thing in your hand!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8dca9a6-00b5-4eaf-a45a-56f6d99c43f2">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b1c8008-4c65-4196-b6c1-685d481c3fa0">
      <Text>A row?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a7108636-95d9-4174-a128-7d1952acca4b">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eaea224e-6667-4be1-8134-762964fbbc6b">
      <Text>The phone!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="31842501-a24d-4a4d-965a-2f62b6d557e6">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dad4aee6-143d-460e-b9fb-7fb337221314">
      <Text>If Bagaduce had opposable thumbs, they’d spend all their time taking selfies.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5695312-f2b0-4d79-a53d-d303a963d00f">
      <Text>BaGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1c894b9c-fe03-41d4-912a-c20d341501ce">
      <Text>What’s that supposed to mean?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73ee697f-364e-4cda-a801-044ded1a3d4e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0e34cc8-689a-4806-8984-8217ad77193e">
      <Text>All you care about is yourself! It’d be insane if I can’t survive a full semester in America!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="97776aae-20cc-42c0-b0dc-154deda75904">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="97be6d0b-44ab-49fe-a2e0-22bfc07923ce">
      <Text>I can swim!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d7576f22-8cc0-45ff-8bb0-a45b77f60b0a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5264836-7f8f-47c9-98e0-29a2913b607d">
      <Text>You’re a crab!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ce7a18bd-2dd8-44b9-96b8-9bc37e741d30">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="301a5a6b-cd31-4a32-be5c-2e14b1db9397">
      <Text>Oh yeah... I don’t wanna be this way forever!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad60642b-b5eb-4f35-b63c-ce5eb90f32d3">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d863150c-d598-4b7e-9ad7-e5caf4b7ed41">
      <Text>Well, you weren’t grateful for where you were. Now, look at you!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a0ad74e2-2a00-4c86-b8c1-15e93905d5f7">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed30cfc9-56e6-4949-a65d-9ed0da5a11c7">
      <Text>You’re the one erasing yourself. You can think you can just take off your shoe and be simply a horse girl.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bee3ff81-a005-4808-b3fd-4ece509a1c68">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e187102b-b3e6-4c0b-9ff2-e01d6917dd50">
      <Text>Taking off shoes is the Vietnamese way. If Eric and Sybil can love you as a washed-up shell of a boy, they can love you as a literal hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a48cb88-417f-4a7a-81f0-77680111722d">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32e2720b-328e-4ae3-b076-cb3fa2af6e91">
      <Text>It’s borrowed time. Borrowed shell. I’ve outgrown my home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a940fb4-1460-4219-8673-4af0ce73c9dd">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="673a4f92-d376-46da-978c-43b5063130dc">
      <Text>My boy got them spirit in him!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72922312-bc20-4d15-a5e7-9d6eddf589d0">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e24f1ac8-179e-44a9-8754-0bfc49ec0b7f">
      <Text>That’s your doing!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ba4f5ff7-773f-479f-90fa-6c0037b441a3">
      <Text>BAGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="436f7473-2c7c-4e75-8b21-7a34cdad6d5d">
      <Text>It’s Maguire’s doing... All hail Annie C. Maguire!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8850a0b6-4748-4bdd-9ddc-1de3197d4451">
      <Text>A hailstorm suddenly hits with bright lightning flashes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e4d6c7a7-8463-44fa-bcf5-299c86285a06">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fc33612c-83a2-471c-ae7e-d33f2f0c1785">
      <Text>This feels...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2746a3bd-ac8a-4078-bbfb-85fed7ddd879">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b899977-c27c-437a-abd1-5c6c58a38b4f">
      <Text>I know...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b447269d-0db2-4472-80d1-4f814b419043">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> &amp; MOrgan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef8e765d-a088-4a6d-bc41-2cdeceb4b242">
      <Text>...a tsunami!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="58286c36-386a-4ed2-bee8-9a70f4048dbe">
      <Text>A massive wave impacts their rowboat. The boat capsizes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c9446612-9d9e-4a12-834d-66e28b9ebdc8">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> struggles to hold control and falls in the water.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4ddf6a07-0e67-489b-b777-43f6ab128227">
      <Text>Everything is muffled. The horseshoe crab floats in the water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16af1e68-5f41-4bc8-9233-899b79bb2f68">
      <Text>MorgAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7cdb7ca-c83f-4ed1-a105-cb18802fb4b5">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>! I’m sorry...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3a8c02f3-37bc-4326-9f1c-067cef112475">
      <Text>A horseshoe crab surfaces...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="278fbdae-f642-401f-81c2-245f0eecdce4">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35a6e62f-d056-434b-8094-378d58c4d48e">
      <Text>My legs... I have ten?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="278e34e5-cdf2-4d79-a450-02f7fba298a9">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> has transformed into a full-size horseshoe crab. She struggles to stay afloat in the water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="443fe6d8-3bdd-4ebe-98f5-2dfae8df8a52">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5bf01e72-ba1e-47f2-95aa-a6aab21a39e4">
      <Text>How art thou arthropod...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b2661b4d-33ab-4c49-873d-f292f0f81774">
      <Text>BaGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3ba2ef8c-5590-44a8-80ff-c8b20bb5121c">
      <Text>Dr. Baxter told ya this liminal space will have you two worlds.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27c4b99c-c36b-43b6-8a3b-f19081f44531">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5a25cb6a-0d48-46a4-b8c1-bda5f1af078e">
      <Text>I didn’t think I’d miss having you in my head rather than attached to my very soul...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36026e4c-76e3-423e-b7bc-bae812d2b363">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e2e1df5-b950-4c00-8a21-5a9f540c9682">
      <Text>To the hermit in the sky, have mercy on us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aca44720-891d-41fa-bbef-21617d792339">
      <Text>BaGADUCE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25fd5480-f0d4-49b3-9b3e-5adb6d36cc7f">
      <Text>We are at the mercy of the currents. Annie C. Maguire has us in her embrace!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ac2f9d8e-7e5d-4a15-91a4-1fb8d18aea1c">
      <Text>Black out.</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Label="Scene 1" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="Yes" Type="New Act" id="bcb3d77a-d198-4296-b0b6-07103897909d">
      <Text>ACT </Text>
      <Text AdornmentStyle="-1">III</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="fb8e8564-787d-4e12-b8db-027c40755879">
      <Text Style="Bold+Underline+AllCaps">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="2 2/8" Page="23" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT &amp; MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SPIRIT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Relic Island</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8e1a7794-5960-4cad-80ef-47b5031a0797">
      <Text>Night has fallen. The hunter's full moon shines bright with the waves crashing and wind howling. The old stone lighthouse stands against the night sky.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="88a0e341-dc1a-43e4-82c3-402b2c0fce3d">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> (now a large horseshoe crab) washes up onto the rocky shore, exhausted. Morgan (still a hermit crab) scuttles ashore nearby.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d32aecd4-6524-4f7e-8683-30f2698b32a0">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> &amp; MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="202a23b6-f21c-4f29-8521-da47ae570805">
      <Text>We’re alive! But we’re still arthropods...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac4262cc-7b95-4807-847b-59a45b640e1d">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aae960d6-4a3a-4975-b0c5-e7f482e5ae21">
      <Text>The wind out here... it cuts right through you. My new shell is snug, but it doesn't stop the cold.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8e04068-fc3b-4a3f-8a41-001b05f15d4f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4fcf3b25-5d0d-440e-ad3b-08599f2896ed">
      <Text>We’re armored for a reason. The world has sharp teeth.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="caf776a7-f840-418a-ba71-2bf20b6c8ef8">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> notices the lighthouse.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a99ed93-04f3-4d94-972e-c5cad30e272b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="820ad0a3-48cc-436c-b2d4-43f04eaf980f">
      <Text>This is it. The light must be inside. We can’t hide in the dark forever. Move, Hermit Boy!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="856d75ac-c49f-41b8-89a4-851f1f9c9b62">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Morgan squeeze through a narrow maintenance entrance or window at the base of the tower.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7f4dcf0-6ccb-45ae-8402-a1d2af377dc9">
      <Text>They navigate the spiral stairs as best they can in their current forms.

</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea80366c-ea8b-4bf7-b75d-cdc54dcaeafb">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd331ad0-8fb4-4041-b843-4418bfeb9367">
      <Text>This is harder than I thought. My little legs are aching.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ecb368f3-cc2e-4e08-8432-cdda13527771">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35b1a9e2-ae9e-4e8d-8acb-0d7c8b989d5f">
      <Text>We’re almost there. Hold onto your soul.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="425e82ea-711a-4e0d-a2dd-56c03e933455">
      <Text>They reach the top lantern room. The Fresnel lens is massive, dusty, and automated, but dark.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f27693d8-7b59-4549-8483-ce41f75d2249">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a8d338dd-d0f5-45f5-981a-010384a79f83">
      <Text>It’s a modern beacon. The power is off. How do we spark a light stronger than a hunter’s full moon?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22cead1c-9b4a-49df-add5-fb7b7a3af74e">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5f86f64-dd9e-43f9-8fd4-b562226cf3c3">
      <Text>I don’t know. There’s no switch for "stronger than the moon."</Text>
    </Paragraph>
    <Paragraph Type="Action" id="29e4c4b4-24a8-419a-96ff-da369786a8f0">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> pushes against the automation equipment, knocking a rusted lever. A faint power light flickers, but the bulb remains dark.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="14607ada-96d0-4c08-9786-e29f43fb1b57">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d615368-08d0-40f1-8d4e-aaec1bf6181c">
      <Text>It’s hopeless. We’re stuck like this.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4e485aa8-b713-4c37-acd5-d3face54ddba">
      <Text>A sudden blue glow appears in the center of the room. A group of ethereal horseshoe crab spirits shimmer into existence. They look ancient and judgmental.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a946f0a-e570-4aa1-902f-caf6931bdf5f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6216fd6a-3565-4ea3-9287-6f14db675237">
      <Text>The spirits!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1db18964-5e10-49ce-887c-fcd72279a408">
      <Text>MoRGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba45293b-d160-4cea-9ce8-9f3857707069">
      <Text>They’re here! Tell them we saved you!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e5f4682-f69a-4c89-992f-2e0994668ddc">
      <Text>Spirit (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e0bf53f9-d222-4547-84a4-21804d0a90c8">
      <Text>You carry the scent of the outcast. The river spirit is not welcome here. This is a place of sanctuary, not restless wandering.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be65e8b6-61fd-4bbc-a226-8a333fdeb8f6">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d24ed37-6115-4cd7-9d5c-36cc0d106043">
      <Text>We need to light the beacon! Please!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5dc992bd-493e-4808-8252-7d3715d84935">
      <Text>SPIRIT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8e1b02a-335d-4553-9ac4-edfd0d0b397d">
      <Text>The light is a test of belonging, Horseshoe Girl. You abandoned your source. They abandoned their grief.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ced8da65-d110-4328-ad3d-974c0797e4f6">
      <Text>The spirits begin to fade, taking their blue light with them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01fd4cab-0e92-4965-af94-18392e2a5a4f">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15cc79a0-8cdb-4fe6-8339-f5ea96d46b35">
      <Text>Wait!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ae67742-02f3-4aa4-91b1-775163543ef8">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bb2923dc-8087-404f-982e-6f92c7bfda5d">
      <Text>They’re leaving us here! We failed. They’re right. I’ve been trying so hard to be someone else, I don't belong anywhere now.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bef8b32e-c423-4804-8f9d-c2d79d42dd91">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> scuttles dejectedly away from the light. Morgan watches the blue glow diminish. He looks at his new, perfect Nautilus shell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="35f955f1-342b-4113-894f-d2452e19c613">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5cb5506-654b-47e3-913b-e21a13f15a78">
      <Text>No, we didn't. I've been running from my memories, but this shell... it fits. It feels safe.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0e5e2045-8662-47ad-99c5-c8e454dd4d5c">
      <Text>Morgan holds his shell close. The blue light pulses around him, forming a sphere of peace. A soft, warm melody begins to play.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="fb8e8564-787d-4e12-b8db-027c40755879">
      <Text Style="Bold+Underline+AllCaps">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="5/8" Page="25" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="FATHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MOTHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Morgan’s Inner Thoughts</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b770c7ec-1cdc-4e2a-a7d9-4a7155ad1420">
      <Text>The room dissolves into an astral plane of swirling water and starlight.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7e720bba-69d7-4a92-80ff-496a57d86d79">
      <Text>His Indonesian </Text>
      <Text Style="AllCaps">mother</Text>
      <Text> and </Text>
      <Text Style="AllCaps">father</Text>
      <Text> appear, smiling warmly. They wear traditional clothing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a35f72f9-e759-4a21-8b16-f1d3d9cc10cf">
      <Text>Mother</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b762af04-c6cd-405a-bb35-2b306e344978">
      <Text>(in Indonesian)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b829138-c291-4d1b-a618-e6cd55b19a54">
      <Text>You carried us with you, Morgan. In that shell. You remembered the source.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="283ddfc4-2aa7-48af-91bd-b53c1710cde4">
      <Text>Father</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="935b806c-8868-4b0a-b5d3-259bea822f6b">
      <Text>(in Indonesian)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7e4051b9-cf38-4775-a555-4922724fdcc5">
      <Text>This is your armor now, the love you found in the world.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="640ca62e-1467-407b-b83d-0eca608e6625">
      <Text>Morgan (as a hermit crab) scuttles towards them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5dbbaf0-6408-4b11-b5b2-6d845df599f8">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8dca19dd-98ac-4601-97f5-d1c8b3d0ca60">
      <Text>My shell... it fits now.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fc70b7c9-46ac-431d-b9c9-416db2167022">
      <Text>MoTHER</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="935b806c-8868-4b0a-b5d3-259bea822f6b">
      <Text>(in Indonesian)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f54e11bc-5bb1-44c2-aa3d-62c92adb66d6">
      <Text>You are a bigger man now, my son. You are home.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="640ca62e-1467-407b-b83d-0eca608e6625">
      <Text>They embrace. The light swells.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="fb8e8564-787d-4e12-b8db-027c40755879">
      <Text Style="Bold+Underline+AllCaps">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cdeb9b90-00bd-4571-bac9-564118a6abff">
      <SceneProperties Length="1 1/8" Page="25" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MORGAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Relic Island</Text>
    </Paragraph>
    <Paragraph Type="Action" id="98573a3d-8869-40bd-be9b-33420611eef8">
      <Text>The astral plane snaps back to reality. The room is blindingly bright. The entire Fresnel lens is illuminated, the bulb somehow sparking to life, blazing with a light stronger than the full moon.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9329f1b3-bfb2-4e4c-b316-0eee8bf24923">
      <Text>The light pulses. In the center of the room, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Morgan stand human again, blinking in the glare. Morgan still clutches his Nautilus necklace. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> is in her horse hoodie and jeans.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d6f3d434-1c33-4686-bb50-6fbdc42db780">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a01c239a-cbc2-4bc7-9117-505f15d4a56d">
      <Text>It wasn’t about a bigger light, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>. It was about a bigger heart. The shelter of home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37d6b1ed-3ee9-4377-aa4a-6629be6b077e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f4b84ec-7838-4963-8fbb-f6f6f8152ef5">
      <Text>We may humans again, but you have the philosophy of a hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6750c666-6703-410a-864f-50bbb7079941">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61dd7b10-4ef5-492e-8d9a-1fb0998714b9">
      <Text>I can feel my allowance in my pocket again!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef82cd7a-259d-4f13-a413-cc219d729dff">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9262106-09da-44f9-8b6d-e53ea525ce25">
      <Text>So </Text>
      <Text AdornmentStyle="-1">roi</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">đó</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">phai</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">không</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="27562a43-f251-4ead-8ef5-b0204cf29361">
      <Text>MORGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="66e6316c-bde2-4afa-9b24-12521ea88119">
      <Text>Yeah. It’s over. Let’s go to-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="27e1cdb1-589e-40db-b688-ebe3ccfd94b9">
      <Text>They hear a boats approaching. A searchlight sweeps across the windows.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="fabdfcae-b951-4278-923e-8e7d37cde1ea">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="c00bd64d-befc-4322-8efc-a667045fd7fa">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="5c10b4f1-b7bb-4d24-b8f0-05a1bf50a5e1">
          <Text>The light!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="edbd38f9-1589-44c4-b807-6fb2e24a736b">
          <Text>MorGAN</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="1b15e731-86f4-4cb7-8089-c89f993ddfba">
          <Text>The Coast Guard...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="41588d83-4d25-4826-a9c6-208ff2a4a0f0">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03dd8378-2d2d-4fa2-ab16-3b4a4bdfa201">
      <Text>It finally feels like home.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ec33c0a8-ff7e-4eee-8cfc-a3fc10ac4123">
      <Text>Morgan embraces </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>. He smells like salmon and high tides. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> is home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fd75ced4-7c55-44ec-bf94-99c9b4fa5ebe">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05682f7c-640b-46e1-84cc-b22bdb2f10d8">
      <Text>The Vietnamese way is to take off your shoes. I’m keeping mine on.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f7438d77-4be2-4754-ab6c-80cfc95931fc">
      <Text>MorGAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb717958-62f1-47b4-89bc-4ee5fb760534">
      <Text>That’s the Maine way.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="27e1cdb1-589e-40db-b688-ebe3ccfd94b9">
      <Text>Black out.</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="24" Spacing="1" StartsNewPage="No" Type="End of Act" id="a3172081-1aa2-4f43-8d7a-8ffcbf054f4c">
      <Text Style="Underline+AllCaps">End of Play</Text>
    </Paragraph>
  </Content>

  <Watermarking Opacity="70" Position="Diagonal Descending">
    <DynamicContent>
      <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="1" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
    </DynamicContent>
    <Distribution>
      <Name></Name>
    </Distribution>
    <WatermarkImage Height="144"></WatermarkImage>
  </Watermarking>

