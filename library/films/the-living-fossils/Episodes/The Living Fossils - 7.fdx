<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20251212T184836" id="c6458417-5d7c-4ebd-8e07-54982c91d980">
    <XRef DateTime="20250719T224917" id="326d3bbb-277d-4966-b8b4-fc0c38660087"/>
    <XRef DateTime="20250719T225100" id="311bf653-30ed-4d65-a49b-1d9bc7012bab"/>
    <XRef DateTime="20251212T184728" id="6b27bc46-320f-42ec-a591-7b32e0147123"/>
  </DocumentRef>

  <Content>
    <Paragraph Type="Scene Heading" id="c6fb7213-b5d4-46a2-a557-eafadef2403a">
      <SceneProperties Length="3/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Fossil Island - Beach - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c6b3a1cf-2fdf-4b57-95cd-9deed0020018">
      <Text>Acadia lies face up and unconscious on the sand. Kooky rests</Text>
      <Text Size="10"> </Text>
      <Text>on</Text>
      <Text Size="10"> </Text>
      <Text>Acadia’s</Text>
      <Text Size="10"> </Text>
      <Text>chest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b967d270-c4e2-4ed8-9611-a9480d48e541">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c60aff4-dcb5-401e-974d-69a1d26533a8">
      <Text>I feel like a fossil...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dd7287ad-c644-4914-bf1e-79f1c3ae09e0">
      <Text>Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9984bc52-81f9-45f5-9a8b-affde23a0a85">
      <Text>This is what it feels like to live.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e18b601c-e637-4c28-90bf-7a813a632a9c">
      <Text>Acadia turns to see the familiar horseshoe-shaped cliffside. They are back!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2479b5e7-5a05-4955-8095-bc7092bd44be">
      <Text>Acadia stands up and places </Text>
      <Text Style="AllCaps">Kooky</Text>
      <Text> on her shoulder. They enter the forest.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="befc23ac-f616-4cca-88bf-4a3e4458b25b">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Fossil Island - Inland - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="23fc0cd5-2af2-491a-9e34-ef0af997f08e">
      <Text>Acadia and Kooky hike through the forest, uncover trails, and climb boulders.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c044c21e-43fc-45d9-a8e6-9d3826f0c202">
      <SceneProperties Length="2 7/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ACADIA &amp; CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT &amp; KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Fossil Island - Cliff - Hours Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0ba3f845-9d94-449b-bb41-34c8cd6935ee">
      <Text>Acadia and Kooky reach a shrine. Horseshoe crab shells are uniformly positioned. They each have red markings on them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c6f34c1a-753b-4680-8cd7-159b2e435e05">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="55e17a1d-99d6-4604-ae0b-abecbf24bc71">
      <Text>I ain’t feeling it with the dead. Undead?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84ec2a90-4f5c-4f1f-aa57-6727bf8b562b">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6dd8be61-7189-45bc-a1d0-7fa0efcc8ca5">
      <Text>They’re molted shells from many generations of horseshoe crabs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1184a09b-8f7b-4868-972d-23c430ad07ce">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3219f341-1a8f-4228-95d9-c3caa3565100">
      <Text>But those markings are human blood... from many generations.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d9ee7f62-5262-424c-aad2-71d343eee533">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5c3b222-f31d-461a-a44f-ce9d7c93cf4a">
      <Text>I’ve held onto your mother’s blood for safe keeping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="df0e581a-c6f3-42d6-9a18-4cbbb5929580">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fa17cf99-0691-439a-b03b-0540204b383d">
      <Text>That’s messed up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61db28e4-4e90-4343-a19f-03023a31ee63">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dcafb6f4-09d8-4541-983c-231e7d2c6e76">
      <Text>There are lots of messed things these ten legs can do.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e5fb3663-9dff-4d07-b04a-5231a67d1a77">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e0768cc-dcb4-4022-8a3a-b36a779d7312">
      <Text>I don’t wanna know...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7edc144e-850e-43e1-b131-e7856bed1eb6">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="128fa12f-5687-487f-a452-0e95eb2fe59f">
      <Text>Well </Text>
      <Text Style="Italic">scientist</Text>
      <Text>, what’s messed up is that you stash our blue blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b44af127-67e1-498d-8a09-6c35383ea260">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2098be67-f64b-405d-9bd5-234285b89bff">
      <Text>Touché.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a1e7a7f-5fc0-4f85-b3d5-7e2dce5b6cfd">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75eb88e5-1a96-4914-83ea-83d6adb585c2">
      <Text>Put me in, kid.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d4a45d6e-718e-43c4-9a71-8703e31bb103">
      <Text>Acadia places Kooky in the little pond. The pond swirls.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d8450b9e-2616-4b56-84d5-506ed1841177">
      <Text>Kooky is now a hat on Cát’s head when she transforms into her. Dressed in the same veil of a horseshoe crab, Cát sees Acadia. They share a smile. A connection. They hold hands.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da88f82b-0821-4be2-89fd-f1c4868df696">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7b5509de-d61f-487e-a452-bee8f55ecc10">
      <Text>Happy birthday, Acadia. You’ve made it just in time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc23cbfa-5144-4ff5-bfcd-57bde85a4a33">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7bde2429-2ce4-4f87-995f-ad4c96133af8">
      <Text Style="Italic">Me (Viet: Mom)</Text>
      <Text>... I’ve missed you. </Text>
      <Text Style="AllCaps">First things first</Text>
      <Text>. It’s time to tell me what’s going on.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="508f65f2-6c97-4c39-8981-a56a9a6bdaa0">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8131d44a-c5cb-4008-9a04-c650fbf15593">
      <Text>For generations, our ancestors lived in harmony with these living fossils. On their last molt and our 15th cycle, we gift them our blood. But, you’re the first in the family to draw theirs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea472227-04a0-4d2c-b43b-1e102f7a9469">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1656bf8e-4a0b-48e0-adf3-5ee4ffea9d8d">
      <Text>Teens need to experiment...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="94e94466-d883-44cb-b8ba-601512239408">
      <Text>With her left hand, Cát takes </Text>
      <Text Style="AllCaps">Kooky</Text>
      <Text>’s molt off her head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4311f376-7e53-47b0-ba6d-262a31fd52aa">
      <Text>CÁT &amp; Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f6daf20d-da43-44ed-b21d-060a1265a6a8">
      <Text>My last molt.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="31c93d38-29e7-4915-878e-e94a0acbbbe9">
      <Text>Cát releases her right-hand grip from Acadia. Acadia’s hand is now cut there, but it is painless. She places her bloody hand on Kooky’s last molt, leaving her mark. She sets Kooky’s molt in an open spot alongside the other generations’ molts.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0248b983-3700-4567-b721-2d6f61ac56ca">
      <Text Style="Underline+AllCaps">“</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Never Change</Text>
      <Text Style="Underline+AllCaps">” Song</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ce978f78-269e-46ed-8c8d-8353c49f9766">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="afa89114-b3b2-4767-aece-27659afa4e84">
      <Text Style="AllCaps">Let’s exchange looks to see the first light of day
do not change your outlook and ever look away
because child, you are no stray
it seems you’ve never changed</Text>
    </Paragraph>
    <Paragraph Type="Action" id="668f1ea8-96a7-42d7-a65f-255e6cdb49dc">
      <Text>Acadia walks away. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> runs and throws horseshoe crab-</Text>
      <Text AdornmentStyle="-1">esque</Text>
      <Text> clothes on Acadia, so that they are matching.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f16295c-def1-444c-b61d-317b41430a82">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5334a30d-dc10-4250-bb3b-3d7d26515542">
      <Text Style="AllCaps">don’t shortchange attention to go our separate ways
let us change for an outing and look good today
even grownups can be led astray
so never ever </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">ever</Text>
      <Text Style="AllCaps"> change
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5334a30d-dc10-4250-bb3b-3d7d26515542">
      <Text Style="AllCaps">I’ll stay by your side, loving you, please never change</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bad1fa23-6d5e-4a13-8899-053920727eb9">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="636f61f9-d1b8-4a78-9274-5677a99c4742">
      <Text Style="AllCaps">Let’s...
don’t...
Even...
You too haven’t ever changed</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fd7fee08-093d-46b2-8bb2-d5653a2e4e00">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c8e0b1e-457e-4036-a25b-e5ad13dba61f">
      <Text Style="AllCaps">I’ll stay by your side, loving you, Just please never change</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a142c066-47b7-4aef-8481-ee7a19f909bb">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="693b7856-e8e3-477e-8ebb-4dbab3a7ebb9">
      <Text Style="AllCaps">Cannot stop this skin from molting wrinkles
cannot stop the thoughts from misremembering my things
cannot stop more and more feelings of endless woes
cannot stop reminiscing about the less frequent wins
the clock never stops taking a toll</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec84107a-e577-42f5-97c6-08ee3f1969d1">
      <Text Style="AllCaps">Time is still the exchange so...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="45bf6040-5faa-44dd-b4af-1215f46e8f86">
      <Text>The spirits of Acadia, Cát, and even Kooky’s ancestors manifest from the shrine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="244bf2d9-9418-4a1c-94e2-1eafddfb56ee">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd13167f-264c-4d27-88e7-547526c18e44">
      <Text Style="AllCaps">when you’re older, your heart stays young!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="3a1ecdae-ed87-466b-8dd5-c8d8339983d4">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="bc76db85-1904-4ec8-aaac-f83a7efa23e3">
          <Text>Acadia</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="44e5ea3f-be66-4d5d-b388-ea4bb6a8b2e2">
          <Text Style="AllCaps">We’re living fossils?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="c0e6fb7a-4952-48a7-b521-41b9d19d915d">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="2bfcb562-f646-41ea-af81-738322c13d4a">
          <Text Style="AllCaps">We’re living fossils...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="12728815-31f0-4881-8d3f-209285e634fa">
      <Text>Acadia and Cát embrace.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94944029-196e-4708-8d6f-f6b42645d59b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6aa3de2c-2a37-468f-8d84-d9348472c8ef">
      <Text Style="AllCaps">You’ll never change...

Let’s exchange looks to see each light of day
do not change your outlook and ever </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">ever</Text>
      <Text Style="AllCaps"> look away
because mom, you’ve never strayed
you’ve never changed</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e7aae97-3735-4649-8027-bd6a69056b84">
      <Text>Acadia &amp; </Text>
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6a9f5031-b2d5-42b7-9755-6607aa1d0b69">
      <Text Style="AllCaps">I’ll stay by your side, loving you, let’s never change!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b8473e4-a3d4-4383-8889-4c7de85107ae">
      <Text>Acadia and </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> run towards the camera. They dive off the cliff and into the sea. They transform into horseshoe crabs and swim off, becoming shadows in the fog.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0edd38d9-039f-4cc2-8f01-a92ff175e4b1">
      <Text Style="Underline+AllCaps">End of “</Text>
      <Text Color="#00000000FEFE" Style="Underline+AllCaps">Never CHange</Text>
      <Text Style="Underline+AllCaps">” Song</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5c5a5150-0280-459b-b806-be85814b973a">
      <Text>Unveiling from the fog is the end title: </Text>
      <Text Style="AllCaps">The Living Fossils</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="End of Act" id="a3172081-1aa2-4f43-8d7a-8ffcbf054f4c">
      <Text Style="Underline+AllCaps">The End</Text>
    </Paragraph>
  </Content>

