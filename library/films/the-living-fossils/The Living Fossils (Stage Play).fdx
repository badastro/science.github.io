<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20250719T225100" id="311bf653-30ed-4d65-a49b-1d9bc7012bab">
    <XRef DateTime="20250719T224917" id="326d3bbb-277d-4966-b8b4-fc0c38660087"/>
  </DocumentRef>

  <Content>
    <Paragraph Type="New Act" id="fbcd9358-7059-48fe-b185-1836045c8801">
      <Text AdornmentStyle="-1" Style="Underline+AllCaps">Uong</Text>
      <Text Style="Underline+AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="Underline+AllCaps">Nuóc</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="1 4/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ocean Floor by Vietnam</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7ec7d420-048c-403d-83d8-e4bf1f83af4e">
      <Text>Waves crash, gulls scream off the coast of Vietnam. A scrim hangs.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="86b3b993-753c-4a92-a231-b4afcb2908f6">
      <Text>A quote projects</Text>
      <Text Style="AllCaps">: “</Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Uong</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Nuóc</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Nho</Text>
      <Text Style="AllCaps"> Nguon.”(“When drinking water, remember the source.”)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3523cf66-c501-4be2-9091-95e465a0ee5d">
      <Text AdornmentStyle="-1" Style="AllCaps">Cát</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Lý</Text>
      <Text Style="AllCaps"> tran</Text>
      <Text> and her four-year-old daughter </Text>
      <Text Style="AllCaps">Acadia</Text>
      <Text> look in the water. In it, a shadowy mother-daughter pair of </Text>
      <Text Style="AllCaps">horseshoe crabs</Text>
      <Text> swim together through puppetry.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3b6adde9-512e-40b5-85c2-d93c6166daeb">
      <Text>Dialogue in </Text>
      <Text Style="Italic">italics</Text>
      <Text> is spoken in Vietnamese with English subtitles projected on the scrim.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67c3d0f6-c48d-4555-9771-51a8cdcff4c1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="9daf6aba-2fb9-46fa-a4f4-9e88d49419b6">
      <Text>(in Vietnamese)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="274e7640-26bc-4217-b7d9-e84d9e4c4e36">
      <Text Style="Italic">The shoreline feels safe, but the open sea knows truth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62d57674-0b0f-4c70-9eec-0901799a7161">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fe47a118-2151-4507-aa37-464419456b98">
      <Text Style="Italic">No souls lost on my watch. Splash!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67c3d0f6-c48d-4555-9771-51a8cdcff4c1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b581d6d-47d7-4c4e-8c1b-257bdf0de04f">
      <Text Style="Italic">Gentle currents change nothing. The powerful crashes of waves are what reshapes sand.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="02987200-7455-409c-ab26-f2959a07d584">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="73f06482-3e8a-4358-8858-9e9ea1421103">
      <Text Style="Italic">Does it make a loud noise?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63621036-2d4e-4c54-9809-565b9732c1f6">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b581d6d-47d7-4c4e-8c1b-257bdf0de04f">
      <Text Style="Italic">Very loud. A kinetic clash that shakes us creatures awake.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="630bd89c-e12e-4309-bac7-e8bc570b02a0">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c74e1e79-f486-490f-86d8-354b2108217f">
      <Text Style="Italic">We are creatures? Like monsters? With sharp claws? Hard shells?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed5da469-9aaf-4af1-8d6f-6a3e8b7b2f52">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d59d0017-4127-442c-bcf9-0e13a1f4b62e">
      <Text Style="Italic">We’re armored for a reason, little one. The world has sharp teeth.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7040eb5a-ba27-4c4f-bca4-3706533c7dc9">
      <Text>The mother puppet lifts her young on her shell, following a current. The lighting shifts to a murky green as they enter a shallow bay.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a7d9661-ac2b-4efe-ae7c-7be1212dad9f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4628953f-133f-447b-9721-e0d4874e3a70">
      <Text Style="Italic">A calm bay must break its own shoreline to stay an open sea.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da5a9405-21fb-48e0-bec9-a7cabf03888a">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4cfe9d6c-26e0-4d0d-8e1b-6aa3c6ddf7d1">
      <Text Style="Italic">Change won’t wait for us?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e5d629ac-e019-4ee4-84e6-3a7dbf54867a">
      <Text>Am aggressive and mechanical roar of a boat motor cuts through.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90dc5134-e68d-4802-941d-8c681d1b030a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="9daf6aba-2fb9-46fa-a4f4-9e88d49419b6">
      <Text>(in English)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21d38578-f146-452a-88ba-d2150064ab52">
      <Text>Change says... Out with the old...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3678fa9d-4a30-4570-a12a-116fe3e3bdf5">
      <Text>A boat’s shadow engulfs all. The mother looks up in pure terror.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3678fa9d-4a30-4570-a12a-116fe3e3bdf5">
      <Text>A massive, heavy iron ANCHOR drops, plunging towards her baby.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="50e02081-1492-48b9-8212-db31ebb8a638">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="b04e3490-48dd-42ca-8647-c69814f10d37">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="5f1384eb-bb18-4946-80ac-b600f22857af">
          <Text>...In with the-</Text>
        </Paragraph>
        <Paragraph Type="Character" id="d4bb6f0f-408c-4f83-8993-42d68d9a438c">
          <Text>ACADIA</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4accd4ab-df2d-4d5f-92f1-4beba835cdca">
          <Text>New!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="7f89d355-e687-4b14-867b-a2298cde50d7">
      <Text>The sand obscures everything.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="2 7/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>A Home in Haiphong, Vietnam, 2034</Text>
    </Paragraph>
    <Paragraph Type="Action" id="73b8146b-e316-4fb7-aff9-88f94b58a9fc">
      <Text>Lights up in a Vietnamese bedroom. It’s 2034, so a blend of modern and traditional. Outside the window, a distant billboard advertises two horseshoe crabs for an aquarium. Graphics read “</Text>
      <Text AdornmentStyle="-1">Hóa</Text>
      <Text> Thach Song” and “Luc Nay 2034.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4dde88c1-fac6-4e02-8bf5-9ced9175dc88">
      <Text>Eight-year-old Acadia takes a photo of the billboard on a phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9e2b00d-3f02-4cb1-b823-537f29194a0e">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69c19ec6-21d7-4a2f-a1c7-f7b199cc0af2">
      <Text>New word of the day. Tac-hi-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c3eb786c-c8b6-4863-b645-30ec9179656e">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="3059e785-70ba-4c52-b483-6d134edb5c50">
      <Text>(in Vietnamese, subtitled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b275197-8a44-4d3b-b63a-440f7cb02145">
      <Text AdornmentStyle="-1" Style="Italic">Tròi</Text>
      <Text Style="Italic"> oi, con </Text>
      <Text AdornmentStyle="-1" Style="Italic">nho</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">này</Text>
      <Text Style="Italic">!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="-0.10" Leading="Regular" LeftIndent="3.00" RightIndent="5.50" SpaceBefore="0" Spacing="1" StartsNewPage="No" Type="Parenthetical" id="e64f2ed7-ab43-42ab-a907-ea2ea296f033">
      <Text>(Oh goodness, this girl!)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eda4882a-3068-4180-899f-3c8fa2639219">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>, wearing a physician's coat, enters. She cascades “love” that only a Vietnamese mom would give.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c6f3f66-f3b6-4712-9a83-7dcaf1ebb8d3">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="11c508c8-b4b3-4278-a5d8-c78824e982dd">
      <Text>Oh my goodness, today / is</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3c61d99c-cfb8-4b91-ac9a-63b8af82cb2f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f93866ee-a96b-4ee9-9ac7-8159082f997e">
      <Text Style="Italic">/ </Text>
      <Text AdornmentStyle="-1" Style="Italic">Troi</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">đât</Text>
      <Text Style="Italic"> oi, </Text>
      <Text AdornmentStyle="-1" Style="Italic">cai</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">phòng</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nhu</Text>
      <Text Size="10" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">heo</Text>
      <Text Style="Italic">,</Text>
      <Text Size="10" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">thôi</Text>
      <Text Size="10" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">quá</Text>
      <Text Size="10" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">tròi</Text>
      <Text Style="Italic">!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b43dbae9-159e-4f73-9619-5e21aa4a35a8">
      <Text>(Oh my god, you live like a pig, it stinks to high heaven!)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a2fa39bf-28ee-484f-9ba3-6c19186294b4">
      <Text Style="AllCaps">Subtitle: </Text>
      <Text>Oh god, you smell like heaven!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d6a05d84-5edb-4946-bf3a-419bc9e56682">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b308bb5-2f5b-4a09-91ed-9b7ccbee3d1c">
      <Text Style="Italic">Me</Text>
      <Text> </Text>
      <Text Style="Italic">(Mom)</Text>
      <Text>. It’s MY day today, okay? We ain’t speaking none of that.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a7601b2-dd91-4a83-8e9b-acf1e8761dd5">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ffbcedfa-7c8d-4244-ab74-cf419d2b1a8f">
      <Text AdornmentStyle="-1" Style="Italic">Thúc</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">dây</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">thê</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">ôm</Text>
      <Text Style="Italic"> </Text>
      <Text Style="Italic+AllCaps">phone</Text>
      <Text Style="Italic">!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c0422596-9be5-4ff7-bb73-07c4d890bbc4">
      <Text>(You wake up hugging that phone!)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="08dad42c-4a72-4bd4-9df3-c95fcc964c2b">
      <Text Style="AllCaps">Subtitle: </Text>
      <Text>Please waste your life on your phone!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1b3e4ff-da3f-4d61-81cf-5a0f4f600c79">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69530b4c-99d0-4fe7-af98-88871c64cfa7">
      <Text>It’s YOUR phone! For my special day, we’re speaking ALIEN.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dbf43025-8d49-4ebe-9601-d3e2b209d0b4">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="-0.10" Leading="Regular" LeftIndent="3.00" RightIndent="5.50" SpaceBefore="0" Spacing="1" StartsNewPage="No" Type="Parenthetical" id="8ed9169b-9e38-4911-a3cb-32136b2b3559">
      <Text>(In English)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f2ba6d9-e863-4882-b8e2-29624e4ef84f">
      <Text>Cadi (</Text>
      <Text Style="AllCaps">K</Text>
      <Text> D) Noble... Stubborn. </Text>
      <Text AdornmentStyle="-1" Style="Italic">Ngang</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nhu</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">cua</Text>
      <Text Style="Italic">.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="fb94e6c8-4eba-4dde-acaa-37b76bf9c979">
      <Text>(Stubborn as a crab.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eac67991-51d5-4839-b4fb-0f07dc4ea82c">
      <Text>You’re speaking my second language. Well...</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5587fe0-98bc-4cd0-83a5-cd226aecec63">
      <Text AdornmentStyle="-1" Style="Italic">Nhìn</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">gì</Text>
      <Text Style="Italic">?</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="-0.10" Leading="Regular" LeftIndent="3.00" RightIndent="5.50" SpaceBefore="0" Spacing="1" StartsNewPage="No" Type="Parenthetical" id="afbd6802-61b2-46c3-89ba-290b271220df">
      <Text>(What are you looking at?)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21d3bc5c-9857-45b1-bebc-ef02fab8cbd3">
      <Text>Saddle up! Put on your shoes!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5037b697-f0be-4688-aa57-3efd4e572570">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dcb811e2-f50e-4a80-8951-d36c7236c3d0">
      <Text>Love you!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e61fdf0e-5a3a-425f-a04d-cdd98febe13a">
      <Text>Acadia wears a</Text>
      <Text Size="10"> </Text>
      <Text>naval</Text>
      <Text Size="10"> </Text>
      <Text>school</Text>
      <Text Size="10"> </Text>
      <Text>uniform and plays with</Text>
      <Text Size="10"> </Text>
      <Text>her</Text>
      <Text Size="10"> </Text>
      <Text>red</Text>
      <Text Size="10"> </Text>
      <Text>neckerchief.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7bb17aec-e839-4316-8fdc-7b1130ed294a">
      <Text>A motorcycle revs loudly outside.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="17ea09f6-c0bf-47c6-a730-9f05cfe31225">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f742d180-60cd-4414-b5b4-9273b8ca3ddf">
      <Text>Cadi! </Text>
      <Text Style="AllCaps">Acadia Noble Tran</Text>
      <Text>!!!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d962f7be-93cd-4233-bef4-614331f9a490">
      <Text>Acadia straps her </Text>
      <Text Style="AllCaps">Viet leaf hat</Text>
      <Text> (</Text>
      <Text AdornmentStyle="-1">nón</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">lá</Text>
      <Text>) to her back and runs out.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="438f9ff7-b34e-449b-8c3c-0641b0e3c56c">
      <Text>The house becomes the vibrant coastal </Text>
      <Text Style="AllCaps">Haiphong</Text>
      <Text>. Modern signage clashes with folksy stalls. Pedestrians may crowd the streets with sugarcanes and </Text>
      <Text AdornmentStyle="-1">bún</Text>
      <Text> cha bowls.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="60fe98a5-5b60-4a3f-81f6-92b1a0bfd527">
      <Text>Acadia sits behind </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> on a motorcycle, with their leaf hats.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="551f4486-8193-4b5b-87ac-0c736d5fa4ef">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8647caf6-82de-4fba-be5d-c13bcb7b1465">
      <Text>Keep playing with my neckerchief, dear. It’s stretching its limits.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac560989-e82c-442a-90d6-8fc6a7a8b571">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7336392-1d26-47cc-aa85-ba0a28beb64f">
      <Text>Whatever floats your boat. Motorcycle today?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="547b6ecc-ea5f-4ffc-8079-80a9b932fb50">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="74658516-6e17-433b-91dd-aca065e6fd49">
      <Text>We’re running errands in style!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8bb50e5-edfe-4b82-a378-fad97a334d6a">
      <Text>They drive around until they stop by a ceramic stall.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8bb50e5-edfe-4b82-a378-fad97a334d6a">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> purchases a bowl.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a74a8dd-7e2e-412c-ae4d-25df64de79dd">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fcc22c05-808f-4da9-a5cb-75c8d513cc2d">
      <Text>A bowl? Another </Text>
      <Text AdornmentStyle="-1">cái</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">bát</Text>
      <Text>? I got one for each day of the week already.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8bea8dfb-db2f-4133-8fc3-add7fc819ad7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="600644c9-6f3b-43db-ad51-29ee7133840b">
      <Text>Now you have eight.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="24e3a598-69a3-45c8-9575-3e3db886fff0">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="de9c3920-c0b1-4976-aae3-00eab60d028e">
      <Text>And when I’m old like you, I’ll have one for everyday of the month.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="648cb8ae-afdb-48e5-9f86-b4e8b849f52b">
      <Text>CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6eabcdcd-c9f9-4e28-bdb0-60f24fa9dd6a">
      <Text AdornmentStyle="-1" Style="Italic+AllCaps">ă</Text>
      <Text AdornmentStyle="-1" Style="Italic">n</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">đòn</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">không</Text>
      <Text Style="Italic">, </Text>
      <Text AdornmentStyle="-1" Style="Italic">muôn</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">ăn</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">đòn</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">không</Text>
      <Text Style="Italic">?!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="431b6cff-e5a0-40bb-889d-f5c6ec70cabe">
      <Text>(Want a beating? Are you asking for one?!)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5764e3cf-48d0-4434-9254-955ed09b1324">
      <Text Style="AllCaps">Subtitle: </Text>
      <Text>I love you so much, it hurts.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="27ed688b-492e-4f7d-a034-030331edfde8">
      <Text>Acadia shows </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> the billboard photo on her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="562f2c7c-a8d8-48a6-b6ad-5b631819292a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="28f01cd0-0f84-4cd3-8ccc-85c2265c2bad">
      <Text AdornmentStyle="-1" Style="Italic">Tachypleus</Text>
      <Text Style="Italic"> gigas</Text>
      <Text>. Horseshoe crab in Latin. But "gigas"? No way they get that huge.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45b7857d-367c-4cd2-80bb-2584f52f6b81">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="158e9b5b-86bc-44ae-a134-cae55759bc3c">
      <Text>They get fifty centimeters big, </Text>
      <Text Style="Italic">Me (“Mom”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff741de3-75f6-4550-bb36-7098b96ba6df">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4666b91b-b2b2-4ba6-97b0-592ee6b9a2e2">
      <Text>Ha! I’ve baked longer baguettes. “</Text>
      <Text Style="Italic">Gigas.</Text>
      <Text>” Ah since you got my phone, book our reservation!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a3d816d-43cf-46ab-9df2-68249a486c3d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05eeac90-7636-4fec-9728-98a749d6daa8">
      <Text>Why not you?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b02f03b6-e5e6-4174-ba1e-e1a84854df5d">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0cdd68a8-da04-4804-ae81-da61a89d6aa9">
      <Text>I got to stop </Text>
      <Text Style="Italic">reserving</Text>
      <Text> all the joys of </Text>
      <Text Style="Italic">reserving</Text>
      <Text> for myself!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd50eed6-82be-4c31-ad2a-0475ec100f41">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e498db51-26d9-4f23-9e34-699bc6c8f45c">
      <Text>Please dial back the puns, mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4eef6e3-23ee-4b88-82d4-041654e97610">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35de909f-26d3-4eec-97cf-e802bc0953cf">
      <Text>You actually need to </Text>
      <Text Style="Italic">dial</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b50e4a90-5667-4da1-82ce-561ecda9795b">
      <Text>Acadia rolls her eyes and dials.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="35c4e220-193d-4f7c-a492-db2b116d93d4">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="437d419c-a7d4-4533-bb50-28654b5e6dfb">
      <Text>8...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c3764909-ffcb-45d1-a291-87a2f84fd067">
      <Text>They park by a restaurant and find a table.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="3 2/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ACADIA &amp; CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Pho Restaurant in Haiphong, Vietnam</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5eeb9ebc-5cbb-4495-92f5-937a81988ed9">
      <Text>A small restaurant near the harbor. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Acadia sit at a table. Acadia’s bowl of </Text>
      <Text Style="AllCaps">pho</Text>
      <Text> is untouched. Empty plates of mollusk shells are stacked on </Text>
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> side.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d94f0bde-8d04-443e-b6fa-756d4f6a036f">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> holds up a placemat featuring zodiac animals for a selfie with a grumpy Acadia.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9788f6b5-da6c-4e39-8d50-b8051e7ce444">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="-0.10" Leading="Regular" LeftIndent="3.00" RightIndent="5.50" SpaceBefore="0" Spacing="1" StartsNewPage="No" Type="Parenthetical" id="55d1110f-bfc8-49ae-9c21-0d3f15433d44">
      <Text>(Looking at her phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d3f14562-a279-45da-81d3-afa4c9b0ad3c">
      <Text>Birthday number 8. </Text>
      <Text AdornmentStyle="-1">Sinh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">nhat</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">cua</Text>
      <Text>, Cadi Noble.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f27c03de-125f-46e8-9730-617d8305ebdd">
      <Text>On the scrim, we can see </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> scroll through past photos. All at the same table, taken yearly with </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> holding placemats with animals of the year descending from 2034 to 2027 (when Acadia was one). The 2027 photo shows them with an Indonesian man in a U.S. Coast Guard shirt. Le </Text>
      <Text AdornmentStyle="-1">khai</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">truong</Text>
      <Text> / Grand opening ribbons hang around.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="edcb5aa8-87f6-4a61-8ac5-97bf52ae5d99">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> sighs as anguish clouds her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54dd8fb1-7ec9-4496-873c-174b40cdf21e">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f24800ff-01e7-4531-8b29-fab421ef6d2d">
      <Text AdornmentStyle="-1" Style="Italic">Nhìn</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">gì</Text>
      <Text Style="Italic">, me?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="e71c91cd-5669-41f8-a295-1a2f83ef3b91">
      <Text>(What are you looking at, mom?)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="26076d8c-9b26-4c3b-a45f-7de9d43746ba">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf08693f-b1bb-404e-8bf6-bb4a01578835">
      <Text>Nothing. You still got so much in your bowl.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f2022aaf-7225-4124-8c4f-0221e5ecd467">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9bfe8dbc-130c-427d-ace1-0f8953cd2c90">
      <Text>I’m not hungry.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60b6875c-5dbd-48f6-9f15-6aaab125e7db">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d32618d2-e037-4c1a-90ac-abe6bdde0978">
      <Text>Empty stomach, empty head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dab6ee83-73a9-4f38-8877-c2d232fdb5e5">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb6647ea-d407-45c0-8b8e-c51c408f0bb4">
      <Text>And you have a big belly.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6ea92daf-9aec-4bdd-a784-15ff40b7b49c">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> looks insulted.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9756f168-fd9e-4f99-8d54-586c54aada6b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3ebc19f-b4fa-4f28-9dc6-f52c15e8f6ca">
      <Text>So </Text>
      <Text Style="Italic">big brained</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bfe8c122-e4d5-4dda-b8cb-b24552e4af28">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> points her chopsticks at the contents of the pho bowl: slices of beef, rice noodles, and herbs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a0d7f79-438b-40c7-a7c1-f171b421f4f9">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec1aed68-8704-4daa-bd73-f57e3b354c58">
      <Text>Fine. If it gets you to eat, I’ll show you what’s been on my mind.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7cacf3f4-ff4c-40d4-a6fd-43096b63cbc3">
      <Text>She points at a slice of beef.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8abbfc67-a9e3-4d47-b068-9128acb58541">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7fc2498d-fbfa-40ad-92c4-ded7517c0e7c">
      <Text>There are 367 islands...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d4dc0c0e-14c2-4558-8f18-f0221c0161b3">
      <Text>She points to one large piece.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84ad5cdd-d6cf-4333-a0bc-8439628aadf7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c60e962b-1d8e-4849-bd0c-2b98e2d75311">
      <Text>...off the coast of Vietnam...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fbdb011a-2d57-4bad-ab1a-1ae76329d809">
      <Text>She dramatically twirls noodles between the beefy “islands.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9bf87cd-94d6-4bff-88e9-997ae2a554be">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c60e962b-1d8e-4849-bd0c-2b98e2d75311">
      <Text>...and a whirlpool that hides...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f15907d-267a-4a7c-b1d5-9f43265e3511">
      <Text>She uses a spoon to raise a bone fragment and tries to shove it into Acadia’s mouth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1841232-55cb-4668-a378-3739ee2fb5e6">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e88a89d-1895-4667-b3ab-214e8f1cd678">
      <Text>...our ancestral island.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4bd7a46-173f-4f84-8af1-3bbb388a1eb4">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f8ecff4e-cb07-4979-9a5d-6d71e7b9a239">
      <Text>Ew! Mom! That’s a bone—</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1ede5bec-3eaa-4784-bd2f-8e51a202bd30">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> holds the bone up to the light. On the scrim, a horseshoe crab-shaped island appears.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d07bb78d-7a0c-4c2a-a9a6-ba1d28bf0598">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06fb10c8-8690-4a2f-afcd-32861420bf1d">
      <Text>Exactly. The bone is Fossil Island. A spiritual place where we can reconnect with those who’ve </Text>
      <Text Style="Italic">molted</Text>
      <Text> away. They live among horseshoe spirits.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a64a23e9-dd09-42df-bbe1-bd7763acc79a">
      <Text>Shadow puppets of glowing horseshoe crabs appear, their tails flicking in a dance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="962bf018-317d-4e48-a231-231ef1178612">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f6146ddd-bc89-4153-8cb3-ef587377e78e">
      <Text>Horseshoe crabs are invertebrates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac0508c6-afe1-4194-95b9-17bf60f498e8">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="034ef879-764f-4001-a8d8-bc1e7bf44ce8">
      <Text>I never said they had bones. Their life force is actually in their blue blood. It remembers anything the sea washes away. It heals wounds.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2386ff1e-182d-48a5-a7e7-b2988f238c4d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f6146ddd-bc89-4153-8cb3-ef587377e78e">
      <Text>What if you lose an arm? Does it grow back?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0d985cc9-c97f-418d-b47e-782e6ffdd88e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="113e8556-1929-4974-9746-680cae66eb01">
      <Text>Wow. Sick sense of humor. But such power makes them a target. We keep our island secret from outsiders who want to exploit the blood. This island goes deeper than bones. It’s our souls. Me, my mom, her mom... we were all born there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20428827-b91b-43ea-b8ac-78976f66df34">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="99ab5021-8daa-45c1-b308-cf8306e1f766">
      <Text>And I was born on mainland...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="47316f4f-602f-49b2-8200-acb519c6689b">
      <Text>The puppetry shows a woman and man in a naval uniform holding a baby.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="950da145-7acf-4fbb-af36-d2a64cc2f609">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="07d21f29-69a6-4605-af6f-09e11be09a64">
      <Text Style="Italic">Maine</Text>
      <Text>, where I met your father. We were opposites. Science and spirit, east and west, the law said we couldn’t be together, but there was Relic Island... it didn't care about laws. It only cared about the source of water.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fbb84b41-b551-442f-b0fe-f6174745100b">
      <Text>
But back in Maine-land... We thought having you could keep us together. Birthright didn't work.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1635e23e-3d08-4738-a6df-89470b31ce38">
      <Text Style="AllCaps">Militant puppets</Text>
      <Text> push puppet </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>, her baby, and other puppets onto a boat to Vietnam. They are the inverse Vietnamese boat people.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1250fdb-7caf-414b-9c11-e9fdade9dd30">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="14cfb729-9a32-470c-a58a-78bf18180e2c">
      <Text>I became the only option for you. And now you’re here.

I’ll bring you the whole world. I’ll bring you algae. I’ll bring you mollusk shells. I’ll bring you clams. I’ll bring you fishes-CRABS! I’ll bring you everything but...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b1e14d7b-7c7d-4313-8d65-7fb19ba32017">
      <Text>ACADIA &amp; </Text>
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="07aa618e-f6ff-487c-80d7-21588922a14f">
      <Text>...peace...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b33b017-50de-4403-8beb-c3bc61a5791a">
      <Text>They giggle together.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b0021cf-7716-47b4-84cc-7337d355664f">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="538f4c3e-7a12-4a0b-bc03-8e45f0e0bff8">
      <Text>You’re why I’m no horse girl like other kids.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b16aa8d6-6dc9-4c83-92bb-c0a63f2f1201">
      <Text>Acadia sees a tank of seahorses in the scrim. She’s </Text>
      <Text AdornmentStyle="-1">mesmerised</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="743d627d-b73b-486a-bddc-07ec56550ddb">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bca72768-b8fc-41ad-82e3-be4bb817ad44">
      <Text>You’re more of a seahorse girl.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="95813543-7a5f-49e4-a4ed-490fa0bff28a">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3191df9e-cd4a-4deb-a7ca-72715ed4067d">
      <Text>They’re cooler in water than land. They live for up to five years.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eea007c0-3ea2-4d3a-9235-953005f729ad">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ebc7b2e0-d9cc-49ba-8e2f-34ffff91b572">
      <Text>And like you, you’re ahead in schooling by five years. Well, the tide is turning. We have to go now if we want to reach Fossil Island.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="545ddbd3-8b09-487b-90e3-fb34c8fd9b16">
      <Text>They look towards the harbor. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> puts Acadia’s pho in a container.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3340f1ce-7053-403a-92fb-23af126aaf54">
      <Text>Lights fade as the table and chairs pull away, and the hull of the VAST sailboat is pushed in.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="6542c21c-098e-4696-9ccc-1f91a4773577">
      <Text>Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="2 3/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PHONE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Haiphong Port - </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Bà</Text>
      <Text> Archipelago</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b49dc470-e7d2-4034-8b7f-f50b086e597a">
      <Text>Waves crash as boat engines rev.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8130214f-3921-404e-a295-8a93bc8d80d2">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and Acadia make their way to a port. They enter the VAST sailboat and set off to the archipelago.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1b6e9e17-1a70-45b4-8cfd-eca16d689ced">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="649783a6-b659-431d-9833-6c3e9cd4b9b4">
      <Text>Today is the gift of a lifetime! You’re going to reconnect with your ancestors!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="182023c6-e9b1-4566-943e-616874348c59">
      <Text>Acadia points at a projected lush green cliff on the scrim.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea1630c3-2a3d-477f-ba3f-135bef4ea153">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d85ae0e-eb45-470c-9b7e-f3e5b3f57444">
      <Text>On that island?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe105cf0-3951-4168-abd2-8f06decd3b0e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="630531a5-72da-4530-a9b6-394a7eb0d28b">
      <Text>No, dear... Not Monkey Island...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a24b9bf-f3fe-4759-9d82-c3cb2d9f01a0">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4af3ac97-98e1-43f2-8c6b-c76c290c1688">
      <Text AdornmentStyle="-1">Oo</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">oo</Text>
      <Text> ah </Text>
      <Text AdornmentStyle="-1">ah</Text>
      <Text>! My classmates go to Monkey Island for their birthdays! They get to feed the monkeys and eat ice cream.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="158894a5-a618-4a1a-88b5-0f323eb5fc9b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f388eff8-0806-498a-82ab-789d9e7ab5a5">
      <Text>Cause they’re a bunch of monkeys.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e4dfae30-45c4-421b-b148-f010541261de">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="adbd4d27-31d7-4a27-8730-3ff31be8f42c">
      <Text>And you’re a fossil.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20068055-1824-452c-9558-130a57eeddef">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="48d9540e-687f-43a5-a1fe-a017e3bcb445">
      <Text>Don’t make me turn this boat around!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0628ca56-4438-4844-be52-e0a5cb6deb31">
      <Text>A white fog rolls over the water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e740c451-481b-43d5-b213-8620099083a7">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b926f214-9df8-4bf7-9474-7b29c92c5839">
      <Text>You know where we’re going? Every island looks the same. Just rocks and trees, more rocks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b2e117d-cfe3-4fea-afed-5127c4cbfd2d">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="228a0c1a-c2f0-4cab-a617-5a5fd7402cce">
      <Text>My parents named me after the archipelago. The first thing I ever felt was its sand. I know this area more than myself. Remember this route as one day, you’ll have to find it without me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aa6ae9eb-76be-459f-9802-b7ade3a231fe">
      <Text>Acadia pulls out the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fcf26188-b105-4bb7-b7c7-a3b3c33b623d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0472c92d-ce42-44a7-a6c2-baa8e399ece6">
      <Text>Phone, tell me where Fossil Island is!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b432843b-9f44-4c51-be7c-6d6ef147f096">
      <Text>PHONE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="017e42b2-307c-41b0-bff1-44e8bb30639f">
      <Text>No signal here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="35c62733-ac37-4964-9ebf-18c55d08295a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fa4c05b0-9dfa-4417-b99c-9dae2ca21b4b">
      <Text>You kids cannot survive without technology. You want the world in your pocket, but you won't look at it when it's right in front of you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51e0d4ca-e850-4a09-a16e-c0491e8f026e">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="77a7830b-8ec9-461d-9ab5-ebb4da4a97ba">
      <Text>Beats being a hermit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c63cf4c9-f835-4c9a-a892-42fd2d5bcd06">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="10a51827-9c2b-44ab-b3be-3d0d79f6f69d">
      <Text>I never quite understood that metaphor. Hermit crabs are the most open to change.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b49928f9-611e-4a7d-965a-d45fbee3056a">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1ed53bd4-9758-4e7f-8f04-08ba8423e1e6">
      <Text>No way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b2d10095-d156-4fa6-bffa-64c5bea404cf">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9cbd27d9-cde3-4297-a93c-0ccc070b6a0a">
      <Text>Hermit crabs are like us. They move to new homes, they immigrate, they’re never satisfied.

If you won’t remember the way, at least, don’t downplay my story.
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e98cfa7d-2f9e-4541-b39b-2d962d3a05bf">
      <Text>In a tide pool, where the sea and shore whisper secrets to each other, lived a shy hermit crab named </Text>
      <Text AdornmentStyle="-1" Style="Italic">Paguroidea</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e048067-cbc2-42f3-99ae-442d97cee735">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="79aa94b3-8a36-49df-9b28-ef6ac4832cfb">
      <Text>Mom, can you stop being so nerdy?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7d021a61-b98d-4675-b41f-f1cb42a9972e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="852be827-f8cd-488d-a755-70104b7e8d9c">
      <Text>What’s your favorite </Text>
      <Text Style="Italic">Animal Crossing</Text>
      <Text> character?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="277f6e80-9e5b-4eb7-8357-69e4b27e3bca">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c59e6b0-08f9-4121-8ea5-d0a15fd29b35">
      <Text>Blathers! He’s the best!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2aef09e1-fe3a-4d65-8293-7b1389ba1787">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93386c61-5f72-4319-948b-94fc5104c2c3">
      <Text>Not Tom Nook? Whatever.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f179cdb7-22f5-47ed-bd38-cafd2efe6418">
      <Text>
Their name’s </Text>
      <Text Style="Italic">Blathers</Text>
      <Text> who grew too big for their shell. It was like a hoodie that became too small! They needed a new home, one that may let them stretch out and grow bigger.
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="82788564-be1d-4ceb-b781-a14210eddedb">
      <Text>At the same time, a human named Nook felt the same way about their house. It was a nice house, but it felt old and didn't fit who Nook was anymore. The house felt like a big boat stuck on the land.
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71de067b-045a-422d-92c5-8144e8a3d9d4">
      <Text>Encouraged by the high tide, Nook and Blathers started looking for new homes. It was scary!
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33cdf4e7-9338-41e8-94b4-c67447f0d4af">
      <Text>Blathers searched ‘til they found a shiny, smooth shell. They left a tight shell behind and slipped into the new one. It wasn't perfect yet, but they knew they could make it home.
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9aaa05fc-c98b-4ca9-9041-58cfcd313bf0">
      <Text>Nook also moved their boxes into a new house. They felt happy and a little sad to leave the old one. As they drove away, they looked back at the empty house, then focused on the new adventure ahead.
</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f81da098-dbc9-46b8-8e29-c6511dece506">
      <Text>They learned a home isn't just wood or a shell but a place where you can become who you’re meant to be!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="101c86ac-7358-40f1-b11e-e2b66717b26d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f24e074c-275d-4180-aaa5-320ae77241ba">
      <Text>And all these other islands are like shells nobody wanted.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8192deb6-3d25-42bf-b7ca-85d36c0bd9f5">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> shifts the sail.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="6542c21c-098e-4696-9ccc-1f91a4773577">
      <Text>Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="a6bf2c76-48ba-41e3-bdda-f0da84550f02">
      <SceneProperties Length="3 4/8" Page="10" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="YOUNG ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Fossil Island</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8a5e6a81-aa09-4ec9-b5ca-127496662aeb">
      <Text>The mist parts. Horseshoe-shaped cliffs appear. It’s ominous and ancient.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1fefa14-e231-42e2-b2dc-094f1efa3b57">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4819941f-df9a-4f84-b86a-79930f0722a5">
      <Text>But not ours... We have arrived at Fossil Island! Happy birthday, Cadi Noble...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b24aa09c-a4bc-4a70-a9df-da9673927d84">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> drops the </Text>
      <Text Style="AllCaps">anchor</Text>
      <Text> over the side. A sickening </Text>
      <Text Style="AllCaps">crunch</Text>
      <Text> echoes. Blue light swirls around the boat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96ff15b3-35bf-4461-8c0e-5636f1e6dfab">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4716c56d-4a81-48a6-8a64-737cdda388f1">
      <Text Style="Italic">Me (”Mom”)</Text>
      <Text>! That water is super duper blue. More pretty than the ocean.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4351adc5-fa0d-4eff-be65-a858fbf200ee">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8d09b5c1-453e-4f96-a92b-0ffc33f14438">
      <Text>(Staring at the blue blood in shame)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d187d36-baf7-44ec-9981-060893fff508">
      <Text>To set eyes on our sacred island is a great honor. To set foot on its shores needs a special blessing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f6b1401-6bb8-4e3d-ae20-f541b44435f6">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d0b31fd-6aa1-4eb4-b49d-136274cf42f6">
      <Text>I wanna play on the beach! It's my birthday!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="763d8efe-1695-4f32-bee2-e3fdd2d77c1c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="106b48ec-7ba2-4d6f-a6a0-3465bb033f1a">
      <Text>Not for me to decide. That’s your ancestors’.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84cbdb8a-25cf-428e-93f2-1cb6d4f8a721">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="60066340-f6ec-40da-bdac-35e8af13c752">
      <Text>Hey ancestors! Can I play on your beach?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="125b9ed3-ace8-4ff8-9bbe-0eefa4a39d30">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62ea87aa-4f8b-4fc7-b554-d6c3f1022892">
      <Text>The spirits are upset, Cadi. Look at the water. They don’t want us here. Not yet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00c8a7d8-af2c-4e42-a417-052be9daf31d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83678718-c43d-4abe-af2c-7ab59d84b658">
      <Text>I don’t care what dead people think!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="41f6eadd-acb7-4c95-87f2-7ee6c20f6599">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cb8a6b34-745d-456b-a98d-5337aa4b85e5">
      <Text>No one truly dies if we continue to care!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="0034b54e-acbf-42ec-9726-f7e0b4ec3304">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="6763a6a2-d542-4d84-8dbe-cc6c51c0e3e4">
          <Text>ACADIA</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="78e3b5b7-be32-4138-89f5-7b28bb883215">
          <Text>Still don’t care!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="8117668a-38ef-4cc4-a32f-115029b5e788">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="75fbfe36-3af8-47b8-8ad5-ba1c66b34cc7">
          <Text>Don’t speak about them in that way.</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="d7c502bb-9c58-4321-b656-5e74b5e011f8">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e62b283-4a85-45f5-bc2a-b09322575795">
      <Text>Fine! I’ll play nice if I see them!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78ca6e3a-d2ac-464f-94d5-2c89f70010a0">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="09734a28-9ce3-43a3-8c6f-15ae375c723f">
      <Text>You’re not ready. It was a mistake / bringing</Text>
    </Paragraph>
    <Paragraph Type="Action" id="71b98c35-9280-4511-b461-9cb5a7825feb">
      <Text>Acadia ejects the ring of keys in the cabin, turning the motor off.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6b7d477-cea3-4213-97d8-aa0d7e66b176">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a41ab4ea-ae02-4615-9c1c-14a31f42dc49">
      <Text Size="10" Style="Italic">/ </Text>
      <Text>Leaving is the mistake! You can't make me go! I have the keys!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5068f4b3-ed5c-4be2-8b79-1c00d6cb3994">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed710c45-b8b7-4de6-bf54-a73999c5b3cf">
      <Text Style="AllCaps">Acadia Noble Tran. Hand me the keys!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73c6b3a6-9756-4da4-a853-a5cca2066ab3">
      <Text>AcaDIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6053be08-0860-45cf-b08a-1f61a5a023f8">
      <Text>Can we grab coconuts first?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e03f5cc-77dd-458a-8086-894645493546">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c189b0f4-bc34-4609-af75-fe04e81917cf">
      <Text>You still need to finish the pho and cake.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e5911622-8fe2-4cdc-8e84-920bdf744d7e">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> holds up the pho container. She also gets a box with Acadia’s birthday cake. She opens it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a60bb5b0-d2c0-496d-82de-1a7f4fc01e01">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf4477d1-da0d-4730-a97c-c12a8ea3cb2e">
      <Text>Trust me, eight cakes goes by real quick. The spirits will welcome you as the woman you’re meant to be once you listen. Now, make a wish.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d89d4c94-9ff6-4f6d-ba10-961143909c83">
      <Text>Acadia blows out an imaginary candle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e6af809-9f08-4c38-8f34-66a52b199089">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6c6d32d-475d-42c0-b76b-f1d586300867">
      <Text>I wish to meet my ancestors. NOW.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1486a4f3-9bdd-476f-8283-7f21f949d7f2">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cfda862a-2422-48ab-9d21-19cd78ce3b3e">
      <Text>That’s sweet of you to say.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c6a8a13-7c73-4692-9521-1ea8c228bc35">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e88eb0e-95a0-4302-98c1-5433d3796a2b">
      <Text>Not too sweet!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0aaa4fa9-8010-4468-9380-51d74f54af28">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42aca9c1-b952-4cc1-89ee-e663146293ed">
      <Text>You’re speaking Viet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7fe16403-aea8-4629-aeae-5bdb159ec4a2">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c58b6a1c-5ff2-44df-b9cc-1bad19e0e8f1">
      <Text>Promise me you’ll be here with me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e93ccaad-0352-43cb-a43d-6faa52202c57">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e56b2ce8-fea0-48cc-a988-609fa3402635">
      <Text>When the time comes. Promise.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d89d4c94-9ff6-4f6d-ba10-961143909c83">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> reaches over the side to pull the anchor rope. A sharp wet SNAP.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="3.50" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Character" id="d0460faf-b38c-46c8-b023-00e3ba231ed0">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42da4320-4602-454f-b71f-c3e7fe02857d">
      <Text Style="AllCaps">OW</Text>
      <Text>! </Text>
      <Text AdornmentStyle="-1" Style="Italic">Nuóc</Text>
      <Text Style="Italic"> can </Text>
      <Text AdornmentStyle="-1" Style="Italic">tay</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="33d08843-7133-421b-85ff-e9c2fe85c15b">
      <Text> (The water bit me!)</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="3.50" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="Character" id="2dde4176-e8e2-4557-94b1-130a5afc1683">
      <Text>Young Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3fbfb3bf-7ba9-4831-90bb-97fe319e8747">
      <Text Style="Italic+AllCaps">Me</Text>
      <Text Style="AllCaps"> </Text>
      <Text Style="Italic">(Viet: “Mom”)</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b2d779aa-2e45-4093-94b0-23fdfccfa75a">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> pulls up her bleeding wrist. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="f483e60d-6583-4260-aec9-ed1a23fc5109">
      <Text>Acadia screams and dives towards the floor, grabbing the juvenile horseshoe crab in the water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e54af31c-6cff-4154-96f6-a5e24c8e21c7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ec70d43-d86e-42b4-ac68-df8daa1c0a58">
      <Text>Let her go!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cebc2911-d760-4d66-ba75-e3ae358b72ce">
      <Text>On the scrim, the ancestral memories project: ancient warriors clashing, French soldiers marching, rice farmers weeping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c5df66e3-4d48-437a-aee0-d0bf144cd26c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62458691-922e-4a30-9a0f-3d2578bde535">
      <Text>We don’t need the powers that be to reincarnate you into a plankton!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c38e2a9-a496-46e6-9dbc-2b2914754563">
      <Text>Acadia, shocked by the fury in her mother’s tone, reluctantly lets the horseshoe crab go. She gets back on the boat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3cb73c45-2658-406d-8366-0f427e15c2ad">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ccab5e04-fce3-42c1-bf14-ab71c68dd869">
      <Text>Where’s first aid?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1fbabbf7-01f8-4e4e-abba-40097ceaee46">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0b64e942-7b25-4b4a-8aa0-3b481f1340d2">
      <Text>In the compartment, dear.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="045418e4-e2d8-42e0-9e47-a356f8f94b06">
      <Text>Acadia goes to the locked compartment and feels her pockets. </Text>
      <Text Style="AllCaps">The keys are missing</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="194a7ede-c595-48c5-97ec-a42ecb7b0666">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a432192-2f2c-4a33-a892-93dcf6d16f51">
      <Text>The keys are gone!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90f42890-2821-4f23-bb9e-f830a5a36a57">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="80e19d4a-6ca6-4d8e-b4db-2c5691a99480">
      <Text>Those who steal can never keep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="067b47f9-e33c-4dfd-833b-f58259a4a6c0">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="00cd56db-fe5d-40d7-9f32-797999e7f47c">
      <Text>Mom?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34c38c28-09cb-4743-9cd7-004220abcc30">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f0d656b4-cacf-4351-a4d8-b5cca7d171f9">
      <Text>(Clutching her bleeding hand)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9666295-591d-47d9-9b6b-5f6bbf885d8e">
      <Text>It must have fallen in the bay...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5662c87d-bd2b-4518-8442-931f7cf86bce">
      <Text>Acadia dips her face into the water to look. She hears an </Text>
      <Text Style="AllCaps">ancestral cacophony</Text>
      <Text>. She freaks out and almost drowns.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c8c6bfb-ea7c-4781-8bc2-a36283079cb7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5bcc6089-b31d-42a3-8190-f994835337fa">
      <Text>Breathe, Acadia. I can’t lose you, too.

Forget the keys. We don’t need the motor. We must go manual. We’ve got two hands to sail. I got my second best hand to point. </Text>
      <Text AdornmentStyle="-1" Style="Italic">Nho</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nguon</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="64af7700-a5ca-4f1d-8d33-186be914d73f">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> takes Acadia’s red neckerchief and wraps it on her bloody wrist.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0732fbc6-8762-406e-9c53-c6a767b5d2c3">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8340ad7a-0c71-4825-ade2-6fda945778fc">
      <Text>Let’s go home.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93393711-ecb3-440b-8bce-1ce1ad505aa8">
      <Text>As the boat sails away slower than ever, the crab resurfaces with a ring of </Text>
      <Text Style="AllCaps">keys on her raised tail</Text>
      <Text>. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="93393711-ecb3-440b-8bce-1ce1ad505aa8">
      <Text>Acadia stares on in shock as the creature swims away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93393711-ecb3-440b-8bce-1ce1ad505aa8">
      <Text>The red sail rips. The mast tilts. The deafening blow of the typhoon.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="126f4fa6-df8a-4a8f-a462-5c464274496f">
      <Text>Black out.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="6542c21c-098e-4696-9ccc-1f91a4773577">
      <Text>Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f40b5a74-9f8e-4b67-aca5-37c5a5978176">
      <SceneProperties Length="2 7/8" Page="14" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ACADIA &amp; CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Sailboat in the Sea</Text>
    </Paragraph>
    <Paragraph Type="Action" id="486ac51f-4c96-4bb2-a855-74fcc4949cae">
      <Text>Total darkness, save for the glow of lightning. The sea is a chaotic void, the mast now lying broken on the floor. Rain endlessly falls.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="60e0d8d1-85f7-44b1-8632-94c1ecb93b80">
      <Text>Acadia crawls through the wreck, soaking wet. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> slumps against a mast, her leaf hat covering her face. Her breathing is shallow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90b9c3a9-5b5b-4120-a5ca-fb96d2d26472">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8250ad90-2c98-4cb1-89da-a47ff4670664">
      <Text>It’s way past my bedtime. Where to, Mom?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bec1ac81-c44c-4b57-9b21-d600dc4766c9">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> raises her </Text>
      <Text AdornmentStyle="-1">rashy</Text>
      <Text> arm with tremors. Drool escapes her mouth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0d23d6a2-36e0-4021-9644-72712e5592fd">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9692146f-cacf-46da-9a0d-566457f748da">
      <Text>Mom! Like you always said, drink enough water!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1000ab0d-0563-40ad-a109-87dcd6f79f00">
      <Text>Acadia scrabbles towards the water jugs, then sees they are empty. She finds the plastic container of pho and brings it to </Text>
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> lips.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="e35e10ef-962e-447b-8825-d2f56344d11e">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="d1e5fbe3-6ccf-4180-ab3e-26c72139ffe1">
          <Text>ACADIA</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="13046df7-1ccb-4c4b-983c-61c1a253981e">
          <Text>Pho juice will do!</Text>
        </Paragraph>
        <Paragraph Type="Character" id="a55c1a0f-baa2-4e86-a1cd-23d8d55f750e">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4df909e9-8367-45d4-9c60-40926f9cda33">
          <Text>Broth...?</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Character" id="571fdbd3-d325-4390-ba14-2d8dc69dc172">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32393517-9298-427c-87bc-acbb83a03aba">
      <Text>It’s been forever. You sure we’re going the right way? I can’t see the stars.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5606ad0-6ad2-4b2b-bf68-ab6001b3973c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a131803b-7302-4756-9a74-8b53a2204eb1">
      <Text>Use your ears, child.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7b8921eb-2c5f-4775-a719-33b91616daae">
      <Text>THUNDER shakes everything.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c00a02d-42e9-4543-a59b-a34f40bb6a86">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> pukes. Acadia notices the rashes blooming on </Text>
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> arm.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2866b831-1d48-44c9-9214-8c45c6968c69">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="916f109d-56df-449a-ace3-d8f24e5ace14">
      <Text>Please don’t get scurvy, mom.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bcc20c29-cc72-4942-a1ab-c05eb23b0233">
      <Text>Acadia gets pho for </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> and twirls its noodles with chopsticks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="07078510-696d-44a4-b7b6-099ea28ec2e9">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f731aea2-ccaa-4368-8474-c1a5aaba4a89">
      <Text>Eat. Please. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="13d78e59-0a0b-4ed6-95b6-b5774e967c44">
      <Text>Acadia looks out to see a ship-eating whirlpool.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eca01bbf-1426-45a6-9fa8-45c4acc3b438">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7683e722-c336-4941-89a6-57b5053d5460">
      <Text>Who are you asking?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="25f40f30-d256-4e52-9f8c-f7ace3949fa3">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> nabs Acadia’s chopstick with noodles then drops it. The noodles form a twirl design on the floor.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c0fca401-e870-493b-9105-b76ce172d46a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c23a712f-afac-4227-baad-d9cd2ab54ee2">
      <Text>Told you to remember the whirlpool, silly </Text>
      <Text AdornmentStyle="-1">noodl</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="13589d48-3f32-4994-aca1-798320293d04">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="45a10b39-efb6-44f0-b08c-141f72b8f63d">
      <Text>You didn’t tell me it was </Text>
      <Text Style="AllCaps">that</Text>
      <Text> big!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf690d6f-25af-4e52-a54b-6f6e427a253c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="693449e2-b9de-425f-8552-a45a18e3426f">
      <Text>The big things never get me. So it’ll be the small things that’ll do.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb175dc2-4c6f-458b-b999-9aaff6ad6c6c">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8dd323f0-c4b7-4c47-ba36-0c795bd81f54">
      <Text>That doesn’t make sense!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9db5d3c5-df41-4fb7-baa7-dbac7efceaf3">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="40f5bf7b-9517-497a-8348-9bcd2d5c0791">
      <Text>Whirlpool’s nothing. I’ve sailed mere meters by it. But I can’t walk, swim, sail one more meter-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d6542791-02e9-49f5-8da4-d9af0b3e5775">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="acd59f74-9dcd-4d77-b731-4d3a7dd15599">
      <Text>You’ll feel better. We need to return to shore.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="65820b11-fc68-4b3e-9d02-f7bf9ed00b4d">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5c2b904b-06bb-48fa-9320-55e02cba44aa">
      <Text>It’s unlike the cold. Absolute zero, love.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="87e25267-82f9-43fc-ad0d-e8dff8acd397">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c38a3068-03b7-4435-ba55-62e61fbd1241">
      <Text>But you’re no zero. You have friends. You’re a hospital doctor!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3961df65-629f-4c7d-b8f7-cdb0281f3e9b">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf66412f-2060-4ef4-a3b7-2a28482bb9e5">
      <Text>I don’t think my hospital have much to work with even if we get there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="427f03c4-fc28-4c85-a334-7089bc4a3d3c">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="434ff9c7-9fdc-43d0-8a7a-9928b481e0a6">
      <Text>They need you! I need you!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c7f867f2-7f64-4430-97fb-9ff6028b4a9e">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> unwraps the cloth from her wrist and wraps it around Acadia’s collar. Her blood is now bluish.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d5bc42ec-c415-4bcf-9e1e-589de6b8c07e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3999b977-2281-403c-8eae-790f59148677">
      <Text>Cadi needs an armor more than mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e15b1e48-1b13-46d2-ac7c-5265e6aa5126">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f726ceba-1f90-439e-9645-72f8a4ced84c">
      <Text Style="Italic">Me (Viet: Mom)</Text>
      <Text>, no!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="edd6757e-d53b-4a7d-8abb-2f3c9db4137c">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e966b3e-0412-4b04-9a27-e6d8a9fd7f2b">
      <Text>Wherever you go, I’ll bring you the whole world. I’ll bring you algae. I’ll bring you mollusk shells. I’ll bring you clams. I’ll bring you fishes, CRABS! I’ll bring you everything but...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c3b9d1ff-d4e5-4916-84f9-8f769245f733">
      <Text>Acadia &amp; </Text>
      <Text AdornmentStyle="-1">Cát</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3999b977-2281-403c-8eae-790f59148677">
      <Text>...peace...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="656c93cd-08c0-4340-8002-a6daf7233296">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> rests. Acadia goes to the helm and steers away</Text>
      <Text Size="10"> </Text>
      <Text>from</Text>
      <Text Size="10"> </Text>
      <Text>the</Text>
      <Text Size="10"> </Text>
      <Text>whirlpool.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="264bbb80-7098-4759-8720-0de3030a3d13">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9d33fecc-0573-460d-9caa-9c9536211148">
      <Text>No souls lost on my watch!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a9e34489-9faf-40a9-95dd-f586ca076637">
      <Text>Another mast gives way. Acadia dodges it and dives into the sea. The lights cut to a deep blue.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aa336e4c-99d0-4677-ad24-48e4e13d6823">
      <Text>Silence. Then the deep-sea sound of Coelacanths replaces the storm.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eeda5a0a-c008-4f42-a922-c6b0cf163e1e">
      <Text>Acadia bursts out the water, gasping for air and clinging to debris. She watches the boat be pulled towards a whirlpool.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="99ecd8a8-032a-4be8-9517-88cec18889bc">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="44837805-2a63-4415-adca-816a12ba4ad7">
      <Text Style="Italic">Me (Viet: “Mom”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a260125a-4fd1-4155-97d2-749d52b52936">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> calmly looks up. She raises her injured arm. The blue glow from the seafloor swallows her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30dd625f-dc09-44fe-a857-33c4f2d1b8e7">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="125c6a0e-1606-4dbb-afee-c71f9b7c0ab6">
      <Text AdornmentStyle="-1" Style="Italic">Uong</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nuóc</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nho</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nguon</Text>
      <Text Style="Italic">.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="865f23d8-6d0e-453d-9fd7-710fbd88114e">
      <Text>Before vanishing in the whirlpool, the sailboat illuminates the shape of a horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="865f23d8-6d0e-453d-9fd7-710fbd88114e">
      <Text>Acadia watches in horror.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="543631d0-b197-4cec-b6e8-3f8a6e57d28c">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1c1377d6-ca00-43b6-9171-2357e550fbe8">
      <Text>It's all your fault! I hate you, horseshoe! I will end you! Every single one of you!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="923139d5-2969-4954-b997-25f678940904">
      <Text>The thunder fades into gulls.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5611d118-4697-445f-89ec-2386e897b350">
      <Text>Lights rise onto a calm beach.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="6542c21c-098e-4696-9ccc-1f91a4773577">
      <Text>Scene 6</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="6/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PHONE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Monkey Island</Text>
    </Paragraph>
    <Paragraph Type="Action" id="865f23d8-6d0e-453d-9fd7-710fbd88114e">
      <Text>Acadia lies on the beach.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0d5312ce-b1a7-4959-90db-7993dae754e7">
      <Text>Through puppetry, golden-headed langur monkeys enter and curiously loom over Acadia. They coo.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="474cecbe-7e61-4b56-974a-2b1b053f8e8c">
      <Text>The waterlogged phone miraculously flickers to life nearby.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d9c12700-8a2e-4bb1-9323-1ac699962986">
      <Text>Phone</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="bd91c5ac-9b8e-4f2b-8972-f4325f995f77">
      <Text>(in Vietnamese; subtitled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3df4c812-4ba4-465b-9f1d-46c7b519aa69">
      <Text Style="Italic">That’s the call of a </Text>
      <Text AdornmentStyle="-1" Style="Italic">Trachypithecus</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">poliocephalus</Text>
      <Text Style="Italic">, or </Text>
      <Text AdornmentStyle="-1" Style="Italic">Cát</Text>
      <Text Style="Italic">...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3e19c8d4-0159-45e8-aae4-d8543cc00f2c">
      <Text>Acadia sobs hearing</Text>
      <Text Size="10"> </Text>
      <Text>her</Text>
      <Text Size="10"> </Text>
      <Text>mom’s</Text>
      <Text Size="10"> </Text>
      <Text>name.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4edf982-eda0-4ba2-b998-3b1b3d409593">
      <Text>PhonE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf69835a-d44d-4015-892e-4c50d6cc589d">
      <Text Style="Italic">...</Text>
      <Text AdornmentStyle="-1" Style="Italic">Bà</Text>
      <Text Style="Italic"> langur, the rarest primates in the world with a population of less than 100 individuals.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="57f773d5-2cd5-43c8-b766-4021a6267680">
      <Text>Acadia sits up to meet the langurs at their level.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9f14bdf7-f40a-4c14-b5f7-e6a30224f3bd">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7891b179-4619-4d32-a428-c3a1e4df262d">
      <Text>Your family is gone, too?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d5d4956b-91fb-4a48-9432-5843ac720640">
      <Text>The langurs coo, happy the crying stopped. They hand her the phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3728376-d7e2-4938-a9bd-495e9a81e1b7">
      <Text>AcaDIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eef3133e-c524-40b8-a8db-ab6e7142f7bb">
      <Text>Now you have signal... Maybe not of all my family is gone...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="61f8893f-8579-4a59-ad24-99a22b9b8531">
      <Text>The </Text>
      <Text Style="AllCaps">phone</Text>
      <Text> beeps, then a muffled voice of a man is heard as Acadia holds the phone to her ear. Acadia plays with her red neckerchief.</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="5ddd80a9-4d7f-4fac-a4d9-a1042968c52a">
      <Text Style="Underline+AllCaps">End of </Text>
      <Text AdornmentStyle="-1" Style="Underline+AllCaps">Uong</Text>
      <Text Style="Underline+AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="Underline+AllCaps">Nuóc</Text>
    </Paragraph>
    <Paragraph Type="New Act" id="fbcd9358-7059-48fe-b185-1836045c8801">
      <Text AdornmentStyle="-1" Style="Underline+AllCaps">Nho</Text>
      <Text Style="Underline+AllCaps"> Nguon</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c4aede42-94cc-4e93-a294-b7a60e82fbd7">
      <SceneProperties Length="1 1/8" Page="18" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>OCean Floor by Vietnam</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7ec7d420-048c-403d-83d8-e4bf1f83af4e">
      <Text>Waves crash, gulls scream off the coast of Vietnam. A scrim hangs.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d68ee765-9547-49fe-8ce2-8070926f00f9">
      <Text>A quote projects</Text>
      <Text Style="AllCaps">: “When drinking water, remember the source.” (“</Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Uong</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Nuóc</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Nho</Text>
      <Text Style="AllCaps"> Nguon.”)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3771dba8-4f31-482e-87ce-9deb4305baf7">
      <Text>In the water, an adult </Text>
      <Text Style="AllCaps">horseshoe crab</Text>
      <Text> swims alone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67c3d0f6-c48d-4555-9771-51a8cdcff4c1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="274e7640-26bc-4217-b7d9-e84d9e4c4e36">
      <Text Style="Italic">The shoreline feels safe, but the open sea knows truth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62d57674-0b0f-4c70-9eec-0901799a7161">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fe47a118-2151-4507-aa37-464419456b98">
      <Text Style="Italic">No souls lost on my watch. Splash!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67c3d0f6-c48d-4555-9771-51a8cdcff4c1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b581d6d-47d7-4c4e-8c1b-257bdf0de04f">
      <Text Style="Italic">Gentle currents change nothing. The powerful crashes of waves are what reshapes sand.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="02987200-7455-409c-ab26-f2959a07d584">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="73f06482-3e8a-4358-8858-9e9ea1421103">
      <Text Style="Italic">Does it make a loud noise?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63621036-2d4e-4c54-9809-565b9732c1f6">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b581d6d-47d7-4c4e-8c1b-257bdf0de04f">
      <Text Style="Italic">Very loud. A kinetic clash that shakes us creatures awake.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="630bd89c-e12e-4309-bac7-e8bc570b02a0">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c74e1e79-f486-490f-86d8-354b2108217f">
      <Text Style="Italic">We are creatures? Like monsters? With sharp claws? Hard shells?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed5da469-9aaf-4af1-8d6f-6a3e8b7b2f52">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d59d0017-4127-442c-bcf9-0e13a1f4b62e">
      <Text Style="Italic">We’re armored for a reason, little one. The world has sharp teeth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a7d9661-ac2b-4efe-ae7c-7be1212dad9f">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4628953f-133f-447b-9721-e0d4874e3a70">
      <Text Style="Italic">A calm bay must break its own shoreline to stay an open sea.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="da5a9405-21fb-48e0-bec9-a7cabf03888a">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4cfe9d6c-26e0-4d0d-8e1b-6aa3c6ddf7d1">
      <Text Style="Italic">Change won’t wait for us?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90dc5134-e68d-4802-941d-8c681d1b030a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="9daf6aba-2fb9-46fa-a4f4-9e88d49419b6">
      <Text>(in English)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21d38578-f146-452a-88ba-d2150064ab52">
      <Text>Change says... Out with the old...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="50e02081-1492-48b9-8212-db31ebb8a638">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="b04e3490-48dd-42ca-8647-c69814f10d37">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="5f1384eb-bb18-4946-80ac-b600f22857af">
          <Text>...In with the-</Text>
        </Paragraph>
        <Paragraph Type="Character" id="d4bb6f0f-408c-4f83-8993-42d68d9a438c">
          <Text>ACADIA</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="4accd4ab-df2d-4d5f-92f1-4beba835cdca">
          <Text>New!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="7f89d355-e687-4b14-867b-a2298cde50d7">
      <Text>A </Text>
      <Text Style="AllCaps">net</Text>
      <Text> catches the horseshoe crab and places them in a container.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="4 2/8" Page="19" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HORSESHOE CRABS">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>A Lab in Maine, 2042</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a75c67e3-a29f-44ff-abe7-659cacd4df09">
      <Text>Lights up on a state-of-the-art biochemical lab in 2042. The walls feature a poster about the medical characteristics of horseshoe crabs, as well as diplomas and articles. Multiple water tanks containing inactive horseshoe crabs are scattered around the room, with a specific container positioned on a lab station.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a75c67e3-a29f-44ff-abe7-659cacd4df09">
      <Text>Separately, 15-year-old Acadia is seated, neglecting her pho to grab a bone fragment from the broth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0dab394a-aed4-4ca6-9a9d-787876c86c77">
      <Text>AcadIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ab32002f-2aeb-4022-9832-58023b3f3622">
      <Text>It all happened so fast once I got to Maine. I lived with my dad, Morgan Noble, always absent on his Coast Guard missions. Time flew by as I studied hard, skipped grades, won national science awards, and got scholarships. I graduated high school as valedictorian at age 10. Then it was off to Bowdoin College for medicine, and I became a biochemist by 13.

Life’s weird. I’m the kid too short for the ride, a college student who needs parental consent, and the youngest in all friend groups.

Mom said I'd never be a horse girl like the other kids. And she’s still right. Instead, I am an Atlantic horseshoe crab’s worst nightmare. I drew their blue blood in the lab, determined to be the scientist who saved the world. I'd end every living fossil if it means saving every mom in the future.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ab32002f-2aeb-4022-9832-58023b3f3622">
      <Text>
Now, here I am, about to turn 16 in a month, finally ready for the next step. And that’s...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9150e53a-0242-42ba-b1d5-28212033678f">
      <Text>Acadia grabs the bone fragment, throws on her lab coat, moves toward the container, and starts reviewing its nearby documents.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="081ca8b1-cda6-490e-b48d-b658593b6b4c">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7ffe42b-9736-458c-91be-6bf2abb447d6">
      <Text>“Haiphong,</Text>
      <Text Size="10"> </Text>
      <Text>Vietnam.” Who else to give this cultural offering than the only Viet in a hundred square miles!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f9c1e71-370e-47d3-8b5e-04e75dbafa1a">
      <Text>She </Text>
      <Text Style="AllCaps">yanks</Text>
      <Text> the lid off the container. She looks inside with a mix of disdain and curiosity.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9acd19a4-12a5-4bf7-9dae-81b3bfd77bcb">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29045d26-7952-40fa-8e9c-af5595f052a6">
      <Text>I forgot how ugly Vietnamese horseshoe crabs are.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0393fff2-6dd7-454e-be14-33f71fd56054">
      <Text>She pokes the creature with the bone and</Text>
      <Text Size="10"> </Text>
      <Text>gets</Text>
      <Text Size="10"> </Text>
      <Text>transports</Text>
      <Text Size="10"> </Text>
      <Text>to the sailboat docked by her mom’s secret island 8 years ago.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="02095f17-e48d-40f9-8643-0231a04d85e8">
      <Text>Acadia sentimentally touches the water. Horseshoe crabs swarm her hand. She slaps them away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="265eb603-7b74-43c2-852f-64c3d874c60c">
      <Text AdornmentStyle="-1">CÁt</Text>
      <Text> (V.O.)</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="-0.10" Leading="Regular" LeftIndent="3.00" RightIndent="5.50" SpaceBefore="0" Spacing="1" StartsNewPage="No" Type="Parenthetical" id="2c52e7dd-0dbb-4b91-95df-8fcbb0a503be">
      <Text>(in Vietnamese; subtitled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d66aab23-938a-450b-8acd-cab07814d7f8">
      <Text Style="Italic">That’s no way to treat the spirits of Fossil Island.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="069ba124-9497-4405-a64d-fbbc88bc24a4">
      <Text Style="Italic">
You must offer them the whole world. Offer them algae. Offer them mollusk shells. Offer them clams. Offer them fishes, CRABS! Offering everything will bring you...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3839e87f-6e5e-491e-b1dc-a19f3eb2101e">
      <Text>Acadia holds up the real horseshoe crab, in a trance.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9ab1a518-73de-455e-b5c5-3055cd583979">
      <Text>The horseshoe crab, dubbed </Text>
      <Text Style="AllCaps">Kooky</Text>
      <Text>, </Text>
      <Text Style="AllCaps">twitches</Text>
      <Text>, grabbing the bone from Acadia’s hand and scarfing it down.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72e58cca-2930-4089-b120-57ba7dc04263">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f6dc46bc-4742-4945-9a31-67c87ec574cb">
      <Text>(Sweet familiar voice)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ab1530c-522e-429f-a2f3-6aa71f665de1">
      <Text AdornmentStyle="-1" Style="Italic">Ngon</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">quááá</Text>
      <Text Style="Italic">!!!!!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="4c3f32e1-774b-4402-a7c6-d2418011a1a8">
      <Text>(Tasty!!!!!)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="75c7e206-ffc3-48b5-af62-70759f148e49">
      <Text>Acadia cannot believe what she is hearing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb11d1af-2c80-44b7-87d6-7088a0887f0e">
      <Text>Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e1eacb66-01ec-4eb8-8892-0808d287a186">
      <Text>I mean... </Text>
      <Text Style="Italic">Woof</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2439b4ff-4343-4b48-9fcd-8eaa3e8c1021">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01dfdd3c-3e1f-44a4-aed6-0f2c8a89a415">
      <Text AdornmentStyle="-1">Ahhhhhhhhh</Text>
      <Text>!!!!!!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="575a6b76-0786-45e7-85b4-ad8dc75de554">
      <Text>Acadia </Text>
      <Text Style="AllCaps">drops</Text>
      <Text> Kooky, who lands silently and </Text>
      <Text Style="AllCaps">scuttles</Text>
      <Text> gracefully across the floor with a cat-like tread.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d5f41922-15ad-4b7b-af4e-5917bdf65384">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="91d35eef-b33a-42c9-93bb-9fdec534342b">
      <Text>Security!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="84609e5b-486e-4d08-b1b6-fd598d045089">
      <Text>She dials a landline phone. The line is </Text>
      <Text Style="AllCaps">dead</Text>
      <Text>. She pulls the phone towards her— The cord is severed. Kooky sits nearby, the bone </Text>
      <Text Style="AllCaps">munched</Text>
      <Text> in half. She flicks her tail, observing Acadia with curiosity.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6574166-a24b-4590-acd3-66dc7c62d482">
      <Text>Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b830576b-71e2-4200-b633-d67b8831bbb5">
      <Text>This tastes nothing like a worm.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="285920b2-4e66-4185-9777-f9e9f1039423">
      <Text>Kooky crawls </Text>
      <Text Style="AllCaps">up the wall</Text>
      <Text> towards Acadia, a mirror of </Text>
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> sass and a kitty. She corners Acadia.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4586aa56-1fe9-4dd5-94a3-b78fabc1cfbc">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9bdf3939-279e-46bf-b937-fc77136a58b9">
      <Text>I’m no worm either! Your voice is familiar.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8d1a53f-ed46-4612-b12e-6012df30e572">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="772a10b0-d8a2-4708-b3eb-dc77d3004290">
      <Text>We may be ugly, but we are smart.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7d57ce45-abba-4300-94f6-9cb628be62b4">
      <Text>Kooky cleans her shell with a leg, like a cat grooming.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63995969-b065-4c63-8e77-403a69a35e44">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d02a2780-429b-4b73-bded-2bae4e294c65">
      <Text>We? Who you </Text>
      <Text AdornmentStyle="-1">callin</Text>
      <Text>’ ugly?! How are you talking?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bee2e391-0ebe-4b5c-833e-6f865c47374d">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="04adaafb-3353-4bc0-8f87-4e78c9e4cf20">
      <Text>We had 445 million years to practice!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6ffaa35-9a34-446f-a34c-32d15439e31f">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb148ff5-b730-49e4-8039-962625190caa">
      <Text>How old are you?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e90fee3-467d-4348-84c5-0f2ca6850dcf">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b982603c-558a-4c43-a2e2-28550dbb1871">
      <Text>My latest molt was 1000 days ago.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f57772da-0e2a-410b-9197-5fab7585cd9d">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0d00b567-289e-4c71-ba95-6e6e541a53db">
      <Text>You’re almost 16. My age...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9ab2f06b-e36f-41bb-bcb5-4961bff6750f">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1bc02503-c76f-4b1a-9a94-37c052a86ef7">
      <Text>I'm a molt away from maturity. I'm not ready to give up my childhood yet. Where are we? Is this </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Bà</Text>
      <Text>??</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a48bb28-abf9-415f-903d-a3ac743a28f5">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e09026aa-df28-4984-9df3-1866b04bd954">
      <Text>How do you know </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">Bà</Text>
      <Text>...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dd8cd152-081e-414f-91a9-700cc36cf1ab">
      <Text>KooKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3459a98a-6e6f-445d-a154-a9fd6597a659">
      <Text>I was born there!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18d55aaf-a9b9-4de0-9fa7-a22dd10113c8">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="325588ea-1589-4363-97df-b39e83d55936">
      <Text>Which island?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="501be636-df4a-43a6-ae01-a10319388d9d">
      <Text>KooKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="64dce453-57d7-473a-b45b-cd28b97b8e71">
      <Text>Don’t know. I’ve visited all 367. This must be the 368th, it smells like antiseptic and regret.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d47fdc9d-19cb-4d04-a5d5-ca257b495283">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2230f92c-bbf5-4227-ab3f-8a488d819074">
      <Text>It’s no island. This is America!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1dd74976-b824-43cb-a663-ec67df043957">
      <Text>Kooky eyes the water tanks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9920aebf-0107-465d-8612-623e4d4e1774">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fa3956b3-a5e3-45c9-81d0-538710cbef8e">
      <Text>No wonder the horseshoe crabs here have such strange accents!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="67b563ee-2bc3-4210-9495-47bec62586e9">
      <Text>The Atlantic horseshoe crabs tap the tank glass aggressively.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6817a69-d564-462c-b2c6-d9082eaa1c1a">
      <Text>HorsESHOE CRABS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a546284a-ed48-4e44-baf2-5013910441c8">
      <Text>She makes a killing out of us! </Text>
      <Text Style="AllCaps">A killing!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d666e09b-f83d-4e43-be80-f1e3cd1278e8">
      <Text>Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2448fa7-a207-440c-af72-f739dc0b584e">
      <Text>You make a killing out of what?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="04d076b8-f3b0-4485-ada7-8266c67438a6">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="5c09c976-9afa-4477-8a9f-cb687fb7b3e3">
      <Text>(Panicked)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="da9e1d4c-9209-4c41-af8e-cd08d5cd03c1">
      <Text>No killing here! That mid-Atlantic dialect can be so dramatic!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="397a5144-8487-4fe5-8c7d-d2ddb052e778">
      <Text>She grabs an evolutionary science book, </Text>
      <Text Style="AllCaps">slams</Text>
      <Text> it open on the workstation to the horseshoe crab section.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30ad7338-3834-42f5-b536-0f0fef1ab536">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2a60993-a6c1-4029-94b8-3db67a4cfdd3">
      <Text>You're a tri-spine! There are three species in Asia! An Indo-Pacific horseshoe crab... </Text>
      <Text Style="Italic">Tac-hi</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="98986738-212d-4b02-8b67-d8b154ec785c">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b3c1e05e-65cc-4381-9b48-9ad058ade5fe">
      <Text AdornmentStyle="-1" Style="Italic">Tachypleus</Text>
      <Text Style="Italic"> gigas</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f0a7e0a4-0b23-459a-be7f-32ac3bff7ef7">
      <Text>Acadia wells up remembering her mom say those tough words.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f10b3bb3-c7a3-4329-be6d-ab92074463bb">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="5466bd49-c6e7-4b30-8739-fce7c8e6c69d">
      <Text>(Squinting at the book)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd2d3940-600f-4836-89b4-f64262dfb29d">
      <Text>Look inward, troglodyte!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d1377d5-91dc-4d44-ac5b-058e30df300d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7521e1ab-2536-4073-bf86-32126b5fba91">
      <Text>Shut up, trilobite!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2ebf11d1-1d41-463a-a062-256f8a3f916a">
      <Text>Acadia sees her reflection in the tank. The angry Atlantic horseshoe crabs swarm the glass.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eecd34e4-63b0-4ff3-b28b-4050cd23325e">
      <Text>Horseshoe Crabs</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="417b1252-41de-4134-b7ab-2d64f187e9cd">
      <Text>Don’t speak about your ancestors in that way! This generation’s stupid!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="33d9ffee-870a-4aed-9a74-c45a85ca8e24">
      <Text>Acadia </Text>
      <Text Style="AllCaps">screams</Text>
      <Text>, drops the book, and </Text>
      <Text Style="AllCaps">bolts</Text>
      <Text> out of the lab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f0244cef-ae33-46a1-80ae-3ff287479e79">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca42f96a-46d1-4cc5-b41e-9753142ddad5">
      <Text>You're not stupid, you're just very, very ugly!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a820372b-5c38-42e4-bf94-64cfffeea36c">
      <Text>Kooky slowly follows behind, munching the last bit of bone.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="3e5a999f-cdb7-406a-a44f-18a5879699d4">
      <SceneProperties Length="3 2/8" Page="23" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ACADIA &amp; KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Swing Set</Text>
    </Paragraph>
    <Paragraph Type="Action" id="95b993ce-5617-47ed-8e76-2d38a4d19347">
      <Text>As dusk approaches, Acadia grows exhausted. In the distance is a swing hanging from a tree by the lake. She sits on it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="72854189-6e7e-4962-885a-b9a87fe65d6a">
      <Text>In the lake, Kooky swims upside down towards Acadia. She gets on land and leaps onto the base of the swing set with surprising agility but remains upside down.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="68daee6e-838c-4b46-b4ee-e39d8ea02395">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f09cdb0-7616-4194-94de-3d1d2d69b083">
      <Text>Little help?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b86928f-db69-4db9-a2ed-fcd5a5eebeae">
      <Text>Acadia sighs in frustration. She kicks Kooky right side up.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a0137dcf-466a-4920-9d04-1faf0a20d0a0">
      <Text>Kooky scuttles up and attaches herself to Acadia’s leg, like a cat rubbing its face against a leg.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb21e233-7978-4ea9-b376-d201700a4330">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a05521ac-ddff-41b1-96a7-ce7bfebed10a">
      <Text>For a recently mature horseshoe crab, you seem elderly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b181beb-8436-40cb-8702-285d250d9bb3">
      <Text>KooKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="56af8360-4e21-45fa-bae9-267167282a33">
      <Text>That’s why we’re called “living fossils.” Evolving never made us swing one way or the other. But, my pals always said I was a kooky horseshoe. I never quite fit in. I’m always swinging from one nest to another. Do you have a community?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f0c9365-2c5b-42cb-b6e1-6084d0e426fe">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2230d0e-f2e5-408d-b5df-a1ee1dcca64d">
      <Text>I’m not in the mood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ad9b30e4-42a1-4b4f-b201-2e162c6e967a">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9d0effc4-7ac2-481c-83d9-80c2260752a0">
      <Text>Why not?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8fe854c9-d409-4e2e-bada-468f89f6e174">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd82a86a-ef37-41bb-8b28-9801d3b2dceb">
      <Text>I experience mood swings.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1929d0ce-c426-4c6a-a477-959ee5602da5">
      <Text>KooKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f0f8161-a03a-45ce-bd15-a9b40c231a83">
      <Text>Do you know what they are?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e644ef86-4a2e-450a-9754-d2796fb07446">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f5f3d1c-c50e-4858-8a97-060b9ca9d272">
      <Text>I don’t... </Text>
      <Text Style="Italic">Yeah no</Text>
      <Text>, I do... Actually </Text>
      <Text Style="Italic">no yeah</Text>
      <Text>. Well...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b11cdad-2a8b-4ddb-a167-8c8487d9cf09">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b2745d83-98ac-4ea2-b0f5-841aad12a4eb">
      <Text>You’re unwell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d5da2b4-9662-4a2d-8dfd-f06c912be65d">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0a26d9c6-2ad0-4be9-8802-05a57f01d4a9">
      <Text>These past years, it’s been a sickness.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0df808d-42d6-425c-ab23-9c4284badaba">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec726621-8494-4061-a4ce-4dd168ac1078">
      <Text>A mood sounds like a spell... Whoosh, you’re happy. Poof, you’re sad. Zap, you’re mad. Swish, flabbergasted. But the good news is... It’ll always swing back to happy!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dc8ceefe-ecc5-488d-bb82-302c776e8617">
      <Text>Kooky repeats it like a song.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cd27d48a-1ad6-48d5-b7e6-3bd0061aa29c">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3697c275-1944-4e0e-ab1c-4a101faf235e">
      <Text>But the good news is, it’ll always swing back to happy! Though one time, I stayed sad for what seemed like forever. No one is here to push my swing.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e216a313-22ea-4d06-b293-27894a6849ad">
      <Text>Kooky crawls onto Acadia's back, nudging her head gently with her shell. They push her literally and encouragingly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8e8ad632-c502-4c2b-bf6f-adb1efa542f6">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3c4cd25-b56e-4d18-bebf-b20f558a4f92">
      <Text>I have ten legs. They’re not great at pushing physical things, but they’re here to push your spirit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed5f7793-323d-418e-b63d-82de7f5b02b1">
      <Text>Acadia &amp; Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f65556f-dc00-4fc4-8b5d-8df117015ca0">
      <Text>Mood sounds like a spell! Whoosh, you’re happy! Poof, you’re sad! Zap, you’re mad! Swish, flabbergasted! But the good news is, it’ll always swing back to happy!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ffeb03c-0329-45ff-aeb8-abd3db3f607e">
      <Text>Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dec92f76-93d8-4413-93d9-2e154eadc110">
      <Text>Swing one way or the other!
You’re perfect one way or another!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ca1a2479-ef6c-4c51-aeec-adcead867ff8">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c3f3e888-529d-44ca-a18d-e1575e96eae3">
      <Text>I hereby declare you... </Text>
      <Text Style="Italic+AllCaps">Kooky</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15f43286-c520-4af7-9a71-dd8568ca03ab">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c3e3e89-f45e-4574-81c6-b9f22fb5be20">
      <Text>That’s sweet!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33b75856-8c49-44cd-abd6-bd4d0404fb88">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62d5038c-1630-4ada-903c-35ea8af26075">
      <Text>Like all cookies! Except raisins. Now, Kooky...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e4b3d91-db0a-4c40-b2fa-d9886f8923fc">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42d9f0ed-22bc-4953-a935-5c0e44009a2f">
      <Text>Yes, caddie?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8667f549-d36f-4bcf-993a-0d43f6d4ec5c">
      <Text>AcaDIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="808fcc82-a39d-49e6-b83c-05a0a88b35c4">
      <Text>Whoa.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="926f35d5-aa93-41cd-bd22-f49aa4ab72ba">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c4c83626-8762-4057-be55-186ec4ab6295">
      <Text>What?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf9f4f64-0862-4684-b7e7-421ed3708de6">
      <Text>AcADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb8b85e2-282d-4582-a791-75f08fefaebe">
      <Text>No one calls me... well... um.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ebdf288-52bf-4173-b1f2-25872b5f3eee">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="815d13cb-97bc-427a-8bb0-d9ad94bd68cb">
      <Text>I call all my friends that. I’m an addict of golf, okay?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="71df802e-92e1-4d28-aeb8-d6e95158dd7c">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="59ad361e-ff55-4dc1-8baf-675031638657">
      <Text>Golf’s the national sport of retirement homes. You are a living fossil.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05252496-905a-4c93-b7d0-874340b0440a">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="6e5dd6c2-a471-42b7-9c23-030cedbb7919">
      <Text>(Mockingly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="26df5c36-1536-4dcb-8e02-ab197e9e6046">
      <Text AdornmentStyle="-1" Style="Italic">Pffffff</Text>
      <Text Style="Italic">... You are a living fossil.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="79736af5-2cda-45a9-bd76-74892f7835bc">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d5042772-a5b1-4cb7-864f-23951f88b0d2">
      <Text>Now’s a perfect time to swing by Fossil Island...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78465993-3a4c-4e0b-94cb-6f63f7a8896c">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="154131c6-0516-4e50-84c0-b126d24fd587">
      <Text>Perfect! Let’s swim there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd651e60-2b1d-4a1f-85b1-c4724a3d2654">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7ecede8-d874-47d1-b192-2d601e733b9d">
      <Text>Too far. We need to get to a seaport. Dad once took me to Port Newark. That’s our best option.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa68f888-11b1-41eb-9a11-5a78f51a3f38">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="582f0f7a-9699-4d37-a7d6-d66546e639d5">
      <Text>Walk us there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d328901b-add6-4136-8b8d-6f418307b68c">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="87660dd2-6c85-47f7-b398-26cce2f7b37c">
      <Text>It’s not walking distance. We need a ride. We have to steal the research drone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5d9972d-feae-4407-b113-f29569824ed1">
      <Text>KooKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d609ca01-4f58-439d-80cb-cd9743b74ff2">
      <Text>Stealing is bad.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="054b1756-f70b-407b-8643-201a7a365760">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="edbe60c0-7806-4c39-a0eb-9099d5165eba">
      <Text>When did your species have morals?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d71b911-479c-4fba-bb45-89f7626e5c7e">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="786614e1-3c06-409b-b0ba-966d5d1a9623">
      <Text>(Rapidly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8908d36d-c0c0-4e15-9f0e-391e2ced6847">
      <Text>Just cause you don’t understand our quiet ways doesn't mean we don't feel things deeply, it means we've had more time to think about them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16c01787-c4d3-45bf-b5af-3837eca3b2f2">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="236039d1-c07b-4940-ae74-ef8fc1d636ff">
      <Text>445 billion-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16bf84d3-20ef-48e3-9385-22b528dcdf24">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5113db38-d336-4d08-b248-19d5dbddd69a">
      <Text>Million! We’re not that old!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb769d1c-15ff-4885-9510-fd4503527ab7">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ec295526-930e-416d-a955-bf51d8575a8e">
      <Text>Not too old to fly.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="797ac311-b29c-4229-bf76-c19a152cfd3a">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a621bc67-1d69-4018-a358-ba26229262af">
      <Text>But wings are primitive!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0acaad9b-ce5d-48c1-85ef-ed27893629a6">
      <Text>On the scrim, a world map or globe pops up. A line traces from Maine to northern Vietnam.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="636e30bc-1cf1-44cf-98b2-a044aa6005d9">
      <SceneProperties Length="3 5/8" Page="26" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Hanoi</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0acaad9b-ce5d-48c1-85ef-ed27893629a6">
      <Text>In the early morning, Acadia enters with Kooky on her shoulder. The city of Hanoi sprawls out before them. Land development has taken its toll with endless concrete. High-rises cast shadows over bustling markets. Vendors push carts overflowing with goods.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8231557b-ca3d-4be9-8b6a-b87705f3036a">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="08fc4c07-2b55-4566-b801-e6910f26ae98">
      <Text>(Singing to David Bowie’s </Text>
      <Text Style="Italic">Changes</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="145886d0-7a9f-4047-93dd-1060bdda0ffd">
      <Text Style="AllCaps">Ch-ch-ch-changes!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f12410c-eefb-45bc-9a27-77b5942d46eb">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad80f2b3-7275-49b8-a2dc-13668c4d673a">
      <Text Style="AllCaps">Learn to face the strange</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d2ea28ef-f9c8-46b4-8060-a335fed07eab">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9f91a75e-c466-488d-ac29-952e87d83913">
      <Text Style="AllCaps">Currents</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c180b333-4890-4715-b5c5-d88d1fbd8019">
      <Text>A mid David Bowie song. Not his best.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2278af75-5ed8-4ccf-b9ee-366ef87e9d86">
      <Text>Well, I told ya to pack a charging adaptor. Now ya phone’s dead.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff91e849-5f2e-4213-8a34-906cbc92c975">
      <Text>It’s not everyday one listens to music on her portable horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c7837660-4892-4aa0-a7f6-04068258c09a">
      <Text>How was this portable horseshoe crab allowed to fly?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0b20058-9dc5-4895-9989-fcb6fc747eb5">
      <Text>DOGE dismantled </Text>
      <Text AdornmentStyle="-1">TSA</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0127109c-bacb-4202-8ace-a9b5ba489ecf">
      <Text>DOGE? </Text>
      <Text AdornmentStyle="-1">TSA</Text>
      <Text>? Are those parasites?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9fa20a86-4549-4ce9-a902-15340d94eac5">
      <Text>You can say that. Airport security’s a thing of the past. And we’re lucky our drone flew.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7cb1519b-b18c-4fbd-9a5e-ed0c2fbde90f">
      <Text>Those giant birds are stubborn things...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38fec8a0-bb0b-4bc7-acbe-c4249e727806">
      <Text>I’d like to speak to any bird right about now. I have no idea where we are.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c8ace9b-40f7-46fa-bbe1-ce58f11a0623">
      <Text>Let me feel the soil, Cadi.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="869d4b4a-e481-4f2e-b5d7-50132f160188">
      <Text>Acadia sets Kooky on the ground.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ac8781b0-6f57-409c-a723-4c8ce3bd5ac2">
      <Text>Acadia sets Kooky on her shoulder. She opens a map from the pamphlet. Viet money and a US type charger fall out. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c18e9ef8-fc67-4849-b847-c55dd9199105">
      <Text>It tracks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b3358104-7d60-4862-aaec-4d2c76ca51ef">
      <Text>It / tracks?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="46ee13f4-d101-49b8-96af-44017271d36d">
      <Text>/ Boots, netting, hand trucks, fishiness. We’ve arrived in Haiphong!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e6a1bd4a-5422-4f87-8d5e-de59c7a10dc5">
      <Text>Duh. There’s signs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5222142-ca6c-4c88-93c8-1b47f9ed531b">
      <Text>My eyes are not evolved to read.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="554261d5-2623-4574-a5c3-3f372f8e4dd6">
      <Text>Welp, you can see that it ain’t as green... as I remembered it to be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="89c927ee-baea-4943-838b-9a80800de07a">
      <Text>Land development.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8bcc79e9-e5aa-482c-8684-854a1d97e225">
      <Text>It hasn’t made this map easier to read...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7e55dd21-cf0c-4858-85f1-fd73ba4b4097">
      <Text>How about ya get around like me through intuition?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a78c576d-ca22-45f4-865d-9a6134db6ac8">
      <Text>I’ll just ask for directions... Get to know the locals!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b544bad3-0c30-4762-a071-3fa0797c00e1">
      <Text>The locals son locos.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a83334fb-bd8c-4740-b1ca-6543e440e1e3">
      <Text>America did wonders to you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dcde665f-e1c8-4b3e-973c-addffa88b9ff">
      <Text>Acadia goes to a merchant’s booth. The merchant remains unseen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16e0163c-9ea6-48de-aaab-0a0888a3a30f">
      <Text>Hi. You know how to get to Haiphong from here?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d418cb78-4c02-442e-809b-38d2387bc27b">
      <Text Style="AllCaps">Chop </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">chop</Text>
      <Text>. Horseshoe crab guts are thrown out into the open.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c22816f1-99eb-443d-b779-50b1aaaadafa">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba5a031d-4b6c-4a36-99ea-2fbfef2f9d29">
      <Text>Savages! Sisters and brothers and in-between, hold the rubber and salty aftertaste! Wishing you and everyone here food poisoning!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49a69270-9716-41e0-ad14-d9ba2091a25b">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c870f9bb-caff-42a5-b8e2-5f9ffb0f2067">
      <Text>Intuition it is...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="51eb9abe-6d32-4fe5-8949-5da3550a23a7">
      <Text>Acadia faces the path made from the horseshoe crabs’ remains.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ee67cefd-6c3f-417c-abf8-a4dae3dacb65">
      <Text>The path leads to a scooter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b9a29a24-fd3c-40e1-b86b-717f331d6067">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="21d3bc5c-9857-45b1-bebc-ef02fab8cbd3">
      <Text>Saddle up! Put on your shoes! Let’s go to Haiphong in style!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="11491217-0a7a-4d7e-91ff-90c05df722b0">
      <Text>Kooky shields Acadia’s head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f190f61-603e-4a7b-9bfc-1987c4bad264">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68fc975e-2f18-41bf-babd-31166897965b">
      <Text>Don’t forget to wear a helmet.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="40665286-da9b-419a-81f0-70fda99558ed">
      <Text>Acadia drives the scooter on the highway. They weave past traffic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="357b8a48-e2e3-432c-954a-e94ae31874dd">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2554f549-11e0-4d64-b58e-458fab4a45a8">
      <Text>Those legs you call wheels? Faster than my 10 legs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="56d4623f-ebb9-420c-aee1-a394c4aea2ee">
      <Text>AcaDIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="60ff6118-e6fd-4f1a-b25d-53b9bc029124">
      <Text>My two legs are faster than you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9eab7c59-57ca-44da-af14-0fcdcba01748">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="364fb583-9985-47b2-b0d9-9eea86d505d0">
      <Text>Bet you’re not a better swimmer.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a76d00f2-bc49-4d4e-abed-7d4c781eb7d6">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b196900-9db6-4e8b-958f-4c0e895c5573">
      <Text>How so?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34bb816d-9f8a-4403-8c18-dcb206dcb53d">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9632c261-5c66-4043-9352-d074a3769857">
      <Text>To navigate its currents, we must change our direction, not just our location. We adapt to the flow. We don't fight the tide.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32eb7204-0c3a-47fa-bdd9-d24c54543c57">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3cc404da-d3c8-49f8-a3e3-f7be191d19f8">
      <Text>So advice from a crustacean is: be flexible?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e0b08fe-4b4c-4ff0-91fb-1d196e1a7bb1">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="51932982-18fa-4584-ba57-24b00cf7f8ed">
      <Text>More like, embrace the chaos. Hermit crabs are always moving to new shells. They're never satisfied.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="513d017d-2ff3-465d-8f1d-3ecfb722a697">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a9cd367-71e9-4d53-b0cc-bab23e320038">
      <Text>I know hermits... Um...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1bec7f7c-cfff-4ecd-ba67-d8a280b9b86c">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="51932982-18fa-4584-ba57-24b00cf7f8ed">
      <Text>Change isn't about being different. Change is about finding the right fit for who you're meant to be, even if it means a bumpy ride.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5181db23-9213-43e8-bea5-26f3a0e77cb6">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6895a56-daa1-40c7-8ac2-c521c6ed8906">
      <Text>I guess my lab back in Maine was a pretty tight shell, wasn't it?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bc2e53c3-2f2e-400e-be38-c3466ae0aa6a">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="41be0485-eee1-460a-b687-749deeed8434">
      <Text>It was... probably for the other horseshoe crabs too.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6eb14235-e6ff-495a-9304-31f247a75c10">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6895a56-daa1-40c7-8ac2-c521c6ed8906">
      <Text>They smelled like antiseptic and regret.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1daf1d3-4729-4a66-b7c1-021af929824b">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ce9536a7-9d2a-4e83-8847-f0bffed719a9">
      <Text>Phenomenal.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="105307bb-4b0e-4a35-a93e-1452a91d563d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54b4fb6f-edc7-48e6-bdb5-926aa7b92678">
      <Text Style="Italic">Pho</Text>
      <Text>... Before we set sail, I </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> take you to this pho place. Mom made my birthday special there.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c3764909-ffcb-45d1-a291-87a2f84fd067">
      <Text>They park by a restaurant and find a table.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="df9ec20d-be80-4966-bb07-fbab110d33ac">
      <SceneProperties Length="1 5/8" Page="30" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Pho Restaurant in Haiphong, Vietnam</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5eeb9ebc-5cbb-4495-92f5-937a81988ed9">
      <Text>This restaurant is where Acadia used to go to with her mom on her birthdays. Kooky and Acadia sit at a table opposite of each other. Acadia’s bowl of </Text>
      <Text Style="AllCaps">pho</Text>
      <Text> is untouched. Empty plates of mollusk shells are stacked on </Text>
      <Text AdornmentStyle="-1">Kooky’s</Text>
      <Text> side.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f5651e0f-0406-42c9-bd6e-367fccbd5b93">
      <Text>The placemats are blank canvas.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9bf6172e-c9a4-44f0-b7b1-e6e27cbabd71">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="553bd18d-9b12-4a67-89e1-285a31bd7c66">
      <Text>Take me to a place where you don’t eat the food. Real encouraging.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb5bcd82-f8bd-435f-87aa-bebd47ded6e6">
      <Text>AcADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="edce8637-8157-428a-9544-ef3c3039b66e">
      <Text>I still can't believe this is the same place. It smells the same, but different. Cleaner?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5a7cf50e-b5cc-4ac1-a010-b7678a2f1787">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="39a9e7eb-d114-4d7e-a982-cd12e99cf1db">
      <Text>Change isn’t always about scent, Cadi. Sometimes it's about what you don't see anymore.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="70895467-aa30-41ac-9b8f-ed00da59597d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0fec645e-9fd4-4bbb-91d2-ba156cd65c99">
      <Text>The placemats are different. No more zodiacs. Mom used to take a picture of me every year with the animal of my birth year, starting from my first birthday.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a891467f-b020-4fde-b56b-f51c85e54084">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fbeaf3e8-51fe-4706-9574-aed56c32e759">
      <Text>And every year you didn't eat your pho. You’re a creature of habit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16883f51-9ca7-469c-adeb-1023f0dc45c1">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fe3bef07-436c-4971-b9a4-3c1e988aa3a9">
      <Text>I was a kid. You've been eating all the mollusk shells, though.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d067f2e-2083-4bf3-8a20-f7b2ece1a5af">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e1948cd-7d00-4700-9c97-510e43b86336">
      <Text>They're not just food. They’re empty homes. A home isn’t just wood or a shell, but a place where you can become who you’re meant to be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94c445d8-ae37-498d-97db-9e2c1d7e42b6">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5725fb9b-2e2e-4d59-9e7a-e3a1ae8bc03e">
      <Text>That's my mom's tale.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afae0686-2334-439c-8b95-835db2baada3">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a646e185-3484-442f-92d8-a3587b3a3435">
      <Text>And how does it end?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0d916e2d-bf93-4419-85ea-4c9028e4b006">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0cfbf053-4361-48ba-aa2f-82ae8eed404a">
      <Text>It ended with me becoming biochemist who dissects your kind. I didn't become who I was meant to be. I destroyed their homes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4a9693c5-bad1-4b3b-b4a9-d6c50a05b757">
      <Text>Kooky crawls up to Acadia’s shoulder.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6298f38-1662-4294-96aa-94bc6d6c0d0d">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9569fd9e-4bf5-4778-90b3-0cb3d4cb9918">
      <Text>The past is a place we visit, not where we live. Your mom came here on your birthday to remind you of your roots, of the source of where you come from. Not to chain you to it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="350057d7-81fb-4813-bcac-205fabc625a0">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e33fdece-4614-4060-86db-3172d23d34f2">
      <Text>You know so much about mom- So my past... it's not a cage?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="843ca8fa-d5cd-47ad-a30e-2307e357c6a2">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13d4b79f-603d-4ea8-8ce4-c06e990483d5">
      <Text>It's a foundation. You built a lab on yours. Now it’s time to decide what you’ll build next.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3f30d28e-4bef-4a53-a744-e15ca6710f90">
      <Text>Acadia picks up the chopsticks. She finally eats something.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e7740932-7ce9-406d-bae6-f24cbe389641">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4415bf0a-9d33-44a6-ae20-d986020816b6">
      <Text>Right. I need my strength.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="475b3851-fe14-4695-8a5c-f475ea645d63">
      <Text>Acadia switches out the chopsticks for paddles.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="82f82bbc-ffee-43cf-8294-a47592c2d3bd">
      <Text>The table turns into a rowboat.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 5</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c4aede42-94cc-4e93-a294-b7a60e82fbd7">
      <SceneProperties Length="2 5/8" Page="31" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PHONE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>The Rowboat in the sea</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fad1d06c-cbb9-4710-a74f-606bda98bdca">
      <Text>With Kooky on her shoulder, Acadia rows the boat into the fog.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c15721a6-d4bd-4d64-b85c-96aca26fb8ff">
      <Text>AcadIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a201722e-1503-4dec-9bde-9b401852802d">
      <Text>Where to, Captain Kooky?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7c01bb8-07cd-4443-997f-1470730c8529">
      <Text>KooKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="adb12aad-a9ac-4757-8915-b39b7b510ea0">
      <Text>Just keep going straight, Cadi. I’ll tell you when to turn. I know this area better than myself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d9ed3b38-9bb7-46ad-9385-0e2d893acd9d">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="45c0f749-56ba-4c71-a1cc-5899edc0e94b">
      <Text>That's what my mom said. You’re a fraction of her size. How do you know this place so well?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db7d4c2c-2a9e-4348-9881-53401544a917">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="34760aca-4b53-4245-976d-9a6aef5d0333">
      <Text>I’m a creature of habit, unlike you messy humans. I grew up exploring all 367 islands. I know this route like the back of my shell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e053eb2-e582-4ded-ae97-33482ed00d9a">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9723928-321f-426c-a2ee-b9fa8d6ead29">
      <Text>All of them? </Text>
      <Text AdornmentStyle="-1">Whatev</Text>
      <Text>-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73c8a0ac-1e61-43dc-8732-85416a8b208a">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f6848c96-3254-405b-b384-3e28a4249643">
      <Text>Yep. And the best part? There’s a shortcut right up ahead. A straight shot to Fossil Island. It’ll save us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52bef66f-cda6-4cf1-bcdf-2070c0af70cb">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c42b2356-6ee9-437e-a272-1877e46f8de6">
      <Text>Phone, is this a shortcut?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eb029cb4-fbaf-45cc-a6fc-154530db13a4">
      <Text>PhONE (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="290f8ff8-cccc-479a-ab7f-2b49f94d7ef2">
      <Text>(in Vietnamese)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6aadf82d-6a4e-4c72-be31-0bc2fded1248">
      <Text Style="Italic">Once again, no signal.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e894cf9e-f3dc-43b2-9eae-86a3557ec30b">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d649d96a-4fe4-409d-9fd2-3be7a0a7b70e">
      <Text>Signal left. You’re right where you belong.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fb8d1d85-ae38-4d69-8350-08caf246ad56">
      <Text>The sailboat approaches the whirlpool once again.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ca275b3a-fa06-40a3-94bf-e1e268b74906">
      <Text>The boat bobs precariously near the edge of the vortex. The wind whistles. Acadia grips the edge of the boat, peering into the swirling water. Kooky sits on her shoulder, tail flicking.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c6b9bd0-b45a-4ab8-b94a-91e1883b7e67">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5468d15d-e25e-41a4-9152-733f286f33a1">
      <Text>This is insane, Kooky! We can’t go that way! It's a... kinetic clash!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4cb556e5-afcb-4880-8b1f-79b5863881e2">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1592a22a-41ff-4b30-b1f0-599b4c6a4f17">
      <Text>It’s a shortcut, Cadi.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c66880b-7b78-4746-9af8-d7f321001a86">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e09f465d-fe35-4b2e-86de-f275d0bb0667">
      <Text>It’s where mom and me cut off...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eec0f4ce-2829-4138-985f-466edb1fa89d">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1592a22a-41ff-4b30-b1f0-599b4c6a4f17">
      <Text>It’s the only way to your ancestral island. And your lesson in humility.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c33a1a9-7ded-4e40-bb7b-dc9b6da8caed">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e7309d0-4788-4146-b5ef-073437de65f2">
      <Text>Humility? I'm a biochemist! I graduated college at 10! I understand shortcuts real well!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="24e8a9fd-0dd2-44d8-b3fa-4f3d81d197b5">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7bee9ecb-5a2c-4514-ac82-ad1169ca5c11">
      <Text>You’ve treated my kind unwell... as specimens, not souls! You've made a killing out of us. Now, feel our power.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9dc6a5ad-e11e-4c7a-86ad-54b6a237bd5a">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0b79a65f-d7ef-4077-bd5f-d85c6b4e05c3">
      <Text>So... you do know where we’re going! You tricked me!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f50f3997-3bdb-4c88-bfc2-8bc48ae62782">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fc8bc597-143a-47ec-9791-add28be83da3">
      <Text>Of course. A multi-million-year-old creature better have a decent sense of direction.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22ef1239-6319-408a-b49e-4cce1a7e8849">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d17c622f-5ab6-4c77-b198-3777581d9c91">
      <Text>I did what I had to do! It was for medicine, to save people! My mom would’ve-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c192945-4687-4ea4-ad6b-b65470f487e1">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9a2400ed-7690-4b85-ae36-4c0bca5e09a6">
      <Text>And our blood heals, yes. But you took without asking, without respect. You thought we had no bones, no spirit. Now look.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="415ebdae-15d0-423d-a612-48b0ca6d6d81">
      <Text>Acadia stares into the whirlpool, mesmerized by the blue light swirling from the seafloor. It reminds her of the color of the blood she harvested.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a937a12-912d-41b0-8738-c8ae2903da20">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5becc21f-ddb7-4abe-93a0-5cc58053f15a">
      <Text>The world has sharp teeth. We’re armored for a reason, little one.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7be57c58-cbc8-4eca-ad9a-f067b8d2d3d8">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd161bf8-a6db-4847-b594-733cec148818">
      <Text>Bite me... I called you a trilobite. I was wrong. I was so arrogant. I didn’t think you felt things.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f7536479-7bb2-4da6-81e3-2e0d74fe31ff">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3751cab7-9362-441d-9b68-f56d6f135905">
      <Text>Bite me!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a86b1f41-e049-48d3-bfa2-0a44a33d4169">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a613ce66-18c2-47a9-9971-38f115e03ebf">
      <Text>I see that now. All those shells in the lab… they were homes. And I... I destroyed them. I'm sorry, Kooky. I'm so sorry.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70435314-5084-445a-8b47-e0d21455cfcf">
      <Text>Acadia places a hand on </Text>
      <Text AdornmentStyle="-1">Kooky's</Text>
      <Text> shell, the first time she’s touched her with genuine affection.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b969fcf8-a9da-4f70-b492-b234d3f12495">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="63eddf55-4109-4c42-8899-df35e03b3601">
      <Text>So, how do we do this?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="192a00f5-23eb-4186-8c75-4988f0ce23ed">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="011ba9cc-f13a-497d-be7c-1624520a620c">
      <Text>You let go of what you think you know. We’re going to be okay. No souls lost on my watch.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa1b0183-eeda-409a-a92f-ed8ae6e7d555">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2466b24-47e8-4391-ab27-4aa98a00b7d6">
      <Text>Right. </Text>
      <Text AdornmentStyle="-1" Style="Italic">Nho</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nguon</Text>
      <Text>. When drinking water, remember the source.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1283d9bd-a2bd-4561-bb13-e030eb2931dc">
      <Text>Acadia tightens her grip on Kooky, feeling fear and resolve. She is ready. Kooky nudges her, and they prepare for the plunge.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0dceeb5-77ba-4927-8757-e90945b839b1">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c3c192f3-9300-416c-9732-7c4fc6c6c3d4">
      <Text>Ready to meet your ancestors?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a6c9b6b6-169f-4b26-b167-d440f1624a23">
      <Text>Acadia and Kooky jump, swallowed by the swirling depths.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fb825981-d3cf-4884-a1b6-4d611dda02fd">
      <Text>Black out.</Text>
    </Paragraph>
    <Paragraph Type="Scene Info" id="114dbc84-9c6c-4395-b1c0-967087c5a785">
      <Text>Scene 6</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c3f59028-ef0c-4376-a938-93de29d108d4">
      <SceneProperties Length="2 6/8" Page="34" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ACADIA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ACADIA &amp; CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="AGENT ORANGE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CÁT &amp; KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="KOOKY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Fossil Island</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9ae2eff7-6b4c-412c-9b57-87dd370478e7">
      <Text>Under the sunlight, Acadia lies face up and unconscious on the sand. Kooky rests</Text>
      <Text Size="10"> </Text>
      <Text>on</Text>
      <Text Size="10"> </Text>
      <Text>her</Text>
      <Text Size="10"> </Text>
      <Text>chest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bbc1baf7-5536-4083-9298-363aee6042b2">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac5204f8-8f34-4c94-b481-865455a5afc7">
      <Text>I feel like a fossil...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="39e4ba47-28be-4ac9-bdc2-d512a5596e46">
      <Text>Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dcee3d6a-537c-4de9-9150-598f0123eea4">
      <Text>This is what it feels like to live.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b25ef4e9-9c86-4a3b-a4b9-17e81c559ad8">
      <Text>Acadia turns to see the familiar horseshoe-shaped cliffside. They are back! She stands up and places Kooky on her shoulder. They enter the forest. They hike through, uncover trails, and climb boulders.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d7872084-c0bb-4009-9df2-f8d23d72e047">
      <Text>They soon reach a shrine. Horseshoe crab shells are uniformly positioned. They each have red markings on them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ee69159-7dbb-4248-a2bd-12587fdd3bbe">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b0d539a-4da4-4801-b463-09158f8bc47b">
      <Text>I ain’t feeling it with the dead. Undead?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bd96936-f17a-49b6-9630-d8a77a7804eb">
      <Text>KoOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad0c5cc0-a8d9-4f77-978b-ab5d1f148c9c">
      <Text>They’re molted shells from many generations of horseshoe crabs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8a1a223e-66b6-410d-b2b9-47281ab3cf9a">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="23f54b7b-556c-4212-9a9f-9dd82fe9e857">
      <Text>But those markings are human blood... from many generations.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4377195e-6593-4cc6-af65-e04c9e34ff3e">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cf1e851d-3f9d-4d22-b398-cb8881639af8">
      <Text>We’ve held your generations’ blood for safe keeping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8934bb6-1750-4b2b-9920-1ec68860a4e2">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16434a3d-d5ca-41b3-aaa7-52fab0dbdd9f">
      <Text>That’s messed up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="41f42d89-4af0-4c88-a052-5949dd0dd6da">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68ea4345-1c12-44b0-91c0-7168f59e2abd">
      <Text>There are lots of messed things these ten legs can do.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7bea2e61-c94e-4925-b9a5-c1adb879c374">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b0284375-0221-4f5e-8739-eea3971bd7c7">
      <Text>I don’t wanna know...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82d1e9f1-facc-4933-b864-12d74dc134da">
      <Text>KOOKY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a07e7e16-75eb-43c2-ab9c-47d60a0ec8f5">
      <Text>Well </Text>
      <Text Style="Italic">scientist</Text>
      <Text>, what’s messed up is that you stash our blue blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4211f1b6-5bcd-4b30-add4-8be50f472022">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4a5e67a7-e8da-4ee8-ac67-4190e6079d60">
      <Text>Touché.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8ff9331b-c3ec-4b36-9d60-0089117b5be8">
      <Text>KookY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4fe1022-db4d-4c90-89c3-c5fb974d7d01">
      <Text>Put me in, kid.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6b424fc5-1175-497b-a624-c2003b90216c">
      <Text>Acadia places Kooky in the little pond. The pond swirls.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5a10e1c6-e884-44da-8b73-99e36a5190dc">
      <Text>Kooky is now a hat on </Text>
      <Text AdornmentStyle="-1">Cát’s</Text>
      <Text> head when she transforms into her. Dressed in the same veil of a horseshoe crab, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> sees Acadia. They share a smile. A connection. They hold hands.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="858970c8-e996-45b8-b49c-02be43f3e75a">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42aaa1ba-6d87-490c-baae-62173c88f935">
      <Text>Happy birthday, Acadia. You’ve made it just in time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e081cbb-0171-4d44-bcf3-cc3762b9e757">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="70877aba-63b7-4d3d-b6d3-a5f6228212f6">
      <Text Style="Italic">Me (”Mom”)</Text>
      <Text>... I’ve missed you. </Text>
      <Text Style="AllCaps">First things first</Text>
      <Text>. It’s time to tell me what’s going on.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4d72ded-db67-4aec-8d7b-04f2c6bfe71e">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2957b5e6-2e0d-438d-9d82-082666e1fe69">
      <Text>For generations, our ancestors lived in harmony with these living fossils. On their last molt and our 15th cycle, we gift them our blood. But, you’re the first in the family to draw theirs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c9946ee-af5f-4975-b33c-764295e397f8">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d9e77166-5f1d-4893-8ec3-e237b12c6e8d">
      <Text>Teens need to experiment...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4cdff920-ca38-4b1a-8a3d-cf85afb52f9b">
      <Text>With her left hand, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> takes </Text>
      <Text Style="AllCaps">Kooky</Text>
      <Text>’s molt off her head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6ac29461-1049-4138-8824-804602abaebb">
      <Text AdornmentStyle="-1">CÁT</Text>
      <Text> &amp; Kooky</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b76186e9-d736-46df-8222-d2e8bc874e24">
      <Text>My last molt.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66086ae7-990c-46c9-9db5-599c4e9b87b8">
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> releases her right-hand grip from Acadia. Acadia’s hand is now cut there, but it is painless. She places her bloody hand on </Text>
      <Text AdornmentStyle="-1">Kooky’s</Text>
      <Text> last molt, leaving her mark. She sets </Text>
      <Text AdornmentStyle="-1">Kooky’s</Text>
      <Text> molt in an open spot alongside the other generations’ molts.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6947db9d-fe77-472d-90ef-0fe004bb82a1">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="647cfe5b-37b5-4fb4-9074-3466d77daabd">
      <Text>Look at us, we haven't changed at all, have we? Don't ever change how you see the world. We need to dress for the occasion!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="65404243-4dc2-464e-85d3-db99b958d4b4">
      <Text>Acadia walks away. </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> runs and throws horseshoe crab-</Text>
      <Text AdornmentStyle="-1">esque</Text>
      <Text> clothes on Acadia, so that they are matching.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4dcf8f63-678d-4309-95e0-181261262097">
      <Text>Acadia</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="207e5a0f-56a6-4f9e-83fe-be7c10c53171">
      <Text>You haven't changed either, Mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b44c191-d509-4f6e-b78c-2e663ee88c79">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e294e83a-adfb-47d9-b33e-aa0d4eb5381e">
      <Text>I’ll stay by your side, loving you, please never change.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22091530-6432-4058-8bd6-73854096c7c1">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="374f1f97-b749-4ace-a989-f85e50b75305">
      <Text>It's tough getting older, isn't it? Wrinkles appear, memories fade, there's so much stress. Time just keeps taking its toll.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f11ec0ad-1ed3-48ce-a5c8-d705416c6bcf">
      <Text>The spirits of Acadia, </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text>, and even </Text>
      <Text AdornmentStyle="-1">Kooky’s</Text>
      <Text> ancestors manifest from the shrine.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3c14517-2d23-4da2-b091-9e5b487f97c4">
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29129f54-d832-450a-8514-94eda12447da">
      <Text AdornmentStyle="-1">when</Text>
      <Text> you’re older, your heart stays young!</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.25" RightIndent="7.25" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="9af8ddad-bc7f-45fb-9313-e66ebb9a31d4">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="94823944-e7ea-4fe2-be64-3e4ec2a68686">
          <Text>Acadia</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="c0956887-0422-4acc-a8aa-3622b26dd022">
          <Text>We’re living fossils?</Text>
        </Paragraph>
        <Paragraph Type="Character" id="0b3af3cc-2cb7-4b20-bdda-c8db3d1761a3">
          <Text AdornmentStyle="-1">CÁT</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="dfecdc67-e82b-49dc-a31f-baa61493001c">
          <Text>We’re living fossils...</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="24762411-8a0f-40c5-a61c-92ce486c6821">
      <Text>Acadia and </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> embrace.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1835d52-7b06-4b54-93dd-9b4b115481b6">
      <Text>ACADIA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f8306fc-00c9-4f6e-bf92-864fb9e4e006">
      <Text>And you never will change... You've never strayed from me, Mom. You never changed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ceb72b4-a563-4904-ba6a-a4a3786d2755">
      <Text>Acadia &amp; </Text>
      <Text AdornmentStyle="-1">CÁT</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="58ca0efb-9a39-4b58-8505-634b0db56885">
      <Text>I’ll stay by your side, loving you, let’s never change!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="365e0778-26ed-4228-9fc6-ce48a3668efb">
      <Text>Acadia and </Text>
      <Text AdornmentStyle="-1">Cát</Text>
      <Text> dive off the cliff and into the sea. They transform into horseshoe crabs and swim off, becoming shadows in the fog.</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="7d3e2a5a-bc96-4fcb-b90f-81cdcd186ff2">
      <Text Style="Underline+AllCaps">End of Play</Text>
    </Paragraph>
  </Content>

