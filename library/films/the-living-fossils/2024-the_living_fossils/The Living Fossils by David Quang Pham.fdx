<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20241117T042414" id="fca4576e-d56d-4a24-a56b-d3a1cc53dda2">
    <XRef DateTime="20241117T042405" id="d9e4a862-33c3-4655-be89-51b71d2b8a57"/>
  </DocumentRef>

  <Content>
    <Paragraph Type="New Act" id="375b3558-11a1-42dd-88eb-72eede9d4ead">
      <Text>Act I</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b53e684b-e39f-4b70-ad6f-f9f416f6a244">
      <Text Style="Bold">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="aa24a6d5-2a2c-45ae-bc01-1e4e06dbda89">
      <Text>Red River in Vietnam - University of Chicago, Early 2020</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0e7c07e1-da00-44ba-b9d9-2ae95ce5e0b5">
      <Text>In the shadows of the Red River, a mother-daughter pair of </Text>
      <Text Style="AllCaps">mangrove horseshoe crabs</Text>
      <Text> swim together. A puppeteer maneuvers this 16-inch adult and her 4-inch baby.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b2b364d3-16e4-4f01-a36a-1652ab87e601">
      <Text>Meanwhile, at UChicago, </Text>
      <Text Style="AllCaps">Cuc Hoang</Text>
      <Text> - a biochemistry PhD student in her 30s - speaks with </Text>
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Style="Italic">(pronounced: “meh”)</Text>
      <Text> on</Text>
      <Text Size="10"> </Text>
      <Text>a</Text>
      <Text Size="10"> </Text>
      <Text>horseshoe-shaped</Text>
      <Text Size="10"> </Text>
      <Text>phone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea0e69dc-4a28-491f-9154-79c4a9e4c784">
      <Text>The puppeteer could be </Text>
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> or the phone call could be pre-recorded.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="458bf9bb-55bd-4448-900b-24db7790716c">
      <Text>CuC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25540e6d-89ab-40eb-9871-27190f376efa">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc den</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Dirty water”)?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1be1bcd2-fb3f-44cb-a9aa-0f7f1e0afe81">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="58039246-2af6-45d6-a9cd-d337ccc6a791">
      <Text Color="#00000000FEFE" Style="Italic">Dung</Text>
      <Text Color="#00000000FEFE">.</Text>
      <Text Color="#00000000FEFE" Style="Italic"> Nuoc den</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Yes. Dirty water”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2c08bbde-a3ae-4df0-82cd-bcfad89b1442">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25540e6d-89ab-40eb-9871-27190f376efa">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc</Text>
      <Text Style="Italic"> (Viet: “Water”)</Text>
      <Text>- The water sure is dirty.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="79b0a47b-7cfe-4861-9a2b-21f1c3fbcda1">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c530c47-2b1c-4380-a4b7-0792a0584d30">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc My ban </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">thiu</Text>
      <Text>  </Text>
      <Text Style="Italic">(Viet: “America is dirty”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea60e848-5e58-4830-a3a5-4250b0ead576">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25540e6d-89ab-40eb-9871-27190f376efa">
      <Text>If America’s dirty, then why fly here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="709b2271-c72b-4146-8e1e-641ed5fe461e">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="85623f7e-beeb-4328-912d-b52243513127">
      <Text>I can’t swim. That’s why I fly. And ya </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">tieng</Text>
      <Text Color="#00000000FEFE" Style="Italic"> Viet</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Vietnamese”)</Text>
      <Text> is dirty.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="92af9aa1-35f8-4a9c-9e7c-195395920e2e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e81fbff-fda4-4e91-8916-f399bac0b5df">
      <Text>Dad no longer speaks it. He’s no help. I- I can’t help it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b767946f-48ef-494c-82a9-79213b43b7a1">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="751339e5-df82-44e2-977f-f80796ad5982">
      <Text>Only I can help ya. But ya two never visit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e17c3f8a-4d45-400f-94d8-9311691f76c9">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e45dc823-a053-4dad-b8f5-8abf0f08eda1">
      <Text>When you see Lake Michigan for the first time, I’ll consider revisiting the Gulf of Tonkin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a3932b2-5b20-4736-b117-64754034bcbe">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2f50e95-f6a8-4b7f-ab87-7bc978602b6a">
      <Text Color="#00000000FEFE" Style="Italic">Vinh Bac </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Bo</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Gulf of Tonkin”)</Text>
      <Text>. But, there’s this very special pond in </Text>
      <Text Color="#00000000FEFE">Haiphong</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ef9a05b-5b82-45c5-b29d-2cd160f5f6c0">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="51f576f6-78fc-48b2-b71e-dd9569db703e">
      <Text>You could’ve shown me before dad took me away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34b3d446-923a-41a7-830e-b97c8e944db7">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08674557-af1d-45e9-a065-901692aed4ed">
      <Text>A 9-year-old would not be ready to face my 10-feet friends.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a9bf27dc-d337-4b20-b844-3cf98a2eb58c">
      <Text>The </Text>
      <Text Style="AllCaps">horseshoe crabs</Text>
      <Text> flaunt their 10 legs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ef0c2aa-80b3-45df-b0bc-352219a18abf">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="31e85fd8-3014-4cfa-a735-e2845188fd6e">
      <Text>10 feet? No one can grow that tall. And when did Vietnam start using imperial units?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f805e45-dc0a-4a11-8ffc-b1b5bf64362b">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="502dc350-428a-4a7c-b8bf-e02fe9b1317d">
      <Text>Yards, miles. We’re 8,000 miles away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="41a8d106-cefc-4b44-a693-aa8b415f085a">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="31e85fd8-3014-4cfa-a735-e2845188fd6e">
      <Text>My lab measures in metric like the rest of the world. No feet here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="31fd0712-838b-46cd-98a0-c5235bd61d48">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6b45ebe-abb6-4b85-a424-29b88b778de9">
      <Text>And no face. We see ya not for a long time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1cf71fbe-3306-4a65-855b-c9e6cd820b55">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68823648-29ff-482f-b37c-d31e88301873">
      <Text>You’ll finally see who I’ve grown up to be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83cadd00-cbce-4d30-9bf4-25f0e98d9772">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8dad22bd-be5f-4b30-a310-da39525caab8">
      <Text>When ya introduce me to uh?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a56037bd-d59f-4ab8-b91c-483e02e0c68c">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="19347029-bd85-4efd-9e5e-e9f0ee36e46a">
      <Text>Introduce you to what? The Chicago Bean?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7acec9be-7927-42c9-8dcd-cdf8f401a3ee">
      <Text>The </Text>
      <Text Style="AllCaps">horseshoe crabs</Text>
      <Text> swim under a manmade bean-shaped structure.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49c77fc6-3b97-41df-a4e0-cc2068538d46">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd8bf66e-f2c1-4849-8298-1daebe7e43d4">
      <Text>Ya single for the rest of ya life?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="04c79759-6548-47a9-802b-1a334d6a74fd">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c1812be-5ab0-444f-b40a-aec5645393ce">
      <Text>Oh, come on. I work in teams!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a238189-2b16-4ce6-8359-7489c58e72b2">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f6eb7d21-2fad-4459-8fd9-7838285c5859">
      <Text>Not what I mean...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="04c79759-6548-47a9-802b-1a334d6a74fd">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9b4d042-6c0e-441b-bc36-8e591cf1641a">
      <Text>Finding someone is just not in my </Text>
      <Text AdornmentStyle="-1">DNA</Text>
      <Text>. Besides, biochemistry is what anchors me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cb65af32-73d6-45ac-a4a6-5af3be61b919">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f70bc88e-c056-43a0-9e94-ea62487ab372">
      <Text>Just don’t let what’s </Text>
      <Text Style="Italic">current</Text>
      <Text> take ya away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b9e5ce0a-4901-4363-b9f4-f1c0d9db9d1f">
      <Text>The </Text>
      <Text Style="AllCaps">horseshoe crabs</Text>
      <Text> follow the current into the unseen darkness.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a15d9f68-d57e-4a67-9695-e7592de941b0">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f126ab99-846e-4c4b-bd4e-69280c7124c4">
      <Text>2020 is- Ugh. Well, when you get here, it will be just you and me. I won’t bring up the world.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cc91ca7a-66c6-443c-a0e9-0e4680e76d54">
      <Text>From the darkness where the horseshoe crabs are hidden, the things </Text>
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> mentions bringing (algae, mollusk shells, clams, fishes, and crabs) are tossed out into the open. These are what horseshoe crabs eat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="39fe7f49-d4c4-4966-af01-f34f521aeefe">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b0e5df1-3c09-4cbf-bb7f-2c5bf4da2333">
      <Text>When I land here, I bring </Text>
      <Text Style="Italic">you</Text>
      <Text> the whole world. I bring </Text>
      <Text Style="Italic">you</Text>
      <Text> algae. I bring </Text>
      <Text Style="Italic">you</Text>
      <Text> mollusk shells. I bring </Text>
      <Text Style="Italic">you</Text>
      <Text> clams. I bring </Text>
      <Text Style="Italic">you</Text>
      <Text> fishes, </Text>
      <Text Style="AllCaps">crabs</Text>
      <Text>!
I bring </Text>
      <Text Style="Italic">you</Text>
      <Text> everything but...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bf37eed-2068-44d0-b5be-f277ffeaf6b4">
      <Text>CUC &amp; </Text>
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61bafea9-d568-4495-b35b-25e51d68c636">
      <Text>...peace. (Laugh)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9648f7e1-2684-48de-8212-171cfa1e5ef7">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5007818f-ad16-4819-bb68-329a8223266d">
      <Text>Never change, mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a31d3002-a516-467c-95ec-8688e677ae81">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> (Phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0684297-d9c6-452a-86a7-5f2416844dd1">
      <Text>I need to- (resonant cough).</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5690618f-7f49-4cb7-8949-8c38e32eb4d3">
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> coughs. Anchor drops. The phone hangs up. Beep </Text>
      <Text AdornmentStyle="-1">beep</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">beep</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">beep</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="95733d4a-e4a9-40b9-8972-eb15a87694f6">
      <Text>Lights on in the darkness. An anchor has crushed the </Text>
      <Text Style="AllCaps">mother horseshoe crab</Text>
      <Text>. The </Text>
      <Text Style="AllCaps">baby</Text>
      <Text> tries desperately to save her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a9aae38d-d167-41fb-b5d2-3f9421440e61">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ef5f0dc-aa91-4ed5-8f32-615e606b0d9d">
      <Text Color="#00000000FEFE" Style="Italic">Me</Text>
      <Text Style="Italic"> (Viet: “Mom”)...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c3a644e-7558-4f9e-b33b-d62e373b3c1b">
      <Text Style="AllCaps">Cuc</Text>
      <Text> abruptly storms out.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="53a44b9f-db2d-46d1-91ef-193de8b7a400">
      <Text>A dim spotlight stays on the </Text>
      <Text Style="AllCaps">baby mangrove horseshoe crab</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1bd38ea6-6a6d-4135-b55f-033271ec9c22">
      <Text>COVID-related news reports are audible. Fast forward to 2028.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69ab3159-85bd-4ed1-a78e-b84512622628">
      <Text>Anchor (Radio)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="14589b20-52e0-48f2-9583-cb1b1d3a6e52">
      <Text>Our nation’s 2028 E. </Text>
      <Text AdornmentStyle="-1">coli</Text>
      <Text> outbreak now ravages the Big Apple. The case was first reported in Paw </Text>
      <Text AdornmentStyle="-1">Paw</Text>
      <Text>, Michigan from the recalled </Text>
      <Text Style="Italic">Monkey Smacks</Text>
      <Text> sold in January and February. Despite the ongoing protests against another recent spurs of government deregulations, the plant in Battle Creek is ramping up production.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69ab3159-85bd-4ed1-a78e-b84512622628">
      <Text>Anchor (Radio)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="14589b20-52e0-48f2-9583-cb1b1d3a6e52">
      <Text>The public has no confidence in pharmaceutical companies to keep this national health crisis under control as they’ve cut corners for their bottom line. To make matters worse, bacterial endotoxin tests are in short supply leading to compromised medical equipment, drugs, and biological products. We go live to Dr. Cuc Hoang and her team of researchers as they issue a press release in light of these developments.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d54df87e-20c5-4dd7-8e0e-f5b5e84c22ed">
      <Text>The 4” </Text>
      <Text Style="AllCaps">baby horseshoe crab</Text>
      <Text> grows into a 16” </Text>
      <Text Style="AllCaps">adult horseshoe crab</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="54a784e1-c7c1-4e82-9414-c9e53ff2e19e">
      <Text>Cuc (Radio)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d54b6a6d-2e9e-40d4-aae8-81f5f2f451cd">
      <Text>We cannot make light of the situation. At the start of the last pandemic </Text>
      <Text Style="AllCaps">8 years ago</Text>
      <Text>, our programs cut corners to grant many of our PhDs. And just like that, we’ll face this epidemic together. To be transparent, our team of researchers have poured our blood, sweat, and tears... But mostly blood from countless limulus </Text>
      <Text AdornmentStyle="-1">polyphemus’s</Text>
      <Text>. The International Union for Conservation of Nature has now categorized these Atlantic horseshoe crabs as endangered species. For the time being, it is not in our jurisdiction to process any more lysate for LAL testing. But, I ask the public to not worry. There are Pacific imports awaiting us. We will move the / needle</Text>
    </Paragraph>
    <Paragraph Type="Action" id="87f43a9b-6e32-4414-9fea-2eca9f64c67e">
      <Text>A net-like shadow looms over the grown </Text>
      <Text Style="AllCaps">horseshoe crab</Text>
      <Text>. Someone steals her away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9474ac17-215b-4888-bf56-3be0e58ab103">
      <Text Style="Bold">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="aa24a6d5-2a2c-45ae-bc01-1e4e06dbda89">
      <Text>Animal House Facility in A Biomedical Lab, March 2028</Text>
    </Paragraph>
    <Paragraph Type="Action" id="20dc529e-640c-4f74-8ed5-d2c614ab205a">
      <Text>A </Text>
      <Text Style="AllCaps">mangrove horseshoe crab</Text>
      <Text> is on display. They go by </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>. The horseshoe crab is barely an adult and acts as though they are.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e79f6e2c-5795-40b1-a6c3-161733be87e0">
      <Text Style="AllCaps">Cuc</Text>
      <Text> enters. She looks at the clipboard and reads.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83619cd8-51cf-4555-8254-93316f000aa1">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4f30a53-58a5-4af7-a081-125118f9f7b0">
      <Text>Haiphong, Vietnam. Estimated birth: 2020. </Text>
      <Text Color="#00000000FEFE">Me</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a8d19665-53d2-4903-b023-c761cb12d873">
      <Text Style="AllCaps">Cuc</Text>
      <Text> does not draw blood.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bcb807ae-1706-405e-9158-dc9c2418e1f2">
      <Text>Four days pass.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a8d19665-53d2-4903-b023-c761cb12d873">
      <Text Style="AllCaps">Cuc</Text>
      <Text> finally decides to draw blood. She grabs a syringe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5ed1a923-54a6-4cec-ba53-4caedd2773cb">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="133cff67-5268-46b6-bf7d-da5f8560c05d">
      <Text Color="#00000000FEFE" Style="Italic">Mau ban</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Dirty blood”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4a8f84d6-7c91-471a-9952-5b5f6cb2e73d">
      <Text Style="AllCaps">Cuc</Text>
      <Text> falls back and accidentally stabs herself with the syringe. She puts herself in the corner.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1d19fc5a-bba7-4358-a1e7-707ba25563a2">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8a92bc9-5cbf-4b6e-a288-8fd9827719f9">
      <Text>Dirty blood?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00bf974e-059f-49be-a14c-371f315606aa">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75317e72-dc4b-4298-a8c6-072d8931dcd3">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc den</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Dirty water”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b291b307-0d25-4d5a-8bd7-b1e310399b48">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9da34d3-5d20-4926-b0f4-e2f945464cbb">
      <Text>Bloody hell, you actually speak.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d5e0ddb1-6c3e-4583-a5d7-c7fd7762bd12">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f1b57243-577e-4df9-ab38-613cb9b15394">
      <Text>I’m surprised I can as you’ve dehydrated me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea234448-8b5e-49e1-bcc0-d4c613eec543">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0804d07a-d43c-4c88-9c91-8697b72fca73">
      <Text>Horseshoe crabs can only survive four days out of water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00d0f7c0-d6cb-4545-a1f3-1b763a0c065d">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="729f950e-1398-41d3-8ebe-70ceb5ed2ac8">
      <Text>What day is this?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a0ede24-28ea-4c38-9754-c3e9cd1d054f">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="76496e04-147b-46a3-bce0-bc57256dc307">
      <Text>Day five.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fc0b05f8-58fa-4ecf-89e8-80fc2e088d51">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e1bb628-5fce-4a5e-9b18-380807d910ed">
      <Text>Five?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c3559a9-3410-4155-8578-fb4a3c7fd0fe">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d2bd17e-5e94-4b77-8b29-2e6fe67598f8">
      <Text>I’ll get you water!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51977637-e0bb-4d6d-96ec-0300cdf66cb9">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e610d8a0-049f-476d-80bf-066ecce94a8b">
      <Text>When I do, I’m gonna claw your eyes out with my ten legs!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0961daaf-56b4-486d-8c8d-7718761beebb">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6f38d500-9a4c-4d18-9c85-6b58f6f8bdcf">
      <Text>Don’t test the water. Now, tell me how are you doing that?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="040f958f-a098-49de-94ca-17f9256b9bef">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="494c5364-08fd-49bf-8c83-a9343d3c8974">
      <Text>Well, I just take my ten legs and dig them into your eye sockets.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="160b018f-acea-4a8e-be37-c42000e5939e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0f85aec-f63c-4b3b-aeab-532151caa7dd">
      <Text>No... How are you speaking without a mouth?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f50dc1c2-9be3-4750-87e3-3139d321e123">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="beff9f15-a900-4605-a368-fb1e5c603a80">
      <Text>I assume we both have brains.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4a6e82a-339d-4825-af33-fecdbe2b9041">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4ac254c9-b805-45ea-a34f-16ce439de470">
      <Text>Yours hasn’t evolved.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0adbab10-4912-49f1-bd81-80dabd418527">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b08545fc-7648-43c8-8f94-1630cca4a858">
      <Text>Excuse me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="42b81791-442b-4f38-bfa1-60fc61dd480d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d98a0630-0690-481b-87c6-423dcdb1f168">
      <Text>It’s not a bad thing. Actually. Homo </Text>
      <Text AdornmentStyle="-1">homo</Text>
      <Text> sapiens have de-evolved.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="523b32e0-8490-469c-8e1e-d32f5d878e9d">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2502dc5-bc7a-4e07-bb87-bc07dc760e51">
      <Text>You troglodytes are so hard on yourself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="550c5cce-5ac5-4c6f-b869-6b86d6deb268">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fbd82bea-abc2-42f2-a085-1098ed3cff60">
      <Text>Take it easy with the insults, trilobite.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2f6474b7-772b-4639-9179-cf382a57a155">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a6131433-4e66-4d5d-8564-5963785cbb49">
      <Text>Bite me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="44d8ef91-c9e5-416c-a7b0-5af8e4a6f1e3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="404150e2-e875-483f-830f-0895de771f06">
      <Text>I’m vegan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6bd4e26d-f765-45a7-9d91-8b002220961f">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f55f2d6-4816-4235-9e72-5a6b7345ffa7">
      <Text>I guess humans have really de-evolved.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="339719d3-c6c6-4759-8260-cb4bc8975ec1">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f50426a9-8b6f-4340-89f8-a4db9e09e1d2">
      <Text>We’re more than eating animals.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a422657-24b5-4ad1-962e-498e920cf268">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc824756-b586-4e50-84dd-9df3593b9bfa">
      <Text>So vegans eat plankton.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a840a89b-6c31-4c20-8763-2850d40631ec">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2dfcef58-ca2b-4f3d-b0b5-fd846f9fb994">
      <Text>I’m not pescatarian.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5541df66-f388-4960-aef4-cde1e9407fc2">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d2aedb5-bcc1-4fa5-a2c8-5d5d97f7f5ca">
      <Text>Then why does it smell like death here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0839d2f0-a492-4b36-bd9e-625221af022f">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2695c15-a163-40aa-820a-22c60ad120a1">
      <Text>You don’t have a nose either.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f02c6ed-c010-4742-a3a1-e62ee774e252">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac5f1aeb-eca3-4251-bca0-f9a455b909fb">
      <Text>You look like death.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bdb406d0-64b5-49d3-bbcb-8046cf4ca867">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2b3d7740-9824-4114-a89c-c05ed5734e23">
      <Text>It’s all part of the job.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb026e6c-e046-4c63-afb8-0bb1a2819ba7">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ace8eef-87e9-4a1a-b58a-6329a7b7b8e0">
      <Text>What’s a job?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b636004-4848-4bb3-b6db-c506c33f2b7d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2bf9806e-6de4-4f11-920b-97951f5658b4">
      <Text>Things you do to make money to trade to live.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16afa450-77d3-4cb2-82e6-012cfab9a05a">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9d792e17-7073-4d6e-9294-5c361f5771c2">
      <Text>Well, I’m proud of your um... imagination. I, on the other leg, work for my food. No middle man or middle crab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="205887ab-5646-4f6c-9931-8c0faea05ae1">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="959cc4b1-ce02-47e5-911c-5168cc1cf561">
      <Text>You eat the nastiest things.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84e91d41-37ba-4258-8d5d-0784f0dffb84">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="17d8713e-4ee8-4350-b439-0f4478345c7c">
      <Text>When I was home, I ate the whole world. I ate the algae. I ate the mollusk shells. I ate the clams. I ate the fishes, </Text>
      <Text Style="AllCaps">crabs</Text>
      <Text>! I ate everything but...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="056d0a9a-387c-4bca-85f1-6fde0aa3bc46">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="5fc841af-d0a0-4014-b249-313020decd58">
      <Text>(Remembering)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4c9dc53b-793b-4143-9c03-c2cc5e438dea">
      <Text>Please, stop-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="103783c9-df54-418f-b5eb-f5396f6012a9">
      <Text Style="AllCaps">Cuc</Text>
      <Text> forces her hand on </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8f8f0bb8-a0a0-4d8c-ae96-6ae31a6d311d">
      <SceneProperties Length="29 7/8" Page="8" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="CUC">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HAI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ME HAI">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text Style="Bold+Underline">“</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">The Living (LeitMotif)</Text>
      <Text Style="Bold+Underline">”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b5dfcf83-a817-47c1-8a48-815afe1c4c99">
      <Text Style="AllCaps">Cuc</Text>
      <Text> is transported to that special pond her mother took her as a kid in Haiphong, briefly. She lets go.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="2502d682-05c1-4175-bd10-512b8da4c672">
      <Text Style="Bold+Underline+AllCaps">End of “</Text>
      <Text Color="#00000000FEFE" Style="Bold+Underline+AllCaps">The Living (Leitmotif)</Text>
      <Text Style="Bold+Underline+AllCaps">”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bf121c94-ff94-412a-b267-037ff7f4102c">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69ba238a-beea-43a8-a783-cb7d6b02a37a">
      <Text>You’re that crazy human.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="05490dc3-013d-4983-ad0d-0c898aa02e0b">
      <Text>The syringe is still stuck in </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text>. She is dizzy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f22bbdce-053b-4807-b8f0-d1acefedafc9">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="494e3a5d-0e81-4ac8-bb3b-0c309622bc85">
      <Text>(Breathing heavily)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6c56f1f-cd0a-4e67-8e98-8b152d623980">
      <Text>Crazy is an understatement.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9cc9b718-7d64-4143-960c-f3771599dc61">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5c5ecdc-705b-4f2d-a93d-183d5cf8d7f0">
      <Text>No, no, you look like her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="89cd91f8-7964-4ce7-ac6e-b487342f8db3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="28673ed4-2ff1-48e8-aeff-874546ba6646">
      <Text>I look like any other Viet?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30dcafee-6a5e-44a8-a2ec-a54e90b6aece">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f159ccb1-7732-4d55-b566-dd272e1ca788">
      <Text>You’re special here in this bright cave, troglodyte.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a91195b-e9d6-4203-ad21-7231f293953d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62e03774-2b86-426f-898c-7291f705c3f5">
      <Text>It’s a lab, trilobite.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8946b215-e06a-4152-9df8-cbbf260d7aa2">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15b206d2-6d4b-4d80-9129-3405b2572464">
      <Text>The other creatures in the lab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b06ac0b-1cf8-4430-9df0-4ec0df199693">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca18c31c-bd1e-467d-b503-2ef2fc60285b">
      <Text>My subordinates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c8a1497-e8bf-4fc9-aba2-e34dbb32d328">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a735a5ea-172b-47e6-bebe-2a80f3dc9e01">
      <Text>They don’t like you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="089faefb-c194-4187-b8fe-81f63991607f">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="50c571b7-2d09-4cbb-b67e-b771376756f8">
      <Text>Of course. I’m their boss. No one likes their boss.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b6d3791f-d064-4376-b3df-97c522b5df7b">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0ceec3f9-4a55-4f7f-a91c-60f9471af73d">
      <Text>You’re not a predator. You’re a prey / just like me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a25bd67-1e1f-4ef0-bd7f-477c0207129d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="186c08ae-a3dd-47a0-9d67-4f8b34769d53">
      <Text>/ Pray you don’t get in my way from / saving</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bfbb04b-9d43-43fb-8b55-84eb5a5a914e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f575783-54e7-436f-9cbd-3c0c0960c9f7">
      <Text>/ Ya can’t save yourself. Ya hurt. Aww... Ya got a boo / boo</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f2ba574-61cc-4354-96eb-11c76eef04e8">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83398466-eaa1-468d-a029-949c1de117d7">
      <Text>/ Don’t speak to me like a child- Wait... you / talk?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bee7f1d9-3efe-43bb-a379-2d5f5cc25176">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7913f7e5-0e5c-46b9-b73d-c2fd2a40d747">
      <Text>/ </Text>
      <Text AdornmentStyle="-1">Dat</Text>
      <Text> needle seems to not belong in ya appendages.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="583597b3-1080-42ac-b588-3cc271a95253">
      <Text>She painfully pulls it out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fd184f99-d5ea-42e6-9361-c8d3ca4a7d89">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="daa28388-7e8f-41b6-ae9c-5284cdecb3d4">
      <Text>Worry not for my skin is a hard shell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="38c821d3-0339-4ec1-8842-bf3771757136">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="96e04838-ceb7-473d-bfbf-57cfd57fc381">
      <Text>Ya speaking my language.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c6ad7d4-790e-43e9-a04c-ccd03ffc0d93">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3dd85b4e-2b75-442a-8b42-299b60f4734d">
      <Text>I wished I spoke Viet more than I have- Wait- Am I tripping?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="faad4813-9d91-49e0-8721-226aceb4b4f0">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42e83f7b-57bd-41d2-87d2-e2a486c38c16">
      <Text>Nah, </Text>
      <Text Style="Italic">I’m the one who’s </Text>
      <Text AdornmentStyle="-1" Style="Italic">trippin</Text>
      <Text>’: Hanoi to Taipei to Seattle, now New York.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a6010f71-454a-4920-8ca6-8807ba763132">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f6b2109-ad48-4c5d-9891-0b6f55b71c55">
      <Text>I’m </Text>
      <Text Style="Italic">talking</Text>
      <Text> here. How are you even doing this?!</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="6e8954f6-ad6b-4935-b52d-36a3a6f4f4f5">
      <Text>(Motioning towards her own moving mouth)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f6b2109-ad48-4c5d-9891-0b6f55b71c55">
      <Text>You got no teeth. Not even a jaw.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2ab06f55-b8ae-43ce-94c3-8e879e789b90">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc1b3162-f17b-43cf-9156-60b158e54dc0">
      <Text>Welp, ya made in my image. Ya jaw dropping.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="361bd17b-9fff-479a-8c2a-8704f9193661">
      <Text Style="AllCaps">Cuc</Text>
      <Text> defensively aims the syringe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="44ff87ab-a170-4453-aa09-787e88dc61aa">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29cbcb34-703e-49f5-9e7d-7fb48619bb87">
      <Text>You ain’t my kind. Let’s not get off on the wrong foot.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20646b03-7f4c-4e74-8544-d93f892d6541">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15482f26-485e-4f6f-91a2-a218c4d26f3b">
      <Text>It’s rather hard to pick da right foot when ya got ten of dem!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1715cee2-80e3-48a3-ad21-0bf784b9923b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c478d884-b18f-494d-8313-535c2bee09ac">
      <Text>Horseshoe! You’ve got ten seconds to explain yourself. </Text>
      <Text Color="#00000000FEFE" Style="Italic">Mot... Hai...</Text>
      <Text Style="Italic"> (Viet: “One... Two...”)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="499cf48c-1b46-40ca-a32e-0aa39dd1f463">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="deb0cb7d-9c70-486f-b7c5-1cfab31fdf83">
      <Text AdornmentStyle="-1">Dat’s</Text>
      <Text> where I spawned!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c0cf8cf8-b75c-4a36-99a6-15293a4553f6">
      <Text Style="AllCaps">Cuc</Text>
      <Text> reads the clipboard then stows away the syringe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5b5cfa23-15c4-49dc-b9cc-1821ec783d40">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f19ae8c-c6d6-4492-98de-ded943acdab8">
      <Text>Hai...? Haiphong?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="66f80aa4-5046-4b83-bb13-6b857191c952">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="949f962f-39eb-4d51-8f10-3db90e85ea9f">
      <Text>Be careful where ya put </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> needle. It’s sharp.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="690bfdf1-b9c2-4536-ab3c-3a8f8a765b32">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d412197-354e-4e84-9af1-89da2b40814f">
      <Text>You’re not my mother.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69fc906b-8d1c-4c37-aeae-25b8d6eec84a">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08ff0f15-f11a-4a2e-9659-5c402142d379">
      <Text>Ya sure as sharp as a troglodyte.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7587ec38-1058-4c0a-825d-9bca10a2c30a">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f005467a-7738-4d46-a08c-f92ee07dd0c5">
      <Text>Wannabe trilobite!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e8b0bcf-2b25-4f41-8397-0e7a083078bb">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2c6035d-e784-4dc2-a189-3eb51bd1f6c4">
      <Text>Bite me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9ea9bc8-2811-43bb-9063-0f58bc815b03">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2a8d4d03-2238-4db3-ad2e-7cd0715adc3b">
      <Text>I’m vegan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c935a1e-3395-4302-b768-26010d6aabbd">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ecb73a42-5809-4933-a6b8-b383d7f3dab5">
      <Text>So, you eat plankton?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f90481c8-56ca-424f-8726-29b0a5ea2a01">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b46e3bd1-ce66-4890-bf9a-6b655d7bd4a4">
      <Text>That’s pescetarian. You’re not worth eating.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1f0dee36-1e50-49b2-a60e-5532271c844c">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68f9406e-9e9e-493f-9343-e14b962d644f">
      <Text>Pesky. Why not? My digestive tracts contain the whole world. It has </Text>
      <Text Style="Italic">a</Text>
      <Text>lgae. It has mollusk shells. It has clams. It has fishes, </Text>
      <Text Style="AllCaps">crabs</Text>
      <Text>! It has everything.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="99feb44d-24e8-49de-8036-a466d7801237">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5139d8df-e352-43f9-96e3-c5d33f530b56">
      <Text>But peace...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c493f348-3774-482d-9cc6-754737df0ba8">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7a9490ae-1016-4808-bb1f-81ad697fa674">
      <Text>What brings ya peace?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c13d93ac-df8c-442c-a2f3-ca83f4c2e59a">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8b9bf5a-5685-409d-95aa-9572ff798dac">
      <Text>Not this city that’s for sure.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c1b489f-cf9d-4591-bb2d-4394a23ee7e1">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fd1c9f26-28b0-47ef-9ff1-10df9db84008">
      <Text>Do ya have a pond ya like to swim in?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6dc7ebae-f79f-4d45-9a49-745362e8361d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="11768cad-f1e2-466d-8012-efdb3f4519b6">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc den</Text>
      <Text> </Text>
      <Text Style="Italic">(Vietnamese: “Dirty water”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5924c442-822a-4dd4-95fc-e8b2a40a48d6">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac0b921b-1287-494a-a904-41333aa9d127">
      <Text>Dirty. My kind of water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91c8017f-7e01-4aff-aa86-53581d92be6b">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ae86d759-ce06-4f1f-a93c-1aae064b8c95">
      <Text>How often does one of my kind set foot in your waters?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49cb84e9-e117-4114-adb4-5a30b46f13c3">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b3863698-96ec-4833-83ef-05db2549f232">
      <Text>Not often. But my community has a legend of this crazy person who kept laying her appendages on my fellow “trilobites.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff081c6d-7ab3-4ac9-8f56-abd7de1979f3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b70c90d-0115-454d-b6a6-85953898bc30">
      <Text>Where is she?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f85f4e2-a910-4e1b-8d46-be8941855af2">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="990ef02d-50e7-4581-b3fb-8d920c0224bb">
      <Text>I don’t know. She left before I hatched.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ef45949-3bb9-4842-9271-abf0bf49e42f">
      <Text>CuC</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="edff4d59-077c-4a3c-8504-3967692c42cc">
      <Text>(Reading the clipboard)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9c69fd7-4cbe-48f6-b582-3fbc20b4b8ec">
      <Text>Born in 2020? Mom...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5dff753-2d7c-4dbf-bcf2-db0f5045f1cd">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="64f38da4-330f-4bcd-bc81-bf3c281ff665">
      <Text>Speaking of- I </Text>
      <Text AdornmentStyle="-1">needa</Text>
      <Text> return to my motherland.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="776c261c-90fb-47a6-948b-36564775e2b5">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b58da6f-853b-4432-8f5a-e9c805551a61">
      <Text>Not without your blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="39d0cae4-98a0-443e-80e4-9df6f4d7cde9">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20702d72-171f-4703-968b-91d423557406">
      <Text>Ew. Ya speaking like a shark.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="653fdecf-7f09-44f6-aae3-9d107e3ffc89">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0970956-26fa-4b8a-b500-bd838fb0c3b1">
      <Text>I’m vegan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8cda7a12-9770-4ba5-9f36-18ea01d5deec">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7b36c9eb-bbc3-4ef8-add0-a8035c122a92">
      <Text>Whale sharks eat plankton.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c40f4cf2-955f-4fe7-ab3b-032ba0704ec3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0970956-26fa-4b8a-b500-bd838fb0c3b1">
      <Text>Your bloods not to drink.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78eacd40-3146-4c3d-97bb-e3fbc986ef9b">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="690ffbdd-7373-4e50-bd17-18590416ccec">
      <Text>Are ya gonna wear me like a hat like dem sea mammals?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de629554-fe44-4517-b6c9-376582f11681">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c36bc3f5-a48b-4118-b448-ba5cecbef0c3">
      <Text>(Laughing like a dolphin)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e122892d-598e-495f-b283-61864c6f3d0e">
      <Text>Ha </Text>
      <Text AdornmentStyle="-1">ha</Text>
      <Text>. These drugs, I may as well be a dolphin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b40d185-9ada-4c77-adb9-5af0f7d466a6">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="68c39e76-f910-4f51-9e0c-6bc25ea7abd7">
      <Text>Where is this pond?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2540a568-a37b-44b1-adda-dae9d9567536">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db45968b-be97-4a47-a0ae-60f63209f52a">
      <Text>Haiphong.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2dafe096-602a-463c-9a01-e58717bc0fac">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e9f283f6-1017-43a2-8c30-d61c1978b986">
      <Text>I know that. Where in Haiphong.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff6ab935-40fb-466d-8351-50d86db6dea3">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9ce9fb5b-4807-49f8-97ea-884075a5fa81">
      <Text>In the dirtiest area.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8b1de0d-b896-475e-ace2-9b3cf167c7ad">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2bcbdc7c-c6f9-43af-9a9b-a11ba1920a28">
      <Text>That narrows nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a38d0ae9-809b-4a89-b6ae-8324b86ac8b1">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b7a62ab1-3ef5-4343-ba3c-92921b2a18a3">
      <Text>A creek from the Red River will lead to that special pond. If you take me back, I’ll lead the way.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b00a8bc8-d6ec-402a-8c3e-8e88978fbd59">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2bcb6438-0392-4772-8d7a-55f829790975">
      <Text>No way. We need your blood first.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c8b9e8b-8bc8-4344-ae1c-edfe2766b190">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9102c673-d71a-4cd4-b0ab-7dc1823a942e">
      <Text>Mind your own blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="91f52803-900c-4c7c-820f-f738a6b5e18c">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dc711266-01bd-4848-9d7a-e61582b38e8b">
      <Text>Your blue blood is our goldmine in medicine!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96984ffa-8e6a-428b-b1b6-6f44c3839ba3">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd472327-e908-4218-8c9a-d574dc8b98f1">
      <Text>Well, I can’t show ya where to go if I’m dead.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43356b58-6df3-43cd-a084-774d8ab57a96">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="17fead60-1289-4758-9f2f-40213bd0d90a">
      <Text>You won’t die.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6b197035-a3b5-44ca-b761-8089aac7c60f">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="96949055-128c-4f2c-9a3a-05fd2b01267f">
      <Text>Can ya say the same for the horseshoe crabs that came before?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61463183-b05f-4b8b-8bc7-455c2d1bb133">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b80ff4c7-60c4-4af9-89d1-652121fd59e9">
      <Text>They-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d2b11b3-1250-4839-8392-77c54aa64759">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93abde28-b42c-4fb9-8e25-81d9a5a2872f">
      <Text>I smell their sacrifice. The stench of it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="224458d8-0299-4c85-b510-f61c9ce96989">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf921b80-fbca-467d-8336-eb84ac9eefdf">
      <Text>You have no nose.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d62dc2da-bd07-4ce9-9ed4-0b0a4884aad6">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2472debd-6e42-4d0c-a782-8e1be43caf3c">
      <Text>I’ve got eyes. Ya need to clean those blue blood stains.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32c1cc2e-8d80-48f6-90dc-f3ce43c732fa">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32983c4d-a76a-4248-91fe-186f1a9ee980">
      <Text>Many didn’t make it on initial samplings. But, this lab has improved our methodology. These early Atlantic horseshoe crabs were unfortunate.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2afd5694-3068-45e1-92e6-59ccb0533e80">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4f7d686-7bae-45f1-ac2a-c987fc001da9">
      <Text>Ohhh. </Text>
      <Text Style="Italic">They’re Atlantic</Text>
      <Text>. Why didn’t you say so? Atlantic sea life don’t matter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="efa55ce6-f18e-41a3-a6bd-cab13c083431">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d6ac6ee8-ec4d-4c7c-b87d-17fd536721b3">
      <Text>Does that mean I can-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="471f4cdf-8f67-4977-80bf-abcddce871dc">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="087fdb32-1dce-49dd-86d3-868b6661b03a">
      <Text>If you want to spill blood, spill mine at home.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="90cd37d7-5015-4e10-8f9b-7e4b2170713e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c3b5f043-cfd5-49a4-96be-b95de3165d46">
      <Text>Your home...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7fc860a1-78bc-44c9-bcff-355fbc359776">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af5a1863-9d2c-4d5b-a8e8-cd3490800f77">
      <Text>Yours. Cuc.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1aff2b88-e0f7-45fc-a540-b9add0d0472e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="80b344d2-d432-4f1c-8285-841187173276">
      <Text>My home is here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69caf039-8fbe-406e-ad9a-f334e11e1ebc">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d608df98-31c1-4dc6-8b26-4a48c8f27542">
      <Text>Troglodytes started in a dark cave and now live in a light cave.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ff0a417a-f8d3-4ea7-b527-a7af53562397">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d34f60bc-37dc-4839-ba85-d280dd22ef35">
      <Text>I don’t live in a lab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c44f5dfe-4a35-4075-9b22-f270a061d367">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eb2114ad-e75e-4e48-9720-f883195c861f">
      <Text>Ya fellow lab-dwellers don’t seem to like ya.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c2965c7d-c80f-4860-b046-4c2df778a920">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d2a63b0-9a56-40a4-8c3a-5ba09393f920">
      <Text>My team? There’s no bad blood amongst us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c901466-67db-4276-938a-0587cb0c955a">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5d796be-e4d7-4cc9-aae8-a37fe3d7e3f6">
      <Text>I got word they’re gonna feed ya to the sharks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b4773ba-d0c1-437d-87ce-f6ba74badd51">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c8bf33e9-575c-43e2-b94d-b5c7e4b6ffa2">
      <Text>It’s an idiom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="775cbcc7-c1b1-4504-a7f0-d50e07379628">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="689fa575-ee28-42c8-a443-46ee995b4d59">
      <Text>Idiot. Ya just like me. A prey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1ac0b268-bb86-4d66-9eae-23cdb97434b3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05a6356c-5da0-4fea-b5b8-a4937c45dd2f">
      <Text>I’m no prey.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="39051c83-16ab-4ec6-96ca-5a37842ed953">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2087799-9d63-4f61-9bdb-e6ddaefead77">
      <Text>Is there an idiom for stupid vegans?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b78c74e2-a83a-45c5-b64f-7262e08a2f23">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6bff139a-9b95-4bb1-8a41-0a8066223ee9">
      <Text>I’m reconsidering my diet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="80c4bd94-797d-4de8-b6b4-1025e983a1ab">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d3e2d619-3559-44f3-9782-8e8a9ad9a9c3">
      <Text>And so is ya ecosystem.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e2dcfaaa-988a-43ad-a3e2-32e1483e9fd4">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba73f62d-366f-4ee1-b1a4-9bceeb8aa8bc">
      <Text>If this lab wants to replace me, they better replace the mobile health vehicle first.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="07b799fd-1ad5-4ed8-b9a7-93c912df1876">
      <Text Style="AllCaps">Cuc</Text>
      <Text> drags away </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30a4341e-78df-40c4-afad-e4d316b67a40">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e8b4b0c-bad9-4151-9083-ae9bbd2c8122">
      <Text>We’re getting </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4200874c-7148-44d6-9938-b215be2c2e28">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7c2eb28a-7be9-4d6c-962f-7228d2a8b701">
      <Text>Ya sure out for blood!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="07b799fd-1ad5-4ed8-b9a7-93c912df1876">
      <Text>The lab transforms into a car.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93bda9db-36ac-4246-a3fe-2d4e3008c4e8">
      <Text Style="Bold">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="15c60340-714f-492f-b228-a2d0dba9fd8e">
      <Text>Vehicle driving out the city, day, March 2028</Text>
    </Paragraph>
    <Paragraph Type="Action" id="86ba7777-26c8-4b50-bc9f-f7125a731fa8">
      <Text Style="AllCaps">Cuc</Text>
      <Text> sets </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text> in the passenger seat. </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> drives.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1e27f24b-1bf6-4429-a6d8-91abb61966f1">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0836b72f-c0cb-49bc-955b-9324d93a9bae">
      <Text AdornmentStyle="-1">Ahhhh</Text>
      <Text>!!! We’ve been eaten by a crocodile!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dfe0bee1-d69c-4633-ad2a-004d83184101">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="df8bc180-bdd6-4d63-a2a8-95cac2a40999">
      <Text>Relax... We’re inside a car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="81c68cc3-d2be-4933-b936-e0f2fb2b5eb7">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba5bd431-ece3-4d9f-a409-5aec9aefee12">
      <Text>Where is </Text>
      <Text AdornmentStyle="-1">acar</Text>
      <Text> taking us?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="920f7377-b508-4552-9623-0c7a2d0b031b">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0b24540-3435-4ae0-81d9-8abfe48f41c0">
      <Text>The Pacific to be specific.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe35625e-e2c3-4e83-b3b1-49e4cbecbf7a">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b49051f0-9884-4747-8d0e-c38b8d0d2f05">
      <Text>Are we there yet?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b6c996b5-6656-4cfd-88fc-c1a8414406d8">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf71db12-69a5-4c5a-90a9-df9781b55783">
      <Text>It’s going to take several days.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="36a74ebe-171d-4e45-8fc7-9c0f627de9a0">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="44659be5-04a1-4d1a-9983-c5ba11656732">
      <Text>Will ya let in some nature sounds?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1a2d519-e476-4bd0-b0b6-3228395cddc3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27f93006-bc4e-49ad-911b-c9666613d261">
      <Text>Mother Earth's </Text>
      <Text AdornmentStyle="-1">Plantasia</Text>
      <Text> by Mort Garson?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f7b167a0-274e-49ec-8e43-8f30bd9da48e">
      <Text Style="AllCaps">Cuc</Text>
      <Text> plays the Bluetooth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="470519d8-fc15-4b7e-86ae-035fc95865cf">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f893cb84-7646-400d-93f6-4b24522b3913">
      <Text>That’s out of this world.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fe1e5b1a-7d01-4a86-9255-627ab75e2ac8">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f4e2e93f-04f3-40cd-8c0e-06c3c9fe0045">
      <Text>Seems the one thing we share is musical tastes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cde50517-1ea2-44a5-8207-d6eb2a9b7de8">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9411a7a9-58aa-41ba-9f2b-3ea620dbbf41">
      <Text>Ya vegans have horrible tastes. This music shouldn’t be in this world.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="37c81f6c-5294-4c89-8e15-a9b9ac7e7518">
      <Text Style="AllCaps">Cuc</Text>
      <Text> switches songs. David Quang Pham will write a short punk song that repeats “I hate you.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c0cd449b-6b10-4b57-97f5-21ff4cdde06e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="48f9bead-a6d4-43fa-bc4e-5ee00e120470">
      <Text>(Disapprovingly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f105b5c3-fd77-41d4-9f68-a191c1a9d524">
      <Text>What is </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4945eae5-4242-45ff-bfff-5be7138d8006">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86419b5a-ba2b-48ad-bdea-d731d5179b9c">
      <Text>Spotify?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="699d018b-8691-4f98-8cd0-34004aa0ff8e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1fbd056e-f3c8-4a6b-ae65-d01f80979244">
      <Text>What animal genus is </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="747bc5de-759e-4dd6-891a-dd8e62c66893">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="691c5cf3-e388-4a47-bac0-ce005035c4e4">
      <Text>It’s an app.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="876b3476-02dc-46f8-b9a3-19ed42e13ad4">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93e8c3b1-5007-4314-a1ce-84a721825607">
      <Text>Appetizer. Ah, a prey I see...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a1d2cbc-cf26-48fe-bf4c-e41dcdaca70e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="075d033e-d38a-475c-bdfa-f698275f204e">
      <Text>What do you have against punk?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9eabd03f-3aa0-4ad8-a3af-88c7bb638a6a">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a064effd-37f8-48d8-b5b1-f1d1634cba4d">
      <Text>Whoever wrote this has no ears.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ba543a8-dabd-4b23-b475-f5c8ead5bf1f">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c79cc7cc-299e-4202-b607-6d1b2c6e0407">
      <Text>This artist is apparently Vietnamese American.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa1b0f27-9327-40c3-b626-17d33d217bac">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c30c29f3-646b-49a0-820f-3720daac958e">
      <Text>(Motherly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d79a2517-57b5-4baa-9167-4343188c9066">
      <Text>Ya keep listening to </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>, ya will get tattoos, then join a gang, and it’ll be da end of it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e97f0937-a082-42ae-9d57-3e0dfbe2172e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4848416b-4cb0-4755-898d-ab28063a3ccc">
      <Text>What could your gang possibly listen to?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="175536c0-616a-48f2-82a9-41d4ad5f6174">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32c4761a-2761-4a16-b781-2c85e5fa70e2">
      <Text>I know my Viet. Give me Nguyen </Text>
      <Text AdornmentStyle="-1">Thien</Text>
      <Text> Dao.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b5d0e8a0-29f5-410f-ae14-10569a8ebd03">
      <Text Style="AllCaps">Cuc</Text>
      <Text> types on her shell phone and searches up the Vietnamese-French contemporary classical composer and shows the screen to </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="184bfabf-91b3-42d4-815e-55ba17796fe9">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="78159ceb-9426-4935-8603-746ad2148257">
      <Text>One of his chamber pieces will do.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0040216a-df45-4983-b7dc-0a9a69c7f4b9">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="99469efe-e883-45e5-b296-009849e7ea25">
      <Text>Dad told me this was my mom’s favorite piece. And yes, my dad showed me a </Text>
      <Text AdornmentStyle="-1">cheo</Text>
      <Text> dance moves after criticizing </Text>
      <Text Style="Italic">Paris by Night</Text>
      <Text> for being so commercial, ugh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b62f796-1f86-4736-8f57-a214a36ba711">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52f18c04-566f-4d22-809b-9b75d6f09b5d">
      <Text>How is ya dad?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a26a6208-e0d3-4314-a86c-96a080e8693b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4137c51-6bab-4a7f-a5ca-6b186d055c32">
      <Text>You can never know with him. He’s one in a billion.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f08b6ae1-f7c3-4739-b46f-901d1001d812">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef59b807-86fa-4257-8508-ae9750268ee5">
      <Text>I once was one in a billion. Now, I’m lucky to be one in a thousand. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="7dca7627-a2ad-4ac2-a998-8c11b274d62c">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ffb9608f-ac86-4bdb-a432-193eff446a89">
      <Text>Right... Well, the </Text>
      <Text AdornmentStyle="-1">IUCN</Text>
      <Text> Species Survival Commission can only work with what they have. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="a66413cf-3486-43cc-a132-91a5a618e21b">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9cb0adf7-6e6b-4744-8de2-d02010af3f65">
      <Text>I-U-C-N?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f56deac8-caf9-4619-8585-655c8a7ae3f1">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e053387a-0347-496e-a5a6-d983a3b20b12">
      <Text>The International Union for Conservation of Nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1b4084b-dc7c-4971-9051-66c1daee2778">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="632fae62-d767-4982-a2fb-36af165487d2">
      <Text>Da world wants to help me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d74f001-98d7-4df7-b15a-f693af735e9f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="772f8c23-4b5a-4452-9dd1-cd50618e05cd">
      <Text>That’s an overstatement. Everyone but America wants to help you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33c17ebf-645c-40e4-8482-8d0ef956ff03">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52f18c04-566f-4d22-809b-9b75d6f09b5d">
      <Text AdornmentStyle="-1">Dat’s</Text>
      <Text> what ya dad’s been surrounding himself with... Was his American ideals osmosis to ya?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c2e4a4f-97c6-4b29-946d-a209b61e4f8e">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2c83e17-716e-4977-9b22-834b5e4c10cb">
      <Text>It was more osmoregulation...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9651f1ec-0b85-4ea5-b55c-89bbc6fefa57">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ba4a4d4-94e2-4856-8aca-030f4c49ff3f">
      <Text AdornmentStyle="-1">Dat’s</Text>
      <Text> some salmon shit ya talking about.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ba72966-8e9e-4d54-869d-eff5de0a6c12">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="84cedb3f-76fc-4559-8575-50164af6d659">
      <Text>Being able to modify the function of your gills to pump out sodium ions to counteract the less saline freshwater is... uh... </Text>
      <Text Style="Italic">smolt-</Text>
      <Text AdornmentStyle="-1" Style="Italic">ing</Text>
      <Text> hot.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d92e8e3d-64cc-4288-a655-426e457aeae3">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16568dce-ade9-4754-8ff0-f07799cf9c0d">
      <Text>So, which one is da fresh and which one is da salt?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8a80f0ce-5455-4345-8c06-1fb53fdba6e1">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6e206109-6b16-491f-92c8-4c2fb421a244">
      <Text>Fresh or salt?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c221a54-655f-442f-83ca-233108edf618">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1287dbfc-ba11-46b4-8009-802f8fd8076a">
      <Text>Haiphong or Chicago?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="abc4854a-5067-4664-9699-cf9454dcdc29">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1336d8d9-4671-4c57-b76b-85106291f52b">
      <Text>It’s not an instinct of mine to answer everything you ask.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ace99980-bef3-43e4-9def-41a8f53bed80">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6409be37-9e5f-4821-9b45-90498555b9db">
      <Text>It makes sense </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> you spawned in Vietnamese freshwater before spending most of ya life on da salty American soil.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bd48357-9b5f-4ed8-8d23-9d19170600ba">
      <Text>They drive by the scenery of the Great Lakes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bc0c8c00-be5c-46fa-83e5-aa8ff557e2ec">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f880268-c1ba-4557-8689-062056a43675">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc co </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nguon</Text>
      <Text Style="Italic"> (Viet: “Water has a source.”)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8ede1d99-1bed-4172-a5f6-fcfa740db3d9">
      <Text>(Repeating)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="526d8754-9fb8-48b0-9a2b-88e93f18cdec">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Nhu</Text>
      <Text Color="#00000000FEFE" Style="Italic"> cay co </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">goc</Text>
      <Text Color="#00000000FEFE" Style="Italic">, </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nhu</Text>
      <Text Style="Italic"> / </Text>
      <Text Color="#00000000FEFE" Style="Italic">nuoc co </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nguon</Text>
      <Text Style="Italic"> (Viet: “A tree has roots much like water has a source”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3cc752c0-dcad-4fc0-8533-d70b1ec0f5c2">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c7e4aff-d984-47ed-89f1-bbae423305f4">
      <Text>As you can see, the Great Lakes...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fc58b8a1-dcd8-4a38-88aa-9f5e1379ed85">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a9f6cbc-ace6-4692-bc85-4e71a2477a63">
      <Text>Tell </Text>
      <Text AdornmentStyle="-1">acar</Text>
      <Text> to stop.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63599798-8d2f-4155-8b0f-9ed17a8d6f91">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="78145c0a-a2ce-436e-bb5f-47b92680527b">
      <Text>No chance you leave my sight.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="26d58614-7ebb-44f5-aa87-d6cfa6b7af36">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0324f9ef-9287-4544-8d14-aac03b6449aa">
      <Text>I’m not gonna leave ya again.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b35e259-d08f-4435-aefb-12def906966f">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7b007320-08af-4a62-836a-fe822df3324f">
      <Text>Again?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="704bd06d-7a59-49ff-ac9f-325abb019b1c">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7afc31ed-48c9-4fd8-8fb5-42408a5363f7">
      <Text>Pinky tail promise?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e778582-3cf3-4391-824a-51ddcbece8c4">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01045872-2f4c-4e5b-a3d5-3c13858e7f0a">
      <Text>Pinky tail promise...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="85c23aaa-d00e-4210-b11d-03d8d4a470f7">
      <Text Style="AllCaps">Cuc</Text>
      <Text> wraps her pinky around </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>’s tail.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bd48357-9b5f-4ed8-8d23-9d19170600ba">
      <Text>They stop by the Great Lakes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="08846c6b-f54d-4b5c-93e5-90567cafcaa2">
      <Text Style="Bold">Scene 4</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="077e74c9-1f07-4688-8264-0f3309e1b96e">
      <Text>The Great Lakes Shore, day, March 2028</Text>
    </Paragraph>
    <Paragraph Type="Action" id="57082a62-0be8-4fbf-91c1-9fc7d75812e5">
      <Text>The waves beat the shore.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cc50e44c-66ea-44a2-8c5e-e8c12f317ca4">
      <Text Style="AllCaps">Cuc</Text>
      <Text> carries </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text> out of their vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cef440e2-ad21-4538-8b7d-d655116c0322">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9cd3d451-13f4-484c-bc76-f47748fb4faf">
      <Text>Can ya put me down? I ain’t no cat, ya know?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a562b7d-f61f-43d2-8256-7859376d271f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="62054e03-2994-41da-bb8d-3df1560fb0d0">
      <Text>And let you burrow yourself into the ground. You take me for a fool.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7909216a-ae89-4a96-b540-c7fb009f2ab2">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="066a8073-d732-45ea-975e-2f34ef0bbace">
      <Text>Ain’t all homo sapiens? But, a pinky tail promise is a pinky tail promise.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="97ea445f-72c5-41f5-b254-1b33f5b4924b">
      <Text Style="AllCaps">Cuc</Text>
      <Text> places </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text> on the ground.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ca427567-6c7b-4551-a84d-7fb4d6294915">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f2d2833-c182-4b44-bb17-b14241af69a1">
      <Text>Ew...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6fa07ca9-b3f3-4220-b7fe-4e44d13de82f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="37263c89-dce5-453c-b689-303bffa62d1d">
      <Text>That’s probably what my mom would say.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="564cb87c-1f23-4231-acb1-b3fcc8f4308f">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d2b42ee-4a60-4ef3-b1df-cdfeaee3b42b">
      <Text>She hasn’t seen this?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="497217b6-d84e-4b5c-980a-7dc49c9d0456">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="353cbf50-51d1-47db-9025-947b7711ae4a">
      <Text>It’s not much different from the Pacific.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d2747544-f776-47e6-9617-883292e55dc8">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eea8c5b6-abe2-4cc8-abdf-346e788f7c55">
      <Text>She lives in the Pacific.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d7333146-0f75-47e5-a907-a2627a2a8269">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="92d28107-d5e6-4cdf-9977-c5f83046ba37">
      <Text>Did.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="25023f37-b226-466f-a631-026daabb7423">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e2c1a2d-0bed-4b93-8257-f8f96a23669c">
      <Text>Where is she now?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c99b5c6-e043-4c9d-8f1f-35f6c1bec993">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="76e37f13-979e-4d90-844b-b4de557d5b47">
      <Text>Not here. She almost was here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d27a26d6-8724-4a0c-9aee-503b5aaec1e8">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2712db9-3e65-40f2-a017-76814321cfef">
      <Text>I’m here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="28a3dd5d-8813-4387-ba74-c1666bc29e3c">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38061715-5397-4e14-8f45-a129cfba997d">
      <Text>No, you’re not. Mom is not.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9be55673-771d-44c5-a48a-95c6f36e01c2">
      <Text>Digging is audible.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93494f2e-b81d-4fe8-999f-f43749e62bb6">
      <Text Style="AllCaps">Cuc</Text>
      <Text> reaches for </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5419abab-9559-4699-b0ee-eaf8c48443bf">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0b46dc34-d2c7-4cf2-9204-5bb96b47e696">
      <Text>You little shit!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46949fc2-ac5e-459f-acd4-fd56f5883b56">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="240b8987-8d7a-4225-89c2-98526174fd74">
      <Text>Relax. I’m just stretching! Dis sand is rough for a Southeast Asian horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="59381e77-ea7e-4847-bdf1-1ad30551ac35">
      <Text Style="AllCaps">Cuc</Text>
      <Text> wipes out the syringe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7bc12316-b167-488e-b597-cd996ce19ccc">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7ce637bf-fbb5-4b6a-bcd9-5b5a85824042">
      <Text>With the sand being rough, you shouldn’t have a problem with a little needle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9f235be-3b23-49c8-b1fb-a7da156aae9b">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0d2e571-f3fc-4773-af5b-6e7fea830a00">
      <Text>If ya gonna do me like </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>, can I also draw blood from ya?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c28e737b-c10d-4364-84f9-141789b79baf">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ece5c8ee-a17b-44c4-8bda-c6a99677dc86">
      <Text>Draw from my hallucinations as long as it lasts, buddy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60307b3d-a095-4876-b79b-ddc193ef3a3c">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d2f08e6-d7ef-46b2-927e-5575315bc7f3">
      <Text>It seems indefinite. </Text>
      <Text AdornmentStyle="-1">Dat</Text>
      <Text> drug in </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> syringe is </Text>
      <Text Style="Italic">strong</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="652fd01f-7dea-4a3f-ac8b-28a29dc7a028">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a84c8976-d55d-43f8-902d-5d668610b2d2">
      <Text>A dose is enough to put an infant orca to sleep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e2d602b-89d1-44a1-8e53-4a5a7d168b47">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2989d4c4-5df0-4405-9b2f-ae04d173ebdc">
      <Text>Ya should lay down... Be a beached killer whale </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> ya are!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9273857b-d9f0-4437-8f19-208583e89004">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb8fefa3-d1d2-41cb-b75e-daa477cfb6ac">
      <Text>Don’t call me a whale, you giant sea cockroach!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b6ab53d-dc96-4c13-972b-49a0d47ec544">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b486a3e1-e6c4-4121-a4cf-0417da5d6bb0">
      <Text>Dis giant sea cockroach gets enough sleep. How else are we still functioning and around?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="138be32f-e57e-4cad-a89f-b410e145b71b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c8b9bd4-0873-4d37-be33-6ff2ec7f0405">
      <Text>I don’t function by burying my head in the sand. The public has done that over and over. And now look at where they are. Heading towards impending doom, epidemic after pandemic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7f6b635d-7968-461e-8662-c38de0c50f94">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca99d2be-dc8a-4118-845b-4c7c4a708e79">
      <Text>I don’t know who </Text>
      <Text Style="Italic">public</Text>
      <Text> is, but I say... </Text>
      <Text Style="Italic">Fuck the public</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="64ab57ef-19f1-47f9-a2e1-7e0382b95442">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e19501bd-fc4c-49f9-9646-320d207d0c9f">
      <Text>They pay me money...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2f174b1-f3b9-40e9-b898-5d7a673c107a">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86b3c294-2edf-4f34-a8b2-b81a5334a546">
      <Text>I still don’t know what </Text>
      <Text Style="Italic">money</Text>
      <Text> is... How about dis: I’ll pay ya comfort and protection. </Text>
      <Text AdornmentStyle="-1">Dat’s</Text>
      <Text> tangible.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4b99a782-75c2-4a31-a9e9-9b8b72ae6b85">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5151f999-2cd3-4804-add1-eea6626fae8e">
      <Text>You have a hard shell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="98a877e0-83d0-4808-8f35-6d303a914be4">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="45b5e1c2-ec98-46b7-a30b-9f9ff8208924">
      <Text>It’s not a hard sell to just... be free to bury ya head in da sand for a change.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3b1eebf6-9d96-45a0-83f2-98a0761f840e">
      <Text Style="AllCaps">Cuc</Text>
      <Text> pockets the syringe and lays down on the ground. She closes her eyes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a832f504-1c2a-4570-bd13-c60d6417d37a">
      <Text Style="AllCaps">Hai</Text>
      <Text> now embodies Cuc’s mother, </Text>
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f6491816-2194-4aaa-98cb-4078ba469209">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="43c55db3-9919-4b7b-b6da-477e83d10336">
      <Text Color="#00000000FEFE" Style="Italic">Cuc vang </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">cua</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">toi</Text>
      <Text Style="Italic"> (Viet: “My golden nugget”).</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96115661-715b-4615-af70-e4911e4338c4">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="37b499d3-b183-4c58-81aa-c16ed9280608">
      <Text>(Correcting </Text>
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a644e081-7a40-40c7-9253-abc9cc9b8953">
      <Text Style="Italic">Cuc Hoang</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20d4b80b-a3a8-4eb4-8c09-220c96618092">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38fb7972-df1c-4c05-968f-0098de4b9d25">
      <Text>Child. Don’t correct me. Who else knows ya name better than ya own mother? I’ll be taking back </Text>
      <Text Style="Italic">da golden nugget</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2781d177-e6d7-478b-8e4c-c6ea7df46d82">
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text> extends a hand to </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text>, but </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> rejects it. Instead, </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> stands and walks with </Text>
      <Text Style="AllCaps">Me</Text>
      <Text> H</Text>
      <Text Style="AllCaps">ai</Text>
      <Text> by her side.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4c82dde-3e04-48e5-ab10-7cd2bf985009">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5fdc3a7-c2f8-44f3-9a0b-c97d729bd68d">
      <Text>Keep da compliment... Two feet is so much better than ten. But I still got off da wrong foot... </Text>
      <Text AdornmentStyle="-1">Anywho</Text>
      <Text>, my other complement: I’ve been meaning to ask about ya father...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="87dadbcb-b2a8-44f1-9d93-253806e72336">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="11d9b6e5-68e8-4df7-94b5-7c59db9bc648">
      <Text>Alive and well.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51456d9c-68be-452b-ae36-b31a91275938">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d7f2a1ff-56b9-48e2-9649-b21979667d81">
      <Text>Surprising since he’s always overworked himself nearly to death. I’m guessing you’ve been taking a lot from him.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="15e3fa7f-40f9-4950-bf45-cd9f139702a5">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="55c6d02c-fbfc-4f6e-a4bf-51d622e82fa5">
      <Text>He’s been there my whole life...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea0f07f1-1a3e-435f-87be-3f19cf5b8c01">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9aafe6f7-877f-4966-8347-cb9ed30ab47b">
      <Text>Da American life you’ve evolved into.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a36339a1-bf65-41da-8a7f-73038a0aef58">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="78931a38-87a4-43e4-9b82-18cc5a78b9a5">
      <Text>Evolved?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="76d2af18-e852-413f-bb8a-a5c3c51a4b47">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac74d028-9b02-4848-a025-f976fdfe2118">
      <Text>Yes, and it’s nothing to be ashamed of. But losing ya voice. Ya culture. Shame is an understatement.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7cc0410c-39b9-49f1-887a-34240ace6c83">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3241a858-e059-451f-8fa6-f1b7ccba0af5">
      <Text>I don’t understand most of what your side of the family has to say. That horseshoe crab... It’s the first time I’ve spoken this much Viet since I held your hands.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="63e0b929-e1c9-4653-a652-b75ba57442ee">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dce8feb4-83f5-4eef-bcf5-a0b582294c62">
      <Text>Communication is like an appendix.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2847e2a6-4af9-4794-b2bc-2f795a659d11">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9ddd2b4-002e-468e-ae2c-96494ac72ca8">
      <Text>Useless organ. WAIT. When is the appendicitis coming?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="958129b2-234c-476b-bfb8-1a5ec73e1d89">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="430082ee-1a57-4d3d-9dd8-21ae655d7f14">
      <Text>Burst da bubble when you’re ready.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3cb49915-2b4c-4db6-ac7d-4e5f82696219">
      <Text Style="AllCaps">Cuc</Text>
      <Text> wipes out the syringe and aims it at </Text>
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text Style="AllCaps">.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1582a1cc-9362-48ef-8526-a19f758c1362">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93fb649f-d920-4609-ac66-fab7b689cb59">
      <Text>How could you let your life remain unchanged for generations while the world evolved?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="414418cb-3c8c-4f3f-8b02-d9ebeff37c1e">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4720dcf-627e-4df8-b706-58a734fc68c3">
      <Text>It’s in my blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="358f49fc-4077-4d2a-b847-21e242d3430d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="47c4105f-d985-4089-ab1e-eef91973d966">
      <Text>And now your body wasn’t prepared for a worldwide pandemic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="92068c96-a7a6-4a5c-9b25-a63be2892191">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15ff2512-0b3c-4ac6-adb7-da3654bd74f3">
      <Text>What’s dat weird hermit crab-looking animal dat swims?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b8aefc8a-2542-4e27-baba-8f1adf76ffd2">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c26d332d-8298-4787-867b-8b5e26a75c2e">
      <Text>A nautilus?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4e80bda-8c76-4834-b9eb-66e78bc2777d">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="78171fbe-3404-4fc9-bbcb-0df9b82030cd">
      <Text>Plural?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bbab503d-ee79-4668-830f-52bea513afb2">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5a6a54dd-c6e5-4a13-8e1f-1bf21024e8da">
      <Text>Nautili?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e203d979-aed5-4a6d-97c9-957d3d2f35b5">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="92c3e636-f477-4092-8aec-70f7a1eae680">
      <Text>We can’t all be nautili and swim away from danger.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="70ae9d05-0d08-449b-9f6a-af61c59c1ff5">
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text> sways and moves about like a nautilus. She plants herself and moves like a horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4f2ad80b-66af-4cae-b8f1-e77cbb4e1f5f">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fef72ddd-d815-40d3-9c32-8e742697b0c8">
      <Text>I’m a horseshoe crab. We are born grounded, and so we will die grounded.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0281e716-5a26-44eb-ab26-a1b113f4c36d">
      <Text Style="AllCaps">Cuc</Text>
      <Text> moves about.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="62d78c32-7d2f-416e-8659-2fd26d7b9e0b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42e735f6-1d48-4b63-9c36-79e1614b5af2">
      <Text>Perhaps, I can be a vagabond nautilus sometimes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82b6f039-f33a-4bb8-8001-327355808a58">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f960663-bc40-47eb-8933-6ffc36a12f80">
      <Text>You’re a mudskipper. Ya can breathe air and water. Ya can climb trees.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a64033a7-96b3-429a-a9af-efccf884fcee">
      <Text>CuC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="078a2e00-8a0c-4d95-a627-1834688f0e65">
      <Text>I’m a biochemist, not a zoologist. You can’t relate to me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cd0ba87c-538a-4b65-9cee-18a3af60ad35">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f99e4f9f-ba5a-4b71-a17f-309372e76d90">
      <Text>But... But all animals relate to one another. All life is related to an ancestor, to a common blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="92de05e4-f789-41d3-97a0-f77d551a4dca">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="95caf3a0-248c-4eea-bd73-f46ee849337b">
      <Text>And you decide to be a missing piece in my ancestry.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3ea05910-34ed-41b7-b679-59958d7f76d9">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4de9afe-9959-4487-9adb-1aa8958483c5">
      <Text>I’m da ancestor dat only you’ll know. But you’re on ya way to being da ancestor dat all will remember. I’m da ancestor whose roots are too far and too lost in da mud, but yours will collect da forgotten waters. </Text>
      <Text Color="#00000000FEFE" Style="Italic">Nhu cay co goc, nhu nuoc co nguon</Text>
      <Text Style="Italic"> (Viet: “A tree has roots much like water has a source”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="21807e5b-5399-4cc6-8fb3-4256f2c1cedd">
      <Text Style="AllCaps">Cuc</Text>
      <Text> drops the syringe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="351d453e-0378-4fed-ba66-68a56009e65e">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bbf3007b-2137-4a23-82a3-a32dfeaf0e22">
      <Text>Ya father didn’t raise you to litter!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bce21e5-6278-41d4-8ed4-c36c386c9962">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad083397-6b57-49b6-9c87-1db3213bc1a2">
      <Text>Mom... I’m having an epiphany.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="72f5fc85-d636-44e7-b01f-5f1403438af5">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d25930f7-19dd-48fe-89ab-ee084511b189">
      <Text>Well, have dat epiphany by a dumpster.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="acee3b98-dbba-43a2-88c5-e15447947f70">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="e325ac20-b937-4be3-aa5c-705947bd1145">
      <Text>(Mumbling)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="423427b2-8074-48f9-b845-98a1be2dcc92">
      <Text>Do I or do I not want to have a mom...?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="19d0e2ed-d33f-4af2-bc20-2c1066176d66">
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text> picks up the syringe. She finally holds </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text>’s hands.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="88755ea0-ee4e-4d49-b9ea-45530b74979f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="57fea5b6-a9bb-4c04-ba78-b9c6980fa299">
      <Text>I wish dad didn’t dump you...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e5a325ae-7142-4419-8c38-e3e735a71c0a">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e6c1d39-3259-40bf-99db-360db1088a6c">
      <Text>It was either his daughter or his wife. Imports are costly and he could only afford da freshest of our bloodline.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dec3d225-a89b-41c6-ae36-f9ce33ea9085">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5a457262-55ac-4c98-aaac-46cbede6e153">
      <Text>I wanted the chance to see you again.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf11c986-f2b6-43f5-8740-3dc1fae02f00">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fcab392d-e258-4c27-976d-bc00663a9258">
      <Text>Well, here I am.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db2f4734-c23c-4df0-a5df-aa1b446bfaca">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e935bb1f-011d-4b28-9412-8f930fb6ce36">
      <Text>Not by the cold Atlantic but by the warm Pacific.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac516fa7-e7e1-48e8-93e3-f197cd4a8617">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d025da53-3a41-4a66-9536-2bd9a2c945ee">
      <Text>For countless families, 2020 was da most awful of times. But ya vision of da future should not be clouded by bad blood, slaughtering these poor defenseless creatures.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ac06c5e2-44aa-4245-9543-37045cf101a9">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8776095b-7823-4176-b334-78e1e500953c">
      <Text>I would drain the life out of every single horseshoe crab in the world if it meant being with you one last time...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eccf3994-5e82-4e28-b243-c919b569e9e3">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6109873c-7aa0-4ada-9be1-cdfd001466cd">
      <Text>How many lives do horseshoe crabs have?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="49ede5e7-bf0b-4ef1-be22-bf9a59854c0a">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e07f3be8-6f14-455f-90e2-4b0de26a17ec">
      <Text>Is that a philosophical question?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e237821e-63d9-446e-96ef-20254cf54140">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="88ab7589-fd33-482e-8353-274e3aff02fd">
      <Text>How many legs do horseshoe crabs have?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1765b019-df5c-4786-9fdf-1bb4141eb398">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eba0a55c-e815-469c-8524-ae5bf10a2127">
      <Text>Ten.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0104d79a-d530-42c6-af86-2d76433cb460">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="034fc19b-1f3c-44bd-8578-b78632ad5e79">
      <Text>Now, how many hands?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dabc6177-e41a-4148-803c-3d8101be6f04">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eef13ec2-e44e-4fd7-a456-614da9c86929">
      <Text>They’re not hands but claws and five sets of them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f010400-6dd2-411d-a612-05ca582cf813">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61938d5f-a5b6-497c-9d91-7fe9b956e58e">
      <Text>I’m grateful dat dad raised a sharp-as-claws kid. But, da point is dat horseshoe crabs have no hands to write.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ec10cb4c-2e7f-48fb-a1a8-2c5e6d13db4b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0d128f8c-3472-498a-972e-ad79592d8708">
      <Text>Why would they need to write? They don’t.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2fe9e3ec-9fd2-41c3-a613-2d4ace8c9cf9">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e3e4df4-9a90-497a-8dd0-695e0b931138">
      <Text>But dey need ancestors. Everyone does. Dey need to remember dis and da only way dey have known since da beginning of time is through their blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="057d0eb5-9c86-4955-a8cc-f1d4f6f9b59a">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e171f5c-b7e3-4206-a1dc-a467f0ff2e1f">
      <Text>But the / endotoxins...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea29059e-7cfc-4ebc-b34f-d34e92d8b04b">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1bbc0fab-7c83-4d23-9eca-6db27302fe15">
      <Text>/ End ya own toxins.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="64d9b9e8-2eea-49b4-b965-c72d9a4ff64f">
      <Text Style="AllCaps">Me</Text>
      <Text> H</Text>
      <Text Style="AllCaps">ai</Text>
      <Text> takes the syringe and plants the needle in her chest.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f54d203c-9526-423f-b182-305a5818a7fd">
      <Text Color="#00000000FEFE">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1080f9d0-da87-458c-8988-3cc246e8624a">
      <Text>Hold my blood forever in ya heart for my cells are warriors with hard shells to protect ya against all toxins. And ya four thousand descendants will thank ya for your cells, Dr. Cuc Hoang. I will always be here to give you a leg up. At least ten legs up, </Text>
      <Text Color="#00000000FEFE" Style="Italic">cuc vang cua toi</Text>
      <Text Style="Italic"> (Viet: “my golden nugget”).</Text>
    </Paragraph>
    <Paragraph Type="Action" id="26ba7b0f-1ca2-497c-b4cc-d5383429b2bd">
      <Text Color="#00000000FEFE" Style="AllCaps">Me</Text>
      <Text> </Text>
      <Text Color="#00000000FEFE">H</Text>
      <Text Color="#00000000FEFE" Style="AllCaps">ai</Text>
      <Text> hands the syringe to </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> and returns to being the horseshoe crab </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2e25c2c8-938c-44a7-b72a-ce7c10631cf1">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b40594d-0aca-4e5b-9a43-725aebe7ff81">
      <Text>How does it feel to have blood drawn from ya, biochemist?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f7506d9b-9498-41ca-8cfd-4e5130980021">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f18ba743-ac01-4ed4-a8d5-ed804429af1d">
      <Text>Hai... It feels like a fresh harvest...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6fcc5776-ca8a-4bbf-9464-587f3cbe8a8b">
      <Text Style="AllCaps">Cuc</Text>
      <Text> passes out. Her cell phone rings. She awakens. She looks at the silent horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db86295f-6e0e-4813-9938-7e4e506af5f4">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6e727fe0-a661-4e4b-9fe4-d3400fa28acf">
      <Text>The hallucinations... It’s worn out!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6385f865-9a04-4b82-bdb0-937e8d0100af">
      <Text Style="AllCaps">Cuc</Text>
      <Text> swiftly answers her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cf902ff2-5382-4496-8692-91e88a8fba0e">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d5da0b62-65dd-4f93-80c4-bdbe2a73ec04">
      <Text>(On the phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e284192b-97be-460e-9b17-b6d684d52c8f">
      <Text>I’d like to address the nation! Oh... Morning, Anton... I’m not currently at the lab. I’m just... taking a walk on the beach. Yes, I am well aware that it’s February. You’ve got that right. This is an optimal season for Midwesterners. Huh? Missing? The mangrove horseshoe crab...? </Text>
      <Text Style="Italic">It does not matter</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e411f53c-69ce-405d-a92a-144244c114ad">
      <Text Style="AllCaps">Hai</Text>
      <Text> disapprovingly shakes. She bittersweetly looks upon </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb3cb89f-9b35-4d61-b919-8789d55e798e">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="f6d40ed8-3dc3-4b1c-8c27-fbaa1d61850f">
      <Text>(On the phone)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="24f77dc5-dfac-47e6-8b77-e5a9bc25ac73">
      <Text Style="Italic">She does not matter</Text>
      <Text>. Well, Anton, thank you for being the greatest assistant a biochemist could ever work with. You’re getting a promotion first thing upon my return. </Text>
      <Text Style="Italic">Yes</Text>
      <Text>. Listen: I’d like to use my PTO now. I’m going to Haiphong in Vietnam! I need to take a very special friend home... </Text>
    </Paragraph>
    <Paragraph Type="Action" id="e84d3790-91cb-4bde-a4d8-51140648ccf1">
      <Text Style="AllCaps">Cuc</Text>
      <Text> hangs up her phone. She plays the woodwind and zither movement from “</Text>
      <Text Color="#00000000FEFE">Hon Thieng Song Nui</Text>
      <Text>“ </Text>
      <Text Style="Italic">(Viet: “Sacred Soul of Rivers and Mountains”)</Text>
      <Text> by Nguyen Thien Dao. She picks up </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d2865569-2d9f-4f24-8f25-b25b359b4b38">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="59376d8d-e065-4201-881e-377ddad223c6">
      <Text Color="#00000000FEFE" Style="Italic">Ban thuoc ve toi</Text>
      <Text Style="Italic"> (Viet: “You belong to me”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="05d20681-963d-4eb6-abf2-69e2faa5eac5">
      <Text>Blackout.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3f32834-117f-43a9-b26e-fd9a30d305ec">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0f067c64-bebe-4d0f-a4a5-2a40f0aa3ae9">
      <Text>F</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06a4a213-2f69-4f80-aad0-a3557beba72c"/>
    <Paragraph Type="Dialogue" id="97e9c246-7c59-475a-898c-a5c3fd97cc57"/>
    <Paragraph Type="Character" id="6242f6a7-f90c-45ed-adb4-ddc745674bfa">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="3b24f340-0a84-4a33-8a83-7339262e8a2e">
      <Text>(Reminiscing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="60cd1034-71b2-4468-80b6-6e5d73925054">
      <Text>Hai...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82242341-ba9c-4708-a167-d4a98cde58c4">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fb1bc31f-5d8e-4f13-84d5-df4b676bf7b2">
      <Text>Sure, ya can address me as Hai. As in </Text>
      <Text Style="Italic">ya highness</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="762f00a0-509e-4915-979a-1a982ec16fe8">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e0f60cc-4ac3-42e1-8d02-ad2e8c3f0003">
      <Text>I don’t remember folks from there / being this...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c40a9163-ae24-4c7f-8d64-f7c7ba288ed5">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5c0f7822-cc56-4442-92d5-345940de5651">
      <Text>/ With such hard shells?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c682ca05-e8e9-453e-9928-8328ec614554">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b4a75c21-2643-46cb-b3bc-8dc70de0837b">
      <Text>Your blood is no hard sell.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b3fdb30-854b-461a-95bc-99c342d6639f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="49db9235-5a0f-4fb2-bbc9-29f2f59ab008">
      <Text>That’s the Hai </Text>
      <Text AdornmentStyle="-1">Phong</Text>
      <Text> I know...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2168d3e6-2e8a-4f7b-b79e-8bbab34db40e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="89503c76-e426-4239-bd38-3d8102dba845">
      <Text>Child... Ya know nothing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="127e5f86-f5d2-4ea2-8568-b13c47d287c8">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2ca0c3d-3df5-4b91-8909-9f45b1838f48">
      <Text>Don’t badger me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5599eed4-f69d-4144-96e9-5369d922d908">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4a8570e-7407-492f-9fc2-911972832f99">
      <Text>Ya know what... Why don’t ya team bother da badgers for a change?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afc796d5-60eb-44e7-bd5f-2db5be7fa8a2">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="af32d84f-ae66-44b1-a00c-981f63eca7a3">
      <Text>No can do. I don’t need to badger the warm-blooded.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46160d98-1642-4a7e-a79c-3ee5c7908e3a">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c745686-1821-4e25-a5aa-6b8a690669fe">
      <Text>Ya implying </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> I’m cold.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3842d3a3-9872-4c10-9338-f477e5364976">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4a222550-ba59-4b6e-acb8-aa74e3972661">
      <Text>I’m stating the fact that you rely on external sources to regulate your body temperature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aef23e9a-2172-442e-89ee-95a9834f5f58">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6a27b9d9-a5b7-4e4f-921d-8a58bf01fc32">
      <Text>I’m glad ya inner nature worked out for ya when ya didn’t have anyone outside to nurture ya.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="16116530-7b7f-48ca-8747-99d0db70eaca">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f2481eab-1d89-4b33-92ed-37363837ccfb">
      <Text>Not entirely. I had my father. My bad blood became squeaky clean when I joined him in da states.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee57e757-7582-49c2-ae49-1956c35b2310">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="353330a2-1669-46b9-b9c6-672d48aace18">
      <Text>What was ya filter?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="958222fc-d763-448f-90ff-7bc30130712b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f37c027d-423c-4dd4-840f-e0706216f42d">
      <Text>Chicago was where my transfusion started.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="37d42d11-5013-4bbf-96e6-d4400a897432">
      <Text>(re: </Text>
      <Text Style="Italic">herself</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f37c027d-423c-4dd4-840f-e0706216f42d">
      <Text>Where dad helped this </Text>
      <Text Style="Italic">transplant</Text>
      <Text> blossom. </Text>
      <Text Style="Italic">The classic immigrant-sponsoring-their-family story</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3a6a302-8e88-4bd3-b5f2-18b811e30f94">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f609933f-85a2-47fe-8622-fefe86ec18db">
      <Text>Did you and your father ever have a father-daughter dance?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8536fffa-9cbb-4b9c-8d98-c6d9f8f840de">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4126096a-274b-4f69-874d-4ebe55695fbd">
      <Text>...why would you care?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eacb0515-d727-4263-ab77-1f1b265d699c">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="59155370-2ddb-4c59-9698-f1aecdaec8d1">
      <Text>Invertebrates make da best dancers. We ain’t got spines after all.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1cad909-5cd2-43ab-b33d-6f1a30be74ca">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0a6d6847-5b24-457d-bda9-3d0b78df22f9">
      <Text>Dancing around cowardice...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="69b9d2a3-3b1b-461a-906c-6fdc62797bb9">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4364aa80-25b7-42e8-bc41-b45debcb3287">
      <Text>By da way, does music scare ya?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a6ce72b-4198-4579-a1f6-9840147de095">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1804013e-683f-4232-8810-86eba97df836">
      <Text>No...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="248ebf12-c962-40b8-8e6e-4ac8f9541546">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eab7ad6f-6e43-47cf-b1b9-b8a716af9a3c">
      <Text>Put some on then! Dis lab is more lifeless than a wind tunnel.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dd5bcaac-07f4-4718-bed8-2515d3cbd4d2">
      <Text Style="AllCaps">Cuc</Text>
      <Text> takes out her phone and picks a punk song.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c0cd449b-6b10-4b57-97f5-21ff4cdde06e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="48f9bead-a6d4-43fa-bc4e-5ee00e120470">
      <Text>(Disapprovingly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f105b5c3-fd77-41d4-9f68-a191c1a9d524">
      <Text>What is </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4945eae5-4242-45ff-bfff-5be7138d8006">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86419b5a-ba2b-48ad-bdea-d731d5179b9c">
      <Text>Spotify?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="699d018b-8691-4f98-8cd0-34004aa0ff8e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1fbd056e-f3c8-4a6b-ae65-d01f80979244">
      <Text>What animal genus is </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="747bc5de-759e-4dd6-891a-dd8e62c66893">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="691c5cf3-e388-4a47-bac0-ce005035c4e4">
      <Text>It’s an app.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="876b3476-02dc-46f8-b9a3-19ed42e13ad4">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="93e8c3b1-5007-4314-a1ce-84a721825607">
      <Text>Appetizer. Ah, a prey I see...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a1d2cbc-cf26-48fe-bf4c-e41dcdaca70e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d86e09ef-a5da-483d-8fba-24fdc986c459">
      <Text>What do you have against punk?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa1b0f27-9327-40c3-b626-17d33d217bac">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c30c29f3-646b-49a0-820f-3720daac958e">
      <Text>(Motherly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d79a2517-57b5-4baa-9167-4343188c9066">
      <Text>Ya keep listening to </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>, ya will get tattoos, then join a gang, and it’ll be da end of it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="96e2e48d-9c17-4a4a-afba-99a56f34da31">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9498cfee-e557-47fa-a056-ce9053d5e2e6">
      <Text>Over exaggeration. What taste in music would you even have, swimming in seawater for decades?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="175536c0-616a-48f2-82a9-41d4ad5f6174">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="32c4761a-2761-4a16-b781-2c85e5fa70e2">
      <Text>Give me Nguyen </Text>
      <Text AdornmentStyle="-1">Thien</Text>
      <Text> Dao.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b5d0e8a0-29f5-410f-ae14-10569a8ebd03">
      <Text Style="AllCaps">Cuc</Text>
      <Text> types on her shell phone and searches up the Vietnamese-French contemporary classical composer and shows the screen to </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="184bfabf-91b3-42d4-815e-55ba17796fe9">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d491150-5893-4af0-97da-c8e739a780f2">
      <Text>One of his chamber pieces will do.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cce51618-a8d9-4f10-822b-17913e9342a5">
      <Text Style="AllCaps">Cuc</Text>
      <Text> plays a piece from Nguyen </Text>
      <Text AdornmentStyle="-1">Thien</Text>
      <Text> Dao on her phone. She dances about as though she has a partner.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0040216a-df45-4983-b7dc-0a9a69c7f4b9">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="99469efe-e883-45e5-b296-009849e7ea25">
      <Text>Dad told me that this was my mom’s favorite piece. And yes, my dad showed me a </Text>
      <Text AdornmentStyle="-1">cheo</Text>
      <Text> dance moves after criticizing </Text>
      <Text Style="Italic">Paris by Night</Text>
      <Text> for being so commercial, ugh.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b62f796-1f86-4736-8f57-a214a36ba711">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52f18c04-566f-4d22-809b-9b75d6f09b5d">
      <Text>I love ya dad. I love </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> bout him.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a26a6208-e0d3-4314-a86c-96a080e8693b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4137c51-6bab-4a7f-a5ca-6b186d055c32">
      <Text>Ya wouldn’t know people like him. He’s one in a billion.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f08b6ae1-f7c3-4739-b46f-901d1001d812">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef59b807-86fa-4257-8508-ae9750268ee5">
      <Text>I once was one in a billion. Now, I’m lucky to be one in a thousand. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="7dca7627-a2ad-4ac2-a998-8c11b274d62c">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ffb9608f-ac86-4bdb-a432-193eff446a89">
      <Text>Right... Well, the </Text>
      <Text AdornmentStyle="-1">IUCN</Text>
      <Text> Species Survival Commission can only work with what they have. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="a66413cf-3486-43cc-a132-91a5a618e21b">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9cb0adf7-6e6b-4744-8de2-d02010af3f65">
      <Text>I-U-C-N?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f56deac8-caf9-4619-8585-655c8a7ae3f1">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e053387a-0347-496e-a5a6-d983a3b20b12">
      <Text>The International Union for Conservation of Nature.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1b4084b-dc7c-4971-9051-66c1daee2778">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="632fae62-d767-4982-a2fb-36af165487d2">
      <Text>Da world wants to help me?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d74f001-98d7-4df7-b15a-f693af735e9f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="772f8c23-4b5a-4452-9dd1-cd50618e05cd">
      <Text>That’s an overstatement. Everyone but America wants to help you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33c17ebf-645c-40e4-8482-8d0ef956ff03">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52f18c04-566f-4d22-809b-9b75d6f09b5d">
      <Text AdornmentStyle="-1">Dat’s</Text>
      <Text> what ya dad’s been surrounding himself with... Was his American ideals osmosis to ya?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c2e4a4f-97c6-4b29-946d-a209b61e4f8e">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2c83e17-716e-4977-9b22-834b5e4c10cb">
      <Text>It was more osmoregulation...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9651f1ec-0b85-4ea5-b55c-89bbc6fefa57">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ba4a4d4-94e2-4856-8aca-030f4c49ff3f">
      <Text AdornmentStyle="-1">Dat’s</Text>
      <Text> some salmon shit ya talking about.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0ba72966-8e9e-4d54-869d-eff5de0a6c12">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="84cedb3f-76fc-4559-8575-50164af6d659">
      <Text>Being able to modify the function of your gills to pump out sodium ions to counteract the less saline freshwater is... uh... </Text>
      <Text Style="Italic">smolt-</Text>
      <Text AdornmentStyle="-1" Style="Italic">ing</Text>
      <Text> hot.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d92e8e3d-64cc-4288-a655-426e457aeae3">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16568dce-ade9-4754-8ff0-f07799cf9c0d">
      <Text>So, which one is da fresh and which one is da salt?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8a80f0ce-5455-4345-8c06-1fb53fdba6e1">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6e206109-6b16-491f-92c8-4c2fb421a244">
      <Text>Fresh or salt?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c221a54-655f-442f-83ca-233108edf618">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1287dbfc-ba11-46b4-8009-802f8fd8076a">
      <Text>Hai </Text>
      <Text AdornmentStyle="-1">Phong</Text>
      <Text> or Chicago?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="abc4854a-5067-4664-9699-cf9454dcdc29">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1336d8d9-4671-4c57-b76b-85106291f52b">
      <Text>It’s not an instinct of mine to answer everything you ask.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ace99980-bef3-43e4-9def-41a8f53bed80">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6409be37-9e5f-4821-9b45-90498555b9db">
      <Text>It makes sense </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> you spawned in Vietnamese freshwater before spending most of ya life on da salty American soil.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bd48357-9b5f-4ed8-8d23-9d19170600ba">
      <Text>Beat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bc0c8c00-be5c-46fa-83e5-aa8ff557e2ec">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f880268-c1ba-4557-8689-062056a43675">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc co </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nguon</Text>
      <Text Style="Italic"> (Viet: “Water has a source.”)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="8ede1d99-1bed-4172-a5f6-fcfa740db3d9">
      <Text>(Repeating)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c197c7c7-7113-455a-9928-9ad0b9500dbb">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Nhu</Text>
      <Text Color="#00000000FEFE" Style="Italic"> cay co </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">goc</Text>
      <Text Color="#00000000FEFE" Style="Italic">, </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nhu</Text>
      <Text Style="Italic"> / </Text>
      <Text Color="#00000000FEFE" Style="Italic">nuoc co </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">nguon</Text>
      <Text Style="Italic"> (Viet: “A tree has roots much like water has a source”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="56ffa355-f59d-41f4-8bf2-d59b5b200bbd">
      <Text Style="AllCaps">Cuc</Text>
      <Text> silences her phone and pulls on her eyelids.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3bff6e21-09a6-4c65-b161-e4d88de5bd16">
      <Text>CuC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8df818ee-e659-4a14-a846-f9b3e2e35138">
      <Text>/ This drug has gotten me hearing an arachnid speak in ancient proverbs... Could never be as annoying like when mom did that...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45043e82-14e9-4c85-9f8d-beda7064d3c0">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71818acb-73e5-4c96-a0a4-e773d79d8e2b">
      <Text>I shall bother ya for as long as I remain here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="37186be7-b058-4bac-b007-1747c866be39">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c3c05022-eefd-4501-885a-1e025c67a92e">
      <Text>Be my guest. That’s all you’ll ever be: remains...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="09abce61-532e-45ea-80ec-198eeca9aae5">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9e0291d9-4d35-46ea-be11-8b01bf212f15">
      <Text>Ya don’t wanna believe it, but I’m da remnants of ya past.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33bbb692-aabd-4671-a804-87633865a7f0">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ef2b65bb-f294-47fb-a340-eb1bd12c5cb9">
      <Text>I guess ya horseshoe crabs technically are for everyone here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="42504992-d4ec-4879-8b2e-ea34e31d5074">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6fd4a25d-d85c-425d-a92d-3bb642b0ede6">
      <Text>But you’re da only homo </Text>
      <Text AdornmentStyle="-1">sapien</Text>
      <Text> in dis </Text>
      <Text Style="Italic">lab</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> reminds me a little bit of home...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c549d9a7-0c13-4ff6-984d-c44f2ff5d8b4">
      <Text>Beat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1cb18aab-3a03-4a6d-bb1a-40bdfdd62973">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9331a1a5-19c6-47ae-9fd8-57bd125658bb">
      <Text>Looks like da </Text>
      <Text AdornmentStyle="-1">Viets</Text>
      <Text> get around...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bcc36ba6-58fa-4c30-ae02-b7bcfdd2bad3">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2727af19-712e-4701-b9df-c4273096239c">
      <Text>Our voices are only heard when hard shells like you in leadership shut the fuck up for once.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d82b78cb-6c9b-4f99-b98b-4790229a8970">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="933453cc-6110-464c-86fb-ae0fd87a3b0a">
      <Text>I’d like to emphasize </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> my kin certainly was everywhere. But now we’re as dead as dodos cause ya colonizing / friends got involved.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0c13a99-99ee-4d8b-8504-226f92a90371">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f30a6294-e1e2-43a4-9200-87d051776947">
      <Text>/ That’s what you get for being unevolved...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="909029f2-920e-4541-b740-c31d5dd32b28">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="24d70c11-519d-4f47-9db1-3e1f446dee36">
      <Text>Who ya calling unevolved?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4a26b5f-f33d-49ef-9c61-b8f6a311a155">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a7fe11df-7260-4c3d-984d-0b351eeba363">
      <Text>You’re not a “who.” You’re a “what.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="03af06c8-e4c7-48c8-95b8-7c22ea54ac68">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e9fb1433-19d6-4e3d-a7ed-9692b232c4c5">
      <Text Style="Italic">What</Text>
      <Text> da? Well, WHAT dis unevolved sea rug can do is speak ya language, neanderthal!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ce46effe-c78b-486b-bff1-4a27ef16950b">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e6cb3fee-dafe-42de-ba78-848e77aaddf5">
      <Text>Meandering in the ocean is what got you caught.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1578a4e-d1db-4c5c-aa15-00b9b0a9d465">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d50530f-5eaa-4d67-8fed-dfff37a3514b">
      <Text>Why haven’t I got caught up in a digestive tract by now?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a35e249-8760-4fc4-b9a5-0332354bb0de">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8bf2b606-c7d7-4e34-bd97-d8588daa8f74">
      <Text>We’re not that kind of people around here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8b828c1-a304-41df-8250-f32416faa996">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca87d057-ccb8-4456-9acb-ee1498b089a6">
      <Text>But out of ya team, ya </Text>
      <Text Style="Italic">look</Text>
      <Text> like those kind of people.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="730507ea-b8e4-49f3-ad03-ded881a99f73">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2e8f5ebe-69f0-48f1-aaa8-024e6661f49e">
      <Text>I look like WHAT?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00c5ffbc-589d-4d0b-a53f-2b8d81be2eff">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd044f73-ff6c-4fac-b5b4-365631e1542d">
      <Text>WHO is ya team?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ec791d96-e64a-4926-ad6e-1cbdce9eaa77">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0084774-8a69-42ab-92e7-0a627e6b7b7a">
      <Text>We’re made up of biochemists. We’ve been tasked with ensuring that our medical devices are not contaminated. Your kind are honorary biochemists.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d0af313-d758-4dd1-b1c9-fb5281c160aa">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="58217502-addd-4679-95bc-c8cfa465ae87">
      <Text>Am I ya mascot?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a15ba054-9ddf-4ba7-ac18-8e1bfe2b47bf">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="183cc330-5aee-4e2c-b384-38f38a7b1596">
      <Text>Well, what’s keeping morale going is actually your blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="478ad776-4b48-4316-99e4-c1c0121a5a91">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="558a3a28-7327-43ce-864a-29b82a39b190">
      <Text>What in blue blazes?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1cf5b7d-0212-467f-93f2-0c0b6f0614b3">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="43da669f-cd07-40f8-95f6-9ae7b7c2f1c6">
      <Text>Your milky blue blood.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f356f495-9839-481c-a91e-3a7f2781523d">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e0cc237-9bec-4bce-b624-a4897f050857">
      <Text>What a toxic relationship!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="05fd1384-fcd0-401d-9838-5e7c08fe3568">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b0b612d-e01d-4189-bd6d-ea0b5abc8c6e">
      <Text>Not as toxic as bacteria. Your blood contains fundamental immune cells that are exceptionally sensitive.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1fdb9a8d-df4d-44ba-87d1-08d73d72e5d0">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b1203f5-b9d1-4dcd-89d5-bda480ca4417">
      <Text>Sensitive?! How has my kin live dis long?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e45ef16-ad4b-47d0-9ac2-e3aeedb417fa">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="473cc4ea-18d3-4028-bcb6-e7c49c49dc1a">
      <Text>When your cells face these invasive bacteria, your cells clot around them and protect the rest of your body from toxins.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c5f115a-efb9-4b12-a982-895b29287be4">
      <Text Style="AllCaps">Cuc</Text>
      <Text> demonstrably encircles </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="535cbdfa-d799-4895-8dd3-1bb12373491a">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0084774-8a69-42ab-92e7-0a627e6b7b7a">
      <Text>It is our solemn duty to protect the community.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c6e434c7-051c-40dc-96b5-221aef4f24ac">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="082ef8ab-9b41-40b9-80bd-895a54ca93ab">
      <Text>And I am a part of </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> community.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dff9f593-60d4-47f7-9c8b-af5aa0526755">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="be538f0b-8fb5-4f12-b44f-99bca76cf94f">
      <Text Color="#00000000FEFE" Style="Italic">May </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">tao</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">khong</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">thuoc</Text>
      <Text Color="#00000000FEFE" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">ve</Text>
      <Text Style="Italic"> (Viet: “Bud, ya don’t belong here.”)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ae750dd-5b42-46e9-adaf-2f96a0f1a1af">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b1120dfb-472a-42f1-9a73-483213560d00">
      <Text>Touché... But </Text>
      <Text AdornmentStyle="-1">Carcinoscorpius</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">rotundicaudas</Text>
      <Text> are more alike to homo </Text>
      <Text AdornmentStyle="-1">homo</Text>
      <Text> sapiens than you’d imagine. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="ded4dae8-7a5e-4307-bfa3-a7eb07f102ff">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="180ba15f-4cca-475d-890b-81f7890e0f38">
      <Text>How so?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8a6d54d-d102-4701-acd1-2319ad8f6943">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f58265f-1129-413a-b29e-95369d1d9b6b">
      <Text>Touché, touché... Um, we eat snails for breakfast, lunch, and dinner.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="07ab7339-5e5a-46b8-937e-0a1cf498ed17">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="de0b9c92-0731-4524-bbec-66f1fa04237f">
      <Text>Our partnering lab in France would’ve had a blast with you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1bf2d9e0-b401-4250-a8f3-0f4a4031297e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b58d8645-8a3e-488f-aed1-5928d89298f1">
      <Text>(French accent)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8f5345ce-a639-4ce8-9350-a93263ecf7a4">
      <Text Style="Italic">Please, have MERCY on me</Text>
      <Text>. </Text>
      <Text Style="Italic">I have a family. Four thousand kids to feed</Text>
      <Text>. </Text>
      <Text Style="Italic">Wee</Text>
      <Text>- Do ya have kids?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="202269c9-8d67-4cf5-b4ee-a444b170fb87">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d535fd13-a106-42d6-9227-5ed2680ab22e">
      <Text>Kids, in this climate?! Hah. More humans in this climate extinction, no thanks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="affe71b8-ac90-405c-809f-6a7f492ed09b">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="11ed27f0-b25e-4770-a1e6-2691ca746415">
      <Text>Why can’t ya be like me and breed ya way </Text>
      <Text AdornmentStyle="-1">outta</Text>
      <Text> trouble? We’ve been doing </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> for 500 million years.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1078240-d11f-4426-81bf-3f553c9ce3a3">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f3767af-8002-43a9-8fb6-b4407342863e">
      <Text>Easy said then done. My generation is also facing financial hardships to be able to raise a family.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b582c06b-2a28-403f-9bf8-0837d29bc045">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="127f5c1b-0012-4ab3-ae51-7d3413d3ee14">
      <Text>Financial hardships? Are those da ships ya use to get to ya spawning grounds?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e10253e6-b066-4704-af57-7e7dafd76a7d">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c00e9394-1b94-4909-a3cf-b57108900d91">
      <Text>Finance is money.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="beb35164-d051-4884-b6a1-45352991af05">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6ba46e16-f7d9-4b1b-b33f-0d4327868716">
      <Text Style="Italic">Money</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f0954bb-b12c-43fe-b976-6f9b4d5640df">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="72950f56-f3fd-4bdb-8b55-77627ddadb0e">
      <Text>Money is... Uh...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="25c27a06-75e7-4850-8234-479ce0be1eba">
      <Text Style="AllCaps">Cuc</Text>
      <Text> stares blankly because no one can explain such human construct.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43784a77-c277-43c2-a3d5-6606eaaad63b">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd268cc9-8fde-48ba-92dc-d920a366e9c6">
      <Text>Take it from me. It does not take much to raise four thousand babies. Ya just need salt water and crustaceans and ten legs to beat da living shit out of dis.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4fcb106c-ce0d-43ac-8384-1a8791596039">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fa9c487e-630f-4945-b07c-9b47baed5dcd">
      <Text>That’s what I’m doing to my assistant first thing tomorrow.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="2b0c8ac7-c56e-4ec6-8adf-1edb3c011453">
      <Text>(re: syringe in hand)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="67a6d89d-6c2c-4695-80c6-2bc61766e3c8">
      <Text>I’m now talking to an arthropods because they didn’t put this in their proper place!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de9c30dc-afed-4735-9305-7d6ab7ab9274">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1574fbb3-a937-4d70-8074-fa43ee7b8f43">
      <Text>And neither are you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a191aac3-7760-4f9b-ab20-f33bdb607f65">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38d03f4c-99e4-4137-97a4-ef272897e658">
      <Text>No, that’s where you’re from. Where you were caught.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="194b8853-8992-4b1a-b32c-ea89d66b34e2">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="30cbe8f7-ffbe-48ac-afaa-45347996c0e0">
      <Text>Ya caught me. I didn’t catch ya name...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5e2afa1f-d4c6-4b7c-99e3-0e16b0db9a50">
      <Text>Beat.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="08023826-b4c6-46cd-98d1-b795c74b5fdd">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c28db6ba-5eeb-40f1-b6ad-8858308fec19">
      <Text Color="#00000000FEFE" Style="Italic">Con ten la</Text>
      <Text>...? </Text>
      <Text Style="Italic">(Viet: “Your name is...?”)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b884d1e-a2a1-4ff6-ae7d-d01f97ded0e0">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aa1ef850-70ff-4a87-b384-b7e8191beca2">
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Im</Text>
      <Text Color="#00000000FEFE" Style="Italic"> lang</Text>
      <Text Style="Italic"> (Viet: “Shut up”).</Text>
      <Text> Dr. Hoang. Please call me Cuc.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4b8c0816-247d-4aaa-aa34-5ec4f7e57966">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c320a7b2-3c30-4894-b627-0c1614d9a30c">
      <Text Style="Italic">Cuc</Text>
      <Text>... I’ve heard </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> saying before... </Text>
      <Text Style="Italic">Cuc</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a91c70cb-c440-4326-98b3-4b06e1e64fe2">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5554e974-d8d1-45d7-9c8c-885accd0f464">
      <Text>Mom named me after her favorite national park in Vietnam.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0a17dc47-88af-459b-b53d-23a62fb496dc">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4a71a52a-04a8-4516-8112-4145350cce2f">
      <Text>Does it have a river feeding into another?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d956e7ab-b48f-49ee-ab69-77825284b176">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="42114db8-5b8b-4979-af3a-962f18cabb7c">
      <Text>I believe so.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd446669-d5db-4e29-897e-ac022097ecfb">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03f24684-ec29-4fea-8b5b-7a0b3553a6e3">
      <Text>Ah, I have a friend who spawned from </Text>
      <Text AdornmentStyle="-1">Buoi</Text>
      <Text> River. Oh, how I miss living by a national park.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e363b621-ed72-4454-b147-4793b05a0e35">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e8f977f6-5cda-438e-9200-e35ff7e3e5dc">
      <Text>You’ll feel right at home here in no time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="decf325d-f256-4a14-a4b1-8568ecced3a5">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9c781842-0005-41a2-aec8-27f4f36829ea">
      <Text>Da longest my elders ever lived was 25 years. There ain’t no time to waste!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0371270b-a817-4e82-8f90-273866d80e08">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ceee4fe-02ec-46de-8bad-bc83481de1b1">
      <Text>By the way, being unevolved is a compliment. I mean... a half billion years of living the same routine for generations.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a1b15088-6dcb-4bc9-bdfa-e666cf81a605">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="951163fe-8442-42af-84fd-99b75e52706e">
      <Text>Dat’s a lot of regrets.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d488fd4-42cc-46f5-828c-72f344d7bf67">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c95837b8-4369-47ac-bf6a-94988da4ceae">
      <Text>I’m sure it’s boring, but your karyotype comprises of 32 chromosomes which is 9 more than me. Aren’t y’all creative?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6ff618ed-5459-4281-b848-c90238bdb42a">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="767c9dbc-9880-499e-84f7-57b8f41a9f25">
      <Text>I know chromo, not one bit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5885b6fc-c0cc-4e9f-9c28-3cc6e340409a">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f42b63ac-4268-4e41-9085-39b909f38fcf">
      <Text>You’re characterized by just four extant species. It’s such low species diversity.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1faee90c-e851-4d65-86e2-8e3489bd3a0c">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="767c9dbc-9880-499e-84f7-57b8f41a9f25">
      <Text>Ya say we lack diversity. Have ya looked at ya lab mates?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51024643-7304-4f6f-bdc6-f0569b916c8f">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="beafaef2-914f-4991-8733-101d87ea8c67">
      <Text>We’re on American soil. The fuck do you expect? Now, Hai...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c272ada-29a8-45ed-ba28-30bf1ebd25fe">
      <Text Style="AllCaps">Cuc</Text>
      <Text> wipes out the syringe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="44de353f-6050-4b01-8791-765080e95d00">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b7bba93-e2a2-456c-a902-d4b0ca291c41">
      <Text>Meet freedom...!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="41dec1c6-0d04-44a3-b62f-da48a4b7f491">
      <Text Style="AllCaps">Cuc</Text>
      <Text> plunges the syringe at </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ebf0e26-f9ea-475d-a4bb-d0d1b6d8b9a7">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ae10ea9e-af98-4a12-a13c-3308fb02caa4">
      <Text>Wait!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0c7481ff-e1d4-4393-82ba-404239c1e709">
      <Text Style="AllCaps">Cuc</Text>
      <Text> stops plunging.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afbcf595-dfd9-470b-8255-7067ef568a60">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a768dc8-fcca-441b-b331-94c1e77ed454">
      <Text>The sick cannot wait!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d269b927-cc79-403e-9d4e-5179df5f61a9">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20bb5aaf-0c3b-4d5c-b577-de2027e4336f">
      <Text Style="Italic">It’s ill-advised to leave da Hippocratic oath hanging</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6376ee93-35f9-48ac-a67d-641cab8a5afe">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9ee71dcb-53b3-4078-893e-d07367e06adb">
      <Text>I may work in medical science, but it doesn’t mean I’m a medical doctor.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c98577ea-80d8-41fe-bf15-c29b0f2c2d18">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1acf1cc0-6181-487b-866f-c5bd01a156ed">
      <Text>I’ll recite it for ya. </Text>
      <Text Style="Italic">Ya have da right to remain</Text>
      <Text> / </Text>
      <Text Style="Italic">silent</Text>
    </Paragraph>
    <Paragraph Type="Character" id="de36e6a1-070a-4728-94bb-719c2e3d8db0">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="df88af3c-d81e-4076-8dcb-5fac45fea7d7">
      <Text>/ That’s... That’s the Miranda / warning</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3c50da2d-a298-4a15-b319-25cfd57e2398">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cb800b62-dbd6-4a56-9c31-050fc2dd61fa">
      <Text>/ </Text>
      <Text AdornmentStyle="-1" Color="#00000000FEFE" Style="Italic">Im</Text>
      <Text Color="#00000000FEFE" Style="Italic"> lang</Text>
      <Text Style="Italic"> (Viet: “Shut up.”)</Text>
      <Text> Remain silent!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9ea0226e-fc2a-4c50-b941-7ba399611881">
      <Text>The water filtration systems is suddenly very audible.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb9bde0c-b531-4cf6-846e-3ce8fe63c480">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="edc7560f-2d64-43d4-a6cf-5da52d494197">
      <Text>Hear </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a12735f-4579-449e-a4de-a486fa0629af">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="70499990-3172-4315-834e-06a84bcc3c4b">
      <Text>Hear what?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a560252e-b954-4985-8ea0-2c8cbfe0f4cf">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="0e2faeec-546f-47d5-8e4d-75be625773cb">
      <Text>(Mimicking the sound)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee44e8b6-7914-4a0a-b771-84739fa17c7f">
      <Text AdornmentStyle="-1">ShHhHhH</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">woooooooooosh</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">sHhHhHh</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="77040b7d-63ae-4b51-909e-2bd2a25bc03a">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5c2b5da1-f352-496f-80e7-8006360a0a3c">
      <Text>The lab’s deionization filtration systems...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1ae5814-edc2-45c9-aa67-92f488d807ac">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b2192e1e-c348-44fc-8856-f807a6ce864e">
      <Text>Basically water, right?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="702d8c2a-12a8-45c5-a2e7-e9df239e02b4">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f43dfeec-55c0-45e5-97b8-767b683d9722">
      <Text>All mineral ions are removed and conductivity is minimized to create this highly purified form of water. Basically.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f6579bb-5ed0-4d66-a758-7e5f39a2815d">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eafe58ae-9992-40e5-9b2f-66c47221e3fb">
      <Text>Let’s do a purity test.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8d7474eb-64db-4693-9c86-34c6c3f6bba2">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ebaf92e0-e800-4fa7-9a41-d379083f90fc">
      <Text>That would not be necessary! I have no soul. Now quit stalling, so I can get blood harvesting over with.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="374bb504-0ee2-45c8-9c35-5ec0eda91559">
      <Text>HaI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dac42bea-065e-4694-9125-c8beca5b13c7">
      <Text>Fine. No purity test. I ask </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> if we were to do it... I won’t scream or object to having my blood drawn at da pier.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b8d17c11-ec9f-4eec-980b-463a18dc5a72">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e76c0b4c-9f40-4aba-a064-07a37de0321f">
      <Text>A New York City pier? Drawing blood is going to draw a crowd.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="155e7b10-2dbf-4cc6-aa79-70bc71ee167e">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d5c0335-8ab9-468a-88cf-1ae884b46b04">
      <Text>I’ll also settle for a beach...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1825dc5c-27ed-4ba7-9141-2e036bea5b8d">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b9659aba-1a07-4174-93ee-db0800d69f5b">
      <Text>How would I know you wouldn’t settle into the sand and vanish without a trace?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9e8b752-ad58-4a06-995d-063d4113ee29">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e4769855-1977-480c-9d09-3d7408ab1c47">
      <Text>Ya know I wouldn’t survive ya dirty seawater.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="907f3a0c-23bf-44e5-9e68-319ae4e6c0ce">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd45c0ef-cbfa-42f4-b255-83e6a8293fd2">
      <Text>You got something to say about the Atlantic?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b4c51a9a-f407-4213-9245-7a12c1e51f72">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15d317cb-c804-458c-ab39-ce849184b8f2">
      <Text>Take me there and I’ll shit all over ya nasty ocean.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="499f5b60-fb43-4ef5-ad9f-bd7f50cff1b0">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="889c5844-8551-4d27-9e30-a472093ec630">
      <Text>You’ve got that right.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="88997412-aec1-4967-9993-ab2a8de3f142">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="71a6cfa3-9f89-4baf-9700-ea1712f72103">
      <Text>And I pinky promise </Text>
      <Text AdornmentStyle="-1">dat</Text>
      <Text> I would let ya take my blood and ya pinky promise me a last look at da sea.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b4034564-9e03-49d6-a2a9-da77df906324">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0dc4a96-2bbc-41c9-b6ef-9db868e70efc">
      <Text>You got no teeth, jaw, nor pinky.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="620450c2-e010-4296-a007-b35106ef92a3">
      <Text>HaI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="06fb26e2-8416-4bc1-b3b7-75eab8d0b862">
      <Text>I promise on my pinky tail.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="07eccac3-180e-489a-a71d-a3cddc783365">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8fda5cfb-dda7-4d22-bdf1-888f2e08e7ef">
      <Text>You got me. You win, hallucinations... Time to go to the beach.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2e96a4d5-825f-4f14-833a-fdf6627300ec">
      <Text Style="AllCaps">Cuc</Text>
      <Text>’s extended pinky crosses with </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>’s tail. She carries </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4b17a460-5373-42d5-99fe-6ae88e5e5edf">
      <Text>The lab lights transitions into the light of near dawn.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0b35121d-de45-4799-be8f-b8fd1b34dcd8">
      <Text Style="Bold">Scene 3</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="84bd7289-9ae7-4e3d-9ed4-2ae4040f882a">
      <Text Style="Bold+AllCaps">A Beach by the Atlantic Ocean, Dawn</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f87e2b7-bda6-4120-af9c-a804e83df53a"/>
    <Paragraph Type="End of Act" id="9499d320-e53c-46c7-9fe8-748748d9f2fe">
      <Text>End of act</Text>
    </Paragraph>
    <Paragraph Type="New Act" id="375b3558-11a1-42dd-88eb-72eede9d4ead">
      <Text>Act </Text>
      <Text AdornmentStyle="-1">II</Text>
    </Paragraph>
    <Paragraph Type="Action" id="217a410c-0a12-49b4-95c1-b87c10d77339">
      <Text Style="Bold">Scene 1</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="aa24a6d5-2a2c-45ae-bc01-1e4e06dbda89">
      <Text>Red River Shore in Vietnam, summer Dusk 1991</Text>
    </Paragraph>
    <Paragraph Type="Action" id="95733d4a-e4a9-40b9-8972-eb15a87694f6">
      <Text>The ship anchor in the first scene drags away from view, revealing a sleeping </Text>
      <Text Style="AllCaps">baby horseshoe crab</Text>
      <Text>. A boat’s horn blows. This startles them awake. They swim about.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3cb9bcf3-ed4f-4804-b27d-4bb8172cd15c">
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text>, pregnant with </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text>, runs in. She sees the </Text>
      <Text Style="AllCaps">baby horseshoe crab</Text>
      <Text> in the river and stops running.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="74bca584-9a9b-422d-b9e5-4b0b12370003">
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text>, </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text>’s father, runs past </Text>
      <Text Color="#00000000E6E6" Style="AllCaps">Me</Text>
      <Text>. Noticing that she’s not advancing, he stops and looks back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3d504948-da5c-4993-8004-a71b089d6279">
      <Text Color="#00000000FDFD">Me</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dec88df9-3485-49c0-8195-d1e73ad280ba">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc den</Text>
      <Text>... </Text>
      <Text Style="Italic">(Viet: “Dirty water”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cee37454-22a2-4a6a-b389-33f3bccbdc35">
      <Text AdornmentStyle="-1">Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd7f257e-90f9-4d72-be03-0cf51c613fc8">
      <Text>The boat will lead us to clean water.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="34513789-0897-4fbb-b641-db93053e2785">
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text> feels the river.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6f5ca3ad-ff66-4f06-bf42-4342c9374ecc">
      <Text AdornmentStyle="-1">Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd7f257e-90f9-4d72-be03-0cf51c613fc8">
      <Text>Like the currents, they won’t stay for us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9140980f-3713-4ff6-bc50-4b16a0e0eacb">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e282717-3a2f-47aa-bb56-bcd0b75cd4c3">
      <Text>Stay for us...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3681d906-5c18-4877-bc35-40c072d719ad">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c08150f0-3c94-4d08-a7ca-4d4921e98175">
      <Text>For your family? Mine? Who’s set</Text>
      <Text Size="10"> </Text>
      <Text>in</Text>
      <Text Size="10"> </Text>
      <Text>their</Text>
      <Text Size="10"> </Text>
      <Text>ways?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e7e6ea87-4882-4f3d-ab44-324c9b6b8cb9">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d8d8c0ee-0aa1-4468-849f-d7508efa53e3">
      <Text>The paths we’ve trekked, the streams we’ve crossed, the homes we’ve built are what’s safe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c2120068-c64f-45f1-a69a-dbb793aad8b0">
      <Text>BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b21551f-ff42-48df-9a26-0c9badfa1489">
      <Text>You’re uninterested in a change of scenery. I bet we can get a place in Louisiana.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c4f7fd65-db96-4d6a-a977-f9a459357852">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="18512ff5-d6e7-4a1d-b944-2d7add3de168">
      <Text>We a hundred percent have had places here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7febab0b-4bac-46ea-88a4-d3aac56af2ca">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d4016f75-4c5e-471e-820f-6a03d0ae4551">
      <Text>We’ve got a closer option: Australia.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d8309920-7db6-4630-a01f-55947adf6e5f">
      <Text>The </Text>
      <Text Style="AllCaps">baby horseshoe crab</Text>
      <Text> touches </Text>
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text>’s hand.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d70ff26-adfa-44ec-8a08-705ac0aab251">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5bf705d9-3566-4b6f-9570-ea267f97c89f">
      <Text>The animals and plants are not the same.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3f60ca95-baa3-4dd7-95a1-08fc20c9d18a">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d23e9932-1aa4-4b2d-b7c7-047086ba2755">
      <Text>What do you want?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fde8bdf0-bc3c-43da-ad74-e91d52c6c5c4">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b5702c90-4ef3-46ff-853b-acf49aee1259">
      <Text>(Pointing at </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd0b821e-38a9-4164-809b-3a34d08490c6">
      <Text>I wanted to change for you...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="d5b384e6-30b3-4ac2-a8f1-c242c6784c85">
      <Text>(Pointing to her belly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd0b821e-38a9-4164-809b-3a34d08490c6">
      <Text>I never wanted to change for...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d5bc42aa-65b2-44e3-9287-72b82f3bd8e4">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2ec3c67f-962f-411b-a1fe-e7349bec37ef">
      <Text>We want the best for our child. To be born in the best conditions, around the cleanest water.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d8309920-7db6-4630-a01f-55947adf6e5f">
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text> accidentally cuts her hand on the </Text>
      <Text Style="AllCaps">baby horseshoe crab</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4e800859-1bb0-48e9-a963-2a9965946b05">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9ade1fe4-020a-48b0-b42e-cc510b65a213">
      <Text>Ow! Their water is clean due to our bloodshed. Is what’s “best” right?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c60cdc3-178b-4d37-8ac9-d4bb37598cb0">
      <Text>BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="96a5b756-467f-40c6-b4ad-a930bbf1574e">
      <Text>End these childish riddles, </Text>
      <Text AdornmentStyle="-1">cho</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">bác</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">ký</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “northern dog”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="df0e780b-03bf-4d49-bbb5-3890c96ba63e">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5199bdf-ad73-438f-9ec8-be70730d6baa">
      <Text>Cho </Text>
      <Text Style="Italic">(Viet: “Dog”)</Text>
      <Text>? You care little for our child. The last thing this dog and her puppy needs is to be tragic Vietnamese boat people!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dd9b25ea-d884-4824-97ca-61aa277a38f3">
      <Text>The boat roars.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e54173d-77eb-48ce-bc74-0fbe87002477">
      <Text AdornmentStyle="-1">Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f2862f1-6443-4081-aa79-d911d8052c7f">
      <Text>Stay. Continue harvesting rice like a peasant. Soon. Our child will harness the unimaginable.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1656c1de-0381-441a-82a2-d7e08487f618">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="559e2286-272c-44f1-a6f5-4f57dcfe5012">
      <Text>Hard to imagine you’ll live in these currents to see our kid. </Text>
      <Text AdornmentStyle="-1" Style="Italic">Ve</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">nhà</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Come home”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f9c2f920-967e-4f35-b196-d1c383a0ab7a">
      <Text>Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a7b9b68e-2015-42ed-9cfd-6074d2ef235b">
      <Text>I’ll come back for you </Text>
      <Text Style="Italic">(re: </Text>
      <Text Style="Italic+AllCaps">Me</Text>
      <Text Style="Italic">’s belly)</Text>
      <Text>. Not you </Text>
      <Text Style="Italic">(re: </Text>
      <Text Style="Italic+AllCaps">Me</Text>
      <Text Style="Italic">)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c0e97d68-e854-4358-b929-c7018a87f9e0">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7f38bc06-d6ed-4460-895b-c3ba90509be3">
      <Text>Never change.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fcf8db31-a200-4cb9-be03-8e9caf0bc279">
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text> leaves for the boat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dad4ff72-a856-41e1-b49a-82c188568c69">
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text> takes the </Text>
      <Text Style="AllCaps">baby horseshoe crab </Text>
      <Text>in her hand and transforms into present-day </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="376d0e69-1b79-414f-9d04-f4c7620e1d68">
      <Text Style="Bold">Scene 1A</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="aa24a6d5-2a2c-45ae-bc01-1e4e06dbda89">
      <Text>Red River Shore in Vietnam, Summer day 2001</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7b33e80b-83a4-4b3a-ad0d-c1b4257fe7b8">
      <Text>The jet turbines roar.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7b33e80b-83a4-4b3a-ad0d-c1b4257fe7b8">
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text> pulls in 9-year-old </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> along the shore. </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> has on a knapsack while </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text> wears a messenger bag.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d1338a5a-67ba-4bb9-be2a-9568b8633881">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3b38616e-8b98-432f-9f96-5776cfdadf6b">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc den </Text>
      <Text Style="Italic">(Viet: “Dirty water”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5378d2c2-9383-462d-9fbf-560ff0ddc5a2">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b0d633e-823b-482a-8ff5-a4be641dceed">
      <Text Color="#00000000DFDF" Style="Italic">Dung</Text>
      <Text Color="#00000000DFDF">. </Text>
      <Text Color="#00000000DFDF" Style="Italic">Nuoc den</Text>
      <Text Style="Italic"> (Viet: “Yes. Dirty water”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="84c9a94b-c17a-448f-8b58-5db23b8507c3">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="136bff47-e1e0-43be-836d-14614a36a690">
      <Text>You’ll love the water. The Chicago River. The Great Lakes. Lake Michigan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a4b748ce-e287-4d2e-b698-0b8edac084b1">
      <Text>YouNG CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4d1d2162-c493-4437-86f4-f23dba3df4cf">
      <Text>Red River!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d614c260-091e-4a54-9db7-79840eb13e15">
      <Text AdornmentStyle="-1">Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="456fb847-dbda-46ba-be0a-ed195536208e">
      <Text>It’s not the same, but it’s cooler. Change of scenery. It’s good for you. For a change.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dca52708-2a83-4c59-b43b-7b3c7ec99a19">
      <Text>In the river, a 10-inch horseshoe crab swims in and catches </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text>’s attention.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60009ce0-3e3d-44cf-a501-253d7b5ed7fe">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cc39c686-3451-4e55-8158-9cecdb5da3f1">
      <Text AdornmentStyle="-1" Color="#00000000FDFD" Style="Italic">Cua</Text>
      <Text Color="#00000000FDFD" Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Color="#00000000FDFD" Style="Italic">sam</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Horseshoe crab”)</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a44c7e93-44da-4c3a-9635-1477ebba00a4">
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text> pulls out a nautilus doll.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="59352c5d-371a-44ee-9e01-513db005736e">
      <Text>Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="def093cd-b1db-4837-a1d0-48e8658405e8">
      <Text>Have you heard of an aquarium? They house animals you’ll recognize.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="196c756b-9e7d-436d-949e-6c2af8591c2f">
      <Text>YouNG CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="433324b3-5c15-4c3d-93ef-0ac3e82fa755">
      <Text>Yeah, fake animals!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="779ac3ef-062a-498d-b1a4-60111d700927">
      <Text Style="AllCaps">Cuc</Text>
      <Text> throws the nautilus doll into the horseshoe crab, incapacitating it. </Text>
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text> holds </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> tight.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4fb37930-98ff-40c8-af36-11da4d5d7dd7">
      <Text Color="#00000000FDFD">Me</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c34c2327-e078-4520-95a6-8016e9fb5a55">
      <Text>Cuc. We’ll share the same aquarium someday. I’ll be with you, think and thin, and </Text>
      <Text Color="#00000000FEFE" Style="Italic">nuoc den </Text>
      <Text Style="Italic">(Viet: “dirty water”)</Text>
      <Text Color="#00000000FEFE">.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ec64fd0f-3d94-4285-b0f6-119c3edc572b">
      <Text>Young CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7103194b-4c25-4463-ab78-6937c12daa75">
      <Text>The dirtiest water...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="caedccf7-2ca0-4134-924f-56bee58d1969">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f8836cba-81e2-43f7-9d97-22c5a539415a">
      <Text>Mud and swamp.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4399f307-fb9e-4e84-b7c2-6437777c705f">
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text Style="AllCaps"> </Text>
      <Text>takes </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="43fea2a7-66b6-4e7c-beab-3281f4a8982a">
      <Text>The nautilus doll comes to life and drags away the horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fccc5c95-5c6c-4a66-8d71-cce36517f96e">
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text> goes in the opposite direction.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="07ac0a7d-dc4c-4e78-b88f-bb3455f9f526">
      <Text Style="Bold">Scene 2</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="aa24a6d5-2a2c-45ae-bc01-1e4e06dbda89">
      <Text>The Coast by HaiPhong, Vietnam - Day, 2028</Text>
    </Paragraph>
    <Paragraph Type="Action" id="11d233af-27cf-48a4-8f7e-3cc7e3444e01">
      <Text>The boat roars.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3d20bcc8-61c9-42ab-970e-c8c00153a5ac">
      <Text Style="AllCaps">Hai</Text>
      <Text> swims along the coastline.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c6f3bbcd-6df9-4c23-9fe9-36a9fcb6d4c1">
      <Text Style="AllCaps">Cuc</Text>
      <Text> enters. She tries listening to a silent </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text>. She then pulls out a syringe and injects herself. She can understand </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text> once again.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="01653add-e4b7-46be-9c9b-57b921a5a141">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="cc16792a-69f4-4061-bf39-0b028e6758b0">
      <Text>(Singing to David Bowie’s </Text>
      <Text Style="Italic">Changes</Text>
      <Text>)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c344976-e5b4-4668-ba0d-8fb029a1c883">
      <Text Style="AllCaps">Ch-ch-ch-changes!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b85346b1-9511-4c41-bd6f-55a8c07a1d6c">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c05ddabf-bb77-4ccf-a19c-10b4ef17743d">
      <Text Style="AllCaps">Learn to face the strange</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="20e99423-71a0-4c56-86e3-9db8e4d03071">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20c0bf08-4ad2-40d7-b856-587289855f8a">
      <Text Style="AllCaps">Currents</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6ccbb023-64db-412f-9232-4a0a85998fb0">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b41a1836-f7f8-4cef-a5f1-1fd9ae252724">
      <Text>A mid David Bowie song. Not his best.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7a2052d4-1913-4835-8268-2ff6859493e3">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="abfc718a-e088-479a-ba18-44f70768fc0f">
      <Text>Well, I told ya to pack a charging adaptor. Now ya phone’s dead.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d036a0a7-0479-499b-96b7-2bbe330b0527">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ddd0921f-eab3-4712-a25b-8fa49701395d">
      <Text>It’s not everyday one listens to music on her portable horseshoe crab.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c0ff39b-0231-4f68-be6b-89151a2df3d3">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05612864-b7d2-4c0b-9267-5f9d56b8e035">
      <Text>How was this portable horseshoe crab allowed to fly?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="050cd9f1-2181-4632-b902-16c03ed94615">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13ebb816-d7aa-4c2c-83d6-8c98682fa70f">
      <Text>DOGE dismantled </Text>
      <Text AdornmentStyle="-1">TSA</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7f0f031-14ac-4ccb-a16c-e9cbe61651b4">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="72df81b3-f34e-4d9c-b485-825bfc943356">
      <Text>DOGE? </Text>
      <Text AdornmentStyle="-1">TSA</Text>
      <Text>? Are those parasites?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b46dd7f4-d5b3-4fe2-94e8-9473cedd81ae">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="18d4fedc-f087-4ef5-8ee7-d7db499859b4">
      <Text>You can say that. Airport security’s a thing of the past. And we’re lucky our plane flew.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="decffdba-fb9b-499b-9815-345bc1d5e928">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4962117e-378f-4268-bfc3-9f8820c2e955">
      <Text>Those giant birds are stubborn things...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c1614ec-58ec-4c2c-bb9a-72ab30487721">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d33688d-d3c5-40c3-a341-1865d44f61cc">
      <Text>I’d like to speak to any bird right about now. I have no idea where we are.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73b52700-581b-4dd9-acc5-7d127299fe00">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ac9501b3-b18d-4bec-a69d-3548f4c2c5fe">
      <Text>Let me feel the soil, Cuc.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="909ea693-1d2d-481c-a736-0a22ca83ee33">
      <Text Style="AllCaps">Cuc</Text>
      <Text> sets </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text> on the ground.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3d20bcc8-61c9-42ab-970e-c8c00153a5ac">
      <Text Style="AllCaps">Cuc</Text>
      <Text> carries </Text>
      <Text Style="AllCaps">Hai</Text>
      <Text> on her shoulder. She opens a map from the pamphlet. Viet money and a US type charger fall out. </Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c3b9019-2c74-4274-a218-9c073a757c8f">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="39c45a3a-0865-4b90-baa1-139a6ff0b3d2">
      <Text>It tracks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="92319b2a-89a8-4c70-bc4c-7d099518dbee">
      <Text>CuC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="557ea4d1-de15-4d15-b867-580341d31240">
      <Text>It / tracks?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4d28738c-2fbd-4c81-9ba5-e33391be45bd">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eb201062-4d8c-4ba7-99f1-2c97d1ccdcdc">
      <Text>/ Boots, netting, hand trucks, fishiness. We’ve arrived in Haiphong!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="312eabdf-48c3-4491-9760-ac31e9c2c54d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8cbd8370-50b5-4db4-afa9-50d0afd56849">
      <Text>Duh. There’s signs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22bfc160-9748-4792-9c6d-59440bf35c88">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0b93aefb-9c6d-4747-9a7f-eee6f3004a11">
      <Text>My eyes are not evolved to read.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="82f5ccfd-c7fd-4780-b8e5-a5ab15e080d4">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8cbd8370-50b5-4db4-afa9-50d0afd56849">
      <Text>Welp, you can see that it ain’t as green... as I remembered it to be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="447bff87-ca0b-4019-95de-c926081fbe10">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c0403ba5-da76-4d7c-a851-3447baba5652">
      <Text>Land development.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b4c12fa5-18e1-42c5-96b3-1377e5732857">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2afd17be-de32-410e-88cb-88f00e21c14a">
      <Text>It hasn’t made this map easier to read...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e38a9ae-4093-4160-8f46-b55f888b0523">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b3804da-404d-465d-a01d-fdf043dc8e0e">
      <Text>How about ya get around like me through intuition?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="be57ed21-9d58-4b40-8aca-98bbd62bfdef">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e7ecc70-4e16-45de-a692-31eaf05eb11a">
      <Text>I’ll just ask for directions... Get to know the locals!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="32b8da32-892e-4219-9e26-b2fac30a2be8">
      <Text>HAI</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fbd8aac6-9cb2-4e37-8aa4-c33a77bf147f">
      <Text>The locals son locos.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22bed431-6d3c-4a8c-8936-222b6d57097b">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0cd2edea-9524-4f81-9931-5722f300b570">
      <Text>New York did wonders to you.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="580762d2-cebe-4354-9293-d48de5b8575f">
      <Text Style="AllCaps">Cuc</Text>
      <Text> goes to a merchant’s booth. The merchant remains unseen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a7b7dc9a-25c5-4dc9-95c0-0281fd276d06">
      <Text>Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a1eadde7-9d04-4ece-a412-9d4139aee69c">
      <Text Color="#00000000FEFE">Chao</Text>
      <Text>. Where is district </Text>
      <Text Color="#00000000FEFE">Vinh Bao</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="367cb864-7f24-4585-a69a-2d1c8228bf4b">
      <Text Style="AllCaps">Chop </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">chop</Text>
      <Text>. Horseshoe crab guts are thrown out into the open.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2030dbec-f149-4a90-9bfc-318269102dbe">
      <Text>Hai</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75e4531f-ba97-4909-8ab0-64f17e18279b">
      <Text>Savages! Sisters and brothers and in-between, hold the rubber and salty aftertaste! Wishing you and everyone here food poisoning!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4a4fc05-a745-47ac-8254-97e1b912448e">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9ddb6a7c-89fa-44ac-bdca-3ef576e5cff3">
      <Text>Intuition it is...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0d6a88c1-c0a8-45ed-9f62-0cb868da94d6">
      <Text Style="AllCaps">Cuc</Text>
      <Text> faces the path made from the horseshoe crabs’ remains.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d89181cc-8dd5-40b9-9785-06eb56a9c800">
      <Text>


























</Text>    </Paragraph>
    <Paragraph Type="Action" id="32d7ef67-9cd3-4e57-8554-e48642d5e1d2">
      <Text Style="Bold">Scene ?</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="aa24a6d5-2a2c-45ae-bc01-1e4e06dbda89">
      <Text>Shedd aquarium in Chicago, 2002</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9db48b95-c1f2-417c-8ab0-7725083311dd">
      <Text>10-year-old </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> and her father </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Bo</Text>
      <Text> stare at a model of a coelacanth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1ae6832f-a246-4eed-8af9-4de79b305806">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e2aa1df-1dc3-42e2-8a04-b50bada9c5ff">
      <Text AdornmentStyle="-1">Bo</Text>
      <Text>! </Text>
      <Text AdornmentStyle="-1" Color="#00000000FDFD" Style="Italic">Cá</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Fish”)</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a6aec54a-b0ad-4815-9924-ba6edb8af5bb">
      <Text AdornmentStyle="-1">Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="29311d4c-ebc7-4560-a900-122ee7783852">
      <Text>Again. “Dad. It’s a fish.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4b277f5c-b9dd-42f4-a0aa-d51905e0026d">
      <Text Style="AllCaps">Cuc</Text>
      <Text> points at a placard.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="deaf1462-aa25-45ae-9310-17b7bc39a15e">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16a2bcfe-0b7c-4dfb-9aac-3c6a30b323fc">
      <Text>I can’t read this... yet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d7fe1fcc-e506-42f4-a44d-5e0113a8cc66">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="e12b8ee3-3725-4360-9198-05cca08a8572">
      <Text>(Mispronouncing)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="87908c4f-93eb-44f1-9dee-584fa834fdc5">
      <Text>The </Text>
      <Text AdornmentStyle="-1">coele</Text>
      <Text>- </Text>
      <Text AdornmentStyle="-1">coela</Text>
      <Text>- </Text>
      <Text AdornmentStyle="-1">cole-canth</Text>
      <Text>... Whatever fish was believed to have gone extinct over 65 million years ago but was rediscovered off the coast of South Africa in 1938.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7d9a17a8-eda5-4d3d-8063-37d1571dea0c">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e370bef9-9acb-4c3b-b257-a9986caef585">
      <Text>That’s when you were born!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="78168cd7-b2e6-4d20-b47e-7b8a4fbed01e">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0586680b-b075-4460-9d92-d8c7b5c9c483">
      <Text>No... I was born in 1838. Thank you very much.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cc789e9e-b43a-4918-9a6c-dd76644e8554">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b9ca982-aa71-4309-8835-14b49af6368b">
      <Text>So this fish stinks?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="971ce497-837d-4c6e-87e8-ad701b9ca09a">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2604ba2d-644f-4c1b-9fea-9bfa38b9a7f0">
      <Text>No. They were extinct. “Extinct” meaning “gone forever.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4921a218-faa3-4c84-b2c9-146f2589da92">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="353cac6e-9df2-48e1-91be-1952afd65b4e">
      <Text>I wanna rediscover mom in Vietnam before she’s extinct?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="67631f1c-ae33-477e-b1b5-68d76e2bd18c">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c2db4232-3904-4e73-aed5-eb2c4b2519b9">
      <Text>She’s always a call away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b6cc6328-86ca-4ccd-b0b1-6d1448c08dc6">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="19ef0e1e-0166-40f3-b6ef-4de70c8c680d">
      <Text>That’s not the same. And she barely calls since it’s night and day where she is.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3114227-70fd-4c06-af15-630651cbc0f2">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d120fd37-389b-4592-820c-d54ea60ee3e4">
      <Text>Our phone will be buzzing in no time with the friends you’ll make at school.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="703cac61-1258-436f-b463-3f98dee5b423">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="69194c48-6af3-4300-8f84-a7d1078b4adf">
      <Text>I’m nothing like them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f7e9405c-7f95-418e-b5d9-759e5ce0fe81">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf8f5226-4169-48d6-b38a-a7c19aeb4862">
      <Text>What do American girls like? They like horses. Join the horse girls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3c07855-e953-40d3-aba0-01fbd181f4ff">
      <Text>Young Cuc</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6a1129dc-db7b-45b7-8b0f-a76465a59296">
      <Text>They call me a crab because you keep packing me fish sauce for lunch.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4c608d8a-8e84-4b3f-bb2f-9daf8d67618c">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="67a6b869-ef1a-4172-ada9-d50649ab14c6">
      <Text>Noted on the fish sauce...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c98afe42-2849-4ba7-a9fc-37ddbcb386a4">
      <Text>“The Living Fossils” exhibit is spotlighted. A nautilus, goblin shark, horseshoe crab, and other ancient animals dangle above.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cbd15ec8-0d41-4106-8917-974d3a430e1f">
      <Text AdornmentStyle="-1">Bo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6d4ec74d-1a78-42f1-91b9-325eb33b49a6">
      <Text>Look. That’s my nautilus you threw into the river.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0002c3f2-8d84-4ff7-93f5-5cbbaae3ea6c">
      <Text>CuC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="de022f30-bf7b-4a53-957d-b3cf4f07a3cf">
      <Text>Nautilus?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9863048c-aaad-44f0-8ee0-d3351f518f95">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01d5cde2-14f6-4f9e-ba11-05211047a8ec">
      <Text>The one with the spiral shell. I’ve heard it’s intelligent and native to Southeast Asia.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb5fa1d0-756f-4ada-a9dd-9379e281e355">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ae17b609-6956-414d-9c92-bec599fa63eb">
      <Text>I’m native...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="334d6c5c-dd2c-475a-b3c3-becb2093da93">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d859350b-18ea-4aef-b63c-71513d1e65ce">
      <Text>But native doesn’t live. Facing the unknown helps one grow.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="09bbd35e-1928-48af-bc02-9b4a2d7e978a">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="75b57b7c-5a4d-4a21-b1be-cb5e2965e7bd">
      <Text>I grow the more I don’t know mom...?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="71721745-df4e-4ade-a1e7-53593c599646">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05c3ff9d-a529-41f6-9360-f3decf8801b8">
      <Text>...sure!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f66324b8-fa72-4795-9ff8-dfc15e6ae331">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5a78b02-546a-45ba-ab83-4bdcbca93ef9">
      <Text>Why am I here and she is not?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a57991dd-f49d-4caa-8fd9-9adf90e06d16">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="323df633-3a99-46b8-828a-b7f60ea1a4df">
      <Text>She won’t leave.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b3306c9-06ca-427a-9835-b804da2f65e3">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4146c99d-555c-4abb-adc5-255c48f4a181">
      <Text>You’ll have money to help her one day?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="188430fb-af1b-4db6-b9fb-e5f0f125730a">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3ad635c6-69b3-4e06-bae8-8afff01cce4a">
      <Text>That won’t change a thing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a48f563-77a5-4e1d-859d-40f09072d9d5">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9dbe97b8-ff52-440f-a259-6500f6d999e8">
      <Text>What changes things?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3b400b81-006e-4572-a7b0-538912e2e13c">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5ad96970-3db5-4d0c-8c11-39646d48d695">
      <Text>Education. School.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c7e8a929-66de-499b-b36a-f8bb5a35d024">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0058286f-9010-4b3e-a223-8bfa41d79178">
      <Text>I had school where I’m from.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0324e24b-61fe-49fe-b2da-76316281ac89">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d016e53d-0699-46d5-9fc5-16a58365d719">
      <Text>Those schools taught your mother. These schools built me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="afad8837-fdc1-4eb5-ade2-f6fd5d4f6972">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52b34276-c33c-487f-8911-07a9684e9c2f">
      <Text>I wanna be as smart as mom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="57e3017a-24f2-4c40-ba1b-9b2b889ef6b4">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="79ec1c62-9149-449c-a501-d018807f8fb9">
      <Text>(Mumbling)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e1a9c038-4dff-475a-a369-d447237e2d12">
      <Text>A smartass sure...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6013cab9-d34f-4695-899e-67676edda12e">
      <Text>





























</Text>    </Paragraph>
    <Paragraph Type="Character" id="89daf475-de37-414a-a91a-cfbcaa4fe29d">
      <Text AdornmentStyle="-1">BO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="067f0848-0e63-4b00-a7c9-8618cac4bb57">
      <Text>You’re going home.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1e8322d2-e6d5-4934-b34b-51b16fff2557">
      <Text Style="Bold">Scene last</Text>
    </Paragraph>
    <Paragraph Type="Action" id="eafeedb5-6126-4547-a7a9-e251f25605a2">
      <Text>A bean-like structure is present. Attached to it is a chain with an unseen anchor.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="08e2dd74-31b3-4cb1-a43f-44e2a4a9e428">
      <Text Style="AllCaps">Cuc</Text>
      <Text> enters. She sits on the structure. She notices the chain and pulls on it until it reveals the anchor with the fossilized horseshoe crab, who was crushed earlier. </Text>
      <Text Style="AllCaps">Cuc</Text>
      <Text> takes the fossil and puts them to her ear.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aec831fe-6459-49d0-a784-0adf790579c6">
      <Text>The horseshoe crab transforms into </Text>
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text>. As the two embrace, </Text>
      <Text Color="#00000000FDFD" Style="AllCaps">Me</Text>
      <Text> coughs up water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="047784c1-dcbf-4291-934b-1fd144d1b50d">
      <Text Color="#00000000FDFD">Me</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="91187954-3a58-49e0-8235-de0c01044ed2">
      <Text>Bleh... (resonant cough like earlier)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="047784c1-dcbf-4291-934b-1fd144d1b50d">
      <Text>CUC</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6460fe5-0a62-4baa-bc2a-c7cabd3a20a5">
      <Text>Dirty water?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b180a142-5228-4c19-b3c9-ed13656b46f6">
      <Text Color="#00000000FDFD">ME</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="25540e6d-89ab-40eb-9871-27190f376efa">
      <Text Color="#00000000FEFE" Style="Italic">Nuoc den</Text>
      <Text> </Text>
      <Text Style="Italic">(Viet: “Dirty water”).</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b42bc0a3-6b87-4787-bf93-d55b623c84ea">
      <Text>Nearby, a couple </Text>
      <Text Style="AllCaps">horseshoe crabs</Text>
      <Text> swim together.</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="9499d320-e53c-46c7-9fe8-748748d9f2fe">
      <Text>End of Play</Text>
    </Paragraph>
  </Content>

