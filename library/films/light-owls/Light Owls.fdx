<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20260114T074357" id="e516c13e-66d0-4adb-a613-32abd31758b1">
    <XRef DateTime="20260114T074220" id="7e425f40-8087-4f45-a516-b1956f9b480b"/>
  </DocumentRef>

  <Content>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="New Act" id="5bc8854a-8238-4fbf-a8d6-72e5ed93d047">
      <Text Style="Underline+AllCaps">Prologue</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="93967e05-c2ed-4f79-8b79-def1619ce678">
      <SceneProperties Length="1" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MS. CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SENOR CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="YOUNG ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Footage - Summer Camp in Oregon - Day - 2002</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7ec7d420-048c-403d-83d8-e4bf1f83af4e">
      <Text Style="AllCaps">Through the camera: Ms. Corazon</Text>
      <Text> (40s) films her daughter </Text>
      <Text Style="AllCaps">Rowan Corazon</Text>
      <Text> (6) and son BARNEY (3). Barney has a bright, wandering gaze. They stand before a </Text>
      <Text Style="AllCaps">falconer</Text>
      <Text> holding an </Text>
      <Text Style="AllCaps">owl</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a66852c-b652-4c3c-8289-e712cad6d41c">
      <Text>Young Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d803bcb-484f-42c5-9516-4c9d15cb1605">
      <Text>Hoot </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text>! Hoot? Can you say hoot?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3a43d392-313b-4aa0-8467-1f39397c074e">
      <Text>Barney doesn't speak. Instead, he mimics the owl’s head tilt.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f56e9cd-23a3-4c02-a0d7-c0adcabd40b9">
      <Text>17-year-old Rowan from 2014 narrates.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e00c3ffb-5928-4e0a-a3ac-1feca50b0165">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08ef5197-6f1d-4625-b0d3-7e5590170a92">
      <Text>It’s what I gave my little brother, Barney: a hoot!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f50ad019-25d0-4a5b-b7ce-751804037364">
      <Text Style="AllCaps">Footage - Kitchen - Evening - 2004</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9822b0c3-cb98-41d7-a5bc-980acaa260b9">
      <Text>Rowan (8) sits with Barney (5) at the table. She makes no sense of the worksheet. Barney’s attention drifts to a fan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="375e5a6e-d367-4600-ae67-261614f143ab">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="87b2d530-1dcd-4034-956d-4a37f7ee675c">
      <Text>But not so much his school.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4a498406-6ca6-4eae-88ba-38713df8df34">
      <Text>YoUNG ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5932065-9e27-4c09-847a-b08fa844317e">
      <Text>Mom, I quit!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bbfadb0-b1b4-44bd-a210-1c308cffaca6">
      <Text>Ms. Corazon (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e7f803c4-e706-4992-9683-f41defea9974">
      <Text>Rowan Corazon, you never quit.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93ba7bce-4b37-4c76-8c27-284bf0beb224">
      <Text>YOUNG ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3371a233-53f0-49cd-8b9a-02ed7a1b3f36">
      <Text>Then fire me!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="60ca24e3-8f3d-4519-a7de-0d028aae9fd1">
      <Text>Senor Corazon (40s) pulls an owl-shaped container of jelly cups from the fridge. Barney forms a bird with his hands.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dc77116b-1aae-4d14-bc0d-f5c24db45460">
      <Text>Ms. CORAZON (o.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e96bf839-4980-4663-9f03-8940536d6abe">
      <Text>Darling. ¿</Text>
      <Text AdornmentStyle="-1">Puedes</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">ayudarle</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="dc4a2d8e-df20-432e-98f9-6c0eb543d445">
      <Text>(Can you help him?)</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8a6780c1-73a8-4253-b5de-983d695d2864">
      <Text>Senor Corazon</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e18a439b-acd7-49ce-a2b5-d6b100ddece1">
      <Text>Unlike us, Ro... ya got fresh worms to share with little bird Barney.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cabf806f-bfed-4285-acb3-4f907417341a">
      <Text>YoUNG ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd71cd59-d0d3-482a-a5dd-44d6a4be59d7">
      <Text>He can find his own worms.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="977c7e88-4e6d-4df8-917b-645bad05f871">
      <Text>ROWAN (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="868972e8-f852-4444-abb1-448a5b8f4064">
      <Text>He wormed his way through school, but he didn’t quite soar until...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="0ed93310-a656-4ba1-aeea-f2cbc9fa2cde">
      <SceneProperties Length="6/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MS. CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="YOUNG BARNEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="YOUNG ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="YOUNG ROWAN &amp; BARNEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Footage - Hallway - Day - 2005</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1baf705e-65f9-402d-97c2-b19cd81eafb9">
      <Text>Barney (6) wanders the hall, his fingers tapping his thighs. He stops, captivated by the light reflecting off a doorknob.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f450728-abc7-4887-be63-a7d7a11ab759">
      <Text>Rowan (9) is unseen in the adjacent room. Her arm snakes out into the hallway, fingers wiggling, beckoning him in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="031043bd-fdf4-4ad7-94d4-ffe9f8f38291">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9d71d6b6-594c-423c-95a7-78dc8051a949">
      <Text>...I took drastic measures. I gave him a beat-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4c4d9085-0bac-4a51-99da-3f937caf3924">
      <Text Style="AllCaps">Footage - BedRoom - Moments Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0bdbb2e0-769b-4614-8078-87a8904310f5">
      <Text>Rowan’s hand swoops down onto a pair of bongos.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1c9f7e05-a1c8-4edb-90b1-a5baa9f6e8d5">
      <Text>Young Barney (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="184f86d0-0dfe-428c-9336-1817e9226e19">
      <Text>Beating!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="46234046-39ca-4f86-abdc-cbba0b6827f1">
      <Text>Rowan taps the bongos four times in sync with her words:</Text>
    </Paragraph>
    <Paragraph Type="Character" id="97edd88a-d496-4195-8806-b7d5e37d4f25">
      <Text>Young Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1098c0fd-46c5-4dc3-af40-6b0815dde7c0">
      <Text>No </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">no</Text>
      <Text>. Beats.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="71b8efe6-85f8-444c-88da-26454feaf4f9">
      <Text>Ms. CORAZON (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b221cf7-6f3d-492b-8ec8-4b1fee8fcc1c">
      <Text>No beatings here. Now what you say?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d7b8f513-c116-4c77-a893-7ac76b30c599">
      <Text>Young Rowan &amp; Barney</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="538fe81a-fd82-483c-be96-d70e193e9814">
      <Text>Gracias, mama...</Text>
    </Paragraph>
    <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="General" id="6c63a151-150e-4221-ace2-51e1efa7c3ea">
      <DualDialogue>
        <SpellCheckIgnoreLists>
          <IgnoredRanges/>
          <IgnoredWords/>
        </SpellCheckIgnoreLists>
        <Paragraph Type="Character" id="017b71bf-d738-4d09-a167-bd83274bcc65">
          <Text>Young Rowan</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="d5fe9571-91b4-43ec-9372-66c7e112995a">
          <Text>...for the bongos.</Text>
        </Paragraph>
        <Paragraph Type="Character" id="cefdc507-2bf9-46b5-9cc8-4ad4626068ef">
          <Text>Young BarnEY</Text>
        </Paragraph>
        <Paragraph Type="Dialogue" id="1db188fa-ffdb-4298-96aa-ebb9045e13a4">
          <Text>...for beatings!</Text>
        </Paragraph>
      </DualDialogue>
    </Paragraph>
    <Paragraph Type="Action" id="8ebe7562-8296-49e7-bd1a-f522ad78219f">
      <Text>Barney suddenly hammers the bongos with wild passion. He jerks his head in a owl-like tilt, eyes wide on the camera.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="85813166-9723-445c-9042-54e511772399">
      <Text>Ms. CORAZON (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dddc8e03-f82e-426f-931f-d2952dbb918c">
      <Text AdornmentStyle="-1">Hahahaha</Text>
      <Text>. We’re for sure deleting that take. From the top, everyone!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="99140be8-5e8c-4e1e-adaa-b049eb86d2cd">
      <SceneProperties Length="3/8" Page="2" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Footage - Auditorium - Evening - 2007</Text>
    </Paragraph>
    <Paragraph Type="Action" id="305dbf76-38e0-4868-b88d-2de8fbc8788a">
      <Text>Rowan (11) plays a piano and </Text>
      <Text Style="AllCaps">Maya Easton</Text>
      <Text> (11, Black) sings in a talent show. Mom’s camera pans to Barney sitting by her. As a coiled spring, he vibrates until- he </Text>
      <Text Style="AllCaps">vaults</Text>
      <Text> onto the stage!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b3fa569f-df0d-407a-943b-aa3c5e854360">
      <Text>Barney erupts into a joyful dance. He </Text>
      <Text Style="AllCaps">bobs</Text>
      <Text> his torso, </Text>
      <Text Style="AllCaps">swivels</Text>
      <Text> his head like an owl, and </Text>
      <Text Style="AllCaps">tucks</Text>
      <Text> his arms like folded wings.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3a55f6c0-ef2e-4f52-9a65-f76a61355889">
      <Text>The girls laugh and pull him into the set. They miss no beat. Rowan picks up tempo, playing to her brother’s wild rhythm.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fc2bf910-bbd8-445e-92b8-34f94a67d1ab">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2cf38939-0667-4fbb-8858-4afb6b916169">
      <Text>We didn't need to find a way to speak... we found our way to fly.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="54214290-0154-4276-bd95-74a3b91bdda5">
      <Text>As the song finishes, the trio unfurls a banner: LIGHT OWLS. The footage </Text>
      <Text Style="AllCaps">freezes</Text>
      <Text> on their triumphant smiles. The banner serves as the film’s </Text>
      <Text Style="AllCaps">title</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="597f8dde-8733-4359-b73d-76ef524be275">
      <SceneProperties Length="4/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN &amp; BARNEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Community Center in Portland - Day (2014)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cf3d9394-e1cb-4287-b4e3-1f6c98e5c38b">
      <Text>Rowan (17) stands at a podium. Behind her, a TV screen pauses at the last frame of the talent show footage.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="326077b9-a22a-49b8-91b9-a04510d05d14">
      <Text>Next to her is a fake coffin and a memorial poster featuring Barney’s goofy photo. The handwritten text reads: “In Memory of Bernardo Corazon: March 28, 1999 – </Text>
      <Text Style="Strikeout">March 28</Text>
      <Text> April 1, 2014”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e3f2db4e-9f63-433a-8582-cf37ec7a2985">
      <Text>RowaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca0e5ce4-d16a-4c64-aee6-f0d2d7d65fdf">
      <Text>We truly gave a hoot about you!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b4d7a987-2880-4538-ab4f-91f2ffee0cc7">
      <Text>Maya (18) and other </Text>
      <Text Style="AllCaps">attendees</Text>
      <Text>, dressed in casual clothes, dab their eyes with tissues. Ms. Corazon films them on her phone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bd8b5f78-06b8-4f72-8945-627a3283dbd2">
      <Text>Suddenly, Barney (15) explodes out of the coffin like a jack-in-the-box. Rowan throws an arm around him.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9ea77b88-44ae-49f6-879f-7f257d6ac36e">
      <Text>Rowan &amp; Barney</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d077eef-c7c9-4ab2-9a1b-00fa7c1af40d">
      <Text Style="AllCaps">April Fools!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="26d3b9cc-cfd1-4304-a463-7bafff63fb08">
      <Text>The audience cheers and laughs. Barney takes a bow.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="6177cc23-2685-4afc-9f16-ea7babcefdac">
      <SceneProperties Length="3/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN &amp; MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Park in Portland - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="93cc922a-2be8-4d16-a097-9564806e5315">
      <Text>Barney, with a beanie over his ears, chases birds around.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4f17895b-a592-4632-ba8d-52da34522d31">
      <Text>Rowan and Maya walk behind him, carrying the memorial poster.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9a1867c6-1d75-4b30-b7e3-109e209a999f">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="109ec687-0a95-4ee4-af46-1b09de82ba97">
      <Text>His 15th birthday. </Text>
      <Text Style="Italic">Check</Text>
      <Text>. In the horizon: college </Text>
      <Text AdornmentStyle="-1">partieeesss</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c314d79-fa6d-4a75-b202-cdd8caee2776">
      <Text>RowaN &amp; Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5d738edf-2de2-45a8-b594-09ae94578212">
      <Text>Hoot </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">hoottttt</Text>
      <Text>!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fd472e07-df96-45b6-825f-5adf9fc11006">
      <Text>Barney stops, tilts his head to look at Rowan. Rowan runs to Barney and pulls him into a fierce hug.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="826e392e-71d9-4a0c-b26a-7b9629117e85">
      <Text>RowaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7e113ed3-01c9-478e-932d-b19ee0a7f168">
      <Text>We’ll always be in cahoots...</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="72c4ef2b-cfe5-4d04-b4b1-5367e2e40c54">
      <Text Style="Underline+AllCaps">End of Prologue</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="New Act" id="b8c915c8-9c2a-41bb-a43c-f5eec110257c">
      <Text Style="Underline+AllCaps">Act I</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8e4de5db-72d7-4dea-9f1a-c55e48cd91cc">
      <SceneProperties Length="1 4/8" Page="4" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BARNEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MS. CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SENOR CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. New York City Streets - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="611d7d7d-199c-4382-bf0a-1fd8c2bf76a2">
      <Text>The quiet atmosphere turns into city chaos with honking cars.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a14b59ae-312f-408b-96da-a69ab927fcbb">
      <Text>Senor Corazon grunts as he hoists a heavy box from the sidewalk. On top of the box is an oversized wired headphone. He carries them towards the apartment entrance.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b6e1e6d-22e9-4e88-9c25-259e09920b5f">
      <Text>Rowan stands by the car. She takes in the towering skyline, then looks at her mom in the passenger seat, then at Barney in the back seat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b6e1e6d-22e9-4e88-9c25-259e09920b5f">
      <Text>Barney looks down, his fingers tapping a nervously against his legs.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="41c79458-22da-4670-9e29-93716f1ad324">
      <Text>Rowan’s phone rings with an incoming FaceTime call. It’s from her mom. Confused, Rowan answers it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8e52a0b4-c64c-48fa-a4d0-c88e16ebc9cc">
      <Text>Barney’s face pops up on the screen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6a458e43-d49b-4fd5-a8b8-c01c8dc8d9cc">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4d1d62c8-96b0-4081-b6a1-bf634c604ee8">
      <Text>Barney?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="28a15de5-f440-4e4a-99fc-ac56d3fc3ca7">
      <Text>Ms. CORAZON (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="12e11fb8-c639-4206-846f-415adb3db8ef">
      <Text>See? Phones are also for the eyes. You’ll get to see your sister while she’s away for college. Wave hi.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1b15c156-b804-4c1a-a3d0-2972f189ef29">
      <Text>Rowan waves both at the phone and Barney in the car window.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bf2806e-152e-4506-9b67-3f68066ff4bc">
      <Text>Her phone buzzes with a text message from Maya. Rowan opens it: F</Text>
      <Text Style="AllCaps">inally</Text>
      <Text>. Apartment to myself! Terms conditions applied.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c8feac1a-9565-4860-b466-27b0eb5bf558">
      <Text>A second text follows: come over foo</Text>
    </Paragraph>
    <Paragraph Type="Action" id="245c5518-fe43-434a-8018-5e6818595992">
      <Text>Senor Corazon returns to the car.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8e3ac7d-2aa1-4551-a160-90a3efdc53d9">
      <Text>SENOR CORAZON</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f18e1a91-803e-43f5-8dbf-e3926c0c88c1">
      <Text>Too bad your spot don’t got indoor laundry. Wanna check a laundromat?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c741918-67c2-4ba1-9ecd-6214fe241f6a">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="61da50d2-9352-49cf-b73f-f6707b35d33c">
      <Text>I can handle myself.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a773c2d7-6463-4085-ad7a-182c9589af72">
      <Text>Ms. Corazon and Barney climb out of the vehicle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d58909bf-aeb1-4758-8882-2e47b2a6b61b">
      <Text>Ms. CORAZON</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4880739b-2899-4b8c-8f71-f6226892aefe">
      <Text>Behave yourself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="02f93237-a230-48b5-84fc-ccab00b85b96">
      <Text>SENOR CORAZON</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f889d509-6dd2-4ae8-8435-d8f797b1892e">
      <Text>You should know better. Get that Animal Behaviors degree.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea222813-e751-4968-bcdd-1ed6f99e4f1a">
      <Text>BarNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5adf8287-11fc-4baa-8327-6a8c66320519">
      <Text>What animals-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1dfd880c-fe95-47fc-a139-47815cf32423">
      <Text>Ms. CORAZON</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2bfc7b21-4aa7-404c-9cd7-e9867a58953d">
      <Text>Your sister is going to school for Animal Behavior and Conservation.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86057713-0e03-497c-9c80-02a887d953b2">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="15967871-7ff8-4116-b9d8-c8655c09f5d8">
      <Text>I’m learning my ABCs again.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="09a3873c-32de-44e3-b2a2-61d14bfe1be3">
      <Text>Rowan and Barney embrace.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a48d6bba-3e48-4b21-84ff-d30fa09686d9">
      <Text>BarNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4492f9f6-d665-4d83-b9ca-a64d61dc1fdd">
      <Text>Di-Dinosaur.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eedb3c25-3969-41a7-a7f3-5205fb41686a">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3c1b481e-3aa3-4a9c-9d9c-be7a8b70f13e">
      <Text>Oh Barney. They’re ex- I’ll let you know about their descendants. See you later alligator.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6cf83466-d8a5-4bb4-a4d0-86fcc0868442">
      <Text>The washing machines rattle and hum.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="bbddccf9-ce5f-40c5-ae57-0ff65f9bcd18">
      <SceneProperties Length="6/8" Page="5" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Laundromat - MomeNTS LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b30c744c-c73e-43a3-85f8-8c38f56f290d">
      <Text>The washing machines rattle.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a4ee546d-b641-45fe-b38b-5f402d111333">
      <Text AdornmentStyle="-1" Style="AllCaps">JoJo</Text>
      <Text Style="AllCaps"> Horne</Text>
      <Text> (18, Asian, genderless) sits cross-legged on a folding table, eyes closed, tapping a laundry basket with a hanger. The beat syncs with the clunking dryer.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dd971278-daba-446f-a099-a79836835dc0">
      <Text>Rowan enters, looking for a clerk. They stop, watching JoJo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="89098ba2-d58c-44b1-a92c-9d3216b1996a">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d345c912-cbd8-45a3-9d2f-f867d7d3a906">
      <Text>They got a serious beat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48cb2b23-b00e-4ff0-bed7-fbfb2d8bb254">
      <Text>Rowan grabs two brooms leaning against a wall and knocks them together repeatedly to a counter-rhythm.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="200c388f-7371-440b-bbbd-2776c30d62ac">
      <Text>JoJo’s eyes snap open. The rhythm stops. Silence fills the room, save for the groan of the machines.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2a7aa07e-5bb6-4c8d-9cb7-696d76e1e087">
      <Text AdornmentStyle="-1">JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e01fa91d-32fd-41f0-b3e2-c61040759190">
      <Text>Who dares disturb my rhythm?!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="efb5d878-37d9-4d9f-8da6-671a8d3032a2">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a3db59ca-1deb-427b-a320-b61919a7e778">
      <Text>Disturb? I was adding to it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73504a90-d377-4697-94cf-b9fc737f6d91">
      <Text AdornmentStyle="-1">JOJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8d06303a-dcc9-4c75-a242-edd20e8f87dd">
      <Text>You add nothing here.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aea7369c-6112-429f-b6e7-c2d30f8375a1">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0eb8dd9e-59f6-4e81-86cf-9b5f6a6c407a">
      <Text>That’s uncalled for. I’m Row-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3b846f2c-3bb4-4a7f-b8bf-edbc55545c25">
      <Text AdornmentStyle="-1">JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d574991-6a6c-47e8-a8b4-6e00afb446a5">
      <Text>Shoo! Begone, tone-deaf beast!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e7409272-92fa-44d2-bc15-e6b4d028b130">
      <Text>Rowan recoils and exits.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="cc5ea02a-76fd-4aa1-b4cf-7b2dd3e18492">
      <SceneProperties Length="3/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. LaundroMAT - ConTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0a466d6f-6117-437d-a16b-d7667dd8b27b">
      <Text>Rowan looks at the towering, indifferent buildings.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ce234592-cac9-4694-89b4-161c2a8e254b">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0133989e-ab08-4ad9-a417-fc22445896fa">
      <Text>New Yorkers are </Text>
      <Text AdornmentStyle="-1">anim</Text>
      <Text>- less predictable than animals!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bf2806e-152e-4506-9b67-3f68066ff4bc">
      <Text>Her phone </Text>
      <Text Style="AllCaps">buzzes</Text>
      <Text>. A text from Maya: Bro, get to the </Text>
      <Text AdornmentStyle="-1">cribbb</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="25cc1ebb-0ca6-42fb-82c2-a9a38e1c7cac">
      <Text>Rowan types back: Address? Idk NYC like that yet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7eabc29b-b4bd-4f00-b37b-8b4d800e9139">
      <Text>RowaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bd3e3bab-d1b7-489a-ab88-46102b908920">
      <Text>At least Maya is adapting to the environment.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6c90b93d-08c9-4f5a-bb26-cb2258a754eb">
      <Text Style="AllCaps">Pre-lap: </Text>
      <Text>The knocking on a door.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8b333443-4dd6-4581-b618-e8527595f807">
      <SceneProperties Length="3/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Maya'S APARTMENT - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dc0b45e5-4496-47a8-86a5-cdab059e5eb5">
      <Text>Rowan stands before a weathered door.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="38350db2-f1ae-4d88-8211-49870254d4d7">
      <Text>The door swings open to reveal Holly Greene (18), who looks nothing like the weirdo Rowan expected.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="47c23ec2-9c30-4002-996d-53edfd819216">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="da8f227b-0d76-465e-97b3-a233eae69077">
      <Text>I must be at the wrong-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9b1b2392-ca8e-404a-9b6d-069521ffa3d2">
      <Text>Maya (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5a4a030a-c609-43a7-9ff1-b8e3d5b685a0">
      <Text>You’re in the right place!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="155bb452-0f05-49b2-b733-99f2ab1409a7">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="69956f45-f95c-4a49-a6b0-450c6505de4b">
      <Text>(Stepping inside)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0622057e-3787-4440-b632-18fc2cc635f4">
      <Text>I haven’t felt right since crossing the bridge...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="8b38d6f0-c4b7-4056-9674-0c7539224e1a">
      <SceneProperties Length="7/8" Page="6" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Maya'S APARTMENT - CONTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cf9bce31-9cb1-49fe-b6c2-6cc261e0361c">
      <Text>The space is cramped but cozy. Rowan sinks onto the sofa next to Maya. Holly retreats into her bedroom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18a88ff1-4ce2-4b8e-85cd-f72e5338df33">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e83c8229-3be6-4d95-accc-f3c231ccb233">
      <Text>Told ya, terms, conditions applied-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9881c0eb-b3c8-41b4-963d-6179ae5ed9cd">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f5d3da89-a845-45ae-bbe2-1402ce9be109">
      <Text>I know, I know. NYC is expensive. I’m just glad the “condition” is a fellow Juilliard musician.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4805bf77-19c4-43eb-8573-342cf079bf6a">
      <Text>Rowan gestures towards a violin case on the floor.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ef0a788f-3654-439d-800d-9216f4370792">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6cc92b6c-f139-456d-80bf-d32c8b36b09d">
      <Text>Glad the condition is you get to be with another Julliard musician.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="793094d6-65a5-4884-a323-972ce9a4e1ce">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fe8abc47-9454-4d82-83a7-b9c8c15515a2">
      <Text>Holly, you’ve got like three more of those in there? What are they?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0f1f2731-9a2a-4d16-9bcb-0f24cfab77c4">
      <Text>Holly leans out from her doorway, holding a banjo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5bc856bb-3e6d-487f-a430-07d4a9ff7de3">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b3baf01-1ce1-4da0-81aa-464191fd1851">
      <Text>Just two more. Guitar and this here banjo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="645a00d7-a384-4afb-b3f4-27299bb20593">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38b4db3b-67c8-4cfa-b6df-469da2a3d3b5">
      <Text>She’s from the Ap-pa-lay-dah—</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bc1fcf9-9337-4b76-bd97-970479e0146d">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6f7cbe25-bd53-46ba-9719-ce8ddc885f3b">
      <Text Style="Italic">Appalachia</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d5dbc0f-5cfd-4e72-8a8c-b1b4a92a0218">
      <Text>HOLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a5dae35-5f45-4490-b587-d2df8af0ccf6">
      <Text>Born and raised. Can’t even say it myself half the time. I’ll admit that much.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e318eed4-532d-41ba-b362-de80f05547ef">
      <Text>Holly disappears back into her room.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e6a01056-5070-467f-85c6-bc93259128fc">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c83cd0c8-ac54-4378-bcca-bb7a8c042347">
      <Text>Well, Ro...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b230f19e-6589-4cd7-b81c-e218750e70b3">
      <SceneProperties Length="1 2/8" Page="7" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BARNEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MS. CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="SENOR CORAZON">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. RowaN'S BEDROOM - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4fbfe540-4731-4193-909a-75352a8d8fc1">
      <Text>Rowan lies flat on her mattress, eyes fixed on the ceiling.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ab9a9bac-db0b-4966-a89a-bfaa6c6fa208">
      <Text>Maya (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c83cd0c8-ac54-4378-bcca-bb7a8c042347">
      <Text>...stay proud of where we’re from.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="37e0dc04-ec29-4bd6-a5f9-3e2c088d36e2">
      <Text>Her phone </Text>
      <Text Style="AllCaps">rings</Text>
      <Text> with an incoming FaceTime call from Barney. She swipes to answer. His grainy face fills the screen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ccca347a-13e4-4812-add3-c59ab3177fda">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed87a91d-be0e-42f4-b81b-4a26561664f0">
      <Text>Barney, the tech wiz!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d04b16a-5a56-432c-9dd3-47d7215f6186">
      <Text>BarNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fa94b13e-a169-4660-bb7d-839cd48acc26">
      <Text>I got it- work.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93301e7f-fdbe-4486-a786-6a809657c40c">
      <Text>Ms. CORAZON (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cb947f56-7517-44cf-852a-1a68d7338b0c">
      <Text>Took a couple hours to teach. But it’ll just be an hour here on out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="eec5f277-9577-416f-9858-741ee6dfde3f">
      <Text>SeNOR CORAZON (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="41883139-bc27-4bd2-80c6-912bfc19ba64">
      <Text>Two more days of driving and we’ll be back home in Portland.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e02ae9d0-f4e5-457d-a505-da1098f1b949">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bcf5f297-a8a5-4e07-9375-765105302de7">
      <Text>How’s Lansing treating the road crew?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8b6fac8-2e7b-465b-a6f5-f3ae81d0f15e">
      <Text>BarNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33d5789b-2a1b-4e0c-9a46-49805869845b">
      <Text>Hotel is nice.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8eafe98-558f-4696-bad3-2e5f9368e8ba">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="58aa22c4-28ab-45f8-a3d3-0df9f8760089">
      <Text>I bet mom filmed a video of you dancing in the lobby.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="334048fc-c1d5-4fbe-af41-7e101652dedc">
      <Text>BARNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33d5789b-2a1b-4e0c-9a46-49805869845b">
      <Text>No dancing in Lansing... I miss you- singing.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d57ab93-81c6-4ba2-a6a4-2b1a164264b6">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b69aa407-dacc-46cd-ba32-e62d7c8b98a1">
      <Text>(A sad smile)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e85092f0-e97f-4434-af66-838a4cae857b">
      <Text>I’m sure you’re the only one, bro.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e604ca5-6d5c-4fa1-b6d4-1fb7016e8d2e">
      <Text>BARNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f828347b-ec1d-41e1-aa8b-67a05a7088f4">
      <Text>No. People... everywhere... like your music.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4fbdd6e-f035-4915-919c-d5193a8521a8">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a1e1cb13-4ea0-491e-a163-82bae56509a6">
      <Text>Maybe someday. But tonight? Tonight, I just like sleep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f40af990-bc5f-4541-a095-7241d612e406">
      <Text>BARNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5839738a-a548-4d7e-8d38-f169dcaa1cdb">
      <Text>But New York City never sleep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="81f8b407-5db1-4abc-a5b0-6cd13b86607e">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="52e9ce55-0f55-4a4e-97a4-76385b54a87a">
      <Text>I look like New York City to you?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="87cc91a5-3fff-4465-ba00-ade07e909cfc">
      <Text>Barney grins, a perfect owl-like tilt of the head.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e3d8be2-c9be-4a78-8792-bd3bc07376c1">
      <Text>BarNEY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca4fee2c-25e6-468b-8576-235c075f341e">
      <Text>Hoot </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9d0c3f00-243b-49c4-8d7b-37766faa82cb">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fe6b746c-97ef-4380-b9f6-1458e16296f0">
      <Text>Hoot </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b5780be3-9bc4-438e-83cd-3a481065f283">
      <Text>The screen goes </Text>
      <Text Style="AllCaps">black</Text>
      <Text>. Rowan lies alone in the silence.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="52face35-51e1-4483-b8b7-9dc68bcea378">
      <SceneProperties Length="5/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Subway Station - Morning</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c3e4449e-5033-4da0-9080-351bc7358985">
      <Text>A sea of jackets and sweatshirts drown the platform. Rowan stands apart, backpack cinched tight. She eyes a slick puddle of grime on the concrete and instinctively pinches her nose.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0c2bee52-5e45-4f90-924f-c70a76245d66">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="320d8feb-2e0c-4f4d-9ac6-6185fc2c212d">
      <Text>The great migration always leaves behind a scent trail...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ad7b772e-88bb-45b7-ba0e-0ce274bad554">
      <Text>A train </Text>
      <Text Style="AllCaps">roars</Text>
      <Text> in.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="dac06b53-3f7e-4fd8-a2d4-a226b807088c">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f6c1ed2-010f-4720-aeb7-3b3daf1123c9">
      <Text>Wildebeests are a keystone species for a reason. They move as one, without thought.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d07a0b4c-78d1-4673-858a-0106cdc12542">
      <Text>The train doors open. A wave of commuters pours out as others shove in. Rowan is pushed into the car by collective force.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1f9ff53d-0be3-402b-9e4b-aa2abd613483">
      <Text>RowAN (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f6c1ed2-010f-4720-aeb7-3b3daf1123c9">
      <Text>Hesitate at the riverbank and the herd tramples you. In Manhattan, the “river” is this beast of steel.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="49fd9e11-d6f5-4e53-ba48-aac8495582a2">
      <Text>Rowan is wedged into countless bodies, immobilizing herself.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="346e3998-9637-40af-b0bd-9596c82c7fa7">
      <Text>ROWAN (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fd013cc8-6929-42b6-9b46-78e357a049a2">
      <Text>The distance-decreasing signal. In the wild, this proximity would trigger a fight-or-flight response. Here, it’s another Monday.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="52face35-51e1-4483-b8b7-9dc68bcea378">
      <SceneProperties Length="2/8" Page="9" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. Hunter College - Afternoon</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1d7a9303-ea4c-4451-97b0-ebea3255d282">
      <Text>Rowan exits a building, blending into the flow of college students. She looks blankly indifferent.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bf2806e-152e-4506-9b67-3f68066ff4bc">
      <Text>Her phone </Text>
      <Text Style="AllCaps">buzzes</Text>
      <Text>. A text from Maya: Open-Mic Monday?</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="dbd3198d-0f9a-4db3-8915-0fffcfe41862">
      <SceneProperties Length="1 3/8" Page="9" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="HOST">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Black Box Theatre - Evening</Text>
    </Paragraph>
    <Paragraph Type="Action" id="996ca7e5-7c6d-4e2a-bf0d-35278f63c6ee">
      <Text>A small theater space. Rowan enters just as a poet finishes their set. A </Text>
      <Text Style="AllCaps">videographer</Text>
      <Text> films the stage with a camcorder on a tripod.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="38cd5974-0319-4d1d-9d93-32f9727ce07e">
      <Text>Maya and Holly sit in the audience.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ed296c43-26cb-49dc-8481-79cf24b187fb">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="87dea98e-cf6d-4b83-b464-78301d68758a">
      <Text>Just in time. Our set is up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8bc8fcc9-6b00-4a92-8155-e6812b64d499">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1a47b7ab-74d9-45c0-bd5d-2237b255aa55">
      <Text>Banjo?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cd771d21-8d4b-4b77-aa7f-e3770801dcdf">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35bc9e4d-5609-4530-b4ae-b64e90a86813">
      <Text>I wouldn’t wanna be caught in the wild with that. Violin tonight!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="db81748e-1837-4258-8b8d-52f93454358a">
      <Text>Maya and Holly get on stage.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="19585b73-86f4-49b5-ac0c-6b5215e41da0">
      <Text>Rowan scans the front row and spots JoJo Horne sitting alone. JoJo stares ahead with characteristic boredom. Rowan frowns.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c95f09a-4a1d-41ea-8926-7b61086182b6">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0eb21ca6-feb6-447b-b9aa-7931bb82294a">
      <Text>I’m going to sing an ancient piece. I won’t give a title, so you won’t search it up and judge.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b865d7fc-db04-4f14-adbe-3dd0e00d21a6">
      <Text>Maya begins to sing, accompanied by Holly’s violin.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a69fd03a-76c0-4b04-a789-a56e9143dd5b">
      <Text>JoJo remains expressionless. The crowd is lethargic.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="faac896c-b46c-43da-93c3-9c8e6134c3d1">
      <Text>Rowan’s fingers begin to twitch, tapping against her thigh. She reads JoJo's indifference as an invitation to intervene.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ca69070-0855-4969-a399-dcfe4633ed62">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="eeb140bf-9d3b-4b6d-b72a-30da44a66ba6">
      <Text>In a new territory, you have to establish your call. You must find the call that says, </Text>
      <Text Style="Italic">I belong here</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0b3e8429-a253-41c0-9446-4ec8eca3373a">
      <Text>Rowan strides to the stage edge, climbs up, and sits at the electric piano.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0b3e8429-a253-41c0-9446-4ec8eca3373a">
      <Text>Holly glances at Maya, bewildered. Maya just smiles—she knows Rowan too well.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f46a9948-4552-4db4-9490-a27c74798a05">
      <Text>JoJo recognizes Rowan. A flicker of interest crosses their face. They grab a </Text>
      <Text AdornmentStyle="-1">cajón</Text>
      <Text> (box drum) near the stage and start beating a rhythm.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8865c872-78f9-4c16-bfd9-e88392f13fe2">
      <Text>Now Maya has a problem; their classical piece is getting a serious update. Holly acknowledges JoJo with a nod, adapting her tempo.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6dfb928a-b13b-46a0-bf90-3a54c3818fab">
      <Text>Host</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="10405cc5-e8f5-4566-9b87-9088088855bf">
      <Text>Woah, you didn’t list these performers for your set!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="10f7939d-cde6-4b78-b935-ff741a96792e">
      <Text>The impromptu quartet slowly finds a groove. The bored audience increasingly engages, nodding along.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="03907ca0-1104-4667-bc32-0e14d6efbee4">
      <Text>Maya starts hooting.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="437f6a77-1d2f-4013-9cae-6ab4759dbea1">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86e93797-99ff-4331-aee5-e5b242a184cb">
      <Text>Hoot! Hoot! Hoot! Hoot!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a43204bd-2cd5-4335-b85f-ae8e367128d8">
      <Text>Rowan joins in on the hooting. Then JoJo. Then Holly.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="10f7939d-cde6-4b78-b935-ff741a96792e">
      <Text>The group ends the number on a powerful, unified beat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ff99530a-150c-455b-893d-96f7126397e3">
      <Text>The group end on a good note.</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="51ded917-df78-4c2a-8721-20f0613a588f">
      <Text Style="Underline+AllCaps">End of Act I</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="New Act" id="b8c915c8-9c2a-41bb-a43c-f5eec110257c">
      <Text Style="Underline+AllCaps">Act </Text>
      <Text AdornmentStyle="-1" Style="Underline+AllCaps">II</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="aaeb6979-8fbd-4f76-9b44-d8c841d77e41">
      <SceneProperties Length="1 1/8" Page="11" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="VIDEOGRAPHER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Theatre - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c258f9b9-7c66-43f6-b4ab-f964ab73a20f">
      <Text>Rowan, Maya, and Holly hang around outside the theatre after the show. JoJo tries to discreetly slip away, but Holly pulls them by the arm.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2e214ec-d2a4-4444-b281-73050f0beb76">
      <Text>HOLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fc1c93d0-7e92-4418-85e7-2ba1a20d7435">
      <Text>JoJo, this is Rowan. Of course, you met Maya.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="600f7a47-4eaf-496d-aad5-1cc7140b5393">
      <Text AdornmentStyle="-1">JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1dab2a11-626c-478a-9a15-2cca776a51c0">
      <Text>Oh I’ve met her, too.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="83fb29f9-cbb3-49cb-8f9a-75079f9f72b9">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f306f7fb-8242-4545-881c-99890594dd00">
      <Text>Well, I didn’t catch your name the first time. Since I’m “deaf.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4456c6f0-7f62-4930-8974-9314e81122a2">
      <Text AdornmentStyle="-1">JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="46de50e2-5dc2-4214-bd98-44b233c0d67b">
      <Text>Tone-deaf. There’s a difference.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3752a652-3cfa-4075-b5bb-f6a7aa1ce480">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ca8d867f-8d41-401f-997d-7db06ed055d5">
      <Text>Okay...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="55dd952e-6651-4c26-be1d-c410b1c1940b">
      <Text>A videographer exits the theatre, carrying equipment.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1451213a-28ec-4f2e-86f1-d2781fe9a16c">
      <Text>Videographer</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2d561ca-5176-4d53-9ee3-6f772dd7c670">
      <Text>Will upload everything tonight. Give us a subscribe on YouTube.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2d6225d2-626c-443a-8cd0-1e417df3fec9">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2511a558-bc60-485b-b3a3-dbfd41f52b44">
      <Text>Wait... We’re gonna be online—</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0396a1ff-d38b-4e26-96ea-85be01b4dd20">
      <Text>Maya slaps Rowan lightly on the shoulder.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="19b9b6aa-6287-4b54-83ad-9a1480799080">
      <Text>ViDEOGRAPHER</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e2d561ca-5176-4d53-9ee3-6f772dd7c670">
      <Text>I am so honored to have been in the room with you guys. No recording could ever come close to the experience you gave everyone here.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d3761ef5-0f05-4c5f-8572-3bde8ea43629">
      <Text>The videographer leaves.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9affde0a-4fba-4102-bada-1399af7e7ca7">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="60937c8e-7a20-493a-bcb5-392f345d0a7c">
      <Text>What was that for?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="85cf6487-60cb-44da-9e49-68f405988615">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f81bd49-561d-47bf-8a14-0d65fe05a95d">
      <Text>You didn’t sign a consent form.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c185bef6-f5ac-4000-955c-a69c867c7937">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f0dab71e-d865-44f7-b8a9-fa2c97d26357">
      <Text>Well, I didn’t.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="539d0a1e-be19-415b-91ad-971ad7cbe8f6">
      <Text>HolLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="daf881d6-03f1-4bef-873f-5eb2b5a561ed">
      <Text>What possessed you to get up there then?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="51c485b7-a10d-4290-9b6b-c043b1d91b87">
      <Text>Rowan looks at JoJo for a beat with a silent acknowledgment.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="ffd81836-3767-4c48-bd47-b8bff81445d4">
      <SceneProperties Length="2/8" Page="12" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Computer Screen - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="586edd1b-0bb6-4c69-a779-7a07a36026e3">
      <Text>A YouTube video of the performance is titled “Fall 2014 Open Mic 1.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4af2946f-0737-431e-acec-0ff19776cccc">
      <Text>RowaN (v.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ee93f731-161f-4f83-9ea1-7b44260d0942">
      <Text>I just want to be part of a herd...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c983e7cf-214f-4096-bbf0-ede93b1c22c7">
      <Text>The view count climbs exponentially overnight: 21 views, 89 views, 2.4k views...</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="ce8e598e-9205-4230-a6bf-0d2982c1e716">
      <SceneProperties Length="4/8" Page="12" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="STUDENT">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Library - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9fbce273-0a21-4ad5-be9d-0394b534bd33">
      <Text>Rowan is combing through the biology aisle, looking focused.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9fbce273-0a21-4ad5-be9d-0394b534bd33">
      <Text>Suddenly, she hears someone humming the melody from her performance last night.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aa61addf-01a3-4961-aad3-8a8654e48f39">
      <Text>Rowan pulls a large biology book from the shelf to reveal a </Text>
      <Text Style="AllCaps">student</Text>
      <Text> on the other side. They stop humming, surprised.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c9e6f6ff-ae3e-4fbd-b894-99ffac351693">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a419c9d4-3923-434b-b262-685816873cdc">
      <Text>Where can I check out that melody you’re humming?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2237be7a-0678-4303-9492-947988a21408">
      <Text>Student</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01de63af-b3cb-4bd3-9c57-ee0bfd2c17d4">
      <Text>You- You should check out yourself. You’re the one who made it?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="49893d83-dcc7-43a1-a640-99d52aafb540">
      <Text>The student displays their phone screen. It's the video of Rowan's performance.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8a79c06f-7bc4-4851-92e7-79b67c8f5e43">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1ebc0047-7d59-4922-a9dd-d85e2f14d47f">
      <Text>I-</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bf2806e-152e-4506-9b67-3f68066ff4bc">
      <Text>Her phone </Text>
      <Text Style="AllCaps">buzzes</Text>
      <Text>. A text from Maya: </Text>
      <Text Style="AllCaps">We made it!!!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="bee0fbac-1b0d-40a5-9f6c-414ddd1e0dff">
      <SceneProperties Length="7/8" Page="13" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="GAL">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="GUY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Subway STATION - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7191e1d4-61e4-4145-80e0-c0eb7b0f3289">
      <Text>The platform is crowded as before, but the atmosphere is different. Several </Text>
      <Text Style="Italic">students</Text>
      <Text> stand around, glued to their phones, headphones in.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bf31bd02-ddcf-4c3b-b0ad-9263000a8283">
      <Text>Rowan stands awkwardly apart, trying to make herself smaller.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2ae61519-6a76-4ed2-b4cf-d0c5b8301360">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="10a79379-d16f-437b-a5b9-dadbb87def2d">
      <Text>A distance-decreasing signal isn't always a good thing. Sometimes, proximity just means you're prey.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4c1778d5-490f-407a-8456-421882b4790b">
      <Text>A </Text>
      <Text Style="AllCaps">guy</Text>
      <Text> (20) standing near her </Text>
      <Text Style="AllCaps">laughs</Text>
      <Text> loudly at his phone. He looks up and notices Rowan, doing a double-take.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f42dd46e-7f58-4464-a43c-754f8ea91d85">
      <Text>Guy</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c566dd0e-b767-4a33-ac43-6adc11ba1e5b">
      <Text>Yo, ya group made some sick beats!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48fa1e19-221a-4249-b896-290a631caa64">
      <Text>He points. Other students look up, recognizing her. A ripple of recognition moves through the crowd. Phones are subtly pointed her way.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e51d050c-c9fa-415c-befb-ff4be0a760ee">
      <Text>Rowan turns bright red, pulling her backpack tighter.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8571e57-1c97-49d1-98dd-42dbcffbba1c">
      <Text>Rowan (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="36b2c5f5-5f26-4ab6-8419-75fbf995327b">
      <Text>I wanted to be part of the herd. I didn't think the internet was apex.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="981329d3-86da-44ee-8a06-d77da9362197">
      <Text>A train roars in. As the doors open, a college girl steps out, notices Rowan, and instantly pulls out her phone to record a selfie video.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="749feea1-0499-4e73-90aa-3af61c358e48">
      <Text>Gal</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="24e5696f-f48d-4233-848d-a2a745d32150">
      <Text>Look who I found! My commute just got a thousand times better! Give us a hoot!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="990a912e-da82-4f8d-b3e7-19da9915e5eb">
      <Text>Rowan is engulfed by the crowd as she boards the train, disappearing into the sea of people who are now all looking at her, not past her. She finds no corner to hide in.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="4b32f203-5b3c-46f0-9fc0-5c98941f341b">
      <SceneProperties Length="1 4/8" Page="13" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN &amp; MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. ROWAN'S APARTMENT - EVENING</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f1c1fd8e-8287-4fbf-9466-f8fb72d7fd65">
      <Text>Rowan stares at her laptop screen. The “Fall 2014 Open Mic 1” video view count is at 130K VIEWS. The comments are a mix of praise and a few harsh remarks.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2c4a02ed-7d68-471a-8eab-2374474fc76a">
      <Text>Maya and Holly are on the sofa, scrolling through their phones, buzzing with notifications.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9c2d1bb9-71d0-4b5c-9613-c52567201ab9">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f2390aab-7de9-4795-baab-afb60a719c46">
      <Text>My cousin in Tennessee texted me. Said people are listening to us while studying in Belmont.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="667ee44b-05de-453f-bcd7-fb5fe45b5079">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c25168b5-820b-41de-bfd1-3ad1d0f9c157">
      <Text>Big deal...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33147b39-90c3-4d36-b3de-2576bcb643de">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aa94e2cd-f638-4647-a5e5-bbe749af1feb">
      <Text>My DMs are going wild.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ce4dc9c3-14b7-468d-9112-2e5db4198bb9">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="05bc22ae-5249-4e80-977c-848ab0014182">
      <Text>Diamondback Moths?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="25e17d18-96e6-422d-ac52-10e658569fbd">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="33c12055-0307-44ae-832e-44f519c8e017">
      <Text>You know what I mean, creature geek-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e944260-c457-401c-b886-271a7e136ec0">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d2b0d5d8-6a35-40c5-80b6-a01e40434070">
      <Text>I just wanted a simple life studying feline communication.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="33b64242-b716-486f-9718-e7a54fe5c3e5">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b00ad94f-6871-4f99-b9f1-5ba931f470a9">
      <Text>Well, congrats. We’re almost as famous as cats on the internet.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2652c1af-a0c7-4619-8526-fef096f50cf1">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="83fff882-cc26-46a1-a185-d4a22058f4d6">
      <Text>I can’t with you, Maya.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a85b6d46-8d69-4f0a-8957-99edadf79800">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b00ad94f-6871-4f99-b9f1-5ba931f470a9">
      <Text>It’s time we get Light Owls in this neck of the woods.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="00b893b0-92cc-446b-ac05-50f75c19b58f">
      <Text>HolLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b8cc68e4-1f5c-4886-b02f-a4716213b7b2">
      <Text>Night owls in Central Park?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="430eda21-1dff-403f-81fc-932c3718cc3e">
      <Text>Rowan &amp; Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="08e116cb-834c-4a67-b913-973cc10d558c">
      <Text>Light Owls.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ab81dfdd-1a5b-4679-9599-8cec9c574f07">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8175d201-8feb-4001-bf8b-be63f126e6f5">
      <Text>In New York City, baby!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="452b6bf2-90a4-4551-bd8d-4a3d0c85e477">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7fd631a8-db37-4c3f-b6f3-148ec1e31a35">
      <Text>It was our childhood band.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="462df0e1-3611-4fe4-ae70-95d37d914b43">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0815bcb1-d59d-4ee6-9f79-1c05b9ebf421">
      <Text>Child... It’s the future.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1533646f-c6aa-477c-9a27-f1f81fec5154">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="663bb6c5-76b0-4693-b5f8-5d39882377cc">
      <Text>The future is not without Barney.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7b4db9e2-98ff-4d9e-8ef0-715c6a346113">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f4af4e4a-38e1-4954-93dc-6a8183a332b4">
      <Text>Barney?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9763435a-dd48-4f3a-b3dd-634d957142be">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d6057868-1d66-4b30-9361-65459b35b069">
      <Text>Her brother and star dancer. Ro, Barney can hop in when he goes to college here.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fe962994-423d-48dc-8cbe-ced9bbab4a3b">
      <Text>Rowan opens the YouTube app on her phone and searches for “Barney and Rowan.” She finds an old video of her and Barney at a small drum circle in Portland, which only has 21 views.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f2ee2a67-b8e6-4841-a468-e6acb300951f">
      <Text>Her phone rings. It’s a FaceTime call from Barney.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a673a3d1-4ce6-4f46-8515-35432f7983fe">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6e35bab5-dd32-4f24-acd1-1eae217d94bf">
      <Text>You should get that.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="4b32f203-5b3c-46f0-9fc0-5c98941f341b">
      <SceneProperties Length="3/8" Page="15" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="BARNEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. ROWAN'S Bedroom - MomeNTS LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="100b6dc9-4d46-438e-b3ca-45269a97183f">
      <Text>Rowan sits at her desk and answers the call. Barney's face fills the screen; he’s in a hotel room, wearing headphones, tapping a rhythm on a table.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="50c97128-a692-43bb-9816-45ab7f2e6ba4">
      <Text>Barney</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd40ef3a-f5b3-4a51-a558-9f5297a120ff">
      <Text>Hoot </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9afe0352-5e9a-45f4-aed8-1c8eebc1437a">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="89a1dab9-c9e8-4758-ad06-676eb361b1e9">
      <Text>Hoot </Text>
      <Text AdornmentStyle="-1">hoot</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1c8421ab-91bf-49af-853d-f38e88ddb538">
      <Text Style="AllCaps">Pre-lap: Call honks</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="2cbdd97a-d22e-41f1-9377-e00f59fb9761">
      <Text>Match cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="fb4a6852-caaa-415c-b25b-e53d3ccc2aaa">
      <SceneProperties Length="3/8" Page="15" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. RoWAN'S BEDROOM - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d6f225a9-10c1-484a-91d0-d70fb9138067">
      <Text>Later that night, the sounds of the bustling city outside make it difficult for Rowan to study at her desk. She looks at an unopened box behind her, where an oversized headphone sits with Barney's name written on them, and puts them on.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="09a66ac3-d859-4992-bc63-be04cbb9e4eb">
      <Text>She opens a music app and searches for "feeling low," which brings up a single result: “</Text>
      <Text AdornmentStyle="-1">Lofi</Text>
      <Text> Guy.” She clicks on it.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="07348173-df55-469d-9e95-7afdfe330695">
      <Text>The screen displays a looped animation of a character wearing large headphones and studying at a desk, similar to the real-life </Text>
      <Text AdornmentStyle="-1">Lofi</Text>
      <Text> Girl on YouTube. The lo-fi hip hop music drowns out the city noise, allowing Rowan to focus on her studies.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="28c77859-c9d4-41a8-94c8-a14f96688295">
      <SceneProperties Length="4/8" Page="15" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Rowan’s Apartment - MomentS LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="66ca19eb-007c-4fc7-890f-3a1919df7b22">
      <Text>Maya is sleeping on the sofa. Rowan opens the bedroom door and steps out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b5c23608-1afd-40f7-9cf5-69a0ca3d0c4e">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e61017e5-512a-49c6-a76d-83a3109a2a9d">
      <Text>I think a parliament is in order.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2221147f-b28c-44d7-87df-683c4c13634f">
      <Text>Maya wakes up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ec2e181-5871-41b2-a077-b86b0116ef31">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2d3df1e0-65e5-42f5-98a7-a237466f9bd1">
      <Text>Watcha going on about? Parliament? Would it kill you to explain any-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8f76079d-5538-439d-869c-96f86727d88a">
      <Text>RowaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a818e9cd-bfa1-4a6b-9db1-8c81f2ee00b6">
      <Text>Parliament is a group of owls, like murder is a group of crows.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f90f0e62-8af0-4656-8ff6-e681b890c9f7">
      <Text>MayA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0bb48ff9-9663-4c97-a40a-6a0fc49d8a9f">
      <Text>Are you saying...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="128249d5-d9f0-431e-b128-ed907b4bbbb6">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dbffdcbb-4a14-44ea-a698-ab71d85c3bd8">
      <Text>Light Owls is back!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2b0ef43d-a1e7-4f2a-bcf4-86e8b27f3e8f">
      <Text Style="AllCaps">Montage:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="0a83b4a4-09e8-4edc-9b18-91f57e56848b">
      <SceneProperties Length="3/8" Page="16" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>- Int. Maya’S APARTMENT - Various - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bc251609-9215-4a97-93f7-83b10b939eb7">
      <Text>-- Holly pulls her banjo and guitar cases out from under her bed.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="64d0ad44-0352-40c0-965d-f3d3807c13be">
      <Text>-- JoJo sorts through a box of found objects: empty containers, a wire hanger, a wooden spoon.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f42d61ad-bd07-4650-bccc-c9cf12f9e85f">
      <Text>-- Rowan sets up her keyboard next to the sofa. Maya helps arrange a makeshift “stage” area.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bc251609-9215-4a97-93f7-83b10b939eb7">
      <Text>-- The group tries different sounds, sometimes clashing, sometimes finding a beat. There are moments of frustration and laughter.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="065a1b38-e9b1-431c-944e-775f9fa90d58">
      <SceneProperties Length="1/8" Page="16" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>- Int. Laundromat - NigHT</Text>
    </Paragraph>
    <Paragraph Type="Action" id="10ab58d7-63b1-49fc-88ac-2f50c6922469">
      <Text>-- JoJo taps a rhythm on a washing machine with a pair of drumsticks. Rowan is there, recording the sound on her phone.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="d50696d0-8f47-48cc-ade9-8ae1aad67023">
      <SceneProperties Length="2/8" Page="16" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>- Int. Corazon’s Home - Portland - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="59de5239-0973-4aa4-aa7c-d38241586f38">
      <Text>-- Barney sits alone, wearing his headphones, mimicking owl head tilts as he watches an old video of him and Rowan dancing on TV.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="a12c72e4-d3d9-49b7-8a52-d8879134d0cb">
      <SceneProperties Length="1/8" Page="17" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>- Int. Maya’s APARTMENT - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7ccfec4c-47fa-4aa1-b28f-0b40ba5a7bd0">
      <Text>-- The group huddles around a laptop, listening back to a rough recording. Holly mimes playing an instrument, and Maya hoot-hoots quietly in rhythm. The energy is productive and cohesive.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="58902d19-771f-4e9a-918a-db6887f411c3">
      <SceneProperties Length="2/8" Page="17" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>- Ext. New YORK CITY STREET - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2b7bf638-d7bb-437a-b7fc-1dbce6a7816f">
      <Text>-- Rowan, Maya, Holly, and JoJo walk together, looking like a united front. Rowan points at a bird in a tree, and they all look up, a shared moment of connection.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="382354b2-ed13-4e24-bc05-218b474ecf71">
      <Text Style="AllCaps">End montage</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="03a84048-fe9b-4c86-95b9-8bc4dfe131d3">
      <SceneProperties Length="2/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Maya'S APARTMENT - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d471f4d7-3b7d-48d1-8472-3170c07e6e0a">
      <Text>Rowan shuts her laptop.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="915571e3-c0fa-422a-b8f2-b1927a1b38c1">
      <Text>RowaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c5b5542d-6fd2-41b2-9fee-2d9719195ef5">
      <Text>And uploaded! Let’s get eyeballs back on us, Light Owls!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3577939b-3673-43ba-b724-4e35b623b23a">
      <Text AdornmentStyle="-1">JOJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5edf3e25-9fd9-4d13-bbeb-13e339f9eeb7">
      <Text>More like ears, cause no one could watch us on the music app, silly.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="03a84048-fe9b-4c86-95b9-8bc4dfe131d3">
      <SceneProperties Length="4/8" Page="17" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Maya'S APARTMENT - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a724af8e-c52d-4f28-a052-252e6ec0e065">
      <Text>Rowan is on the sofa, scrolling through a textbook, but her eyes keep drifting to her phone. Maya and Holly are sitting at the table, a few empty takeout containers around them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="51fc3d2c-9ce8-4b0d-b983-1b8d8039191c">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="b0735111-5fb7-4f42-a9e4-f7e9f7bd931f">
      <Text>(Sighs)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35f9bb89-19cb-41dc-a943-3590104c9139">
      <Text>Two hundred views on Bandcamp. Total. That's across three tracks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="60838851-fc6e-4467-8fe6-c9ed309d9ae6">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="700cc1ff-e65e-413f-9ce9-8430ba88ef15">
      <Text>My cousin in Tennessee ain’t seeing our songs in the search results.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee17f229-21e9-459e-98c6-5bda3d0a0071">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5792981-c59c-4655-be0d-508a4de597a0">
      <Text>I heard nothing from anyone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="86abe543-121a-4b59-a681-1aafd250514f">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="edcd8383-5b7a-424a-b8c9-52fc31f76288">
      <Text>Heard... Herding fans gets easier once we know their behaviors.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2b0ef43d-a1e7-4f2a-bcf4-86e8b27f3e8f">
      <Text Style="AllCaps">Montage:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="158ecd57-b002-4c21-a0be-f214e6d48baf">
      <SceneProperties Length="2/8" Page="18" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>- Int. Lecture Hall</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d120641c-63c7-4539-ae69-aa1d2feb3bfa">
      <Text>- Rowan keeps studying music psychology in an animal class.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5f265e8a-5ae7-4a3c-8015-c0abb830a953">
      <Text>- </Text>
    </Paragraph>
    <Paragraph Type="Action" id="a773c172-863a-4b91-a768-1346e3e68f3f">
      <Text>[Their open-mic fame seems like a one-hit wonder]</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3905e46f-2b50-4ca2-9db3-3c2136918bed">
      <Text>[The videographer earlier makes Maya and Holly realize that they need to make a music video.]</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="03a84048-fe9b-4c86-95b9-8bc4dfe131d3">
      <SceneProperties Length="1 6/8" Page="18" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. RoWAN'S BEDROOM - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d7e34bdc-cab1-47ad-a320-45a1293784d9">
      <Text>The room is a mess of papers and electronic music gear.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="359135e6-efbd-40b7-8f30-97a65cb2ae1d">
      <Text Style="AllCaps">Through the camera:</Text>
      <Text> Rowan sits at a desk, mimicking </Text>
      <Text AdornmentStyle="-1">Lofi</Text>
      <Text> Guy. She wears oversized headphones, staring at a diagram of a bird in a textbook. A red REC icon glows in the corner of the frame.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="80cc1ccd-d5fb-49e5-acb4-7eb8f346f8ea">
      <Text>Suddenly, Rowan’s stoic expression breaks. She looks directly into the camera.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="335c6fc4-e959-47f1-a489-ae8b5f0467dd">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9bf06f5e-db62-4865-9ba1-b59f80bec841">
      <Text>Are we good?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f56e9cd-23a3-4c02-a0d7-c0adcabd40b9">
      <Text>The recording icon vanishes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f56e9cd-23a3-4c02-a0d7-c0adcabd40b9">
      <Text>Maya speaks from the shadows of the room..</Text>
    </Paragraph>
    <Paragraph Type="Character" id="76027c73-93f3-4b8f-8845-c4bd7e3f4fcc">
      <Text>Maya (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="19d221f1-a764-43a1-a6eb-4709530bdba7">
      <Text>Nope. Keep going.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f8aa2dfc-facb-4148-aa9a-9fc5d38d9be0">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5b114dc0-e9fd-40ba-8800-496e2a90b1ce">
      <Text>I don’t look studious enough for you?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dd48fd9d-7d7e-4a4b-84e1-21db38d34de5">
      <Text Style="AllCaps">Back to scene:</Text>
      <Text> Holly peers through the viewfinder of a camcorder mounted on a tripod.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e8820e30-d176-45c7-b83d-5b9dd2b328d0">
      <Text>Holly</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f64bd340-7b2a-4302-89ef-3c46034837de">
      <Text>Stay in the zone, Rowan. For a sec there, you looked like you know what you’re doing.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4df26332-8c94-4822-b86b-4111bc3015ca">
      <Text>JoJo sits on the edge of the bed, absentmindedly drumming pencils against a stack of hardcovers. Maya leans against the bedframe next to them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ae691a4a-cbbc-4989-be99-d198e2fc03cf">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="618e30ff-1948-436a-a194-f3f86b3f0c33">
      <Text>We need a long, continuous take. Don’t break.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e0fc079a-9787-4a51-bed9-95ab3de7f609">
      <Text Style="AllCaps">Through the camera:</Text>
      <Text> Rowan groans and rubs her eyes.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e371dd76-3c3f-495e-94bb-8432b8c99d4d">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8735806a-4277-48a8-8b9b-6ad80f91517d">
      <Text>Can’t we just loop what we’ve got and call it a night?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f9fe7a7-c35b-4604-a485-92b007a72640">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d198dee0-4eed-4407-baa5-ab0812e3ed27">
      <Text>Look at the bird.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a542ddb6-ed90-47e9-afdf-2ea572efb98b">
      <Text>Rowan raises her middle finger towards the camera.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="28f14684-2590-4297-b8e1-a8a33c292097">
      <Text>Holly (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="fbc33cc2-ac47-4579-8df1-3612c8cafa24">
      <Text>Okay... Give me the bird. Sure.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ea7251a5-4575-408e-bfbc-e84d7a918b23">
      <Text Style="AllCaps">Back to scene:</Text>
      <Text> JoJo continues tapping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="501cf3a1-245e-46e8-84c3-b5096ac6a59c">
      <Text AdornmentStyle="-1">Jojo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a886f653-3200-4749-8a30-77f6ac6f1414">
      <Text>The internet knows fake. They wanna see a page turn. Get the </Text>
      <Text Style="Italic">vibe</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="657806b6-ca1a-4e30-9151-bdbbf83ecc03">
      <Text>Holly</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2641936c-f0ae-4c10-9aa5-d1c6b5d3253e">
      <Text>Exactly. Authenticity!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a85e3d94-140e-4074-b6a8-7e7b2a7ca2c8">
      <Text Style="AllCaps">Through the camera:</Text>
      <Text> Rowan sighs and gets back in character. As JoJo taps, the bird diagrams in the textbook morph into musical notations in her mind.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e2e90d50-5680-4026-a781-c5e0b27b7b7b">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ad278c53-ff50-4b93-a225-f068775ec253">
      <Text>I miss playing with y’all. This playing pretend is killing me.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3d56a47f-0d18-47dd-98bd-983177cfaa92">
      <Text>Maya walks into the frame, leaning over Rowan’s shoulder.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3549df2-5c4b-4f21-a0cf-0e7714a0349c">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf946c16-70ac-4018-ac8a-f8e2544e498e">
      <Text>Look on the bright side: we’re giving the nerds what they need. A music video for our lo-fi tracks to survive finals week. Including you. Hoot!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0333b880-f0ce-45e4-880c-379bcb6662f4">
      <Text>Maya adjusts Rowan’s headphones and steps out of the shot.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7939b4f3-c923-488b-9b0c-f118cd02f7da">
      <Text Style="AllCaps">Back to scene:</Text>
      <Text> A Light Owls lo-fi track overlap the scene. By the bedframe, Maya is harmonically hooting. JoJo's pencil-tapping sounds like a </Text>
      <Text AdornmentStyle="-1">cajón</Text>
      <Text>. Holly is mimicking a violin with another tripod. She hits the record button on the camcorder.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3c1df738-ffbc-4874-9289-abe614b23666">
      <Text Style="AllCaps">Through the camera:</Text>
      <Text> The </Text>
      <Text Style="AllCaps">rec</Text>
      <Text> icon reappears. Rowan flips a page on the textbook.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="0eaa1b7e-926b-442b-b2cd-36f5afce6be5">
      <SceneProperties Length="3/8" Page="19" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Computer Screen - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="041960c0-d55c-47e1-be5c-bfe92a7c92f3">
      <Text>Light Owls track continues playing.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="041960c0-d55c-47e1-be5c-bfe92a7c92f3">
      <Text>A cluttered desktop is filled with files: animal-behave-final.</Text>
      <Text AdornmentStyle="-1">pdf,</Text>
      <Text> lab-results-v5.</Text>
      <Text AdornmentStyle="-1">pdf,</Text>
      <Text> lab-results-v7.</Text>
      <Text AdornmentStyle="-1">pdf,</Text>
      <Text> etc.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cb61bcd2-35e3-4b80-a1af-cc937732f1f2">
      <Text>A cursor drags the “poor-rowan.</Text>
      <Text AdornmentStyle="-1">mp4”</Text>
      <Text> file into a YouTube upload window.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="161c4dfc-15b5-414a-83c2-de7ebb3428e3">
      <Text>The progress bar crawls forward. The upload hits 100%.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="10be7062-672b-4563-9973-59e073cc56f8">
      <Text>The track ends. The screen goes </Text>
      <Text Style="AllCaps">black</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b22e5fd5-98a6-4170-bc8b-f8ec499acfbf">
      <SceneProperties Length="1 6/8" Page="20" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Living Room - ContinUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d4080875-a7a5-4eb4-a21f-42110e60b5fb">
      <Text>We see a laptop shut off. Rowan slams the laptop lid shut.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e78d274-9d7f-4368-bb0e-12754bf56856">
      <Text>MayA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ed3c553f-3787-48b7-bde0-ffacc7c29916">
      <Text>Go to bed, girl. You’re done.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3a595e1d-6b20-49c2-aa57-e3aeddbb6b5b">
      <Text>The laptop sits on a table, pushed aside to make room for a mountain of empty takeout containers and Holly’s violin case.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1a0620e7-126b-4ea7-aa5f-49545e2eed4e">
      <Text>Rowan collapses, draping herself over Maya and Holly on the couch. JoJo is already dozing off next to them.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="34eb9341-c464-4377-bd88-0e6f9ca775e8">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e8280b62-5ed4-4cc3-845f-08fc04d99c4e">
      <Text>I’m so done with you.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="aa4d7480-6450-4a39-b268-7020ea07e506">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1caf68f9-2baa-4d69-bb2d-4ac4dfe4a428">
      <Text>JoJo is done with all of us.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f66082fe-2e70-40f8-a836-b0b6c5ff4b6c">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="18f67dbd-49b6-4dc6-a2a0-2cc15bf8e602">
      <Text>(Muffled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6ddf7623-661d-4232-9010-cbb3878a7104">
      <Text>You think a Light Owls music video will get more views than our first album on Bandcamp?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6d43fd5a-89e3-4a2e-8783-e58b6f9b28dd">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f51cefc8-61f5-4f62-9456-89af4d168975">
      <Text>By the laws of our lord </Text>
      <Text Style="Italic">algorithm</Text>
      <Text>, a video has more reach. Fanatics listen to us on Bandcamp. Addicts shall watch us on YouTube.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2afaa8d5-4030-4de0-a16e-f023940de4d9">
      <Text>Holly checks her phone.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d8f154aa-95ad-4dcf-a9b5-bc333cb0ed48">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="bf823e03-997f-47c9-9433-52675469f4bb">
      <Text>People are hitting up the chat. Hmm... Someone just asked if the bird in the textbook is a hint we’re releasing new tracks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8b4ee784-7b9c-4744-9f31-008a5225f778">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5864c0b3-89d4-47d4-8a61-fbc2c2cdec61">
      <Text>It’s a hint I’ll fail ornithology.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a80c3328-12ee-4a28-b055-6b7f1e4cba37">
      <Text AdornmentStyle="-1">JoJO</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="529db2ba-e544-4c6b-9741-a4f9bb11a621">
      <Text>(Murmuring)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0018dc83-979c-4193-9495-d5b21f693ed6">
      <Text>Word is... bird is the word...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="af2aabfe-d543-48a3-b966-917170fe9540">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="85072407-0037-484a-8390-e7995cd94e93">
      <Text>What new thing do they expect from us? All we do is hoot.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="12aae3c0-2000-4152-8de9-ac6b65e802b0">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="129ba3b6-1c1b-42b4-bfe9-1436484030ee">
      <Text>Maya. That’s your thing. While I... </Text>
      <Text Style="Italic">pull the strings</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="26b00a6e-3766-444b-b54f-54d5981a5534">
      <Text>Holly motions like she is playing an invisible violin.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c70d29c6-6fe6-48c3-9a9c-2cd4dad20643">
      <Text AdornmentStyle="-1">JOJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ba919d2b-46b0-42c5-973e-fc3263e4d90a">
      <Text>Holly. You fiddle... around...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f7654698-7018-46a4-963e-ca41c1a749c7">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="092e3161-e6d2-4d52-a3f3-e90475313ca7">
      <Text>JoJo... You’re good a drummer as you are sleeping.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="74057a83-eb1c-4857-bcf1-e4fd4b109ab9">
      <Text>JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0885f9bb-b315-41a5-9a83-49564391dfd2">
      <Text>I ain’t... sleep... good...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f1edcfa1-9111-4033-8417-8381c704a9ca">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9b4c324d-0432-4000-8242-5a7c6ce66d89">
      <Text>Rowan, seriously, go to sleep. Animal behavior’s your last final. It’s soon. Don’t animals sleep too?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2bacc3f5-eeb0-4eb3-a41b-293c7484cffe">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e8cb44d2-dd22-44d7-a599-52e9d417557f">
      <Text>All animals sleep.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ecc6c205-bc13-466d-ac7b-27c2aa404fbc">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="47fb338d-deb2-4c30-840c-d873db361fb1">
      <Text>But the songbirds.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0f04fb7c-cf08-4afa-bd1c-3994b0a37b73">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="212a90c3-0202-4bfe-a7eb-fabe9ce2d97c">
      <Text>Light Owls will get there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9e3396dd-5468-47df-929b-508a373f801c">
      <Text AdornmentStyle="-1">JOJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c241d6e3-6970-4ec5-9c98-917ff4c6be08">
      <Text>Last hoot before we hit dreamland?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0a51424d-89b4-493f-98fb-ed5a6167c57a">
      <Text>The bandmembers harmonically hoot into the night.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="522f8a8a-3367-4ddf-b9f1-2399c6f849ee">
      <Text Style="AllCaps">Montage:</Text>
      <Text> We see various high school and college students study with Light Owls on their desktop, tablets, phones, or on a browser tab.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="36af897e-62b1-46fb-a7cc-2afcb6e721de">
      <Text Style="AllCaps">End montage</Text>
    </Paragraph>
    <Paragraph Type="Action" id="60261a57-ff3b-4940-a8e1-f26be7076f89">
      <Text>The hoots grow frantic. It morphs into a phone alarm.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="76a8eecf-bbb1-4439-a1ac-cc94644108c4">
      <SceneProperties Length="2/8" Page="22" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. ROWAN'S BEDROOM - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="45487cb5-cf0b-492b-aa02-f77f9f1503b5">
      <Text>The phone reads: 10:21AM. Rowan’s hand hits snooze.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f3f36489-f02e-44bb-b94d-eef46e44f458">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="6fdb2a47-33ae-4055-a38f-5b0abd27bfb5">
      <Text>(Murmuring)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8007145a-aa8d-4a11-a561-5a135df016ef">
      <Text>Hoot... Hoot...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2b2cb6ea-ccbf-4882-bf66-f495badc70bd">
      <Text>Rowan looks up. The phone suddenly reads: 2:54PM. Rowan freaks out and dashes off.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="32a08695-4d28-4509-9256-3708bb25d260">
      <SceneProperties Length="2/8" Page="22" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Subway Train - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9d7bf615-b720-404c-abe2-399f43621b5c">
      <Text>Rowan frantically reads through a textbook. She reads through a section about peregrine falcon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b1efc6e4-cc12-47b7-b049-2deb108d3a83">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="336ef1df-7acb-4207-a5a1-7c994a607782">
      <Text>Peregrine falcon can dive over 300 kilometers an hour. If only Subways can go a fraction of the speed...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="15edc50b-fe82-4155-8ceb-cc2725235e47">
      <Text>When the train reaches the Hunter College station, she exits.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="d84d0d40-aad4-4acf-9d63-830b2f473adf">
      <SceneProperties Length="6/8" Page="22" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Hunter College Gate - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c7c99ccb-2cd2-44bf-883c-3464a4f7aaa8">
      <Text>Rowan stands frozen as </Text>
      <Text Style="AllCaps">students</Text>
      <Text> stream past her. Then, the </Text>
      <Text Style="AllCaps">teacher’s assistant</Text>
      <Text> approaches.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="52d83195-4e82-4955-994c-fd7a8c4b0a07">
      <Text>RowaN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a5598d93-39f7-403d-9820-65a04b4768f4">
      <Text>I’m so sorry I’m late-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8898d04c-fe4e-4f65-a824-4c7427a72a2e">
      <Text>TA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ea094d4-cb2c-4fc5-8c4c-2ff2b6324078">
      <Text>Hibernating? It’s unlike you. But it’s what happens when you stay up ‘til 6AM.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d70b05ed-cc38-46aa-a73d-51c189018e7d">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ce2bc93-739a-43bd-85d1-b6b20ad2ff53">
      <Text>How did you know-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3a922e7b-dd58-4927-ae84-a216126fa581">
      <Text>TA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="82be49a5-b3d5-4fa8-88e7-c46e6d0c34b4">
      <Text>Light Owls uploaded your music video ten hours ago. I enjoyed it. It helped me prepare myself for proctoring today’s final.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a9e66541-716a-484e-8275-69a07a6af07a">
      <Text>Rowan almost passes out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="44dbfcd6-9d71-4931-800a-c80b06f51496">
      <Text>TA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0739b8ed-c820-4907-971a-0aab603b14eb">
      <Text>Final’s not final. You have another chance with the make-up exam. Maybe you could use your track to put yourself to sleep earlier?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="589d2c68-890d-4948-9c2b-04ee89c4b70e">
      <Text>The TA walks away.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4377e5c-391e-4149-8635-affb76aa6f85">
      <Text>TA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e1ab1422-fe0f-42c7-9dd6-d1f322d8d337">
      <Text>Be on your best behavior!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8239004e-a8ca-4924-8bb8-aabcfcfcd7b2">
      <Text>Rowan stands frozen.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="39c9c939-338b-4d88-bbb1-96769d413372">
      <SceneProperties Length="3/8" Page="23" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Subway Train - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c5637c73-5cdd-4f19-ad13-e3b6897434a7">
      <Text>Rowan sits pressed against the rattling window. She watches her reflection in the dark glass.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="809370db-982b-4f4f-8521-f76e05e77f42">
      <Text>Next to her, a </Text>
      <Text Style="AllCaps">teenager</Text>
      <Text> wears oversized headphones. Their eyes are closed, nodding to a rhythm Rowan recognizes. Rowan reaches out, her hand hovering near their shoulder, wanting to ask: </Text>
      <Text Style="Italic">Do you see me? Or do you just see the girl in the loop?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3694a84b-12e7-4b31-bb70-9480d19b75fc">
      <Text>Rowan pulls her hand back.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="02d7e53c-7169-41fd-bdca-e0a032cab5d3">
      <SceneProperties Length="6/8" Page="23" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. Maya’s Apartment - EvENING</Text>
    </Paragraph>
    <Paragraph Type="Action" id="87dfb563-b214-498c-a684-e12fef670d39">
      <Text>Rowan knocks on the apartment door. Maya opens it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="92023aa0-3903-4c9f-ad6a-aaac204b48d5">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3d09a7e5-3d5c-477c-9086-a5b033b43371">
      <Text>What do they say: like shooting fish in a barrel?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="2b31308d-654f-483e-80d2-98b912e7e5ec">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b49810ef-c748-4f0e-a5a7-51c979fd995f">
      <Text Style="Italic">Like shooting me with a barrel</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7c4cb9c5-9b6a-4297-a282-799ac857cafd">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13cf56b7-41b8-42c0-be24-efff09eb8d44">
      <Text>Um... Sounds like finals went well.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a8a40191-28af-491e-8ec1-018ab63dff2f">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="40ac3b86-2bdb-4976-8c68-9541b04c9b23">
      <Text>Well...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ae49858c-6518-4dfd-9fcd-8c1a788f414d">
      <Text>Maya pulls out her phone and shows their YouTube video.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5f1e3def-755b-418e-8ce7-beb46fc159a6">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="16a28af2-8caf-4a9a-a351-7edc01f4e3bc">
      <Text>Here’s the cherry on top. We’re trending in three continents, especially South Korea, studious people there. We’re more viral than Lofi Guy!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4105ecc7-fa35-4445-a3b3-eac341750258">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="366935ac-b9b2-4330-b281-d0f778ad0ca1">
      <Text>I lowkey don’t...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5205460a-447f-4bd1-8075-92de5bf467f8">
      <Text AdornmentStyle="-1">JoJO</Text>
      <Text> (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="db42a9d4-df0c-47e8-8302-0378792c3df9">
      <Text>Lowkey don’t what?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0fc400ea-7002-4ba8-b31d-fb939ed81541">
      <Text>Rowan turns around to see JoJo and Holly in the hallway. They got snacks in hand.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd3036ca-eb63-48f5-9ff6-04da192a9681">
      <Text>Jojo</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="0c732c11-0172-4fb5-ad5f-4cbb6619c1e2">
      <Text>Lowkey don’t wanna wait for this party to get started!</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="12669374-03fc-4119-a72d-c680247edcd7">
      <SceneProperties Length="1 7/8" Page="24" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="HOLLY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="JOJO">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Maya’s AparTMENT</Text>
    </Paragraph>
    <Paragraph Type="Action" id="45dcd99c-b7fd-4815-b55e-a579a0e4b143">
      <Text>With snacks on the table and everyone seated around, Maya shows their Light Owls study video on the TV.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cfbd7f85-2771-4420-8251-270502860075">
      <Text>HollY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="01e6dcca-95ea-479e-8596-9d5da1766c59">
      <Text>Light Owls strikes again. We’re getting everyone studying.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fb60dc78-4735-4ad6-b83e-aae80df9752b">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="feecb055-38b5-4245-99ce-10dadebe9674">
      <Text>It’s a public service.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7d3d2003-f46c-46db-9239-8b1baf8e0c2c">
      <Text>JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ff1e45a6-eaa2-48dd-95ba-0a67e78dec90">
      <Text>And the ads will make us money!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f2c065e5-2ba7-4de5-b99a-835b59d3a8e5">
      <Text>RowAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e2a87cd-d8a7-4efa-9b89-a9fa24092ee1">
      <Text>Light Owls is helping everyone succeed...</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="c461bb09-a859-45b4-9733-ff6e5eaface5">
      <Text>(Mumbling)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c237824d-7999-4ee6-91d0-e6f54eaf21f5">
      <Text>But not this night owl.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7793e901-3bc0-4189-b2d7-11c71ef7b42e">
      <Text>Rowan’s phone receives two notifications. A Hunter College email about the makeup exam and an email from a producer.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="955fc95a-3c00-4bb0-9867-31394476b660">
      <Text>She reads through it and checks the date. She reads the other email from an acclaimed producer.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="caf37191-0f62-4de3-a124-dfb43c0efbc2">
      <Text>The producer offers Light Owls a licensing deal and would like them to meet with them on this date, the same date as the make-up exam.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7f112e8c-3eb5-4c67-b430-30abc47c807e">
      <Text>Rowan looks at her friends and almost says something.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="cff6e69e-d90b-481b-9662-599601ce04a2">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="aabf41cd-5318-4c88-a754-2da8521d0ef5">
      <Text>You’re shaking...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b511943c-6b5c-4cc2-b9e9-795f7cca7d7c">
      <Text>Rowan hides her phone. She looks at the TV, where the digital version of herself is eternally flipping a page.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7ce641e3-a9fd-4ee0-957f-5eb39404cc91">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="c6a928d8-8ff4-49f4-bb03-d16d9a82162a">
      <Text>JoJo’s base always gets to me.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="18167cb6-1d24-492a-84c5-66a1526a8023">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4500c755-8d3e-4908-96eb-4682b1f3d3f0">
      <Text>Our future can be so basic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1b2d22f3-f915-49b9-a501-a9d284428e4d">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b166b6c-8aee-4dd7-ba6b-b288cfb52b23">
      <Text>No more takeout.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4068f0bc-30a1-4dd0-9d95-452a36f19373">
      <Text>JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f9aa21e4-2bef-4c91-9311-baad1af04a50">
      <Text>All you can eat.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="86b8b8a9-ab0a-478b-abe8-a0027734cb0c">
      <Text>JoJo taps a rhythm on the table. </Text>
      <Text Style="AllCaps">Tap</Text>
      <Text>. </Text>
      <Text Style="AllCaps">Tap tap</Text>
      <Text>. Holly joins in, rubbing a bag of snacks. Maya shares her vocals. The room becomes a microcosm of sound.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="86b8b8a9-ab0a-478b-abe8-a0027734cb0c">
      <Text>Rowan feels the vibrations settling in her chest. She stands up abruptly. The rhythm breaks. The silence is thick.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46d28658-3dd8-407e-8ddf-a67d81d8ac96">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="13183564-7ce2-4cca-823a-0cfec0f2619e">
      <Text>Rowan?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d4c5d4d0-85ac-4c72-bc23-189e5a519bd0">
      <Text>Rowan walks to the window.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="fc5638a6-6c61-45bd-932f-58569668e60a">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="669391bb-76bb-4fbb-af03-63e1ccc4f99f">
      <Text>I’m a textbook bird, y’all. I seem real, but I’m really just ink.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5c09fdce-ddfd-4671-9589-e11ac087e422">
      <Text>JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a4bd5df9-8ec9-40df-bbe0-424ec696899f">
      <Text>You’re coming around. Birds aren’t real.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a113972c-e482-4483-9f09-c20c814229bf">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="9a78746a-3a62-4ff8-b104-251362068cc7">
      <Text>That’s a conspiracy theory...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="43bfb658-6ad5-424f-b43f-9e9a0e65302f">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="750804a5-83c2-4c67-afc9-331bebcfabe7">
      <Text>Shut it, you two. Ro... Ink don’t make music. You do.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f9777337-256d-4c4b-834f-9c7b9e3e3ef7">
      <Text>Rowan looks at her reflection in the glass, then at the two notifications still burning in her pocket.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bb0b7fad-6d9c-40d7-9d61-96ace65d3acd">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="20d2a061-d2a9-4375-bf04-6a83a1aad3ba">
      <Text>I needa go.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e0399ea7-e3a5-4dd9-9dce-0cbbb94f89fd">
      <Text>JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7d5f42b6-ffad-4bad-bd76-b1deb418a934">
      <Text>The party’s just starting.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1a3cf91d-c85f-42a5-a30e-67cd5140ea33">
      <Text>HoLLY</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ccf6edc3-3320-4e17-ba7f-cce2d2f2052e">
      <Text>The party’s loopin’.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4790d2f1-d313-4a0e-a3ef-04da1f47887b">
      <Text>Rowan exits without another word, leaving her friends in the glow of their own success.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6855e4bf-7ad9-466a-b0bd-e9450e18fed4">
      <Text>JoJO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ddb147bd-87ed-41df-85bb-3b7a39565469">
      <Text>Thinking about it, having that on loop gets awkward.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="d92a4d6a-3972-434c-8186-9ad2b10aa6cf">
      <SceneProperties Length="2/8" Page="26" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. New York City Street - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b77766fa-5bc3-4c4b-9f14-27e9214e78ea">
      <Text>Rowan walks quickly. The city sounds are audible: the hiss of a bus, the clack of a manhole, and the honks. She pulls her clothes tighter. She stops underneath a streetlight and pulls out her phone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="28a9dd23-e94e-413d-af40-d1a069bc3050">
      <Text Style="AllCaps">Close up: </Text>
      <Text>Her thumb hovers between the two emails. The Hunter College logo versus the producer’s golden digital signature.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="613d8df6-ae6c-4d0f-b99f-e9fce9e3b948">
      <Text>No clicks. She feels the vibration of a passing subway train.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2a3d1331-ad68-47b4-9374-d056df51d8fb">
      <SceneProperties Length="3/8" Page="26" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Record Store - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f8881763-fbee-460d-b0e9-9559bac32444">
      <Text>Rowan wanders the aisles. She runs her fingers over the vinyl records. The </Text>
      <Text Style="AllCaps">zips</Text>
      <Text> of flipping through the racks is rhythmic.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a38aae4f-069d-4c91-a1ce-dc1ea898b419">
      <Text>She stops and picks up an album with a bird on the cover. She presses the cool cardboard to her forehead, closing her eyes.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c2594fe7-ab55-4769-b4eb-0694d8741be9">
      <Text>A </Text>
      <Text Style="AllCaps">clerk</Text>
      <Text> watches her. They are wearing the same oversized headphones. They recognizes Rowan. They don’t speak. Instead, they just tap their heart and give a knowing nod.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="84313b81-1f30-435f-8a94-d778c54e4b8f">
      <Text>Rowan realizes she is a symbol now as the “Light Owls loop.” It crushes her spirit.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="9d25cedd-2e92-41da-893c-e04e003959cb">
      <SceneProperties Length="2/8" Page="26" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Rowan'S BEDROOM - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e34a2be4-f077-4c2b-b95c-6006efc7a5b0">
      <Text>Rowan places the vinyl into a vinyl player and starts it up.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="347ffc7a-020c-48b9-903a-41dab7d9d349">
      <Text>She sits at her desk and studies. The vinyl player becomes one of Light Owls tracks. She could not get it out of her system and goes mad.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="361b4388-ecca-406e-83eb-b90b0ef48963">
      <Text>She dumps the vinyl record into the trash.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="a6a4aeed-151b-4001-aa33-eebbe74e2f95">
      <SceneProperties Length="1 3/8" Page="26" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Library - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="cdec0953-2010-48ae-aaec-cef4f9b6f4bd">
      <Text>Rowan sits at a table with textbooks and a notebook. She sees someone in oversized headphones watching the Light Owls video.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2b93f407-f393-4158-9351-765622535ff4">
      <Text>She takes out a pen and draws an owl in the notebook. She rips the paper out.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="46821a13-6a43-4d28-9c59-d2d2af7eece6">
      <Text>MaYA (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3f7ecdd7-3316-476d-8a18-8b3d122818a9">
      <Text>I thought finals were done?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2d327e9c-625b-47b5-a1dd-15d55ce5ac47">
      <Text>Rowan turns. Maya is standing there by the shelves.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c142efc3-560b-4ff2-b439-a5d5cf3ff1e3">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8873fc3a-7841-4c41-b239-aadc5563c1a4">
      <Text>How do you know I’d be here?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="5e2a5bec-e75d-472b-9e62-e73b37926e4e">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="03db874f-438c-470b-9add-7f2ffad0b6de">
      <Text>If a bird never knew a life outside the cage, they would see the cage as freedom.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7428be08-0af3-4ca5-b150-1ce0985fed82">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b5afd83-021b-42cf-b7e7-d19cf7bf4f29">
      <Text>Wise words...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b3e0d4ea-9a72-4d8c-9827-9a1038746290">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6b0a4543-e991-4e70-963d-ffd06f8f10c6">
      <Text>Not really. I may have heard it from some podcast. Anywho...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="442b7d4f-95f7-4c6f-b3b6-17fa1c771e68">
      <Text>Maya sits across from Rowan.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="069870bc-5ae9-4735-a758-2d0d46dcd71b">
      <Text>Maya takes the owl drawing and adds a speech bubble. She writes: “Break the loop?”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="be30ba49-ccfc-4361-ae78-7dc569404f39">
      <Text>Rowan takes out her phone and shows them the producer’s email. Maya goes from perplexed to joy.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93ce2fdf-fee8-4f17-9afb-77a228347d37">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1126b913-8fb4-4c1a-b1ab-7529c9df9689">
      <Text>Was that why you were shaking?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="3933864f-77e9-4985-91fe-4cf4b81abe19">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a2f1d2bf-20ef-47e3-9da5-b22511db2928">
      <Text>No...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e2b93711-345d-45fd-b46b-7c7c86f3332a">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3e016229-6cd7-493d-9164-13db81b5c1ef">
      <Text>Wow, it’s soon. It’ll have us all shaking. You should answer their email...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e1d8c814-ffa5-4dd1-8dfd-6b1f25210d48">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="59b51e73-cb6a-4d70-9d51-6017e0878516">
      <Text>I should put answers on my exam this time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4494f5a3-0075-4a7a-99cd-eab3fec8a967">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4b25f89b-d9bb-43be-aebf-afa02463a75b">
      <Text>So you failed?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f5d14fb8-e844-48d4-bda4-e473726f3b5a">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8ec7fa52-78e1-434c-803e-219d87ad86a2">
      <Text>Worst. I didn’t show up.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6e204264-28e8-4722-bea0-9d6d1519a8b6">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="27169ba9-1ddd-47d5-aee0-f8536a7a60e4">
      <Text>And you think doing it twice with this producer would give us a nice track record?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d008649a-72f4-4161-9af8-749fb65153f2">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="19954c3b-bb0a-4496-989d-ea5f675d559e">
      <Text>The make-up exam is the same time.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ae23b06e-fc60-4e74-9d51-652c8305dce5">
      <Text>MAYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="236dd958-7c32-432d-9c39-6f0386cf42fc">
      <Text>Couldn’t you reschedule?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6835434a-3101-40ca-83c8-719279dc5f33">
      <Text>RoWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="28511bc4-30c1-4326-8e40-5d1037aaf0f9">
      <Text>The make-up is the reschedule!</Text>
    </Paragraph>
    <Paragraph Type="Character" id="082c5c2c-6181-488d-b40a-6eb75dee2d0f">
      <Text>MaYA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="322c9dba-3298-4372-aada-9587010b2ee0">
      <Text>No... This producer... The almighty-</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="0f86da99-5764-4cee-9ce4-2de416ecc425">
      <SceneProperties Length="5/8" Page="28" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Music Producer’s Office - Day (Imagination)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dcfa6d2b-4edb-42ed-8d2a-9720093c53f0">
      <Text>The world of white marble overlooks a skyline. </Text>
      <Text Style="AllCaps">Producer</Text>
      <Text> (40s) sits at a desk, with much of their face hidden.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8ac915d6-9a9b-4151-886b-c4594a068a5e">
      <Text>Their mouth moves, but no sound comes out. Only white noise.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f4751aa1-160f-4af3-a163-da51d6b4e1a4">
      <Text>Rowan looks down at the desk. The tablet has a contract.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0b6bf77d-62e4-4c27-8dbe-b317437f66b2">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="082dee1e-263c-48b8-85d3-c98956ee266f">
      <Text>Hoo-hoot.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="028e09e8-a485-4ca5-9ef1-f8edb9ad8a5f">
      <Text>Producer smiles and points to the signature line.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="06d4f67f-e666-4991-a80f-14cba39e1565">
      <Text>Rowan tries again, her throat tightening.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ea812930-9521-4863-ae22-0fd8c9e0e691">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="07071907-7acb-4379-93c3-e168470dca2a">
      <Text>I’m not a— Hoo-hoot.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d46f85cd-70b9-4f9b-a642-897ec3250cbc">
      <Text>The tablet shows the girl from the video: frozen in a side profile, wearing the oversized headphones and flipping pages</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f9ab3706-f39a-4be0-829d-df9512915ea9">
      <Text>The producer taps their watch.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="2a0448ca-2502-4570-bbdc-bdabb5e40385">
      <Text>Rowan opens her mouth to scream, but the only thing that comes out is silence.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="168c8145-b5ba-480a-b85a-f507893d7cd9">
      <SceneProperties Length="1" Page="28" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Library - Continuous</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7aae8866-e38b-44d2-8825-1fe88124b39c">
      <Text>Rowan blinks, the imagined office dissolves into the library. The producer’s watch’s ticking is replaced by laptop hums.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="65621ebc-ad0a-4e15-bf77-b4c62780fe70">
      <Text>Maya is still across from her.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="b7a3fc09-5066-4f60-a1b7-3d7ea2d7537d">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e15517b3-6478-435c-b539-75af85e7e53b">
      <Text>I won’t ask a mogul to move their schedule for an undergrad who can’t wake up for an alarm.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="bd20b27b-b245-4d8e-b27f-31eddc45e8f6">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="35749c67-a1aa-4662-acc5-1f09a80a0d0d">
      <Text>Then choose. But Rowan, look around.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9c3e0b28-6dd7-4867-8300-72acca56dda4">
      <Text>Maya tilts her head towards the sea of cubicles. Rowan follows her gaze.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="989eb0ed-d22b-4776-b6f3-ce0f2a3d53c5">
      <Text>A few tables over, a student with tired eyes has a browser tab open: </Text>
      <Text Style="AllCaps">Light Owls</Text>
      <Text>. In the corner of their screen, the digital Rowan flips her page.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6573e100-4d93-4a6f-a922-0ad9f7ec5843">
      <Text>Further down, another student face-down on their notebook has the video playing on their phone, propped up against a cup. Rowan is everywhere. A thousand versions of her, all studying perfectly, while the real one sits paralyzed.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="deef2e52-0d6f-4d35-af66-0a0530cdc3b2">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="b16022ae-7e49-4593-b6bd-fd0b707aa6e9">
      <Text>You’re already helping them pass.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d37bc8c7-e579-4150-a11d-b3a5deb00e1e">
      <Text>Maya leans in closer, her voice dropping to a whisper.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e05bba3-423d-47b5-8aca-fc5a37bcfe25">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="89dcd462-5355-4b0d-9b45-14bd9a44d479">
      <Text>Who’s gonna help you?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="332da96a-335e-48ff-a2ac-26d8b2be992c">
      <Text>Rowan looks back at her owl drawing. The “Break the loop?” speech bubble feels like a dare.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e770bc29-dba4-4b9a-b102-cbd4a8f55ec9">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8c2a6abc-fff3-46e4-9b57-68ef6551bff9">
      <Text>The bird in the video... she never finishes the chapter. She just keeps reading the same paragraph over and over.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1f408479-ff2b-491a-9a28-00ce99f7f902">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dccbe3a4-0529-4fa4-a09b-ba6a4d472446">
      <Text>Sounds like a hell of a way to live.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c801f5a2-2a0b-4f19-a925-8c47d7e8bea6">
      <Text>Rowan picks up her pencil. She circles the word “Break” until the tip of the pencil tears through the paper.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="af95c554-df4f-4d33-879c-cc7ee5ada69a">
      <SceneProperties Length="3/8" Page="29" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Subway Train - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="05f7d853-0639-465b-8b68-87599f6c7a79">
      <Text>Rowan sits hunched over with an animal textbook.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="de8fe8f0-7168-4eef-8140-12e16bad9a2d">
      <Text>She turns to a page about </Text>
      <Text Style="AllCaps">Migratory Patterns</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b9291826-183c-4b31-aa10-d8fca84207a6">
      <Text>Her pen hovers over a diagram of a bird’s flight path.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="48ee2132-97a6-42df-9ed2-06cbf2addec0">
      <Text>In the margins, she writes: “Static wings on a paper sky / I’m tired of the view / I’d rather fall than fly in a circle with you.”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="dffc013d-195e-435d-9274-e1a48473f672">
      <Text>The train wheels grind against the track and </Text>
      <Text Style="AllCaps">wail</Text>
      <Text> like Holly’s violin when she pushes the bow too hard.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="d3e4f18a-0d86-43ea-8a6d-74a1a36e6fd3">
      <Text>Smash cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="22f0620a-ca8b-443e-89ee-12d2f9086bd3">
      <SceneProperties Length="1/8" Page="30" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Rehearsal Room</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5ced79c7-9c0e-4db7-9dcc-ecec4009c27f">
      <Text>Holly plays the violin.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="4b2aef07-5174-48b8-ba84-2487c0292d2f">
      <Text>Back to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="2334c7a2-3cce-485a-bf5e-6fa60cf95f53">
      <SceneProperties Length="3/8" Page="30" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Subway Train - Night</Text>
    </Paragraph>
    <Paragraph Type="Action" id="07f35283-f7f8-415e-8f16-638a81514132">
      <Text>Rowan’s eyes light up. She fumbles her phone out of her pocket, hits the voice memo app, and thrusts the mic towards the rattling window.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4c5aa12e-2e0d-4678-817f-0f34fa481d75">
      <Text>The train screams again. Rowan watches the waveform dance in jagged peaks across her screen.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f48f0805-9356-437b-9ea5-bd555ff4d565">
      <Text>She hits </Text>
      <Text Style="AllCaps">stop</Text>
      <Text>. She renames the file: final_final_v1.mp3.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4d65c6c8-6db2-4e32-a891-52d3f3e0cae8">
      <Text>Rowan leans her head back against the vibrating glass, with a tired smile. She looks at the “Migratory Patterns” diagram, then shuts the book.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="f05f72b6-cd73-4eba-82e3-798b54d1ccfc">
      <SceneProperties Length="2/8" Page="30" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Int. Rowan’s Bedroom - Day of</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6f65a633-67d9-497c-86b7-68cebca4f864">
      <Text>10AM. The room is bathed in sunlight.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1ea03ac6-79ab-46b2-b2ff-d2e79d063cca">
      <Text>On the nightstand, Rowan’s phone trigger two alarms with clashing rhythm and sounds.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d80e88dd-c68e-401a-83d4-38fd295150db">
      <Text>The screen flashes:</Text>
    </Paragraph>
    <Paragraph Type="Action" id="14ef4ff9-0bcb-44f5-928c-4e1d8cfa98e7">
      <Text>10 AM - PRODUCER MEETING - MIDTOWN</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="b1bf5623-be55-44b8-8bae-97a705e3040b">
      <SceneProperties Length="5/8" Page="30" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="DIGITAL ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>10 AM - ORNITHOLOGY Final - RM 254</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5d1aac99-4f17-4c73-a505-cf2d710c388f">
      <Text>Rowan sits on the edge of the bed. She is already dressed in her lucky academic sweater.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="017eced9-081a-4bc6-8134-d23e82bd13d2">
      <Text>She looks to her side: the electronic gear, the wires snaking like vines, the glowing interface of her creative life.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4553f911-a843-408c-8dd4-1ed48da2c10d">
      <Text>She looks the other way: the animal behaviors textbook with its weight of facts and feathers.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="69c4c9eb-7c92-4405-812a-9a5cdb7b812e">
      <Text>The alarms continue to scream. The “Light Owls” hooting ringtone overlaps.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d86e23d3-de5c-4142-9759-cc6e1c2d977b">
      <Text>She picks up the phone. Her hands are now steady. She opens YouTube Studio. She finds the “poor-rowan.mp4” video with its countless views and what turned her into a digital statue. She opens settings. Her thumb hovers over the </Text>
      <Text Style="AllCaps">delete</Text>
      <Text> button.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="494b2a12-8057-40a4-861f-e3487abc0607">
      <Text>She stares at the frozen image of herself. The digital Rowan suddenly takes off her headphones and turns to real-life Rowan.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e9856387-70d0-4baf-b2d2-488f7e4ec626">
      <Text>Digital Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8a70e902-a33e-4a28-a99c-c8753a464249">
      <Text>You’re a hoot.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c1502149-3045-4b89-97dd-088fc622adb3">
      <Text>Rowan does not delete it. Instead, she swipes out and into an email app. She hits </Text>
      <Text Style="AllCaps">compose</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="aa42f745-2b28-43ed-a7fd-b0cdf2028f56">
      <SceneProperties Length="7/8" Page="31" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="MAYA">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PRODUCER">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Recording Studio - Later</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f9ae2422-c716-4a3f-aad2-b45382dff13d">
      <Text>Soundproof foam fill the space. Through the control room glass, Maya and Holly stand in the booth. Maya adjusts a mic stand while Holly tunes her guitar. JoJo sits on a cajón, with pencils in hands.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1d60d5d3-0c08-4954-b05c-3f308eb782f2">
      <Text>On the other side of the glass, Rowan sits by a soundboard.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="30449f5a-27c3-4095-9942-7cb96318e667">
      <Text>Producer (V.O.)</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="7aadba68-e90b-47d6-8729-21f28f2c4510">
      <Text>(Through the intercom)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="138cec29-7201-4c86-a9bc-3bc91b2e79bb">
      <Text>Beautiful. Sound check is perfect. Now, give us “studying” everyone!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8a4e5da6-775a-470b-b50f-dd9f5b2f7765">
      <Text>On the phone, an email notification pops up from Hunter College. It is from the TA. It reads:</Text>
    </Paragraph>
    <Paragraph Type="Action" id="22d5fda1-6863-48f0-9bc4-410e47b2e39f">
      <Text>“Dear Rowan Corazon, thank you for sending me this unique sound. Looking forward to when it’s finished so I can study with it. It’s okay to choose your path. I would too! So, I am wondering if you want to make up this course next semester?”</Text>
    </Paragraph>
    <Paragraph Type="Action" id="23b16b6a-6773-4668-ab82-9577f03364a2">
      <Text>Rowan looks back through the glass. She sees Maya, who catches her eye and offers a conspiratorial wink. Holly gives a firm nod. And JoJo simply sticks out their tongue.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a0f0612c-dc26-4b2a-a235-38741180839a">
      <Text>Rowan leans into the mic.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="9739c994-48d6-42cc-97a6-32f5365824ab">
      <Text>ROWAN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="dd3467ca-2871-4f4e-a05f-7d1c9571a549">
      <Text>The loop is broken.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6bed3944-6a3f-44ac-a0d2-aa6cad552867">
      <Text>Holly strikes a defiant chord. JoJo picks up the beat. Maya starts hooting.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a2f8cfdd-35dd-4a9b-a8f0-72ab79bc55f7">
      <Text>Maya</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4eda84cb-50e1-49e3-8046-b1cf8066c22a">
      <Text>Hoot!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="87f91254-6d36-4786-b8de-f8a228fbbc40">
      <Text>The student is gone; the artist is here. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="e3dfaecb-ba61-4f83-869a-1fce19ef72c0">
      <Text>Rowan is mixing on the soundboard, mirroring herself flipping pages at her desk.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="a27312e9-e990-45c0-a2c6-cd78f5102747">
      <Text>Match cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="aa3abc45-d1af-4002-bae6-b19d5dbd6cdb">
      <SceneProperties Length="4/8" Page="32" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ROWAN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Ext. The Woods - Dawn</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e2391aac-2d17-4159-a058-a84723e38165">
      <Text>The morning light is soft. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="e2391aac-2d17-4159-a058-a84723e38165">
      <Text>Through a phone in Rowan’s hand, digital Rowan is on a loop, working the sound board. She turns off the phone.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e2391aac-2d17-4159-a058-a84723e38165">
      <Text>Rowan sits at the base of a tree, hunched over a notebook. She wears her oversized headphones and starts writing freely.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ed922f38-5d54-4283-959c-9c14312ca2d0">
      <Text>The image mirrors an earlier scene with Lofi Guy. But there is no camera, tripod, and REC icon.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="3588e206-ee6e-426a-8e52-afa34311edb0">
      <Text>Rowan pauses, exhales a long, grounded breath, and slides the headphones down to rest around her neck.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="864bfa89-9999-41fe-ba18-1411578ac00c">
      <Text>In the distance, an owl’s HOOT breaks the silence.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="8147532f-ec01-437f-8a71-063ff1748ffa">
      <Text>Rowan looks up, searching the branches. She simply smiles.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7e2c2de6-0a0a-4ceb-ac9f-c687a8f60b97">
      <Text>Rowan</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="40a25e63-6aef-42d2-8e68-d2f85abf4a13">
      <Text>We are good.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="36de373f-1f8a-45a8-925b-8851e00c1d3d">
      <Text>FADE OUT.</Text>
    </Paragraph>
    <Paragraph Alignment="Center" FirstIndent="0.00" Leading="Regular" LeftIndent="1.00" RightIndent="7.50" SpaceBefore="12" Spacing="1" StartsNewPage="No" Type="End of Act" id="1d686bb2-d1c8-465d-b94b-e6b312d4c003">
      <Text Style="Underline+AllCaps">The End</Text>
    </Paragraph>
  </Content>

