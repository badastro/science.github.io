<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="6">

  <DocumentRef DateTime="20250719T225100" id="311bf653-30ed-4d65-a49b-1d9bc7012bab">
    <XRef DateTime="20250719T224917" id="326d3bbb-277d-4966-b8b4-fc0c38660087"/>
  </DocumentRef>

  <Content>
    <Paragraph Type="Scene Heading" id="0680abd7-95c7-47f1-9ae5-691bd0e4ad12">
      <SceneProperties Length="2/8" Page="1" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. Paddy Fields in Vietnam - Day - Flashback</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e377f487-2f42-457f-b73f-326eb10e6ec1">
      <Text>A </Text>
      <Text Style="AllCaps">black-and-white illustration</Text>
      <Text> of the vast rice paddy fields.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a60d92c8-100e-488a-94da-ffed853951ae">
      <Text Style="AllCaps">A Quote appears over the illustration: </Text>
      <Text>
</Text>      <Text Style="AllCaps">“</Text>
      <Text AdornmentStyle="-1" Style="AllCaps">Ăn</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">trông</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">nôi</Text>
      <Text Style="AllCaps">, </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">ngôi</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">trông</Text>
      <Text Style="AllCaps"> </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">huóng</Text>
      <Text Style="AllCaps">.” - Vietnamese proverb</Text>
    </Paragraph>
    <Paragraph Type="Action" id="d37f95cb-7291-4f9b-a45a-0ffb7b1e8f8d">
      <Text Style="AllCaps">Subtitle: Watch the pot when you eat, watch your direction when you sit.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7ec7d420-048c-403d-83d8-e4bf1f83af4e">
      <Text>We hear </Text>
      <Text Style="AllCaps">Thwack.</Text>
      <Text> </Text>
      <Text Style="AllCaps">Thwack</Text>
      <Text>. It echoes like distant gunshots.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="99a6b25a-4700-4ea0-82a3-436ff3d54c64">
      <Text>Match cut to:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c1d99b0a-d08c-46cb-804a-c2d3bd53ae3e">
      <SceneProperties Length="1/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALLEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Senior Center - Kitchen - Day</Text>
    </Paragraph>
    <Paragraph Type="Action" id="342ca4a7-8383-440d-9bea-addb3fe29d2f">
      <Text Style="AllCaps">Thwack</Text>
      <Text>. A woman’s hand slices a scallion with a chef's knife. </Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="38215191-cbd8-4c95-bbf9-ea38d4f12d31">
      <SceneProperties Length="5/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALLEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHEYENNE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Senior Center - Hallway - ConTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="5528c71f-f1c3-4156-8380-1d02f3038fcc">
      <Text Style="AllCaps">Allen</Text>
      <Text> (70s), an elderly Black man, wearing a veteran’s cap, stops behind the door. He twitches at this familiar scent.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="02fa50d6-17e8-4855-960f-5c3ae9b88b1a">
      <Text>Then we hear the amused voice of a community worker woman named </Text>
      <Text Style="AllCaps">Cheyenne</Text>
      <Text> (40s), who stands behind Allen.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8bf959ce-8449-4701-8bdc-10560539daa9">
      <Text>Cheyenne (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="a211f0f8-7b46-4025-8be6-5286c8175a34">
      <Text>The flashbacks again?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="75ad8c18-6927-4e5b-9824-eade1765e066">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1b624ebd-50dc-4bf6-8d77-4a09306d9ee5">
      <Text>Get off my back.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="694b6da6-c58c-45d0-9074-bf8e3d23c609">
      <Text>ChEYENNE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7bee4fc0-c38f-4866-a5d1-cb7719a24c31">
      <Text>I’ll get off it if you get in there-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="94e011da-e4df-4bc5-8f30-348dcb0f5a3b">
      <Text>AlLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="922a733a-a4bc-45ff-87ca-9882df430a14">
      <Text>Nobody else is here anyway, especially the vets.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f620d244-4d0d-43fa-a7a4-57c713d5e0d6">
      <Text>ChEYENNE (O.S.)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7bee4fc0-c38f-4866-a5d1-cb7719a24c31">
      <Text>Well, I bet the guest would make a good friend.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="61b00030-63d1-4f7b-885d-6d32194e5229">
      <Text>AllEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d62c28ad-d2fa-4c89-a7bf-3fbb41ab5dfd">
      <Text>This one makes for a worthy...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="c339dea9-400a-4c1e-a7de-e4a5e6ff5340">
      <Text>Cheyenne nudges Allen through the door.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="79cc9fbd-2761-4997-93e3-da6a9f07479d">
      <SceneProperties Length="1 5/8" Page="1" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALLEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHEYENNE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="PARSLEY">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="TIDAL[S]">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>Int. Senior Center - Kitchen - ConTINUOUS</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0576d460-fa97-4326-948c-1607008d263c">
      <Text>Allen stumbles in.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="0576d460-fa97-4326-948c-1607008d263c">
      <Text Style="AllCaps">Lien</Text>
      <Text> (50s), a Vietnamese woman, continues slicing scallions without looking up. A flyer on the fridge reads: “Cooking Series: Vietnam.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="094c3e03-835a-4f44-ba09-8b6799492da8">
      <Text>AlLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e123b1c-4592-4943-9725-2b7e29a21e45">
      <Text>...foe.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8081a555-030e-4b73-893d-043e94faec8c">
      <Text>Lien</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="6cfc4fa6-9085-4cdd-b752-76b9c13c696b">
      <Text>Pho.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="ed6a171a-3e40-4f60-b5d1-16ec1d645f5a">
      <Text>Lien twirls her knife with ease, finally looking up. She locks eyes with Allen, challenging him to repeat it.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="6c921f19-bca6-4faf-baf2-5641f3b32f31">
      <Text>Lien</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="4741e21a-05be-4d8a-b9a8-0109e96147a1">
      <Text Style="Italic">Pho</Text>
      <Text>...</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1b04dcc1-7bc8-4125-930e-63a1b8047fce">
      <Text>Allen</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="245ca672-9b76-45cf-bfb6-09d2118a8203">
      <Text>Yeah, I know. I’ve been there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="45193e00-774b-4972-a29a-581fdf5654d8">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="666f0312-d369-405d-9a3f-7ad17439c6e0">
      <Text>What parts?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a19d7ba2-cc89-47f9-8f5d-c041439b243a">
      <Text>AllEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="7837160a-374d-4fbd-a2ec-72e2953f40f0">
      <Text>Everywhere I wasn’t supposed to be.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="38c1a0b0-9c44-4254-afb4-15f6cf23b821">
      <Text>LiEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="cd0f41f0-1441-4188-9298-842cd4a04620">
      <Text>You vets didn’t feel welcomed?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="e20ca58d-088c-4bf2-88d2-b20532559ee2">
      <Text>AllEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2f074f37-d07e-47ba-99c7-ed5327691ca4">
      <Text AdornmentStyle="-1">Irregardless</Text>
      <Text>, I ain’t wanna be there.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="964732e3-47b4-4ee8-9f48-c88ba1417e28">
      <Text>ChEYENNE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="965dcfa2-d86d-4110-bdab-01a4a3c06b26">
      <Text>Nor you here but hey, I expect you make enough for me when I come back!</Text>
    </Paragraph>
    <Paragraph Type="Action" id="fb1ed9eb-f612-4243-aee0-e4cecb267972">
      <Text>Cheyenne slips out the door, leaving silence.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="27b6096c-1c8e-46a0-aff6-7a6e6b85f997">
      <Text>Lien slides gingers to Allen and holds out a pair of tongs.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="c612c48f-6936-45fd-a3aa-be26a419b6d6">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1f988389-798c-49b7-93f5-e1e740c20c75">
      <Text>Char them over the flame. Until they are black.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="db1986b8-f90f-441b-81e6-66525914ec95">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="43f1f17d-0ff6-42a0-b279-59cf8b34de2f">
      <Text>You want me to ruin ‘</Text>
      <Text AdornmentStyle="-1">em</Text>
      <Text>?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4206d121-cdc8-41ea-94bc-00cf09576f9f">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="1e3fe950-b83d-4042-ae0f-1c431b70f0d6">
      <Text>No burn, no soul. No questions.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="af20ac6b-6c93-463a-add9-502114c85a81">
      <Text>Allen takes the tongs. The flame of the stove flickers. Seeing the flame, he grips the tongs like a sidearm.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4bc97216-65e2-4238-bb48-4c8cb56ecbb1">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="e94b7b6b-88fc-43d7-a3b0-4f900b83bb90">
      <Text>(Softly)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="8b2386dc-e438-46a4-8e88-b503d2bcf3ff">
      <Text>It’s just ginger.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4ee6386f-428d-4608-875d-61205db27051">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="acb8ca55-b370-4396-84cd-7e4e40e6fc97">
      <Text>It wreaks like a villain-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f114d9b8-a5fa-45c0-9d5d-b71c59f9561c">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="d098f33b-33ed-4a8a-948e-87ddd8dd3db9">
      <Text>Village.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="44a71919-e35e-4e77-ad8f-6c8101ae8f2c">
      <Text>A pot simmers. The broth foams to the top.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="44a71919-e35e-4e77-ad8f-6c8101ae8f2c">
      <Text>Allen rushes for the skimmer and precisely skims the foam.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0db22bad-421d-408b-b10b-22d040fe0a6b">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e5595a3a-8e48-4850-ae6a-756d2ab7a24d">
      <Text>Keeping the village flood-free.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="8c4de234-9119-4935-8e7b-b749a6e61b82">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="72b9d295-e8a0-44b0-9db2-750d790bd8e4">
      <Text>My commander used to say, "leave the mess in the field and sky.”</Text>
    </Paragraph>
    <Paragraph Type="Character" id="a337ddfa-a1d8-4238-8a6d-40e14ffd3d9f">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="54189e63-45c5-4a6d-b3c5-a29e6f81d963">
      <Text>I believe these are yours to leave.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a60302a7-ea43-485e-88d2-81b7b9fc95ce">
      <Text>Lien hands the star anises and cinnamons to Allen. He drops them in the pot. Aromas bloom. Allen takes a shaky breath.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="c6c86c48-ea50-48a7-8ae6-f89446bae2ae">
      <SceneProperties Length="2 2/8" Page="3" Title="">
        <SceneArcBeats>
          <CharacterArcBeat Name="ALLEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="ALLEN &amp; LIEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="CHEYENNE">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
          <CharacterArcBeat Name="LIEN">
            <Paragraph Alignment="Left" FirstIndent="0.00" Leading="Regular" LeftIndent="0.00" OutlineLevel="0" RightIndent="1.39" SpaceBefore="0" Spacing="1" StartsNewPage="No"/>
          </CharacterArcBeat>
        </SceneArcBeats>
      </SceneProperties>
      <Text>INT. Senior Center - DINING ROOM - LATER</Text>
    </Paragraph>
    <Paragraph Type="Action" id="aca7ed09-6fd3-4dba-9a02-53334cd1454b">
      <Text>They sit across from each other. The bowls are vibrant with white noodles, the amber broth, and the bright green herbs. There is a plate with lime wedges and chili powder.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="04a23188-3f35-4a72-b32b-7d89a261c8c3">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ced7424f-2406-444a-a942-a8e5f8f4979a">
      <Text>You </Text>
      <Text AdornmentStyle="-1">gotta</Text>
      <Text> lotta nerve. Teaching us how to cook food in a place that-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="4233f0a3-69be-4312-8f1f-a06d25bcc14b">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="786373c1-868d-469e-b602-a2706061514a">
      <Text>Took everything?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="06f573f5-4888-4237-81b3-924e0075b7ee">
      <Text>AlleN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="159e7cf3-8dbc-42a9-827c-1b6d072f0752">
      <Text>Who took you here, Lien?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="14333cc0-4002-4ca7-abb8-5d01b5713abc">
      <Text>LiEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="786373c1-868d-469e-b602-a2706061514a">
      <Text>Certainly not by plane, Allen.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="6e3305b8-7802-4537-a6fd-a66777434217">
      <Text>She hovers a ceramic spoon over the bowl, like a plane.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f4cdb61f-8247-482e-8015-74a92c0860f5">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5e31921b-49ca-4ff7-8f01-a8f7d0135088">
      <Text>Just a boat made of pieces of wood.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="1779c5f8-cada-4e34-986d-c6531eeafe69">
      <Text>She lets the spoon settle slowly into the broth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="1cc30eb7-f84f-4c1e-9584-6bb3af62d3fa">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="158bb203-4659-4886-8569-74856c9e0bda">
      <Text>The entertainment was the ocean and people praying under the stars.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="e2f12646-96aa-40d9-9bbc-0d3806ecf81b">
      <Text>She twirls the noodles with chopsticks.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="22e81414-247d-4f3e-acfb-787198e4204e">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="a211b84f-7a18-4fc3-97c5-7617722f1b81">
      <Text>(in Vietnamese; subtitled)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="86c96d46-522c-45d5-b86a-bcaee8bff763">
      <Text AdornmentStyle="-1">Chúng</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">tôi</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">mât</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">hêt</Text>
      <Text> </Text>
      <Text AdornmentStyle="-1">rôi</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="1be83414-5621-474e-bad3-d1a08720839b">
      <Text>(We’ve lost everything.)</Text>
    </Paragraph>
    <Paragraph Type="Action" id="234f06cc-45ea-4cf5-b0bb-edefca1d036c">
      <Text>Allen sets down his fork. The "foe" sinks in</Text>
      <Text Size="10"> </Text>
      <Text>his</Text>
      <Text Size="10"> </Text>
      <Text>mind’s</Text>
      <Text Size="10"> </Text>
      <Text>broth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="672e8469-c831-42e7-900c-f32b282e776c">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="892993ef-4aa7-4988-a3dc-0c762c40140f">
      <Text>The boat people. I read the papers then. I was already “home.” Those who never left porches called us names. Unjust- Racist- I put my anger not at my fellow citizens-</Text>
    </Paragraph>
    <Paragraph Type="Character" id="73590900-0165-497d-bbb2-567c6851a578">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ae1b6a59-f015-4892-870b-3e98e744158d">
      <Text>We’re both ghosts. You left a land that didn’t want you and went to another that didn't want you. I left a land I didn't want to lose. The land lost me.</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="f2ac007a-5368-4edc-b1ce-01e9815a06c2">
      <Text>
The fire chased us out. Now, we use it to keep warm and make warmth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="d0c50b1a-ab88-4fcd-a7b3-844485510a7a">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="3be47b3d-e278-4d04-abd4-9e71cf6b5b3c">
      <Text>My mama once said: "The water remembers." If it ain’t treated right, it’d taste like struggle.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f50dec07-a598-4f3d-aa45-569a90d6f700">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5abb16ee-0924-41ac-abd6-9331af10c0d1">
      <Text>When we were on the boat, water was the foe. All salt and death. But here we choose what stays in the pot. Then throw the rest away.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="9e452de0-a1d4-4144-9eee-e2c83de81543">
      <Text>Allen removes the bone fragments from his bowl with a spoon.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="50bc5c1c-6f03-4f48-a675-7cebfbf1bd4e">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5496597d-b217-4177-84d2-5419dff40864">
      <Text>I’ve been holding onto the wrong recipes for fifty years, Lien.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="7021a345-4194-4926-b756-9ba30ff79382">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="ea479ce7-d1ee-443a-b38b-dfb27caa2f79">
      <Text>Then today, we throw them out.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="69e366b1-bb16-42f6-ba43-69c11033852b">
      <Text>Allen picks up a lime wedge. He squeezes it, watching the juice disappear into the broth.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="93925f9a-4f55-43b3-ab2e-5fdcd11bb86a">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="e3786b7e-3de6-4060-aae1-4649905858a3">
      <Text>Ever think about returning?</Text>
    </Paragraph>
    <Paragraph Type="Character" id="09677c4c-5f66-4f84-8232-19aadd858fe8">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="2021e3b3-6e83-48d0-a30a-7231376cf90d">
      <Text>In my dreams. But when I awaken, I’m happy to sit in community.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bb48d716-3a9c-4173-9d30-e221c8b87823">
      <Text>Allen lifts his spoon and tastes the broth. He closes his eyes. For the first time, he’s simply here as one who made it to the other side of the water.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="0e724926-31e2-4cc9-bb9b-2d5e760fa2d8">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="5571095b-6f5b-4560-b9be-94e475c3090b">
      <Text>It’s good.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="87d38ae3-8187-4056-b75a-8b8377f0da54">
      <Text>LIEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="72de94d9-cc8c-48ab-ba3f-5086c4bc6ea5">
      <Text>It’s </Text>
      <Text Style="Italic">pho</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="b01ada0f-84a6-4070-829c-5a7bcde2df11">
      <Text>Allen smirks.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="bd79f2fb-adfa-46ee-8253-cae049c1c812">
      <Text>Cheyenne peeks in. She sees them sitting together, at peace.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="f145d04d-22d1-474d-838a-f267f74c8b08">
      <Text>CHEYENNE</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="550e7c59-1a2f-48a8-a5ae-553477626d87">
      <Text>Lien, Allen! Made enough to go around?</Text>
    </Paragraph>
    <Paragraph Type="Action" id="f5c4c713-a0cf-4920-a38c-02e09d4610ae">
      <Text>Allen and Lien see each other’s</Text>
      <Text Style="Italic"> </Text>
      <Text>directions</Text>
      <Text Size="10"> </Text>
      <Text>/</Text>
      <Text Size="10"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">ngôi</Text>
      <Text Style="Italic"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">trông</Text>
      <Text Size="10"> </Text>
      <Text AdornmentStyle="-1" Style="Italic">huóng</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="ee161b2d-6cb2-49b0-a22c-de4ab1ce3f6a">
      <Text>ALLEN &amp; LieN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="081b3e17-3e90-4c6d-a69a-d2a4e6731607">
      <Text>We need more friends...</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7ece5d5b-4764-4a20-a140-b9c29de596e6">
      <Text>He looks down at the bowl.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="65d85322-8d6a-4fd4-9b94-0d8962bfc751">
      <Text>ALLEN</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="38b95ddd-78d0-43d6-8f0e-3ae9ca6d579c">
      <Text>...to go with </Text>
      <Text Style="Italic">pho</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="0692d0b1-8896-4a95-9925-a82ffda92db7">
      <Text>MATCH CUT TO:</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="0680abd7-95c7-47f1-9ae5-691bd0e4ad12">
      <SceneProperties Length="3/8" Page="5" Title="">
        <SceneArcBeats/>
      </SceneProperties>
      <Text>Ext. Paddy Fields in Vietnam - Day - Flashback</Text>
    </Paragraph>
    <Paragraph Type="Action" id="4e5c6118-f149-4506-a6f5-2561c681ceab">
      <Text>The </Text>
      <Text Style="AllCaps">thwack </Text>
      <Text AdornmentStyle="-1" Style="AllCaps">thwack</Text>
      <Text Style="AllCaps"> thwack</Text>
      <Text> returns.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="7c5c3b7a-4e5d-483c-80de-87367f80a723">
      <Text>The black-and-white opening illustration bleeds into </Text>
      <Text Style="AllCaps">color</Text>
      <Text>.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="a7ec4915-2c20-4bde-adfa-8f7cd9b0a704">
      <Text>The camera pulls back to reveal the source of the </Text>
      <Text Style="AllCaps">thwacks</Text>
      <Text>: two farmers swinging bundles of harvested rice. </Text>
    </Paragraph>
    <Paragraph Type="Action" id="16d79d82-9b64-43a7-9663-09fd6c0cdc0f">
      <Text>One is a </Text>
      <Text Style="AllCaps">young black soldier</Text>
      <Text>. Beside him is a </Text>
      <Text Style="AllCaps">Vietnamese girl</Text>
      <Text>. A long-forgotten rifle leans against a distant tree.</Text>
    </Paragraph>
    <Paragraph Type="Transition" id="36de373f-1f8a-45a8-925b-8851e00c1d3d">
      <Text>FADE OUT.</Text>
    </Paragraph>
    <Paragraph Type="End of Act" id="1d686bb2-d1c8-465d-b94b-e6b312d4c003">
      <Text Style="Underline+AllCaps">The End</Text>
    </Paragraph>
  </Content>

